---
const { searchEndpoint = '/search.json' } = Astro.props as { searchEndpoint?: string };
---

<div id="zz-search-modal" class="hidden">
  <div class="search-wrap">
    <input type="text" id="zz-search-input" placeholder="Search..." autocomplete="off" />
    <ul id="zz-search-results"></ul>
  </div>
</div>

<style>
  #zz-search-modal {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(5px);
    z-index: 20000;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  #zz-search-modal.visible {
    opacity: 1;
    pointer-events: auto;
  }
  .search-wrap {
    width: 80%;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    max-height: 80vh;
  }
  #zz-search-input {
    font-size: 3rem;
    background: transparent;
    border: none;
    border-bottom: 2px solid #555;
    color: white;
    width: 100%;
    outline: none;
    text-align: center;
    padding-bottom: 0.5rem;
    font-family: inherit;
  }
  #zz-search-results {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    overflow-y: auto;
  }
  :global(#zz-search-results li) {
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #333;
    padding-bottom: 1rem;
  }
  :global(#zz-search-results a) {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  :global(#zz-search-results h3) {
    margin: 0 0 0.5rem 0;
    color: #fff;
    font-size: 1.2rem;
  }
  :global(#zz-search-results p) {
    color: #aaa;
    font-size: 1rem;
    margin: 0;
    line-height: 1.4;
  }
  :global(.search-highlight) {
    color: #fff;
    background: rgba(255, 255, 255, 0.2);
    font-weight: bold;
    padding: 0 2px;
  }
</style>

<script define:vars={{ searchEndpoint }}>
  let searchData = null;
  const commands = [
    { keys: ['home', 'inicio'], slug: '/', title: 'Inicio', type: 'Special' },
    { keys: ['dash', 'board'], slug: '/dashboard', title: 'Dashboard', type: 'Special' },
    { keys: ['about', 'acerca'], slug: '/about', title: 'Acerca de', type: 'Special' },
  ];

  const normalizeSearchItem = (item) => ({
    title: String(item.title || ''),
    slug: String(item.slug || ''),
    content: typeof item.content === 'string' ? item.content : null,
    type: String(item.type || 'Page'),
    hasDataview: Boolean(item.hasDataview),
  });

  function initSearch() {
    const modal = document.getElementById('zz-search-modal');
    const input = document.getElementById('zz-search-input');
    const resultsContainer = document.getElementById('zz-search-results');
    const searchWindow = window;

    if (!(modal instanceof HTMLDivElement)) return;
    if (!(input instanceof HTMLInputElement)) return;
    if (!(resultsContainer instanceof HTMLUListElement)) return;

    searchWindow.openSearch = async () => {
      modal.classList.add('visible');
      input.focus();
      if (!searchData) {
        try {
          const res = await fetch(searchEndpoint);
          const payload = await res.json();
          searchData = Array.isArray(payload)
            ? payload
                .filter((item) => typeof item === 'object' && item !== null)
                .map((item) => normalizeSearchItem(item))
            : [];
        } catch (e) {
          console.error('Failed to load search index', e);
        }
      }
    };

    searchWindow.closeSearch = () => {
      modal.classList.remove('visible');
      input.value = '';
      resultsContainer.innerHTML = '';
    };

    modal.onclick = (e) => {
      if (e.target === modal) searchWindow.closeSearch?.();
    };

    input.onkeydown = (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const first = resultsContainer.querySelector('a');
        if (first instanceof HTMLAnchorElement) first.click();
      }
    };

    input.oninput = (e) => {
      const target = e.target;
      if (!(target instanceof HTMLInputElement)) return;

      const query = target.value.toLowerCase();
      if (query.length < 2) {
        resultsContainer.innerHTML = '';
        return;
      }

      const commandResults = commands
        .filter((cmd) => cmd.keys.some((key) => key.includes(query)))
        .map(({ keys: _keys, ...cmd }) => cmd);

      let contentResults = [];
      if (searchData) {
        contentResults = searchData.filter((item) => {
          return (item.title && item.title.toLowerCase().includes(query))
            || (item.content && item.content.toLowerCase().includes(query));
        });
      }

      const results = [...commandResults, ...contentResults];

      resultsContainer.innerHTML = results.slice(0, 10).map((item) => {
        const content = typeof item.content === 'string' ? item.content : '';
        let snippet = '';
        if (content) {
          const lowerContent = content.toLowerCase();
          const idx = lowerContent.indexOf(query);
          if (idx !== -1) {
            const start = Math.max(0, idx - 40);
            const end = Math.min(content.length, idx + query.length + 40);
            snippet = content.substring(start, end);
            const regex = new RegExp(`(${query})`, 'gi');
            snippet = '...' + snippet.replace(regex, '<span class="search-highlight">$1</span>') + '...';
          } else {
            snippet = content.substring(0, 80) + '...';
          }
        } else if (item.type === 'Special') {
          snippet = '<span style="opacity:0.7; font-style:italic;">Jump to page</span>';
        }

        const dvBullet = item.hasDataview
          ? '<span style="display:inline-block;width:6px;height:6px;background:violet;border-radius:50%;margin-left:8px;vertical-align:middle;" title="Contains Dataview"></span>'
          : '';

        return `
          <li>
            <a href="${item.slug}" data-title="${String(item.title || '').replace(/"/g, '&quot;')}">
              <h3>${item.title}${dvBullet} <small style="opacity:0.5; font-size:0.8em">(${item.type})</small></h3>
              <p>${snippet}</p>
            </a>
          </li>
        `;
      }).join('');
    };

    resultsContainer.onclick = async (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;

      const link = target.closest('a');
      if (!(link instanceof HTMLAnchorElement)) return;

      const handler = searchWindow.handleSearchNavigation;
      if (typeof handler !== 'function') return;

      e.preventDefault();

      try {
        const handled = await handler({
          href: link.getAttribute('href') || '',
          title: link.getAttribute('data-title') || '',
        });

        if (handled !== false) {
          searchWindow.closeSearch?.();
        }
      } catch (error) {
        console.error('Room search navigation failed', error);
      }
    };
  }

  const handleGlobalKeydown = (e) => {
    const modal = document.getElementById('zz-search-modal');
    const searchWindow = window;
    if (e.key === 'Escape' && modal instanceof HTMLElement && modal.classList.contains('visible')) {
      searchWindow.closeSearch?.();
    }

    const target = e.target;
    const isEditable = target instanceof Element && target.matches('input, textarea, [contenteditable]');
    if ((e.key === '?' || (e.key === 'S' && e.shiftKey)) && !isEditable) {
      e.preventDefault();
      void searchWindow.openSearch?.();
    }
  };

  document.addEventListener('astro:page-load', () => {
    initSearch();
    document.removeEventListener('keydown', handleGlobalKeydown);
    document.addEventListener('keydown', handleGlobalKeydown);
  });
  
  // Init on first load as well
  initSearch();
  document.removeEventListener('keydown', handleGlobalKeydown);
  document.addEventListener('keydown', handleGlobalKeydown);
</script>
