---
import '../styles/ribbon.css';
import { getCollection } from 'astro:content';
import { isElevatedGlobalRole } from '../lib/roles';
import { buildCourseHref } from '../lib/course-routing';

interface Props {
  courseId?: string;
  courseHref?: string;
  performativeRoomHref?: string;
  activeCourseCode?: string;
  session?: { user?: { name?: string; email?: string; image?: string } } | null;
  revealHref?: string;
  publicReaderMode?: boolean;
}

const {
  courseId = '',
  courseHref = '/cursos',
  performativeRoomHref = '',
  activeCourseCode = '',
  session = null,
  revealHref = '',
  publicReaderMode = false,
} = Astro.props;

const isPublicReaderMode = Boolean(publicReaderMode);

const userInitial = (session?.user?.name || session?.user?.email || '?')
  .trim()
  .charAt(0)
  .toUpperCase();
const hasVivo = Boolean(performativeRoomHref);
const badgeLabel = activeCourseCode.slice(0, 4) || '···';
const dashboardHref = courseId ? `/dashboard?course=${encodeURIComponent(courseId)}` : '/dashboard';

// Get all courses from the content collection
const allCourseFiles = await getCollection('cursos').catch(() => []);
const coursesData = allCourseFiles
  .filter(entry => entry.id.endsWith('_index'))
  .map(entry => {
    const cid = entry.id.replace('/_index', '');
    return {
      id: cid,
      title: entry.data?.title || cid,
      code: (entry.data as any)?.code || cid.slice(0, 4).toUpperCase(),
      href: buildCourseHref(cid, (entry.data || {}) as Record<string, unknown>),
      public: (entry.data as any)?.public ?? false,
    };
  });

let userCourses: typeof coursesData = [];

if (session?.user?.email) {
  try {
    const { query } = await import('../lib/db/pool');
    const email = String(session.user.email).trim().toLowerCase();

    const { data: users } = await query(
      `SELECT id, role FROM "User" WHERE "email" ILIKE $1`,
      [email]
    );
    const user = users?.[0];

    if (user) {
      const isTeacher = isElevatedGlobalRole(user.role);

      if (isTeacher) {
        userCourses = coursesData;
      } else {
        const { data: enrollments } = await query(
          `SELECT "courseId" FROM "Enrollment" WHERE "userId" = $1`,
          [user.id]
        );
        const enrolledIds = enrollments ? enrollments.map((e: any) => String(e.courseId)) : [];
        userCourses = coursesData.filter(c => enrolledIds.includes(c.id));
      }
    }
  } catch (error) {
    console.error('Error fetching user courses for ribbon switcher:', error);
  }
} else {
  userCourses = coursesData.filter(c => c.public);
}
---

<!-- Desktop ribbon / Mobile bottom bar -->
<nav class="ribbon" aria-label="Navegación principal">

  <!-- Brand logo -->
  <a href="/" class="ribbon-item ribbon-item--logo" aria-label="musiki26 — inicio" title="Inicio">
    <img src="/logo-musiki.png" alt="musiki26" />
    <span class="ribbon-beacon" aria-hidden="true"></span>
  </a>

  <!-- Course nav toggle (was .course-sidebar-handle--left) -->
  {!isPublicReaderMode && (
    <button
      type="button"
      class="ribbon-item ribbon-item--circle ribbon-item--mobile-visible ribbon-mobile-primary ribbon-mobile-primary--toc"
      data-sidebar-toggle="left"
      aria-label="Navegación del curso"
      title="Navegación del curso (⌘/Ctrl + \)"
    >
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M3 12h18M3 6h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  )}

  <div class="ribbon-divider"></div>

  <!-- Profile -->
  {session?.user && (
    <a
      href={dashboardHref}
      class="ribbon-item ribbon-item--avatar"
      aria-label="Mi perfil"
      title="Mi perfil / Dashboard"
    >
      {userInitial}
    </a>
  )}

  <!-- Search -->
  <button
    type="button"
    class="ribbon-item ribbon-item--mobile-visible ribbon-mobile-primary ribbon-mobile-primary--search"
    id="ribbon-search-btn"
    aria-label="Buscar (Shift + ?)"
    title="Buscar (Shift + ?)"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
      <path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  <!-- Dashboard — mobile primary action -->
  {!isPublicReaderMode && (
    <a
      href={dashboardHref}
      class="ribbon-item ribbon-item--mobile-visible ribbon-item--mobile-only ribbon-mobile-primary ribbon-mobile-primary--dashboard"
      aria-label="Dashboard"
      title="Dashboard"
    >
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/>
        <rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/>
        <rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/>
        <rect x="14" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="2"/>
      </svg>
    </a>
  )}

  <!-- Vivo (sala performativa) — camera icon, accent color, always shown -->
  {!isPublicReaderMode && hasVivo ? (
    <a
      href={performativeRoomHref}
      class="ribbon-item ribbon-item--vivo ribbon-item--mobile-visible ribbon-mobile-primary ribbon-mobile-primary--live"
      aria-label="Sala vivo"
      title="Sala vivo"
    >
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="1" y="7" width="14" height="10" rx="2" fill="currentColor" opacity="0.18"/>
        <rect x="1" y="7" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/>
        <path d="M15 10l6.5-3.5v11L15 14V10Z" fill="currentColor"/>
        <circle cx="8" cy="12" r="2" fill="currentColor"/>
      </svg>
    </a>
  ) : !isPublicReaderMode ? (
    <span
      class="ribbon-item ribbon-item--vivo ribbon-item--vivo--off ribbon-item--mobile-visible ribbon-mobile-primary ribbon-mobile-primary--live"
      aria-label="Sala vivo (no disponible)"
      title="Sala vivo (no disponible)"
      aria-disabled="true"
    >
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="1" y="7" width="14" height="10" rx="2" fill="currentColor" opacity="0.18"/>
        <rect x="1" y="7" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/>
        <path d="M15 10l6.5-3.5v11L15 14V10Z" fill="currentColor"/>
        <circle cx="8" cy="12" r="2" fill="currentColor"/>
      </svg>
    </span>
  ) : null}

  <!-- Foro — opens right sidebar (on mobile: sweeps up from bottom) -->
  {!isPublicReaderMode && (
    <button
      type="button"
      class="ribbon-item ribbon-item--mobile-visible ribbon-mobile-primary ribbon-mobile-primary--forum"
      data-sidebar-toggle="right"
      aria-label="Foro"
      title="Foro"
    >
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  )}

  <!-- Actividad — placeholder, not yet linked -->
  {!isPublicReaderMode && (
    <span
      class="ribbon-item ribbon-item--inactive"
      aria-label="Actividad (próximamente)"
      title="Actividad (próximamente)"
      aria-disabled="true"
    >
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
        <rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
        <rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
        <rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
      </svg>
    </span>
  )}

  <!-- Theme toggle -->
  <button
    type="button"
    class="ribbon-item"
    id="ribbon-theme-toggle"
    aria-label="Cambiar tema"
    title="Cambiar tema claro/oscuro"
  >
    <!-- sun (shown in dark mode) -->
    <svg class="ribbon-theme-sun" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M12 2.25a.75.75 0 0 1 .75.75v2.25a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75ZM7.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM18.894 6.166a.75.75 0 0 0-1.06-1.06l-1.591 1.59a.75.75 0 1 0 1.06 1.061l1.591-1.59ZM21.75 12a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1 0-1.5H21a.75.75 0 0 1 .75.75ZM17.834 18.894a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 1 0-1.061 1.06l1.59 1.591ZM12 18a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-2.25A.75.75 0 0 1 12 18ZM7.758 17.303a.75.75 0 0 0-1.061-1.06l-1.591 1.59a.75.75 0 0 0 1.06 1.061l1.591-1.59ZM6 12a.75.75 0 0 1-.75.75H3a.75.75 0 0 1 0-1.5h2.25A.75.75 0 0 1 6 12ZM6.697 7.757a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 0 0-1.061 1.06l1.59 1.591Z"/>
    </svg>
    <!-- moon (shown in light mode) -->
    <svg class="ribbon-theme-moon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 0 1 .162.819A8.97 8.97 0 0 0 9 6a9 9 0 0 0 9 9 8.97 8.97 0 0 0 3.463-.69.75.75 0 0 1 .981.98 10.503 10.503 0 0 1-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 0 1 .818.162Z" clip-rule="evenodd"/>
    </svg>
  </button>

  <!-- Info / metadata panel -->
  <button
    type="button"
    class="ribbon-item ribbon-item--circle"
    data-page-info-toggle
    aria-label="Info y metadatos"
    title="Info (⌘/Ctrl + i)"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
      <path d="M12 8v.01M12 11v5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  <!-- Reveal / Slides — only when this note has a presentation theme -->
  {revealHref && (
    <a
      href={revealHref}
      class="ribbon-item ribbon-item--reveal"
      aria-label="Presentación (Reveal)"
      title="Ver presentación"
    >
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="2" y="4" width="20" height="14" rx="2" stroke="currentColor" stroke-width="2"/>
        <path d="M8 20h8M12 18v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <path d="M10 9l5 3-5 3V9Z" fill="currentColor"/>
      </svg>
    </a>
  )}

  <div class="ribbon-spacer"></div>
  <div class="ribbon-divider"></div>
  {!isPublicReaderMode && <span class="ribbon-label">pods</span>}

  <!-- Graph -->
  <button
    type="button"
    class="ribbon-item ribbon-item--mobile-visible ribbon-mobile-primary ribbon-mobile-primary--graph"
    id="ribbon-graph-btn"
    aria-label="Graph"
    title="Graph (click = modal)"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="18" cy="5" r="3" stroke="currentColor" stroke-width="2"/>
      <circle cx="6" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
      <circle cx="18" cy="19" r="3" stroke="currentColor" stroke-width="2"/>
      <path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98" stroke="currentColor" stroke-width="2"/>
    </svg>
  </button>

  <!-- Nueva nota — mobile primary action -->
  {!isPublicReaderMode && (
    <button
      type="button"
      class="ribbon-item ribbon-item--mobile-visible ribbon-item--mobile-only ribbon-mobile-primary ribbon-mobile-primary--new-note"
      id="ribbon-new-note-btn"
      aria-label="Nueva nota"
      title="Nueva nota"
    >
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
      </svg>
    </button>
  )}

  <!-- Notas -->
  {!isPublicReaderMode && (
    <button
      type="button"
      class="ribbon-item"
      id="ribbon-notas-btn"
      aria-label="Notas"
      title="Notas"
    >
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  )}

  <!-- Hyperpiano — future, disabled -->
  {!isPublicReaderMode && (
    <span
      class="ribbon-item ribbon-item--inactive"
      aria-label="Hyperpiano (próximamente)"
      title="Hyperpiano (próximamente)"
      aria-disabled="true"
    >
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="2" y="6" width="20" height="13" rx="2" stroke="currentColor" stroke-width="2"/>
        <path d="M7 6v6M10 6v4M14 6v6M17 6v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </span>
  )}

  <div class="ribbon-spacer"></div>
  <div class="ribbon-divider"></div>

  <!-- UNTREF / Universidad Pública -->
  <div class="ribbon-untref-container">
    <button
      type="button"
      class="ribbon-untref-btn"
      id="ribbon-untref-btn"
      aria-label="Universidad Pública Argentina"
      title="Universidad Pública Argentina — Más información"
    >
      <span class="ribbon-untref-legend">universidad pública</span>
      <img src="/logos/logo-untref.svg" alt="UNTREF" class="ribbon-untref-logo" />
    </button>
  </div>

  <!-- Course switcher badge/dropdown trigger -->
  {!isPublicReaderMode && (
    <button
      type="button"
      class="ribbon-item ribbon-item--badge"
      id="ribbon-courses-btn"
      aria-label={`Mis cursos — curso activo: ${badgeLabel}`}
      aria-haspopup="listbox"
      aria-expanded="false"
      title="Mis cursos"
    >
      {badgeLabel}
    </button>
  )}

  <!-- About -->
  <a href="/about" class="ribbon-about" aria-label="Acerca de musiki26">·</a>

</nav>

<!-- Modal for Universidad Pública -->
<dialog id="untref-modal" class="untref-modal">
  <div class="untref-modal-content">
    <div class="untref-modal-header">
      <button type="button" class="untref-modal-close" id="untref-modal-close" aria-label="Cerrar modal">&times;</button>
    </div>
    <div class="untref-modal-body markdown-body" id="untref-modal-body">
      <div class="untref-modal-loading">Cargando información...</div>
    </div>
  </div>
</dialog>

<!-- Course switcher menu -->
{!isPublicReaderMode && (
  <div class="ribbon-courses-menu" id="ribbon-courses-menu" role="listbox">
    <div class="ribbon-courses-menu-header">Mis Cursos</div>
    <div class="ribbon-courses-list">
      {userCourses.map(c => (
        <a href={c.href} class={`ribbon-courses-item ${c.id === courseId ? 'is-active' : ''}`} role="option" aria-selected={c.id === courseId}>
          <span class="ribbon-courses-item-title">{c.title}</span>
          <span class="ribbon-courses-item-code">{c.code}</span>
        </a>
      ))}
      {userCourses.length === 0 && (
        <span class="ribbon-courses-menu-empty">No tienes cursos activos</span>
      )}
    </div>
    <div class="ribbon-courses-menu-footer">
      <a href="/cursos">Ver todos los cursos</a>
    </div>
  </div>
)}

<style>
  .ribbon {
    --ribbon-width: 44px;
  }
</style>

<style is:global>
  /* Zero out header height — ribbon is vertical, no top offset needed */
  :root {
    --musiki-header-height: 0px !important;
  }
  /* Adjust theme icon visibility */
  html:not(.dark) .ribbon-theme-sun { display: none; }
  html.dark .ribbon-theme-moon { display: none; }
  /* Mobile body padding so content isn't hidden under bottom bar */
  @media (max-width: 500px) {
    body { padding-bottom: calc(var(--ribbon-mobile-clearance, 64px) + 8px) !important; }
  }

  /* Inactive (unlinked) ribbon item */
  .ribbon-item--inactive {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  /* Vivo — live camera, red accent so it pops */
  .ribbon-item--vivo:not(.ribbon-item--vivo--off) {
    color: #e53e3e !important;
  }
  .ribbon-item--vivo:not(.ribbon-item--vivo--off):hover {
    color: #fc4444 !important;
    background: color-mix(in srgb, #e53e3e 12%, transparent) !important;
  }
  .ribbon-item--vivo--off {
    color: color-mix(in srgb, var(--c-fg) 25%, transparent) !important;
    pointer-events: none;
    cursor: default;
  }

  /* Vivo camera logo 20% larger on desktop */
  .ribbon-item--vivo svg {
    width: 22px !important;
    height: 22px !important;
  }

  /* Vivo camera logo 20% larger on mobile */
  @media (max-width: 500px) {
    .ribbon > .ribbon-item--mobile-visible.ribbon-item--vivo svg {
      width: 19.2px !important;
      height: 19.2px !important;
    }
    .ribbon > .ribbon-item--mobile-visible.ribbon-item--vivo:not(.ribbon-item--vivo--off) {
      color: #e53e3e !important;
    }
  }

  /* Reveal icon — accent color hint */
  .ribbon-item--reveal {
    color: color-mix(in srgb, var(--c-fg) 55%, var(--c-accent, #7c6ff7) 45%);
  }
  .ribbon-item--reveal:hover {
    color: var(--c-accent, #7c6ff7);
  }

</style>

<script>
  const setupRibbon = () => {
    // Theme toggle — same logic as Header.astro
    const handleThemeToggle = () => {
      const el = document.documentElement;
      el.classList.toggle('dark');
      const isDark = el.classList.contains('dark');
      el.dataset.theme = isDark ? 'dark' : 'light';
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    };

    ['ribbon-theme-toggle'].forEach((id) => {
      const btn = document.getElementById(id);
      if (btn && !btn.dataset.bound) {
        btn.dataset.bound = 'true';
        btn.addEventListener('click', handleThemeToggle);
      }
    });

    // Search: dispatch to document (Search.astro listens on document, not window)
    const searchBtn = document.getElementById('ribbon-search-btn');
    if (searchBtn && !searchBtn.dataset.bound) {
      searchBtn.dataset.bound = 'true';
      searchBtn.addEventListener('click', () => {
        document.dispatchEvent(new KeyboardEvent('keydown', { key: '?', shiftKey: true, bubbles: true }));
      });
    }

    // New note: reuse the course notes sidebar create action.
    const newNoteBtn = document.getElementById('ribbon-new-note-btn');
    if (newNoteBtn && !newNoteBtn.dataset.bound) {
      newNoteBtn.dataset.bound = 'true';
      newNoteBtn.addEventListener('click', () => {
        const createButton = document.querySelector('.notas-sb-new-btn');
        if (createButton instanceof HTMLElement) {
          createButton.click();
          return;
        }
        window.dispatchEvent(new CustomEvent('musiki:create-note'));
      });
    }

    // Haptic feedback when toggling sidebars on mobile
    if (typeof navigator.vibrate === 'function') {
      document.querySelectorAll('[data-sidebar-toggle]').forEach((btn) => {
        if (btn instanceof HTMLElement && !btn.dataset.hapticBound) {
          btn.dataset.hapticBound = 'true';
          btn.addEventListener('click', () => {
            if (window.matchMedia('(max-width: 500px)').matches) {
              navigator.vibrate(10);
            }
          });
        }
      });
    }

    // Graph: open modal by clicking existing trigger if present, else dispatch event
    const graphBtn = document.getElementById('ribbon-graph-btn');
    const openGraph = () => {
      const existing = document.querySelector('[data-graph-modal-trigger], #graph-modal-trigger');
      if (existing instanceof HTMLElement) {
        existing.click();
      } else {
        window.dispatchEvent(new CustomEvent('musiki:open-graph'));
      }
    };
    if (graphBtn && !graphBtn.dataset.bound) { graphBtn.dataset.bound = 'true'; graphBtn.addEventListener('click', openGraph); }

    // Notas: dispatch event that dockview-workspace listens for
    const notasBtn = document.getElementById('ribbon-notas-btn');
    const openNotas = () => window.dispatchEvent(new CustomEvent('musiki:open-notas'));
    if (notasBtn && !notasBtn.dataset.bound) { notasBtn.dataset.bound = 'true'; notasBtn.addEventListener('click', openNotas); }


    // Page info toggle: dispatch event; slug.astro handles opening the right sidebar + info panel
    document.querySelectorAll('[data-page-info-toggle]').forEach((btn) => {
      if (btn instanceof HTMLElement && !btn.dataset.bound) {
        btn.dataset.bound = 'true';
        btn.addEventListener('click', () => window.dispatchEvent(new CustomEvent('musiki:open-page-info')));
      }
    });

    // UNTREF Modal setup
    const untrefBtn = document.getElementById('ribbon-untref-btn');
    const untrefModal = document.getElementById('untref-modal');
    const untrefClose = document.getElementById('untref-modal-close');
    const untrefBody = document.getElementById('untref-modal-body');

    if (untrefBtn && untrefModal instanceof HTMLDialogElement && !untrefBtn.dataset.bound) {
      untrefBtn.dataset.bound = 'true';
      let contentLoaded = false;

      const openModal = async () => {
        untrefModal.showModal();

        if (!contentLoaded && untrefBody) {
          try {
            const response = await fetch('/universidad-publica.md');
            if (!response.ok) throw new Error('Error al cargar la información');
            const markdownText = await response.text();

            // Import marked dynamically for performance
            const { marked } = await import('marked');
            untrefBody.innerHTML = await marked.parse(markdownText);
            contentLoaded = true;
          } catch (error) {
            console.error('Error loading public university info:', error);
            untrefBody.innerHTML = `<div class="untref-modal-error" style="padding: 2rem; text-align: center;">
              <h3>Error de carga</h3>
              <p>No se pudo cargar la información sobre la universidad pública. Por favor, intente nuevamente más tarde.</p>
            </div>`;
          }
        }
      };

      untrefBtn.addEventListener('click', openModal);

      // Light dismiss (click outside modal content to close)
      untrefModal.addEventListener('click', (e) => {
        if (e.target === untrefModal) {
          untrefModal.close();
        }
      });

      if (untrefClose) {
        untrefClose.addEventListener('click', () => {
          untrefModal.close();
        });
      }
    }

    // Courses Dropdown setup
    const coursesBtn = document.getElementById('ribbon-courses-btn');
    const coursesMenu = document.getElementById('ribbon-courses-menu');

    if (coursesBtn && coursesMenu && !coursesBtn.dataset.bound) {
      coursesBtn.dataset.bound = 'true';

      const toggleMenu = (e: Event) => {
        e.stopPropagation();
        const isOpen = coursesMenu.classList.toggle('is-open');
        coursesBtn.setAttribute('aria-expanded', String(isOpen));
      };

      coursesBtn.addEventListener('click', toggleMenu);

      // Close menu when clicking outside
      document.addEventListener('click', (e) => {
        if (coursesMenu.classList.contains('is-open') && !coursesMenu.contains(e.target as Node) && e.target !== coursesBtn) {
          coursesMenu.classList.remove('is-open');
          coursesBtn.setAttribute('aria-expanded', 'false');
        }
      });

      // Close menu on ESC key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && coursesMenu.classList.contains('is-open')) {
          coursesMenu.classList.remove('is-open');
          coursesBtn.setAttribute('aria-expanded', 'false');
          coursesBtn.focus();
        }
      });
    }

  };

  setupRibbon();
  document.addEventListener('astro:page-load', setupRibbon);
</script>
