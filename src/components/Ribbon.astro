---
import '../styles/ribbon.css';

interface Props {
  courseId?: string;
  courseHref?: string;
  performativeRoomHref?: string;
  activeCourseCode?: string;
  session?: { user?: { name?: string; email?: string; image?: string } } | null;
  revealHref?: string;
}

const {
  courseId = '',
  courseHref = '/cursos',
  performativeRoomHref = '',
  activeCourseCode = '',
  session = null,
  revealHref = '',
} = Astro.props;

const userInitial = (session?.user?.name || session?.user?.email || '?')
  .trim()
  .charAt(0)
  .toUpperCase();
const hasVivo = Boolean(performativeRoomHref);
const badgeLabel = activeCourseCode.slice(0, 4) || '···';
---

<!-- Desktop ribbon / Mobile bottom bar -->
<nav class="ribbon" aria-label="Navegación principal">

  <!-- Brand logo -->
  <a href="/" class="ribbon-item ribbon-item--logo" aria-label="musiki26 — inicio" title="Inicio">
    <img src="/logo-musiki.png" alt="musiki26" />
    <span class="ribbon-beacon" aria-hidden="true"></span>
  </a>

  <!-- Course nav toggle (was .course-sidebar-handle--left) -->
  <button
    type="button"
    class="ribbon-item ribbon-item--circle ribbon-item--mobile-visible"
    data-sidebar-toggle="left"
    aria-label="Navegación del curso"
    title="Navegación del curso (⌘/Ctrl + \)"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M3 12h18M3 6h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  <div class="ribbon-divider"></div>

  <!-- Profile -->
  {session?.user && (
    <a
      href="/dashboard"
      class="ribbon-item ribbon-item--avatar"
      aria-label="Mi perfil"
      title="Mi perfil / Dashboard"
    >
      {userInitial}
    </a>
  )}

  <!-- Search -->
  <button
    type="button"
    class="ribbon-item ribbon-item--mobile-visible"
    id="ribbon-search-btn"
    aria-label="Buscar (Shift + ?)"
    title="Buscar (Shift + ?)"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
      <path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  <!-- Vivo (sala performativa) — camera icon, accent color, always shown -->
  {hasVivo ? (
    <a
      href={performativeRoomHref}
      class="ribbon-item ribbon-item--vivo ribbon-item--mobile-visible"
      aria-label="Sala vivo"
      title="Sala vivo"
    >
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="1" y="7" width="14" height="10" rx="2" fill="currentColor" opacity="0.18"/>
        <rect x="1" y="7" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/>
        <path d="M15 10l6.5-3.5v11L15 14V10Z" fill="currentColor"/>
        <circle cx="8" cy="12" r="2" fill="currentColor"/>
      </svg>
    </a>
  ) : (
    <span
      class="ribbon-item ribbon-item--vivo ribbon-item--vivo--off ribbon-item--mobile-visible"
      aria-label="Sala vivo (no disponible)"
      title="Sala vivo (no disponible)"
      aria-disabled="true"
    >
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="1" y="7" width="14" height="10" rx="2" fill="currentColor" opacity="0.18"/>
        <rect x="1" y="7" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/>
        <path d="M15 10l6.5-3.5v11L15 14V10Z" fill="currentColor"/>
        <circle cx="8" cy="12" r="2" fill="currentColor"/>
      </svg>
    </span>
  )}

  <!-- Foro — opens right sidebar (on mobile: sweeps up from bottom) -->
  <button
    type="button"
    class="ribbon-item"
    data-sidebar-toggle="right"
    aria-label="Foro"
    title="Foro"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <!-- Actividad — placeholder, not yet linked -->
  <span
    class="ribbon-item ribbon-item--inactive"
    aria-label="Actividad (próximamente)"
    title="Actividad (próximamente)"
    aria-disabled="true"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
      <rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
      <rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
      <rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
    </svg>
  </span>

  <!-- Theme toggle -->
  <button
    type="button"
    class="ribbon-item"
    id="ribbon-theme-toggle"
    aria-label="Cambiar tema"
    title="Cambiar tema claro/oscuro"
  >
    <!-- sun (shown in dark mode) -->
    <svg class="ribbon-theme-sun" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M12 2.25a.75.75 0 0 1 .75.75v2.25a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75ZM7.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM18.894 6.166a.75.75 0 0 0-1.06-1.06l-1.591 1.59a.75.75 0 1 0 1.06 1.061l1.591-1.59ZM21.75 12a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1 0-1.5H21a.75.75 0 0 1 .75.75ZM17.834 18.894a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 1 0-1.061 1.06l1.59 1.591ZM12 18a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-2.25A.75.75 0 0 1 12 18ZM7.758 17.303a.75.75 0 0 0-1.061-1.06l-1.591 1.59a.75.75 0 0 0 1.06 1.061l1.591-1.59ZM6 12a.75.75 0 0 1-.75.75H3a.75.75 0 0 1 0-1.5h2.25A.75.75 0 0 1 6 12ZM6.697 7.757a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 0 0-1.061 1.06l1.59 1.591Z"/>
    </svg>
    <!-- moon (shown in light mode) -->
    <svg class="ribbon-theme-moon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 0 1 .162.819A8.97 8.97 0 0 0 9 6a9 9 0 0 0 9 9 8.97 8.97 0 0 0 3.463-.69.75.75 0 0 1 .981.98 10.503 10.503 0 0 1-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 0 1 .818.162Z" clip-rule="evenodd"/>
    </svg>
  </button>

  <!-- Info / metadata panel -->
  <button
    type="button"
    class="ribbon-item ribbon-item--circle"
    data-page-info-toggle
    aria-label="Info y metadatos"
    title="Info (⌘/Ctrl + Shift + \)"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
      <path d="M12 8v.01M12 11v5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  <!-- Reveal / Slides — only when this note has a presentation theme -->
  {revealHref && (
    <a
      href={revealHref}
      class="ribbon-item ribbon-item--reveal"
      aria-label="Presentación (Reveal)"
      title="Ver presentación"
    >
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="2" y="4" width="20" height="14" rx="2" stroke="currentColor" stroke-width="2"/>
        <path d="M8 20h8M12 18v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <path d="M10 9l5 3-5 3V9Z" fill="currentColor"/>
      </svg>
    </a>
  )}

  <div class="ribbon-spacer"></div>
  <div class="ribbon-divider"></div>
  <span class="ribbon-label">pods</span>

  <!-- Graph -->
  <button
    type="button"
    class="ribbon-item"
    id="ribbon-graph-btn"
    aria-label="Graph"
    title="Graph (click = modal)"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="18" cy="5" r="3" stroke="currentColor" stroke-width="2"/>
      <circle cx="6" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
      <circle cx="18" cy="19" r="3" stroke="currentColor" stroke-width="2"/>
      <path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98" stroke="currentColor" stroke-width="2"/>
    </svg>
  </button>

  <!-- Notas -->
  <button
    type="button"
    class="ribbon-item"
    id="ribbon-notas-btn"
    aria-label="Notas"
    title="Notas"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  <!-- Hyperpiano — opens course pod workspace -->
  <button
    type="button"
    class="ribbon-item"
    id="ribbon-hyperpiano-btn"
    aria-label="Hyperpiano"
    title="Hyperpiano"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="2" y="6" width="20" height="13" rx="2" stroke="currentColor" stroke-width="2"/>
      <path d="M7 6v6M10 6v4M14 6v6M17 6v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  <!-- SA — Sonic Analyzer with mic input -->
  <button
    type="button"
    class="ribbon-item"
    id="ribbon-sa-btn"
    aria-label="Sonic Analyzer"
    title="Sonic Analyzer"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M2 12h2M6 8v8M10 5v14M14 9v6M18 7v10M22 12h-2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  <!-- SV — Sonic Visualizer (audio file analysis) -->
  <button
    type="button"
    class="ribbon-item"
    id="ribbon-sv-btn"
    aria-label="Sonic Visualizer"
    title="Sonic Visualizer"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M3 3v18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M7 16l4-6 4 4 3-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div class="ribbon-spacer"></div>
  <div class="ribbon-divider"></div>

  <!-- Course switcher badge -->
  <a
    href="/cursos"
    class="ribbon-item ribbon-item--badge"
    aria-label={`Mis cursos — curso activo: ${badgeLabel}`}
    title="Mis cursos"
  >
    {badgeLabel}
  </a>

  <!-- About -->
  <a href="/about" class="ribbon-about" aria-label="Acerca de musiki26">·</a>

  <!-- Mobile "···más" toggle — only visible on mobile -->
  <button
    type="button"
    class="ribbon-item ribbon-item--mobile-visible"
    data-ribbon-mas-toggle
    aria-label="Más opciones"
    title="Más opciones"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="12" cy="5" r="1.5" fill="currentColor"/>
      <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
      <circle cx="12" cy="19" r="1.5" fill="currentColor"/>
    </svg>
  </button>

</nav>

<!-- Mobile "más" sheet — icon-only grid -->
<div class="ribbon-mas-sheet" id="ribbon-mas-sheet" aria-hidden="true">
  <div class="ribbon-mas-grid">
    {session?.user && (
      <a href="/dashboard" class="ribbon-mas-icon" aria-label="Perfil" title="Perfil">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2"/>
          <path d="M4 20c0-4 3.582-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </a>
    )}
    <!-- Vivo -->
    {hasVivo ? (
      <a href={performativeRoomHref} class="ribbon-mas-icon ribbon-mas-icon--vivo" aria-label="Sala vivo" title="Sala vivo">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="1" y="7" width="14" height="10" rx="2" fill="currentColor" opacity="0.18"/>
          <rect x="1" y="7" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/>
          <path d="M15 10l6.5-3.5v11L15 14V10Z" fill="currentColor"/>
          <circle cx="8" cy="12" r="2" fill="currentColor"/>
        </svg>
      </a>
    ) : (
      <span class="ribbon-mas-icon ribbon-mas-icon--vivo ribbon-mas-icon--disabled" aria-label="Sala vivo (no disponible)" aria-disabled="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="1" y="7" width="14" height="10" rx="2" fill="currentColor" opacity="0.18"/>
          <rect x="1" y="7" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/>
          <path d="M15 10l6.5-3.5v11L15 14V10Z" fill="currentColor"/>
          <circle cx="8" cy="12" r="2" fill="currentColor"/>
        </svg>
      </span>
    )}
    <!-- Foro -->
    <button type="button" class="ribbon-mas-icon" data-sidebar-toggle="right" aria-label="Foro" title="Foro">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <!-- Theme -->
    <button type="button" class="ribbon-mas-icon" id="ribbon-mas-theme" aria-label="Cambiar tema" title="Cambiar tema">
      <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 0 1 .162.819A8.97 8.97 0 0 0 9 6a9 9 0 0 0 9 9 8.97 8.97 0 0 0 3.463-.69.75.75 0 0 1 .981.98 10.503 10.503 0 0 1-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 0 1 .818.162Z" clip-rule="evenodd"/>
      </svg>
    </button>
    <!-- Info -->
    <button type="button" class="ribbon-mas-icon" data-page-info-toggle id="ribbon-mas-info" aria-label="Info" title="Info">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
        <path d="M12 8v.01M12 11v5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <!-- Graph -->
    <button type="button" class="ribbon-mas-icon" id="ribbon-mas-graph" aria-label="Graph" title="Graph">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="18" cy="5" r="3" stroke="currentColor" stroke-width="2"/>
        <circle cx="6" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
        <circle cx="18" cy="19" r="3" stroke="currentColor" stroke-width="2"/>
        <path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98" stroke="currentColor" stroke-width="2"/>
      </svg>
    </button>
    <!-- Notas -->
    <button type="button" class="ribbon-mas-icon" id="ribbon-mas-notas" aria-label="Notas" title="Notas">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <!-- Hyperpiano -->
    <button type="button" class="ribbon-mas-icon" id="ribbon-mas-hyperpiano" aria-label="Hyperpiano" title="Hyperpiano">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="2" y="6" width="20" height="13" rx="2" stroke="currentColor" stroke-width="2"/>
        <path d="M7 6v6M10 6v4M14 6v6M17 6v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <!-- SA -->
    <button type="button" class="ribbon-mas-icon" id="ribbon-mas-sa" aria-label="Sonic Analyzer" title="Sonic Analyzer">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M2 12h2M6 8v8M10 5v14M14 9v6M18 7v10M22 12h-2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <!-- SV -->
    <button type="button" class="ribbon-mas-icon" id="ribbon-mas-sv" aria-label="Sonic Visualizer" title="Sonic Visualizer">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M3 3v18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M7 16l4-6 4 4 3-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</div>

<style>
  .ribbon {
    --ribbon-width: 44px;
  }
</style>

<style is:global>
  /* Zero out header height — ribbon is vertical, no top offset needed */
  :root {
    --musiki-header-height: 0px !important;
  }
  /* Adjust theme icon visibility */
  html:not(.dark) .ribbon-theme-sun { display: none; }
  html.dark .ribbon-theme-moon { display: none; }
  /* Mobile body padding so content isn't hidden under bottom bar */
  @media (max-width: 500px) {
    body { padding-bottom: var(--ribbon-bottom-height, 60px); }
  }

  /* Inactive (unlinked) ribbon item */
  .ribbon-item--inactive {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  /* Vivo — live camera, red accent so it pops */
  .ribbon-item--vivo {
    color: #e53e3e;
  }
  .ribbon-item--vivo:hover {
    color: #fc4444;
    background: color-mix(in srgb, #e53e3e 12%, transparent);
  }
  .ribbon-item--vivo--off {
    color: color-mix(in srgb, var(--c-fg) 25%, transparent);
    pointer-events: none;
    cursor: default;
  }
  .ribbon-mas-icon--vivo {
    color: #e53e3e;
    background: color-mix(in srgb, #e53e3e 10%, transparent) !important;
  }
  .ribbon-mas-icon--vivo:active {
    background: color-mix(in srgb, #e53e3e 20%, transparent) !important;
  }

  /* Reveal icon — accent color hint */
  .ribbon-item--reveal {
    color: color-mix(in srgb, var(--c-fg) 55%, var(--c-accent, #7c6ff7) 45%);
  }
  .ribbon-item--reveal:hover {
    color: var(--c-accent, #7c6ff7);
  }

  /* Mobile más sheet */
  @media (max-width: 500px) {
    .ribbon-mas-sheet {
      position: fixed;
      bottom: var(--ribbon-bottom-height);
      right: 0;
      left: 0;
      background: color-mix(in srgb, var(--c-bg) 96%, var(--c-fg) 4%);
      border: 1px solid var(--ribbon-border);
      border-bottom: none;
      border-radius: 10px 10px 0 0;
      padding: 14px 10px;
      z-index: 101;
      box-shadow: 0 -4px 20px rgba(0,0,0,0.18);
      transform: translateY(100%);
      transition: transform 220ms cubic-bezier(0.32, 0.72, 0, 1);
    }
    .ribbon-mas-sheet.is-open {
      transform: translateY(0);
    }
    .ribbon-mas-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
    }
    .ribbon-mas-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 54px;
      height: 54px;
      border-radius: 12px;
      color: var(--c-fg);
      background: color-mix(in srgb, var(--c-fg) 6%, transparent);
      border: none;
      cursor: pointer;
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
    }
    .ribbon-mas-icon:active {
      background: color-mix(in srgb, var(--c-fg) 14%, transparent);
    }
    .ribbon-mas-icon svg {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
    }
    .ribbon-mas-icon--disabled {
      opacity: 0.3;
      pointer-events: none;
    }
  }
  /* Hide sheet on desktop */
  @media (min-width: 501px) {
    .ribbon-mas-sheet { display: none; }
    .ribbon-mas-toggle { display: none; }
  }
</style>

<script>
  const setupRibbon = () => {
    // Theme toggle — same logic as Header.astro
    const handleThemeToggle = () => {
      const el = document.documentElement;
      el.classList.toggle('dark');
      const isDark = el.classList.contains('dark');
      el.dataset.theme = isDark ? 'dark' : 'light';
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    };

    ['ribbon-theme-toggle', 'ribbon-mas-theme'].forEach((id) => {
      const btn = document.getElementById(id);
      if (btn && !btn.dataset.bound) {
        btn.dataset.bound = 'true';
        btn.addEventListener('click', handleThemeToggle);
      }
    });

    // Search: dispatch to document (Search.astro listens on document, not window)
    const searchBtn = document.getElementById('ribbon-search-btn');
    if (searchBtn && !searchBtn.dataset.bound) {
      searchBtn.dataset.bound = 'true';
      searchBtn.addEventListener('click', () => {
        document.dispatchEvent(new KeyboardEvent('keydown', { key: '?', shiftKey: true, bubbles: true }));
      });
    }

    // Haptic feedback when toggling sidebars on mobile
    if (typeof navigator.vibrate === 'function') {
      document.querySelectorAll('[data-sidebar-toggle]').forEach((btn) => {
        if (btn instanceof HTMLElement && !btn.dataset.hapticBound) {
          btn.dataset.hapticBound = 'true';
          btn.addEventListener('click', () => {
            if (window.matchMedia('(max-width: 500px)').matches) {
              navigator.vibrate(10);
            }
          });
        }
      });
    }

    // Graph: open modal by clicking existing trigger if present, else dispatch event
    const graphBtn = document.getElementById('ribbon-graph-btn');
    const masGraphBtn = document.getElementById('ribbon-mas-graph');
    const openGraph = () => {
      const existing = document.querySelector('[data-graph-modal-trigger], #graph-modal-trigger');
      if (existing instanceof HTMLElement) {
        existing.click();
      } else {
        window.dispatchEvent(new CustomEvent('musiki:open-graph'));
      }
    };
    if (graphBtn && !graphBtn.dataset.bound) { graphBtn.dataset.bound = 'true'; graphBtn.addEventListener('click', openGraph); }
    if (masGraphBtn && !masGraphBtn.dataset.bound) { masGraphBtn.dataset.bound = 'true'; masGraphBtn.addEventListener('click', openGraph); }

    // Notas: dispatch event that dockview-workspace listens for
    const notasBtn = document.getElementById('ribbon-notas-btn');
    const masNotasBtn = document.getElementById('ribbon-mas-notas');
    const openNotas = () => window.dispatchEvent(new CustomEvent('musiki:open-notas'));
    if (notasBtn && !notasBtn.dataset.bound) { notasBtn.dataset.bound = 'true'; notasBtn.addEventListener('click', openNotas); }
    if (masNotasBtn && !masNotasBtn.dataset.bound) { masNotasBtn.dataset.bound = 'true'; masNotasBtn.addEventListener('click', openNotas); }

    // Hyperpiano: open CoursePodWorkspace with hyperpiano pod
    const hpBtn = document.getElementById('ribbon-hyperpiano-btn');
    const masHpBtn = document.getElementById('ribbon-mas-hyperpiano');
    const openHyperpiano = () => window.dispatchEvent(new CustomEvent('musiki:open-hyperpiano'));
    if (hpBtn && !hpBtn.dataset.bound) { hpBtn.dataset.bound = 'true'; hpBtn.addEventListener('click', openHyperpiano); }
    if (masHpBtn && !masHpBtn.dataset.bound) { masHpBtn.dataset.bound = 'true'; masHpBtn.addEventListener('click', openHyperpiano); }

    // SA: open CoursePodWorkspace with sonic-analyzer pod (mic input)
    const saBtn = document.getElementById('ribbon-sa-btn');
    const masSaBtn = document.getElementById('ribbon-mas-sa');
    const openSA = () => window.dispatchEvent(new CustomEvent('musiki:open-sa'));
    if (saBtn && !saBtn.dataset.bound) { saBtn.dataset.bound = 'true'; saBtn.addEventListener('click', openSA); }
    if (masSaBtn && !masSaBtn.dataset.bound) { masSaBtn.dataset.bound = 'true'; masSaBtn.addEventListener('click', openSA); }

    // SV: open CoursePodWorkspace with sonic-visualizer pod (file-based)
    const svBtn = document.getElementById('ribbon-sv-btn');
    const masSvBtn = document.getElementById('ribbon-mas-sv');
    const openSV = () => window.dispatchEvent(new CustomEvent('musiki:open-sv'));
    if (svBtn && !svBtn.dataset.bound) { svBtn.dataset.bound = 'true'; svBtn.addEventListener('click', openSV); }
    if (masSvBtn && !masSvBtn.dataset.bound) { masSvBtn.dataset.bound = 'true'; masSvBtn.addEventListener('click', openSV); }

    // Page info toggle: dispatch event; slug.astro handles opening the right sidebar + info panel
    document.querySelectorAll('[data-page-info-toggle]').forEach((btn) => {
      if (btn instanceof HTMLElement && !btn.dataset.bound) {
        btn.dataset.bound = 'true';
        btn.addEventListener('click', () => window.dispatchEvent(new CustomEvent('musiki:open-page-info')));
      }
    });

    // Mobile "más" toggle
    const masSheet = document.getElementById('ribbon-mas-sheet');
    const masBtns = document.querySelectorAll('[data-ribbon-mas-toggle]');
    const closeMas = () => {
      masSheet?.classList.remove('is-open');
      masSheet?.setAttribute('aria-hidden', 'true');
    };
    masBtns.forEach((btn) => {
      if (btn instanceof HTMLElement && !btn.dataset.bound) {
        btn.dataset.bound = 'true';
        btn.addEventListener('click', () => {
          const open = masSheet?.classList.contains('is-open');
          open ? closeMas() : (masSheet?.classList.add('is-open'), masSheet?.removeAttribute('aria-hidden'));
        });
      }
    });
    // Close sheet when a mas icon is tapped
    if (masSheet && !masSheet.dataset.masItemsBound) {
      masSheet.dataset.masItemsBound = 'true';
      masSheet.querySelectorAll('.ribbon-mas-icon').forEach((item) => {
        item.addEventListener('click', () => setTimeout(closeMas, 80));
      });
    }
    // Close on outside tap
    if (!document.documentElement.dataset.ribbonOutsideClickBound) {
      document.documentElement.dataset.ribbonOutsideClickBound = 'true';
      document.addEventListener('click', (e) => {
        if (masSheet?.classList.contains('is-open') && !masSheet.contains(e.target as Node)) {
          const masToggle = document.querySelector('[data-ribbon-mas-toggle]');
          if (!masToggle?.contains(e.target as Node)) closeMas();
        }
      });
    }
  };

  setupRibbon();
  document.addEventListener('astro:page-load', setupRibbon);
</script>
