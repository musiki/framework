</style>

<script>
  const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (ch) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  }[ch]));

  const formatBytes = (value) => {
    const n = Number(value || 0);
    if (n < 1024) return `${n} B`;
    if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
    return `${(n / 1024 / 1024).toFixed(1)} MB`;
  };

  const depthForPath = (path) => Math.max(0, String(path || '').split('/').filter(Boolean).length - 1);
  const baseNameForPath = (path) => String(path || '').split('/').filter(Boolean).pop() || String(path || '');
  const normalizePrefix = (path) => {
    const parts = String(path || 'room/').split('/').filter(Boolean);
    return parts.length ? `${parts.join('/')}/` : 'room/';
  };
  const ancestorPrefixes = (path) => {
    const parts = normalizePrefix(path).split('/').filter(Boolean);
    const result = [];
    for (let index = 0; index < parts.length; index += 1) {
      result.push(`${parts.slice(0, index + 1).join('/')}/`);
    }
    return result.length ? result : ['room/'];
  };

  function typeFromUrl(url) {
    const ext = String(url || '').split('?')[0].split('.').pop()?.toLowerCase() || '';
    if (ext === 'pdf') return 'pdf';
    if (['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg'].includes(ext)) return 'img';
    if (['mp3', 'wav', 'ogg', 'm4a', 'aac', 'flac', 'mov', 'mp4'].includes(ext)) return 'audio';
    if (ext === 'md') return 'md';
    if (ext === 'tex') return 'tex';
    if (ext === 'ly') return 'ly';
    return /^https?:\/\//i.test(url) ? 'link' : 'other';
  }

  function r2PreviewMarkup(object) {
    const url = String(object?.url || '');
    const name = String(object?.name || '');
    const type = typeFromUrl(url);
    if (type === 'img') {
      return `<div class="recursos-r2-preview recursos-r2-preview--image"><img src="${esc(url)}" alt="${esc(name)}" loading="lazy" decoding="async" /></div>`;
    }
    if (type === 'pdf') {
      return `<div class="recursos-r2-preview recursos-r2-preview--pdf"><iframe src="${esc(url)}#page=1&toolbar=0&navpanes=0&scrollbar=0" title="${esc(name)}" loading="lazy"></iframe></div>`;
    }
    return `<div class="recursos-r2-preview recursos-r2-preview--${esc(type)}"><span class="recursos-r2-preview-token">${esc(type.toUpperCase())}</span></div>`;
  }

  function r2CurrentMarkup(prefix, hasObjects = false, virtualFlat = false) {
    return `
      <div class="recursos-r2-current">
        <span class="recursos-r2-current-path">${esc(prefix)}${virtualFlat ? ' · vista plana' : ''}</span>
        ${hasObjects ? `
          <span class="recursos-r2-bulk-actions">
            <span><span data-r2-selected-count>0</span> sel.</span>
            <button type="button" class="recursos-editor-btn recursos-editor-btn--danger" data-r2-bulk-delete disabled>Borrar seleccionados</button>
          </span>
        ` : ''}
      </div>
    `;
  }

  document.querySelectorAll('[data-recursos-editor]').forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    const courseId = root.dataset.courseId || '';
    const canManage = root.dataset.canManage === 'true';
    if (!courseId || !canManage) return;

    const sessionListEl = root.querySelector('[data-session-list]');
    const listEl = root.querySelector('[data-recursos-list]');
    const countEl = root.querySelector('[data-recursos-count]');
    const statusEl = root.querySelector('[data-recursos-status]');
    const r2TreeEl = root.querySelector('[data-r2-tree]');
    const r2ExplorerEl = root.querySelector('[data-r2-explorer]');
    const r2PrefixInput = root.querySelector('[data-r2-prefix]');
    const r2Dropzone = root.querySelector('[data-r2-dropzone]');
    const r2FileInput = root.querySelector('[data-r2-file-input]');
    const r2UploadButton = root.querySelector('[data-r2-upload-button]');
    const r2UploadStatus = root.querySelector('[data-r2-upload-status]');
    const attachForm = root.querySelector('[data-recursos-attach-form]');
    const attachUrl = root.querySelector('[data-attach-url]');
    const attachName = root.querySelector('[data-attach-name]');
    const attachFolder = root.querySelector('[data-attach-folder]');
    const attachClase = root.querySelector('[data-attach-clase]');
    const attachSession = root.querySelector('[data-attach-session]');
    const sessionNewBtn = root.querySelector('[data-session-new]');
    const classOptionsPayload = root.querySelector('[data-recursos-class-options]');
    let availableSessions = [];
    let classOptions = [];
    try {
      classOptions = JSON.parse(classOptionsPayload?.textContent || '[]');
    } catch {
      classOptions = [];
    }
    if (!Array.isArray(classOptions)) classOptions = [];

    const setStatus = (message) => {
      if (statusEl) statusEl.textContent = message || '';
    };

    const requestJson = async (url, options = {}) => {
      const resp = await fetch(url, options);
      const payload = await resp.json().catch(() => ({}));
      if (!resp.ok) throw new Error(payload?.error || `HTTP ${resp.status}`);
      return payload;
    };

    const copyText = async (text) => {
      await navigator.clipboard.writeText(text);
      setStatus('Link copiado');
    };

    const setR2UploadStatus = (message) => {
      if (r2UploadStatus) r2UploadStatus.textContent = message || '';
    };

    const normalizeText = (value) => String(value ?? '').trim();

    const labelForClaseId = (claseId) => {
      const normalized = normalizeText(claseId);
      if (!normalized) return 'curso';
      const match = classOptions.find((option) => normalizeText(option?.value) === normalized);
      return match?.label || normalized;
    };

    const sessionMatchesClase = (session, claseId) => {
      const sessionClaseId = normalizeText(session?.claseId);
      const selectedClaseId = normalizeText(claseId);
      return !selectedClaseId || !sessionClaseId || sessionClaseId === selectedClaseId;
    };

    const sessionLabel = (session) => {
      const name = normalizeText(session?.name) || 'sesión';
      return `${name} · ${labelForClaseId(session?.claseId)}`;
    };

    const sessionOptionsMarkup = (selected = '', claseId = '') => [
      '<option value="">Sin sesión</option>',
      ...availableSessions
        .filter((session) => sessionMatchesClase(session, claseId))
        .map((session) => `<option value="${esc(session.id)}" ${String(session.id) === String(selected) ? 'selected' : ''}>${esc(sessionLabel(session))}</option>`),
    ].join('');

    const renderAttachSessions = () => {
      if (!(attachSession instanceof HTMLSelectElement)) return;
      const selected = attachSession.value;
      const claseId = attachClase instanceof HTMLInputElement ? attachClase.value : '';
      attachSession.innerHTML = sessionOptionsMarkup(selected, claseId);
      if (selected && !attachSession.value) attachSession.value = '';
    };

    const rowMetaMarkup = (item) => {
      const parts = [item.type || 'recurso', item.source || 'manual'];
      parts.push(item.claseId ? `clase: ${labelForClaseId(item.claseId)}` : 'curso');
      const session = availableSessions.find((candidate) => String(candidate.id) === String(item.sessionId || ''));
      if (session) parts.push(`sesión: ${session.name || session.id}`);
      return parts.map(esc).join(' / ');
    };

    const renderSessionList = () => {
      if (!sessionListEl) return;
      sessionListEl.innerHTML = '';
    };

    const resourceRowMarkup = (item) => `
      <article class="recursos-row" data-id="${esc(item.id)}" draggable="true">
        <div class="recursos-row-main">
          <input data-field="name" value="${esc(item.name)}" aria-label="Nombre" title="Nombre" />
          <a class="recursos-row-link" href="${esc(item.url)}" target="_blank" rel="noreferrer" aria-label="Abrir recurso" title="${esc(item.url)}">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a5 5 0 0 0 7.1 0l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1" />
              <path d="M14 11a5 5 0 0 0-7.1 0l-2 2a5 5 0 0 0 7.1 7.1l1.1-1.1" />
            </svg>
          </a>
          <input data-field="folder" value="${esc(item.folder)}" aria-label="Carpeta" title="Carpeta" />
          <input data-field="claseId" list="recursos-editor-class-options" value="${esc(item.claseId || '')}" aria-label="Clase / capítulo" title="Clase / capítulo" placeholder="curso" />
          <select data-field="sessionId" aria-label="Sesión" title="Sesión">${sessionOptionsMarkup(item.sessionId || '', item.claseId || '')}</select>
        </div>
        <div class="recursos-meta">${rowMetaMarkup(item)}</div>
        <div class="recursos-row-actions">
          <button type="button" class="recursos-editor-btn" data-copy="${esc(item.url)}">Copiar</button>
          <button type="button" class="recursos-editor-btn" data-save>Guardar</button>
          <button type="button" class="recursos-editor-btn recursos-editor-btn--danger" data-delete>Borrar</button>
        </div>
      </article>
    `;

    const sessionGroupMarkup = (session, items) => {
      const sessionId = session?.id || '';
      const isUnsessioned = !sessionId;
      return `
        <section class="recursos-session-group" data-session-drop="${esc(sessionId)}">
          <div class="recursos-session-item" ${sessionId ? `data-session-id="${esc(sessionId)}"` : ''}>
            ${sessionId
              ? `<input data-session-name value="${esc(session.name || '')}" aria-label="Nombre de sesión" title="Nombre de sesión" />`
              : '<span class="recursos-session-name-static">Sin sesión</span>'}
            <span class="recursos-session-meta">${esc(isUnsessioned ? 'recursos generales' : labelForClaseId(session.claseId))}</span>
            ${sessionId ? '<button type="button" class="recursos-editor-btn" data-session-save>Guardar</button>' : ''}
          </div>
          <div class="recursos-session-resources">
            ${items.length ? items.map(resourceRowMarkup).join('') : '<div class="recursos-editor-empty">Sin recursos en esta sesión.</div>'}
          </div>
        </section>
      `;
    };

    const uploadR2Files = async (files) => {
      if (!(r2PrefixInput instanceof HTMLInputElement)) return;
      const fileList = Array.from(files || []).filter((file) => file instanceof File);
      if (!fileList.length) return;

      const form = new FormData();
      form.set('courseId', courseId);
      form.set('prefix', r2PrefixInput.value || 'room/');
      fileList.forEach((file) => form.append('file', file));

      try {
        setStatus(`Subiendo ${fileList.length} archivo${fileList.length === 1 ? '' : 's'}...`);
        setR2UploadStatus(`Subiendo ${fileList.length} archivo${fileList.length === 1 ? '' : 's'} a ${r2PrefixInput.value || 'room/'}`);
        const payload = await requestJson('/api/live/recursos/r2', {
          method: 'POST',
          body: form,
        });
        const uploaded = Array.isArray(payload.uploaded) ? payload.uploaded : [];
        setStatus(`${uploaded.length || fileList.length} archivo${(uploaded.length || fileList.length) === 1 ? '' : 's'} subido${(uploaded.length || fileList.length) === 1 ? '' : 's'}`);
        setR2UploadStatus('Soltar archivos aca para subirlos a la carpeta actual.');
        await loadR2();
      } catch (error) {
        const message = error?.message || String(error);
        setStatus(message);
        setR2UploadStatus(message);
      }
    };

    const getSelectedR2Keys = () => {
      if (!r2ExplorerEl) return [];
      return Array.from(r2ExplorerEl.querySelectorAll('[data-r2-select]:checked'))
        .filter((input) => input instanceof HTMLInputElement)
        .map((input) => input.value)
        .filter(Boolean);
    };

    const updateR2SelectionControls = () => {
      if (!r2ExplorerEl) return;
      const selectedCount = getSelectedR2Keys().length;
      const countEl = r2ExplorerEl.querySelector('[data-r2-selected-count]');
      const bulkBtn = r2ExplorerEl.querySelector('[data-r2-bulk-delete]');
      if (countEl) countEl.textContent = String(selectedCount);
      if (bulkBtn instanceof HTMLButtonElement) bulkBtn.disabled = selectedCount === 0;
    };

    const loadResources = async () => {
      if (!listEl) return;
      listEl.innerHTML = '<div class="recursos-editor-empty">cargando...</div>';
      try {
        const payload = await requestJson(`/api/live/recursos/editor?courseId=${encodeURIComponent(courseId)}`);
        const items = Array.isArray(payload.items) ? payload.items : [];
        availableSessions = Array.isArray(payload.sessions) ? payload.sessions : [];
        renderSessionList();
        renderAttachSessions();
        if (countEl) countEl.textContent = String(items.length);
        if (items.length === 0) {
          listEl.innerHTML = '<div class="recursos-editor-empty">Sin recursos vinculados.</div>';
          return;
        }
        const itemsBySession = new Map();
        for (const item of items) {
          const key = String(item.sessionId || '');
          if (!itemsBySession.has(key)) itemsBySession.set(key, []);
          itemsBySession.get(key).push(item);
        }
        const knownSessionIds = new Set(availableSessions.map((session) => String(session.id || '')));
        const orphanSessionGroups = [...itemsBySession.keys()]
          .filter((sessionId) => sessionId && !knownSessionIds.has(sessionId))
          .map((sessionId) => ({ id: sessionId, name: `Sesión ${sessionId.slice(0, 8)}`, claseId: '' }));
        const groups = [
          ...availableSessions,
          ...orphanSessionGroups,
          { id: '', name: 'Sin sesión', claseId: '' },
        ].filter((session) => session.id || (itemsBySession.get('') || []).length);
        listEl.innerHTML = groups
          .map((session) => sessionGroupMarkup(session, itemsBySession.get(String(session.id || '')) || []))
          .join('');
      } catch (error) {
        listEl.innerHTML = `<div class="recursos-editor-empty">${esc(error.message || error)}</div>`;
      }
    };

    const loadR2 = async () => {
      if (!r2TreeEl || !r2ExplorerEl || !(r2PrefixInput instanceof HTMLInputElement)) return;
      const prefix = normalizePrefix(r2PrefixInput.value || 'room/');
      r2PrefixInput.value = prefix;
      r2TreeEl.innerHTML = '<div class="recursos-editor-empty">cargando...</div>';
      r2ExplorerEl.innerHTML = '<div class="recursos-editor-empty">cargando R2...</div>';
      try {
        const payload = await requestJson(`/api/live/recursos/r2?courseId=${encodeURIComponent(courseId)}&prefix=${encodeURIComponent(prefix)}`);
        const effectivePrefix = normalizePrefix(payload.prefix || prefix);
        r2PrefixInput.value = effectivePrefix;
        const folders = Array.isArray(payload.folders) ? payload.folders : [];
        const objects = Array.isArray(payload.objects) ? payload.objects : [];
        const virtualFlat = Boolean(payload.virtualFlat);
        const ancestors = ancestorPrefixes(effectivePrefix);
        r2TreeEl.innerHTML = [
          ...ancestors.map((folder) => `
            <button type="button" class="recursos-r2-node recursos-r2-node--folder" style="--depth:${depthForPath(folder)}" data-folder="${esc(folder)}" data-active="${folder === effectivePrefix ? 'true' : 'false'}">
              <span class="recursos-r2-label">
                <span class="recursos-r2-icon">${folder === effectivePrefix ? '▾' : '▸'}</span>
                <span class="recursos-r2-name" title="${esc(folder)}">${esc(baseNameForPath(folder))}</span>
              </span>
            </button>
          `),
          ...folders.map((folder) => `
            <button type="button" class="recursos-r2-node recursos-r2-node--folder" style="--depth:${depthForPath(folder)}" data-folder="${esc(folder)}" data-active="false">
              <span class="recursos-r2-label">
                <span class="recursos-r2-icon">▸</span>
                <span class="recursos-r2-name" title="${esc(folder)}">${esc(baseNameForPath(folder))}</span>
              </span>
            </button>
          `),
        ].join('');

        if (!objects.length) {
          r2ExplorerEl.innerHTML = `
            ${r2CurrentMarkup(effectivePrefix, false, virtualFlat)}
            <div class="recursos-editor-empty">Sin archivos en esta carpeta.</div>
          `;
          return;
        }

        r2ExplorerEl.innerHTML = [
          r2CurrentMarkup(effectivePrefix, true, virtualFlat),
          ...objects.map((object) => `
            <div class="recursos-r2-row recursos-r2-row--file" data-url="${esc(object.url)}" data-key="${esc(object.key)}" data-name="${esc(object.name)}">
              <label class="recursos-r2-select">
                <input type="checkbox" data-r2-select value="${esc(object.key)}" aria-label="Seleccionar ${esc(object.name)}" />
              </label>
              ${r2PreviewMarkup(object)}
              <div class="recursos-r2-file-main">
                <span class="recursos-r2-file-name" title="${esc(object.key)}">${esc(object.name)}</span>
                <span class="recursos-r2-meta">${formatBytes(object.size)}</span>
                <div class="recursos-r2-actions">
                  <button type="button" class="recursos-editor-btn" data-r2-copy="${esc(object.url)}">Copiar</button>
                  <button type="button" class="recursos-editor-btn" data-r2-use>Usar</button>
                  <button type="button" class="recursos-editor-btn recursos-editor-btn--danger" data-r2-delete>Borrar</button>
                </div>
              </div>
            </div>
          `),
        ].join('');
        updateR2SelectionControls();
      } catch (error) {
        r2TreeEl.innerHTML = '';
        r2ExplorerEl.innerHTML = `<div class="recursos-editor-empty">${esc(error.message || error)}</div>`;
      }
    };

    const saveResourceRow = async (row, overrides = {}) => {
      if (!(row instanceof HTMLElement)) return;
      const id = row.dataset.id || '';
      const payload = {
        courseId,
        id,
        name: row.querySelector('[data-field="name"]')?.value || '',
        folder: row.querySelector('[data-field="folder"]')?.value || '',
        claseId: row.querySelector('[data-field="claseId"]')?.value || '',
        sessionId: row.querySelector('[data-field="sessionId"]')?.value || '',
        ...overrides,
      };
      await requestJson('/api/live/recursos/editor', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
    };

    listEl?.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      if (target.matches('[data-session-save]')) {
        const sessionRow = target.closest('[data-session-id]');
        if (!(sessionRow instanceof HTMLElement)) return;
        const nameInput = sessionRow.querySelector('[data-session-name]');
        const name = nameInput instanceof HTMLInputElement ? nameInput.value : '';
        if (!name.trim()) return;
        setStatus('Guardando sesión...');
        await requestJson('/api/live/session', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: sessionRow.dataset.sessionId || '', name }),
        });
        setStatus('Sesión guardada');
        await loadResources();
        return;
      }
      const row = target.closest('.recursos-row');
      if (!(row instanceof HTMLElement)) return;
      const id = row.dataset.id || '';
      if (target.matches('[data-copy]')) {
        await copyText(target.getAttribute('data-copy') || '');
        return;
      }
      if (target.matches('[data-save]')) {
        setStatus('Guardando...');
        await saveResourceRow(row);
        setStatus('Guardado');
        await loadResources();
        return;
      }
      if (target.matches('[data-delete]')) {
        if (!confirm('Borrar este recurso de RECURSOS?')) return;
        setStatus('Borrando...');
        await requestJson(`/api/live/recursos/editor?courseId=${encodeURIComponent(courseId)}&id=${encodeURIComponent(id)}`, {
          method: 'DELETE',
        });
        setStatus('Borrado');
        await loadResources();
      }
    });

    listEl?.addEventListener('dragstart', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const row = target.closest('.recursos-row');
      if (!(row instanceof HTMLElement)) return;
      event.dataTransfer?.setData('text/plain', row.dataset.id || '');
      event.dataTransfer?.setData('application/x-recursos-row-id', row.dataset.id || '');
    });

    listEl?.addEventListener('dragover', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const group = target.closest('[data-session-drop]');
      if (!(group instanceof HTMLElement)) return;
      event.preventDefault();
      group.dataset.dragOver = 'true';
    });

    listEl?.addEventListener('dragleave', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const group = target.closest('[data-session-drop]');
      if (group instanceof HTMLElement) group.dataset.dragOver = 'false';
    });

    listEl?.addEventListener('drop', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const group = target.closest('[data-session-drop]');
      if (!(group instanceof HTMLElement)) return;
      event.preventDefault();
      group.dataset.dragOver = 'false';
      const id = event.dataTransfer?.getData('application/x-recursos-row-id') || event.dataTransfer?.getData('text/plain') || '';
      if (!id) return;
      const row = listEl.querySelector(`.recursos-row[data-id="${CSS.escape(id)}"]`);
      if (!(row instanceof HTMLElement)) return;
      const sessionId = group.dataset.sessionDrop || '';
      const select = row.querySelector('[data-field="sessionId"]');
      if (select instanceof HTMLSelectElement) select.value = sessionId;
      setStatus('Moviendo recurso...');
      await saveResourceRow(row, { sessionId });
      setStatus('Recurso movido');
      await loadResources();
    });

    listEl?.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || !target.matches('[data-field="claseId"]')) return;
      const row = target.closest('.recursos-row');
      if (!(row instanceof HTMLElement)) return;
      const sessionSelect = row.querySelector('[data-field="sessionId"]');
      if (!(sessionSelect instanceof HTMLSelectElement)) return;
      const selected = sessionSelect.value;
      sessionSelect.innerHTML = sessionOptionsMarkup(selected, target.value);
      if (selected && !sessionSelect.value) sessionSelect.value = '';
    });

    sessionListEl?.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement) || !target.matches('[data-session-save]')) return;
      const row = target.closest('[data-session-id]');
      if (!(row instanceof HTMLElement)) return;
      const nameInput = row.querySelector('[data-session-name]');
      const name = nameInput instanceof HTMLInputElement ? nameInput.value : '';
      if (!name.trim()) return;
      setStatus('Guardando sesión...');
      await requestJson('/api/live/session', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: row.dataset.sessionId || '', name }),
      });
      setStatus('Sesión guardada');
      await loadResources();
    });

    r2TreeEl?.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const folderRow = target.closest('[data-folder]');
      if (folderRow instanceof HTMLElement && r2PrefixInput instanceof HTMLInputElement) {
        r2PrefixInput.value = folderRow.dataset.folder || 'room/';
        await loadR2();
      }
    });

    r2ExplorerEl?.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      if (target.matches('[data-r2-bulk-delete]')) {
        const keys = getSelectedR2Keys();
        if (!keys.length) return;
        if (!confirm(`Borrar ${keys.length} archivos de R2?`)) return;
        setStatus(`Borrando ${keys.length} archivos R2...`);
        await requestJson('/api/live/recursos/r2', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ courseId, keys }),
        });
        setStatus(`${keys.length} archivos R2 borrados`);
        await loadR2();
        return;
      }
      const row = target.closest('[data-url]');
      if (!(row instanceof HTMLElement)) return;
      const url = row.dataset.url || '';
      const key = row.dataset.key || '';
      const name = row.dataset.name || '';
      if (target.matches('[data-r2-copy]')) {
        await copyText(url);
        return;
      }
      if (target.matches('[data-r2-delete]')) {
        if (!confirm(`Borrar este archivo de R2?\n${key}`)) return;
        setStatus('Borrando archivo R2...');
        await requestJson('/api/live/recursos/r2', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ courseId, key }),
        });
        setStatus('Archivo R2 borrado');
        await loadR2();
        return;
      }
      if (target.matches('[data-r2-use]')) {
        if (attachUrl instanceof HTMLInputElement) attachUrl.value = url;
        if (attachName instanceof HTMLInputElement) attachName.value = name;
        if (attachFolder instanceof HTMLInputElement && !attachFolder.value) {
          const type = typeFromUrl(url);
          attachFolder.value = type === 'audio' ? 'media' : (type === 'pdf' || type === 'img' ? 'DOC' : '');
        }
        setStatus('URL preparada para vincular');
      }
    });

    r2ExplorerEl?.addEventListener('change', (event) => {
      const target = event.target;
      if (target instanceof HTMLInputElement && target.matches('[data-r2-select]')) {
        updateR2SelectionControls();
      }
    });

    attachForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = new FormData(attachForm);
      setStatus('Vinculando...');
      await requestJson('/api/live/recursos/editor', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          courseId,
          url: form.get('url'),
          name: form.get('name'),
          folder: form.get('folder'),
          claseId: form.get('claseId'),
          sessionId: form.get('sessionId'),
          roomName: form.get('roomName'),
        }),
      });
      attachForm.reset();
      const roomInput = root.querySelector('[data-attach-room]');
      if (roomInput instanceof HTMLInputElement) roomInput.value = `${courseId}-stage`;
      renderAttachSessions();
      setStatus('Vinculado');
      await loadResources();
    });

    attachClase?.addEventListener('input', renderAttachSessions);
    sessionNewBtn?.addEventListener('click', async () => {
      const defaultName = new Date().toISOString().slice(0, 10) + '-sesión';
      const name = prompt('Nombre de sesión', defaultName);
      if (!name) return;
      const claseId = attachClase instanceof HTMLInputElement ? attachClase.value : '';
      setStatus('Creando sesión...');
      const payload = await requestJson('/api/live/session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          roomName: `${courseId}-stage`,
          courseId,
          claseId: claseId || null,
          name,
        }),
      });
      const newSessionId = payload?.session?.id || '';
      await loadResources();
      if (newSessionId && attachSession instanceof HTMLSelectElement) {
        attachSession.value = newSessionId;
      }
      setStatus('Sesión creada');
    });

    root.querySelector('[data-recursos-refresh]')?.addEventListener('click', () => loadResources());
    root.querySelector('[data-r2-load]')?.addEventListener('click', () => loadR2());
    r2UploadButton?.addEventListener('click', () => {
      if (r2FileInput instanceof HTMLInputElement) r2FileInput.click();
    });
    r2FileInput?.addEventListener('change', async () => {
      if (!(r2FileInput instanceof HTMLInputElement)) return;
      await uploadR2Files(r2FileInput.files);
      r2FileInput.value = '';
    });
    r2Dropzone?.addEventListener('dragover', (event) => {
      event.preventDefault();
      if (r2Dropzone instanceof HTMLElement) r2Dropzone.dataset.dragging = 'true';
    });
    r2Dropzone?.addEventListener('dragleave', (event) => {
      if (!(event.currentTarget instanceof HTMLElement)) return;
      event.currentTarget.dataset.dragging = 'false';
    });
    r2Dropzone?.addEventListener('drop', async (event) => {
      event.preventDefault();
      if (r2Dropzone instanceof HTMLElement) r2Dropzone.dataset.dragging = 'false';
      await uploadR2Files(event.dataTransfer?.files);
    });
    root.querySelector('[data-r2-up]')?.addEventListener('click', () => {
      if (!(r2PrefixInput instanceof HTMLInputElement)) return;
      const parts = r2PrefixInput.value.split('/').filter(Boolean);
      parts.pop();
      r2PrefixInput.value = parts.length ? `${parts.join('/')}/` : 'room/';
      void loadR2();
    });

    void loadResources();
    void loadR2();
  });
</script>
