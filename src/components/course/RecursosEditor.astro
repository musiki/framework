---
type Props = {
  courseId: string;
  canManage: boolean;
  classOptions?: Array<{ value: string; label: string }>;
};

const { courseId, canManage, classOptions = [] } = Astro.props;
const classOptionsJson = JSON.stringify(classOptions).replace(/</g, '\\u003c');
---

<section
  class="recursos-editor"
  data-recursos-editor
  data-course-id={courseId}
  data-can-manage={canManage ? 'true' : 'false'}
>
  <header class="recursos-editor-header">
    <div>
      <p class="recursos-editor-kicker">80 RECURSOS</p>
      <h1>Editor de recursos</h1>
    </div>
    <button type="button" class="recursos-editor-btn" data-recursos-refresh>Actualizar</button>
  </header>

  {!canManage ? (
    <p class="recursos-editor-empty">No tenes permisos para editar recursos de este curso.</p>
  ) : (
    <>
      <div class="recursos-editor-grid">
        <section class="recursos-editor-panel">
          <div class="recursos-editor-panel-head">
            <h2>Recursos vinculados</h2>
            <span data-recursos-count>0</span>
          </div>
          <div class="recursos-session-list" data-session-list></div>
          <div class="recursos-editor-list" data-recursos-list></div>
        </section>

        <section class="recursos-editor-panel recursos-r2-panel">
          <div class="recursos-editor-panel-head">
            <h2>R2 / Cloudflare</h2>
            <button type="button" class="recursos-editor-btn" data-r2-up>Arriba</button>
          </div>
          <div class="recursos-r2-toolbar">
            <input data-r2-prefix value="room/" spellcheck="false" />
            <button type="button" class="recursos-editor-btn" data-r2-load>Listar</button>
          </div>
          <div class="recursos-r2-upload" data-r2-dropzone>
            <input type="file" data-r2-file-input multiple hidden />
            <button type="button" class="recursos-editor-btn" data-r2-upload-button>Subir archivo</button>
            <span data-r2-upload-status>Soltar archivos aca para subirlos a la carpeta actual.</span>
          </div>
          <div class="recursos-file-tree-browser" data-r2-browser>
            <div class="ft-tree" data-r2-tree></div>
            <div class="ft-explorer" data-r2-explorer></div>
          </div>
        </section>
      </div>

      <section class="recursos-editor-panel recursos-attach-panel">
        <div class="recursos-editor-panel-head">
          <h2>Vincular URL a RECURSOS</h2>
          <span data-recursos-status></span>
        </div>
        <form class="recursos-attach-form" data-recursos-attach-form>
          <label>
            URL
            <input name="url" data-attach-url required />
          </label>
          <label>
            Nombre
            <input name="name" data-attach-name />
          </label>
          <label>
            Carpeta
            <input name="folder" data-attach-folder placeholder="DOC, media, compartidos..." />
          </label>
          <label>
            Clase / capítulo
            <input name="claseId" data-attach-clase list="recursos-editor-class-options" placeholder="general del curso" />
          </label>
          <label>
            Sesión
            <select name="sessionId" data-attach-session></select>
          </label>
          <input type="hidden" name="roomName" data-attach-room value={`${courseId}-stage`} />
          <button type="button" class="recursos-editor-btn" data-session-new>Nueva sesión</button>
          <button type="submit" class="recursos-editor-btn recursos-editor-btn--primary">Vincular</button>
        </form>
      </section>
    </>
  )}
  <datalist id="recursos-editor-class-options" data-class-options-list>
    {classOptions.map((option) => (
      <option value={option.value} label={option.label}></option>
    ))}
  </datalist>
  <script type="application/json" data-recursos-class-options set:html={classOptionsJson}></script>
</section>

<style>
  .recursos-editor {
    display: grid;
    gap: 1rem;
    max-width: min(1180px, 100%);
    margin: 0 auto;
  }

  .recursos-editor-header,
  .recursos-editor-panel-head,
  .recursos-r2-toolbar,
  .recursos-attach-form {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .recursos-editor-header {
    justify-content: space-between;
    border-bottom: 1px solid var(--c-border);
    padding-bottom: 0.8rem;
  }

  .recursos-editor-header h1 {
    margin: 0;
    font-size: 1.7rem;
  }

  .recursos-editor-kicker {
    margin: 0 0 0.2rem;
    font-size: 0.78rem;
    color: var(--c-fg-dim);
    letter-spacing: 0.08em;
  }

  .recursos-editor-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    gap: 1rem;
  }

  .recursos-editor-panel {
    border: 1px solid var(--c-border);
    background: color-mix(in srgb, var(--c-bg) 94%, var(--c-link) 6%);
    border-radius: 8px;
    padding: 0.9rem;
    min-width: 0;
  }

  .recursos-editor-panel-head {
    justify-content: space-between;
    margin-bottom: 0.7rem;
  }

  .recursos-editor-panel h2 {
    margin: 0;
    font-size: 1rem;
  }

  .recursos-editor-list {
    display: grid;
    gap: 0.55rem;
    max-height: 62vh;
    overflow: auto;
  }

  .recursos-session-list {
    display: grid;
    gap: 0.42rem;
    margin-bottom: 0.7rem;
  }

  .recursos-file-tree-browser {
    display: grid;
    grid-template-columns: minmax(116px, 0.34fr) minmax(0, 0.66fr);
    max-height: 62vh;
    min-height: 19rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--c-border) 82%, transparent);
    border-radius: 7px;
    background: color-mix(in srgb, var(--c-bg) 97%, var(--c-fg) 3%);
  }

  .ft-tree,
  .ft-explorer {
    min-width: 0;
    padding: 0.45rem 0;
    overflow: auto;
  }

  .ft-tree {
    border-right: 1px solid color-mix(in srgb, var(--c-border) 72%, transparent);
    background: color-mix(in srgb, var(--c-bg) 96%, var(--c-link) 4%);
  }

  .ft-explorer {
    background: var(--c-bg);
  }

  .recursos-row {
    display: grid;
    gap: 0.45rem;
    border: 1px solid color-mix(in srgb, var(--c-border) 75%, transparent);
    border-radius: 6px;
    padding: 0.55rem;
    background: var(--c-bg);
  }

  .recursos-row-main,
  .recursos-row-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
  }

  .recursos-r2-node,
  .recursos-r2-row {
    display: grid;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--c-fg);
    text-align: left;
  }

  .recursos-r2-node {
    grid-template-columns: minmax(0, 1fr);
    padding: 0.3rem 0.45rem 0.3rem calc(0.55rem + (var(--depth, 0) * 1rem));
    cursor: pointer;
  }

  .recursos-r2-row {
    grid-template-columns: minmax(0, 1fr) auto auto auto auto;
    padding: 0.32rem 0.5rem;
  }

  .recursos-r2-node:hover,
  .recursos-r2-row:hover {
    background: color-mix(in srgb, var(--c-link) 9%, transparent);
  }

  .recursos-r2-node[data-active="true"] {
    background: color-mix(in srgb, var(--c-link) 14%, transparent);
    color: var(--c-link);
  }

  .recursos-r2-node--folder {
    font-weight: 650;
  }

  .recursos-r2-row--file {
    font-weight: 400;
  }

  .recursos-r2-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
  }

  .recursos-r2-icon {
    flex: 0 0 1rem;
    color: color-mix(in srgb, var(--c-link) 80%, var(--c-fg) 20%);
    text-align: center;
  }

  .recursos-r2-toolbar input,
  .recursos-attach-form input,
  .recursos-attach-form select {
    min-width: 0;
    border: 1px solid var(--c-border);
    border-radius: 6px;
    background: var(--c-bg);
    color: var(--c-fg);
    padding: 0.45rem 0.55rem;
  }

  .recursos-row-main input[data-field="name"] {
    flex: 1 1 18rem;
  }

  .recursos-row-main input[data-field="folder"] {
    flex: 0 1 9rem;
  }

  .recursos-meta,
  .recursos-r2-meta,
  .recursos-editor-empty {
    color: var(--c-fg-dim);
    font-size: 0.78rem;
  }

  .recursos-row-url,
  .recursos-r2-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .recursos-editor-btn {
    border: 1px solid var(--c-border);
    border-radius: 6px;
    background: var(--c-bg);
    color: var(--c-fg);
    padding: 0.42rem 0.62rem;
    cursor: pointer;
  }

  .recursos-editor-btn:hover {
    border-color: var(--c-link);
  }

  .recursos-editor-btn--primary {
    background: var(--c-link);
    color: white;
    border-color: var(--c-link);
  }

  .recursos-editor-btn--danger {
    color: #b3261e;
  }

  .recursos-r2-panel {
    background: var(--c-bg);
  }

  .recursos-r2-panel .recursos-editor-btn {
    padding: 0.28rem 0.48rem;
  }

  .recursos-r2-current {
    padding: 0.3rem 0.55rem 0.45rem;
    color: var(--c-fg-dim);
    font-size: 0.76rem;
    border-bottom: 1px solid color-mix(in srgb, var(--c-border) 62%, transparent);
    margin-bottom: 0.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .recursos-r2-toolbar input {
    flex: 1 1 auto;
  }

  .recursos-r2-upload {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px dashed color-mix(in srgb, var(--c-border) 82%, transparent);
    border-radius: 7px;
    padding: 0.55rem 0.65rem;
    margin-bottom: 0.65rem;
    color: var(--c-fg-dim);
    font-size: 0.78rem;
    background: color-mix(in srgb, var(--c-bg) 96%, var(--c-link) 4%);
  }

  .recursos-r2-upload[data-dragging="true"] {
    border-color: var(--c-link);
    background: color-mix(in srgb, var(--c-link) 10%, var(--c-bg) 90%);
    color: var(--c-fg);
  }

  .recursos-r2-upload span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .recursos-attach-form {
    align-items: end;
    flex-wrap: wrap;
  }

  .recursos-attach-form label {
    display: grid;
    gap: 0.25rem;
    flex: 1 1 12rem;
    min-width: 10rem;
    font-size: 0.78rem;
    color: var(--c-fg-dim);
  }

  .recursos-attach-form label:first-child {
    flex-basis: 24rem;
  }

  @media (max-width: 900px) {
    .recursos-editor-grid {
      grid-template-columns: 1fr;
    }

    .recursos-file-tree-browser {
      grid-template-columns: 1fr;
    }

    .ft-tree {
      border-right: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--c-border) 72%, transparent);
      max-height: 14rem;
      overflow: auto;
    }
  }
</style>

