---
// POD del recorrido académico: plantilla, visualización y motor de hidratación.
// La API aporta evidencia real; el componente no fabrica puntos ni rachas.
import { t } from '../../lib/i18n';
import { TENANTS, DEFAULT_TENANT_ID } from '../../lib/tenant/tenants';
import ItineraryEditor from './ItineraryEditor.astro';

const locale = (Astro.locals.tenant ?? TENANTS[DEFAULT_TENANT_ID]).locale;
// Strings the client script writes, in the tenant locale (read via data-cpp-strings).
const clientStrings = JSON.stringify({
  'req.proyecto': t(locale, 'progress.reqProject'),
  'req.conexiones': t(locale, 'progress.reqConnections'),
  'req.coloquios': t(locale, 'progress.reqColloquia'),
  'req.estigmergia': t(locale, 'progress.reqStigmergy'),
  'req.aporte': t(locale, 'progress.reqContribution'),
  density: t(locale, 'progress.density'),
  openCourse: t(locale, 'progress.openCourse'),
  signIn: t(locale, 'progress.signIn'),
  loadError: t(locale, 'progress.loadError'),
  empty: t(locale, 'progress.empty'),
  networkError: t(locale, 'progress.networkError'),
});
---

<section
  class="progress-sidebar-panel"
  id="progress-sidebar"
  data-cpp-strings={clientStrings}
  aria-label="Progreso del recorrido"
  aria-hidden="true"
>
  <div class="cpp-shell">
    <header class="cpp-header">
      <div class="cpp-heading">
        <span class="cpp-eyebrow">Recorrido académico</span>
        <h2 class="cpp-title" id="cpp-course">Progreso</h2>
        <p class="cpp-sub" id="cpp-active-unit">Tu mapa de aprendizaje</p>
      </div>
      <div class="cpp-header-actions">
        <span class="cpp-pct" id="cpp-pct" aria-label="Progreso completado">—</span>
        <button
          type="button"
          class="cpp-icon-btn"
          id="cpp-maximize"
          aria-pressed="false"
          aria-label="Progreso a pantalla completa"
          title="Progreso a pantalla completa"
        >⤢</button>
        <button
          type="button"
          class="cpp-close"
          data-progress-close
          aria-label="Cerrar progreso"
          title="Cerrar"
        >×</button>
      </div>
    </header>

    <section class="cpp-hot" id="cpp-hot" aria-labelledby="cpp-hot-title" aria-live="polite">
      <div class="cpp-block-head">
        <h3 class="cpp-section-label" id="cpp-hot-title">En esta nota</h3>
        <span class="cpp-block-note" id="cpp-hot-count"></span>
      </div>
      <p class="cpp-hot-note" id="cpp-hot-name"></p>
      <div class="cpp-hot-reading" id="cpp-hot-reading" hidden>
        <span>Lectura</span>
        <span class="bar"><i id="cpp-hot-reading-fill"></i></span>
        <strong id="cpp-hot-reading-pct">0%</strong>
      </div>
      <ul class="cpp-hot-list" id="cpp-hot-list"></ul>
      <p class="cpp-hot-empty" id="cpp-hot-empty" hidden>Esta nota no tiene evaluaciones.</p>
      <div class="cpp-block-head cpp-hot-rubric-head">
        <h4 class="cpp-section-label" id="cpp-rubric-title">Rúbrica-recorrido</h4>
        <span class="cpp-block-note">resaltado: lo que suma esta nota</span>
      </div>
      <div class="cpp-rubric" id="cpp-rubric"></div>
    </section>

    <ItineraryEditor />

    <section class="cpp-daily" id="cpp-daily" aria-labelledby="cpp-daily-title">
      <div class="cpp-daily-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="cpp-daily-copy">
        <span class="cpp-section-label">Hoy · repetición espaciada</span>
        <div class="cpp-daily-line">
          <strong class="cpp-daily-count" id="cpp-daily-count">—</strong>
          <div>
            <h3 id="cpp-daily-title">Preparando tu sesión</h3>
            <p id="cpp-daily-message">Buscando ideas que conviene volver a encontrar.</p>
          </div>
        </div>
      </div>
      <a class="cpp-daily-start" id="cpp-daily-start" href="#" hidden>
        Empezar sesión <span aria-hidden="true">↗</span>
      </a>
    </section>


    <!-- Recorrido: el itinerario que armó el docente, con la parada actual
         resaltada y el resto en muted. Sin itinerario no se inventa uno. -->
    <section class="cpp-block cpp-route" aria-labelledby="cpp-route-title">
      <div class="cpp-block-head">
        <h3 class="cpp-section-label" id="cpp-route-title">Recorrido</h3>
        <button
          type="button"
          class="cpp-icon-btn"
          id="cpp-route-fold"
          aria-pressed="false"
          title="Ver sólo la parada actual y sus vecinas"
          aria-label="Ver sólo la parada actual y sus vecinas"
          hidden
        >◎</button>
      </div>
      <p class="cpp-route-empty" id="cpp-route-empty" hidden>La cursada todavía no tiene itinerario.</p>
      <div class="cpp-path" id="cpp-path"></div>
    </section>

    <!-- Connectoma: el grafo de la materia desde la nota activa. Profundidad
         1 = sus vecinos, 5 = el mapa entero (relaciones hypo/hyper/connect). -->
    <section class="cpp-connect" aria-labelledby="cpp-connect-title">
      <div class="cpp-block-head">
        <h3 class="cpp-section-label" id="cpp-connect-title">Connectoma</h3>
        <div class="cpp-connect-tools">
          <label class="cpp-depth" title="Profundidad: 1 sus vecinos · 5 el mapa entero">
            <input type="range" id="cpp-depth" min="1" max="5" step="1" value="2" aria-label="Profundidad del Connectoma" />
            <output id="cpp-depth-out" for="cpp-depth">2</output>
          </label>
          <label class="cpp-depth" title="Separación entre vecinas">
            ↔
            <input type="range" id="cpp-spread" min="0" max="100" step="5" value="50" aria-label="Separación entre notas del Connectoma" />
          </label>
          <button type="button" class="cpp-icon-btn" id="cpp-zoom-out" aria-label="Alejar" title="Alejar">−</button>
          <button type="button" class="cpp-icon-btn" id="cpp-zoom-in" aria-label="Acercar" title="Acercar">+</button>
        </div>
      </div>
      <div class="cpp-graph" id="cpp-graph" aria-label="Red de notas conectadas"></div>
      <span class="cpp-density" id="cpp-dens"></span>
    </section>

    <div class="cpp-legend" aria-label="Leyenda del recorrido">
      <span><i class="cpp-key cpp-key-ring"></i>no leído</span>
      <span><i class="cpp-key cpp-key-half"></i>leído</span>
      <span><i class="cpp-key cpp-key-solid"></i>completado</span>
      <span><i class="cpp-key cpp-key-eval"></i>evaluado</span>
      <span><i class="cpp-key cpp-key-ray">ϟ</i>conexión</span>
      <span><i class="cpp-key cpp-key-play"></i>coloquio</span>
      <span><i class="cpp-key cpp-key-peer"></i>pares</span>
      <span><i class="cpp-key cpp-key-star">★</i>aporte</span>
    </div>

    <p class="cpp-note" id="cpp-note" aria-live="polite"></p>
  </div>
</section>

<style is:global>
  .progress-sidebar-panel {
    position: absolute;
    inset: 2.55rem 0 0;
    z-index: 18;
    display: block;
    padding: 0;
    background: var(--c-bg);
    border-radius: inherit;
    color: var(--c-fg);
    opacity: 0;
    pointer-events: none;
    transform: translateX(0.7rem);
    transition: opacity 180ms ease, transform 180ms ease;
    overflow-y: auto;
    overflow-x: hidden;
  }
  .course-container[data-progress-open='true'] .progress-sidebar-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }
  .cpp-shell {
    --cpp-accent: var(--accent, #c0562b);
    --cpp-gold: #b8892b;
    --cpp-line: color-mix(in srgb, var(--c-border) 78%, transparent);
    min-height: 100%;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--cpp-accent) 5%, transparent), transparent 34%),
      var(--c-bg);
  }
  html[data-theme='dark'] .cpp-shell { --cpp-gold: #d0a53f; }
  .cpp-header {
    position: sticky;
    top: 0;
    z-index: 4;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem var(--course-sidebar-pad-x) 0.9rem;
    border-bottom: 1px solid var(--cpp-line);
    background: color-mix(in srgb, var(--c-bg) 94%, transparent);
    backdrop-filter: blur(14px);
  }
  .cpp-heading { min-width: 0; }
  .cpp-eyebrow,
  .cpp-section-label {
    display: block;
    margin: 0;
    color: var(--c-fg-dim);
    font-size: 0.64rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .cpp-title {
    margin: 0.22rem 0 0;
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.02rem;
    font-weight: 620;
    line-height: 1.2;
  }
  .cpp-sub {
    margin: 0.22rem 0 0;
    color: var(--c-fg-dim);
    font-size: 0.72rem;
    line-height: 1.35;
  }
  .cpp-header-actions { display: flex; align-items: center; gap: 0.52rem; }
  .cpp-pct {
    color: var(--cpp-accent);
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }
  .cpp-close {
    width: 1.85rem;
    height: 1.85rem;
    border: 1px solid var(--cpp-line);
    border-radius: 999px;
    background: transparent;
    color: var(--c-fg-dim);
    cursor: pointer;
    font: inherit;
    line-height: 1;
  }
  .cpp-close:hover { border-color: var(--cpp-accent); color: var(--cpp-accent); }
  /* «En esta nota»: la nota activa, separada del mapa por un borde de acento. */
  .cpp-hot {
    margin: 0.95rem var(--course-sidebar-pad-x) 0.75rem;
    padding: 0.85rem 0.9rem 0.9rem;
    border: 1px solid var(--cpp-line);
    border-left: 3px solid var(--cpp-accent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--cpp-accent) 6%, var(--c-bg));
  }
  .cpp-hot-note {
    margin: 0.15rem 0 0.55rem;
    color: var(--c-fg);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .cpp-hot-note:empty { display: none; }
  .cpp-hot-reading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) 2.7rem;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.45rem;
    font-size: 0.72rem;
    color: var(--c-fg-dim);
  }
  .cpp-hot-reading[hidden] { display: none; }
  .cpp-hot-reading .bar { height: 3px; border-radius: 3px; background: var(--cpp-line); overflow: hidden; }
  .cpp-hot-reading .bar > i { display: block; width: 0; height: 100%; background: var(--cpp-accent); }
  .cpp-hot-reading strong { text-align: right; color: var(--c-fg); }
  .cpp-hot-list { display: grid; gap: 0.3rem; margin: 0; padding: 0; list-style: none; }
  .cpp-hot-item {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr) auto;
    gap: 0.45rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--c-fg);
  }
  .cpp-hot-item .mark { color: var(--c-fg-dim); }
  .cpp-hot-item.is-done .mark { color: var(--cpp-accent); }
  .cpp-hot-item.is-done .lab { color: var(--c-fg-dim); }
  .cpp-hot-item .lab { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cpp-hot-item .tag svg { display: block; width: 14px; height: 14px; }
  .cpp-hot-empty { margin: 0; font-size: 0.78rem; color: var(--c-fg-dim); }
  .cpp-hot-empty[hidden] { display: none; }
  .cpp-hot-rubric-head { margin-top: 0.85rem; }
  .cpp-req:not(.is-touched) { opacity: 0.55; }
  .cpp-req.is-touched .lab { color: var(--c-fg); font-weight: 600; }
  .cpp-daily {
    position: relative;
    display: grid;
    gap: 0.8rem;
    margin: 0.95rem var(--course-sidebar-pad-x) 0.75rem;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--cpp-accent) 32%, var(--cpp-line));
    border-radius: 12px;
    background:
      linear-gradient(115deg, color-mix(in srgb, var(--cpp-accent) 12%, var(--c-bg)), var(--c-bg) 68%);
  }
  .cpp-daily::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 1.2rem;
    height: 1.2rem;
    border-top: 2px solid var(--cpp-accent);
    border-right: 2px solid var(--cpp-accent);
    opacity: 0.8;
  }
  .cpp-daily-copy { position: relative; z-index: 1; }
  .cpp-daily-line {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.7rem;
  }
  .cpp-daily-count {
    min-width: 2.15rem;
    color: var(--cpp-accent);
    font-family: var(--font-serif, Georgia, serif);
    font-size: 2.25rem;
    font-weight: 500;
    line-height: 0.9;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .cpp-daily h3 { margin: 0; font-size: 0.86rem; font-weight: 650; }
  .cpp-daily p {
    max-width: 28ch;
    margin: 0.2rem 0 0;
    color: var(--c-fg-dim);
    font-size: 0.7rem;
    line-height: 1.45;
  }
  .cpp-daily-start {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.58rem 0.72rem;
    border: 1px solid color-mix(in srgb, var(--cpp-accent) 56%, var(--cpp-line));
    border-radius: 7px;
    color: var(--c-fg);
    font-size: 0.72rem;
    font-weight: 650;
    text-decoration: none;
  }
  .cpp-daily-start:hover { background: var(--cpp-accent); color: var(--c-bg); }
  .cpp-daily-start[hidden] { display: none; }
  .cpp-daily-orbit {
    position: absolute;
    right: -1.7rem;
    bottom: -2.2rem;
    width: 7rem;
    height: 7rem;
    opacity: 0.18;
  }
  .cpp-daily-orbit i {
    position: absolute;
    inset: 0;
    border: 1px solid var(--cpp-accent);
    border-radius: 50%;
  }
  .cpp-daily-orbit i:nth-child(2) { inset: 1.2rem; }
  .cpp-daily-orbit i:nth-child(3) { inset: 2.4rem; background: var(--cpp-accent); }
  .cpp-block,
  .cpp-connect {
    padding: 0.85rem var(--course-sidebar-pad-x);
    border-top: 1px solid var(--cpp-line);
  }
  .cpp-block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.7rem;
    margin-bottom: 0.65rem;
  }
  .cpp-block-note,
  .cpp-density {
    color: var(--c-fg-dim);
    font-size: 0.64rem;
    font-variant-numeric: tabular-nums;
  }
  .cpp-rubric { display: flex; flex-direction: column; gap: 0.18rem; }
  .cpp-req {
    display: grid;
    grid-template-columns: 1.2rem minmax(0, 1fr) 52px 2.7rem;
    align-items: center;
    gap: 0.48rem;
    min-height: 1.7rem;
    font-size: 0.71rem;
  }
  .cpp-req .ic { display: grid; width: 1.2rem; place-items: center; color: var(--cpp-accent); }
  .cpp-req .ic svg { display: block; width: 16px; height: 16px; }
  .cpp-req .lab { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cpp-req .bar {
    height: 3px;
    overflow: hidden;
    border-radius: 3px;
    background: var(--cpp-line);
  }
  .cpp-req .bar > i { display: block; width: 0; height: 100%; background: var(--cpp-accent); }
  .cpp-req .cnt {
    color: var(--c-fg-dim);
    text-align: right;
    font-size: 0.67rem;
    font-variant-numeric: tabular-nums;
  }
  .cpp-req.done .cnt { color: var(--cpp-accent); }
  .cpp-unit { margin-top: 0.7rem; }
  .cpp-unit:first-child { margin-top: 0; }
  .cpp-unit-label {
    margin: 0 0 0.15rem;
    padding-left: 0.1rem;
    color: var(--c-fg-dim);
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  /* Tope de ancho: con la sidebar maximizada el viewBox escalaría las etiquetas. */
  .cpp-path svg { display: block; width: 100%; max-width: 22rem; overflow: visible; }
  .cpp-path-link { color: inherit; outline: none; }
  .cpp-path-link:focus-visible .cpp-ring,
  .cpp-path-link:hover .cpp-ring { stroke: var(--cpp-accent); opacity: 1; }
  .cpp-path-link:focus-visible .cpp-lab,
  .cpp-path-link:hover .cpp-lab { fill: var(--cpp-accent); opacity: 1; }
  .cpp-connect { padding-bottom: 0.5rem; }
  .cpp-graph { position: relative; width: 100%; height: 220px; overflow: hidden; border-radius: 6px; cursor: grab; }
  .cpp-connect-tools { display: flex; align-items: center; gap: 0.25rem; }
  .cpp-depth { display: inline-flex; align-items: center; gap: 0.25rem; color: var(--c-fg-dim); font-size: 0.66rem; }
  .cpp-connect-tools { flex-wrap: wrap; justify-content: flex-end; }
  .cpp-depth input { width: 4.2rem; accent-color: var(--cpp-accent); }
  .cpp-depth output { min-width: 0.6rem; font-variant-numeric: tabular-nums; }
  .cpp-icon-btn {
    min-width: 1.45rem;
    height: 1.45rem;
    padding: 0 0.3rem;
    border: 1px solid var(--cpp-line);
    border-radius: 999px;
    background: transparent;
    color: var(--c-fg-dim);
    cursor: pointer;
    font: inherit;
    font-size: 0.78rem;
    line-height: 1;
  }
  .cpp-icon-btn[hidden] { display: none; }
  .cpp-icon-btn:hover,
  .cpp-icon-btn[aria-pressed='true'] { border-color: var(--cpp-accent); color: var(--cpp-accent); }
  /* Progreso a pantalla completa (la sidebar derecha maximizada): el Connectoma crece. */
  .course-container[data-right-maximized='true'] .cpp-graph { height: 62vh; }
  /* Recorrido: la parada actual con acento, el resto en muted. */
  .cpp-route-empty { margin: 0; color: var(--c-fg-dim); font-size: 0.76rem; }
  .cpp-stop { transition: opacity 160ms ease; }
  .cpp-stop[data-state='upcoming'],
  .cpp-stop[data-state='done'] { opacity: 0.45; }
  .cpp-stop:hover { opacity: 0.9; }
  .cpp-disc { fill: var(--c-bg); stroke: var(--cpp-line); stroke-width: 4; }
  .cpp-disc.is-done { fill: color-mix(in srgb, var(--cpp-accent) 14%, var(--c-bg)); }
  .cpp-arc { fill: none; stroke: var(--cpp-accent); stroke-width: 4; stroke-linecap: round; }
  .cpp-kind { fill: currentColor; font-size: 15px; opacity: 0.8; }
  .cpp-stop[data-state='current'] .cpp-kind,
  .cpp-stop[data-state='current'] .cpp-stop-lab { fill: var(--cpp-accent); opacity: 1; }
  .cpp-stop-lab { font-weight: 600; }
  .cpp-ring.cpp-dot { fill: var(--c-bg); }
  .cpp-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.48rem 0.8rem;
    padding: 0.65rem var(--course-sidebar-pad-x) 0.85rem;
    border-bottom: 1px solid var(--cpp-line);
    color: var(--c-fg-dim);
    font-size: 0.61rem;
  }
  .cpp-legend span { display: inline-flex; align-items: center; gap: 0.3rem; }
  .cpp-key { position: relative; display: inline-block; width: 0.72rem; height: 0.72rem; flex: none; }
  .cpp-key-ring { border: 1.3px solid currentColor; border-radius: 50%; }
  .cpp-key-half { border: 1.3px solid currentColor; border-radius: 50%; background: linear-gradient(90deg, currentColor 50%, transparent 50%); }
  .cpp-key-solid { border-radius: 50%; background: currentColor; }
  .cpp-key-eval { width: 0.58rem; height: 0.58rem; background: var(--cpp-accent); transform: rotate(45deg); }
  .cpp-key-ray { width: auto; height: auto; color: var(--cpp-accent); font-style: normal; font-size: 0.85rem; }
  .cpp-key-play { clip-path: polygon(10% 0, 100% 50%, 10% 100%); background: var(--cpp-accent); }
  .cpp-key-peer { width: 0.8rem; height: 0.45rem; border: 1px solid var(--cpp-gold); border-bottom: 0; border-radius: 50% 50% 0 0; }
  .cpp-key-star { width: auto; height: auto; color: var(--cpp-gold); font-style: normal; }
  .cpp-note {
    margin: 0;
    padding: 0.65rem var(--course-sidebar-pad-x) 1rem;
    color: var(--c-fg-dim);
    font-size: 0.68rem;
    line-height: 1.45;
  }
  .cpp-note:empty { display: none; }
  .cpp-ray { fill: none; stroke: var(--cpp-accent); stroke-width: 1.4; stroke-linejoin: round; }
  .cpp-badge { fill: var(--cpp-accent); }
  .cpp-badge-peer { fill: none; stroke: var(--cpp-gold); stroke-width: 1.25; }
  .cpp-halo { fill: none; stroke: var(--cpp-accent); }
  .cpp-ring { fill: none; stroke: currentColor; stroke-width: 1.4; opacity: 0.48; }
  .cpp-half { fill: currentColor; opacity: 0.48; }
  .cpp-solid { fill: currentColor; opacity: 0.86; }
  .cpp-eval { fill: var(--cpp-accent); }
  .cpp-conn { fill: none; stroke: var(--cpp-line); stroke-width: 2; }
  .cpp-conn.done { stroke: currentColor; opacity: 0.48; }
  .cpp-lab { fill: currentColor; font-size: 11px; opacity: 0.78; }
  .cpp-next { animation: cpp-pulse 1.8s ease-in-out infinite; }
  @keyframes cpp-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.34; } }
  @media (prefers-reduced-motion: reduce) {
    .cpp-next { animation: none; stroke: var(--cpp-accent); }
  }
</style>

<script>
  import { pendingFromPod, publishPending } from '../../lib/course/progress-pending.mjs';
  import { summarizeActiveNote } from '../../lib/course/active-note-progress.mjs';
  import { ITINERARY_KINDS } from '../../lib/itinerary/itinerary.mjs';
  import { resolveRoute, visibleStopIndexes } from '../../lib/itinerary/route-position.mjs';
  import { createConnectome, type Connectome } from '../../scripts/course/progress-connectome';

  const SVGNS = 'http://www.w3.org/2000/svg';
  // El Recorrido en círculos (como el camino de Duolingo): cada parada del
  // itinerario es un círculo con su progreso en el aro y sus notas alrededor;
  // el capítulo del árbol de autor corta secciones.
  const VIEW_W = 328;
  const CX = VIEW_W / 2;
  const ZIGZAG = [0, 52, 0, -52];
  const CR = 24;
  const ORBIT = 37;
  const ROW_H = 124;
  const TOP = 48;

  const REQ_LABEL: Record<string, string> = {
    proyecto: 'proyecto (obra)',
    conexiones: 'conexiones autoradas',
    coloquios: 'coloquios',
    estigmergia: 'estigmergia entre pares',
    aporte: 'aporte público',
  };
  const REQ_ICON: Record<string, string> = {
    proyecto: '<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3" class="cpp-eval"/><circle cx="8" cy="8" r="6" class="cpp-halo"/></svg>',
    conexiones: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M9 2 5 7h3l-2 5 6-7H9Z" class="cpp-ray"/></svg>',
    coloquios: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 3 8 5-8 5Z" class="cpp-badge"/></svg>',
    estigmergia: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 11a4 4 0 0 1 8 0M6 7a4 4 0 0 1 8 0" class="cpp-badge-peer"/></svg>',
    aporte: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m8 2 1.4 3.6H13l-2.9 2.3 1.1 3.7L8 9.4l-3.2 2.2 1.1-3.7L3 5.6h3.6Z" class="cpp-badge"/></svg>',
  };

  let connectome: Connectome | null = null;
  let itinerary: { stops: any[] } | null = null;
  const ROUTE_FOLD_KEY = 'musiki:progress-route-folded';
  let lastCourse = '';
  let lastData: any = null;
  let activeSlug = '';

  const el = (id: string) => document.getElementById(id);
  // Localized strings from the server (data-cpp-strings); the Spanish literal is the fallback.
  const str = (key: string, fallback: string, vars: Record<string, string | number> = {}) => {
    let table: Record<string, string> = {};
    try { table = JSON.parse(el('progress-sidebar')?.dataset.cppStrings || '{}'); } catch { /* fallback */ }
    return (table[key] || fallback).replace(/\{(\w+)\}/g, (match, name) => (name in vars ? String(vars[name]) : match));
  };
  const container = () => document.querySelector('.course-container');
  const courseId = () => {
    const fromAttr = (container()?.getAttribute('data-live-course-id') || '').trim();
    if (fromAttr) return fromAttr;
    const parts = window.location.pathname.split('/').filter(Boolean);
    return parts[0] === 'cursos' ? (parts[1] || '') : (parts[0] || '');
  };
  const isOpen = () => container()?.getAttribute('data-progress-open') === 'true';
  const stateOf = (c: any) => c?.evaluated ? 3 : (c?.completed ? 2 : (c?.read ? 1 : 0));

  function svgEl(name: string, attrs: Record<string, string>) {
    const node = document.createElementNS(SVGNS, name);
    Object.entries(attrs).forEach(([key, value]) => node.setAttribute(key, value));
    return node;
  }

  function renderDaily(daily: any) {
    const count = Number(daily?.total) || 0;
    const countEl = el('cpp-daily-count');
    const titleEl = el('cpp-daily-title');
    const messageEl = el('cpp-daily-message');
    const startEl = el('cpp-daily-start') as HTMLAnchorElement | null;
    if (countEl) countEl.textContent = String(count);
    if (!titleEl || !messageEl || !startEl) return;
    if (count > 0) {
      titleEl.textContent = count === 1 ? 'Una idea pide volver' : `${count} ideas piden volver`;
      messageEl.textContent = 'Una sesión breve para fortalecer memoria y conexiones, sin sumar puntos vacíos.';
      startEl.href = String(daily?.items?.[0]?.href || '#');
      startEl.hidden = false;
    } else {
      titleEl.textContent = 'Sesión al día';
      messageEl.textContent = 'No hay repasos vencidos en este curso. El mapa sigue disponible para explorar.';
      startEl.hidden = true;
      startEl.removeAttribute('href');
    }
  }

  let lastRubric: { rubric: any; required: any; project: any } | null = null;
  let touchedRubricKeys: string[] = [];

  function renderRubric(rubric: any, required: any, project: any) {
    lastRubric = { rubric, required, project };
    const host = el('cpp-rubric');
    if (!host) return;
    host.replaceChildren();
    ['proyecto', 'conexiones', 'coloquios', 'estigmergia', 'aporte'].forEach((key) => {
      const have = key === 'proyecto'
        ? (project?.c4Level > 0 ? 1 : (Number(rubric?.proyecto) || 0))
        : (Number(rubric?.[key]) || 0);
      const need = Number(required?.[key]) || 1;
      const done = have >= need;
      const row = document.createElement('div');
      row.className = `cpp-req${done ? ' done' : ''}${touchedRubricKeys.includes(key) ? ' is-touched' : ''}`;
      const icon = document.createElement('span');
      icon.className = 'ic';
      icon.innerHTML = REQ_ICON[key];
      const label = document.createElement('span');
      label.className = 'lab';
      const c4 = key === 'proyecto' && project?.c4Level > 0
        ? ` · ${['—', 'mini-c', 'little-c', 'pro-c', 'big-c'][project.c4Level] || '4C'}`
        : '';
      label.textContent = `${str(`req.${key}`, REQ_LABEL[key])}${c4}`;
      const bar = document.createElement('span');
      bar.className = 'bar';
      const fill = document.createElement('i');
      fill.style.width = `${Math.min(100, Math.round(100 * have / need))}%`;
      bar.appendChild(fill);
      const count = document.createElement('span');
      count.className = 'cnt';
      count.textContent = `${have}/${need}${done ? ' ✓' : ''}`;
      row.append(icon, label, bar, count);
      host.appendChild(row);
    });
  }

  // El título de la nota bajo el nodo, en hasta dos líneas. Los nombres de
  // archivo sin title llegan con _ y -: se leen mejor como palabras.
  const LABEL_CHARS = 17;
  function labelLines(name: string): string[] {
    const spaced = name.includes(' ') ? name : name.replace(/-/g, ' ');
    const words = spaced.replace(/_+/g, ' ').trim().split(/\s+/);
    const lines: string[] = [];
    let line = '';
    for (const word of words) {
      if (!line) line = word;
      else if ((line + ' ' + word).length <= LABEL_CHARS) line += ' ' + word;
      else { lines.push(line); line = word; }
    }
    if (line) lines.push(line);
    if (lines.length > 2) lines.splice(1, lines.length - 1, `${lines.slice(1).join(' ').slice(0, LABEL_CHARS - 1)}…`);
    return lines.map((l) => (l.length > LABEL_CHARS ? `${l.slice(0, LABEL_CHARS - 1)}…` : l));
  }

  function appendProject(host: HTMLElement, project: any) {
    const level = Math.max(0, Math.min(4, Number(project?.c4Level) || 0));
    const section = document.createElement('section');
    section.className = 'cpp-unit';
    const heading = document.createElement('h4');
    heading.className = 'cpp-unit-label';
    heading.textContent = 'Obra · 4C';
    const svg = svgEl('svg', { viewBox: `0 0 ${VIEW_W} 70` });
    const cx = CX;
    const cy = 31;
    for (let ring = level; ring >= 1; ring--) {
      svg.appendChild(svgEl('circle', { cx: String(cx), cy: String(cy), r: String(6 + ring * 7), class: 'cpp-halo', style: `opacity:${0.14 + ring * 0.13}` }));
    }
    svg.appendChild(svgEl('circle', { cx: String(cx), cy: String(cy), r: '6', class: level ? 'cpp-eval' : 'cpp-ring' }));
    const text = svgEl('text', { x: String(cx), y: String(cy + 25), 'text-anchor': 'middle', class: 'cpp-lab' });
    text.textContent = `obra · ${['—', 'mini-c', 'little-c', 'pro-c', 'big-c'][level]}`;
    svg.appendChild(text);
    section.append(heading, svg);
    host.appendChild(section);
  }

  // ── Recorrido: las paradas del itinerario de la cohorte (paso C). Cada parada
  // es una unidad del camino; la actual va con acento y el resto en muted. Sin
  // itinerario no se listan todas las notas: eso es el Connectoma.
  const KIND_ICON = new Map<string, string>(ITINERARY_KINDS.map((kind: { id: string; icon: string }) => [kind.id, kind.icon]));

  async function loadItinerary(cid: string): Promise<{ stops: any[] } | null> {
    try {
      const response = await fetch(`/api/progress/itinerary?courseId=${encodeURIComponent(cid)}`, { headers: { Accept: 'application/json' } });
      const data = response.ok ? await response.json() : null;
      return Array.isArray(data?.itinerary?.stops) ? { stops: data.itinerary.stops } : null;
    } catch {
      return null;
    }
  }

  const routeFolded = () => {
    try { return localStorage.getItem(ROUTE_FOLD_KEY) === '1'; } catch { return false; }
  };

  function noteLink(concept: any, label: string): SVGElement {
    const link = svgEl('a', {
      href: String(concept.href || '#'),
      class: 'cpp-path-link',
      'aria-label': label,
      'data-course-id': courseId(),
      'data-lesson-page-slug': String(concept.pageSlug || concept.slug || ''),
    });
    const title = svgEl('title', {});
    title.textContent = label;
    link.appendChild(title);
    return link;
  }

  function appendNoteDot(parent: SVGElement, concept: any, x: number, y: number) {
    const state = stateOf(concept);
    const link = noteLink(concept, String(concept.name || concept.slug || 'Nota'));
    const r = 4.6;
    if (state >= 3) link.appendChild(svgEl('rect', { x: String(x - r), y: String(y - r), width: String(r * 2), height: String(r * 2), transform: `rotate(45 ${x} ${y})`, class: 'cpp-eval' }));
    else if (state === 2) link.appendChild(svgEl('circle', { cx: String(x), cy: String(y), r: String(r), class: 'cpp-solid' }));
    else {
      if (state === 1) link.appendChild(svgEl('path', { d: `M ${x} ${y - r} a ${r} ${r} 0 0 1 0 ${r * 2} Z`, class: 'cpp-half' }));
      link.appendChild(svgEl('circle', { cx: String(x), cy: String(y), r: String(r), class: 'cpp-ring cpp-dot' }));
    }
    parent.appendChild(link);
  }

  type RouteStop = { stop: any; items: any[]; state: string };

  function renderCircles(host: HTMLElement, chapterLabel: string, stops: RouteStop[]) {
    const section = document.createElement('section');
    section.className = 'cpp-unit';
    if (chapterLabel) {
      const heading = document.createElement('h4');
      heading.className = 'cpp-unit-label';
      heading.textContent = chapterLabel;
      section.appendChild(heading);
    }
    const height = TOP + (stops.length - 1) * ROW_H + ORBIT + 46;
    const svg = svgEl('svg', { viewBox: `0 0 ${VIEW_W} ${height}` });
    const centers = stops.map((_, i) => ({ x: CX + ZIGZAG[i % ZIGZAG.length], y: TOP + i * ROW_H }));
    centers.slice(0, -1).forEach((from, i) => {
      const to = centers[i + 1];
      const done = stops[i].items.length > 0 && stops[i].items.every((item) => stateOf(item) >= 2);
      svg.appendChild(svgEl('path', {
        d: `M ${from.x} ${from.y + ORBIT + 8} C ${from.x} ${from.y + ROW_H / 2}, ${to.x} ${to.y - ROW_H / 2}, ${to.x} ${to.y - ORBIT - 8}`,
        class: `cpp-conn${done ? ' done' : ''}`,
      }));
    });
    stops.forEach(({ stop, items, state }, i) => {
      const { x, y } = centers[i];
      const group = svgEl('g', { class: 'cpp-stop', 'data-state': state });
      const real = items.filter((item) => !item.placeholder);
      const doneCount = items.filter((item) => stateOf(item) >= 2).length;
      const pct = items.length ? Math.round((100 * doneCount) / items.length) : 0;
      const next = real.find((item) => stateOf(item) < 2) || real[0];
      const label = String(stop.title || '');
      const circle = next ? noteLink(next, label) : svgEl('g', {});
      if (state === 'current') circle.appendChild(svgEl('circle', { cx: String(x), cy: String(y), r: String(CR + 6), class: 'cpp-halo cpp-next' }));
      circle.appendChild(svgEl('circle', { cx: String(x), cy: String(y), r: String(CR), class: pct === 100 ? 'cpp-disc is-done' : 'cpp-disc' }));
      circle.appendChild(svgEl('circle', {
        cx: String(x), cy: String(y), r: String(CR), pathLength: '100',
        'stroke-dasharray': `${pct} 100`, transform: `rotate(-90 ${x} ${y})`, class: 'cpp-arc',
      }));
      const icon = svgEl('text', { x: String(x), y: String(y), 'text-anchor': 'middle', 'dominant-baseline': 'central', class: 'cpp-kind' });
      icon.textContent = KIND_ICON.get(stop.kind) || '◆';
      circle.appendChild(icon);
      const text = svgEl('text', { x: String(x), y: String(y + ORBIT + 20), 'text-anchor': 'middle', class: 'cpp-lab cpp-stop-lab' });
      labelLines(label).forEach((line, index) => {
        const span = svgEl('tspan', { x: String(x), dy: index ? '1.15em' : '0' });
        span.textContent = line;
        text.appendChild(span);
      });
      circle.appendChild(text);
      group.appendChild(circle);
      // Las notas de la parada alrededor del aro, empezando arriba.
      items.forEach((item, k) => {
        const angle = -Math.PI / 2 + (2 * Math.PI * k) / Math.max(items.length, 1);
        appendNoteDot(group, item, x + ORBIT * Math.cos(angle), y + ORBIT * Math.sin(angle));
      });
      svg.appendChild(group);
    });
    section.appendChild(svg);
    host.appendChild(section);
  }

  function renderPath(concepts: any[], project: any) {
    const host = el('cpp-path');
    if (!host) return;
    host.replaceChildren();
    const stops = itinerary?.stops || [];
    const empty = el('cpp-route-empty');
    if (empty) empty.hidden = stops.length > 0;
    const fold = el('cpp-route-fold');
    const folded = routeFolded();
    if (fold) {
      fold.hidden = stops.length < 4;
      fold.setAttribute('aria-pressed', String(folded));
    }
    if (stops.length) {
      const route = resolveRoute(stops, concepts, activeSlug || activeNote().slug);
      // Secciones: paradas seguidas del mismo capítulo (el de su primera nota conocida).
      const sections: { chapter: string; stops: RouteStop[] }[] = [];
      visibleStopIndexes(route.stops.length, route.currentIndex, folded).forEach((index) => {
        const entry = route.stops[index] as RouteStop;
        const known = entry.items.find((item) => !item.placeholder);
        const last = sections[sections.length - 1];
        const chapter = known ? String(known.unitLabel || '') : (last?.chapter ?? '');
        if (last && last.chapter === chapter) last.stops.push(entry);
        else sections.push({ chapter, stops: [entry] });
      });
      sections.forEach((section) => renderCircles(host, section.chapter, section.stops));
    }
    appendProject(host, project);
  }

  el('cpp-route-fold')?.addEventListener('click', () => {
    try { localStorage.setItem(ROUTE_FOLD_KEY, routeFolded() ? '0' : '1'); } catch { /* sin storage queda desplegado */ }
    if (lastData) renderPath(lastData.concepts || [], lastData.project || {});
  });

  // ── Connectoma: force-graph desde la nota activa (progress-connectome.ts).
  // Un click abre la nota igual que un link del recorrido: un .cpp-path-link
  // que atrapa el handler de Dockview de [...slug].astro, o navega si no hay.
  function openConcept(concept: any) {
    const link = document.createElement('a');
    link.className = 'cpp-path-link';
    link.href = String(concept.href || '#');
    link.dataset.courseId = courseId();
    link.dataset.lessonPageSlug = String(concept.pageSlug || concept.slug || '');
    link.hidden = true;
    el('progress-sidebar')?.appendChild(link);
    link.click();
    link.remove();
  }

  function renderConnectome(concepts: any[], edges: any[]) {
    const host = el('cpp-graph');
    if (!host) return;
    if (!connectome) {
      connectome = createConnectome(host, openConcept, (shown, total) => {
        const density = el('cpp-dens');
        if (density) density.textContent = shown < total ? `${shown} de ${total} notas` : `${total} notas`;
      });
      connectome.setDepth(Number((el('cpp-depth') as HTMLInputElement | null)?.value) || 2);
      connectome.setSpread(Number((el('cpp-spread') as HTMLInputElement | null)?.value ?? 50));
    }
    connectome.update(concepts, edges, activeSlug || activeNote().slug);
  }

  el('cpp-depth')?.addEventListener('input', (event) => {
    const value = (event.target as HTMLInputElement).value;
    const out = el('cpp-depth-out');
    if (out) out.textContent = value;
    connectome?.setDepth(Number(value));
  });
  el('cpp-spread')?.addEventListener('input', (event) => {
    connectome?.setSpread(Number((event.target as HTMLInputElement).value));
  });
  el('cpp-zoom-in')?.addEventListener('click', () => connectome?.zoomBy(1.4));
  el('cpp-zoom-out')?.addEventListener('click', () => connectome?.zoomBy(1 / 1.4));

  // Pantalla completa: Progreso entero, con el mismo maximizar de la sidebar
  // derecha que usa el Foro. El botón refleja el estado aunque se cambie desde allá.
  const isMaximized = () => (container() as HTMLElement | null)?.dataset.rightMaximized === 'true';
  const syncMaximize = () => el('cpp-maximize')?.setAttribute('aria-pressed', String(isMaximized()));
  el('cpp-maximize')?.addEventListener('click', () => {
    document.querySelector<HTMLElement>('[data-sidebar-maximize="right"]')?.click();
    syncMaximize();
    window.setTimeout(() => connectome?.resize(), 220);
  });
  const maximizeTarget = container();
  if (maximizeTarget) {
    new MutationObserver(() => { syncMaximize(); connectome?.resize(); })
      .observe(maximizeTarget, { attributes: true, attributeFilter: ['data-right-maximized'] });
  }
  syncMaximize();

  // ── «En esta nota»: las evaluaciones de la nota que se está leyendo. Con
  // Dockview es el panel activo (data-rendered-slug); si no, la página. El
  // estado de cada evaluación lo publica [...slug].astro en __musikiEvalProgress.
  // Nombre y evaluaciones salen de la misma raíz: si el panel de la nota activa
  // no está a la vista se muestra la página, con su nombre, no el de otra nota.
  function activeNote(): { root: HTMLElement | null; slug: string } {
    if (activeSlug) {
      const panel = document.querySelector<HTMLElement>(`[data-rendered-slug="${CSS.escape(activeSlug)}"]`);
      if (panel && panel.getClientRects().length > 0) return { root: panel, slug: activeSlug };
    }
    return {
      root: document.querySelector<HTMLElement>('[data-class-content]'),
      slug: document.querySelector<HTMLElement>('[data-course-layout-root]')?.dataset.livePageSlug || '',
    };
  }

  function noteNameOf(slug: string): string {
    const last = slug.split('/').filter(Boolean).pop() || '';
    return last.replace(/\.(md|mdx)$/i, '').replace(/[-_]+/g, ' ').trim();
  }

  function renderHotNote() {
    const list = el('cpp-hot-list');
    if (!list) return;
    const { root, slug: noteSlug } = activeNote();
    const byId = new Map(((window as any).__musikiEvalProgress || []).map((item: any) => [item.id, item]));
    const items = root
      ? Array.from(root.querySelectorAll<HTMLElement>('.eval-block-wrapper'))
          .map((wrapper) => byId.get(wrapper.dataset.evalId || '') || null)
          .filter(Boolean)
      : [];
    const summary = summarizeActiveNote(items as any[]);
    touchedRubricKeys = summary.rubricKeys;

    const name = el('cpp-hot-name');
    if (name) name.textContent = noteNameOf(noteSlug);
    const count = el('cpp-hot-count');
    if (count) count.textContent = summary.evals.length ? `${summary.done}/${summary.evals.length} hechas` : '';
    const empty = el('cpp-hot-empty');
    if (empty) empty.hidden = summary.evals.length > 0;

    const reading = el('cpp-hot-reading');
    if (reading) {
      reading.hidden = !summary.reading;
      if (summary.reading) {
        const pct = Math.round(100 * summary.reading.done / summary.reading.total);
        const fill = el('cpp-hot-reading-fill');
        const label = el('cpp-hot-reading-pct');
        if (fill) fill.style.width = `${pct}%`;
        if (label) label.textContent = `${pct}%`;
      }
    }

    list.replaceChildren(...summary.evals.filter((e) => e.type !== 'mcc').map((item) => {
      const li = document.createElement('li');
      li.className = `cpp-hot-item${item.complete ? ' is-done' : ''}`;
      const mark = document.createElement('span');
      mark.className = 'mark';
      mark.textContent = item.complete ? '✓' : '○';
      const label = document.createElement('span');
      label.className = 'lab';
      label.textContent = item.label;
      li.append(mark, label);
      if (item.rubricKey) {
        const tag = document.createElement('span');
        tag.className = 'tag';
        tag.innerHTML = REQ_ICON[item.rubricKey] || '';
        tag.title = `Suma a: ${str(`req.${item.rubricKey}`, REQ_LABEL[item.rubricKey])}`;
        li.appendChild(tag);
      }
      return li;
    }));

    if (lastRubric) renderRubric(lastRubric.rubric, lastRubric.required, lastRubric.project);
  }

  window.addEventListener('musiki:eval-progress', () => renderHotNote());
  document.addEventListener('astro:page-load', () => { activeSlug = ''; renderHotNote(); });

  function updateActiveUnit() {
    const subtitle = el('cpp-active-unit');
    if (!subtitle || !lastData) return;
    const normalized = activeSlug.split('/').filter(Boolean).pop()?.toLowerCase() || '';
    const concept = (lastData.concepts || []).find((item: any) =>
      String(item.slug || '').toLowerCase() === normalized
      || String(item.id || '').toLowerCase().endsWith(`/${normalized}`));
    subtitle.textContent = concept?.unitLabel
      ? `Unidad activa · ${concept.unitLabel}`
      : 'Tu mapa de aprendizaje';
  }

  async function load() {
    const cid = courseId();
    const note = el('cpp-note');
    if (!cid) {
      if (note) note.textContent = str('openCourse', 'Abrí un curso para ver el recorrido.');
      return;
    }
    lastCourse = cid;
    const courseTitle = document.querySelector('.course-title-link-text')?.textContent?.trim() || cid;
    const title = el('cpp-course');
    if (title) title.textContent = courseTitle;
    if (note) note.textContent = 'Cargando evidencias…';
    try {
      const response = await fetch(`/api/progress/pod?courseId=${encodeURIComponent(cid)}`, { headers: { Accept: 'application/json' } });
      if (!response.ok) {
        if (note) note.textContent = response.status === 401 ? str('signIn', 'Iniciá sesión para ver tu progreso.') : str('loadError', 'No se pudo cargar el progreso.');
        return;
      }
      const data = await response.json();
      lastData = data;
      const concepts = Array.isArray(data.concepts) ? data.concepts : [];
      const edges = Array.isArray(data.edges) ? data.edges : [];
      const completed = concepts.filter((concept: any) => stateOf(concept) >= 2).length;
      const percent = el('cpp-pct');
      if (percent) percent.textContent = concepts.length ? `${Math.round(100 * completed / concepts.length)}%` : '0%';
      renderDaily(data.daily || {});
      publishPending(cid, pendingFromPod(data));
      renderRubric(data.rubric || {}, data.required || {}, data.project || {});
      renderHotNote();
      itinerary = await loadItinerary(cid);
      renderPath(concepts, data.project || {});
      renderConnectome(concepts, edges);
      updateActiveUnit();
      if (note) note.textContent = concepts.length ? '' : str('empty', 'Todavía no hay conceptos disponibles para este curso.');
    } catch (error) {
      if (note) note.textContent = str('networkError', 'Error de red al cargar el progreso.');
    }
  }

  (window as any).__musikiProgressLoad = load;
  window.addEventListener('musiki:active-note', ((event: CustomEvent<{ slug?: string }>) => {
    activeSlug = String(event.detail?.slug || '');
    updateActiveUnit();
    if (lastData) {
      renderPath(lastData.concepts || [], lastData.project || {});
      renderConnectome(lastData.concepts || [], lastData.edges || []);
    }
    // El panel recién abierto hidrata sus evaluaciones después del evento.
    renderHotNote();
    window.setTimeout(renderHotNote, 300);
    if (isOpen() && courseId() !== lastCourse) void load();
  }) as EventListener);
  window.addEventListener('musiki:progress-changed', () => { if (isOpen()) void load(); });
  document.addEventListener('astro:before-swap', () => {
    connectome?.destroy();
    connectome = null;
  }, { once: true });
</script>
