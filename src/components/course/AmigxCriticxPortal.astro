---
import { ensureDbUserFromSession, getForumCourseAccess } from '../../lib/forum-server';
import { isElevatedGlobalRole } from '../../lib/roles';
import { getAmigxCriticxPortalState, type AmigxCriticxPortalState } from '../../lib/amigx-criticx/service';
import { countWords } from '../../lib/amigx-criticx/logic';

interface Props {
  courseId?: string;
  session?: { user?: { name?: string; email?: string; image?: string } } | null;
}

const { courseId = 's123', session = null } = Astro.props;

let initialState: AmigxCriticxPortalState | null = null;
let loadError = '';

if (session?.user?.email) {
  try {
    const dbUser = await ensureDbUserFromSession(session as any);
    if (dbUser) {
      const access = await getForumCourseAccess(dbUser, courseId);
      const isTeacher = Boolean(access.isTeacher || isElevatedGlobalRole(dbUser.role));
      if (access.isEnrolled || isTeacher) {
        initialState = await getAmigxCriticxPortalState(courseId, {
          id: dbUser.id,
          name: dbUser.name,
          email: dbUser.email,
          isTeacher,
        });
      } else {
        loadError = 'Debés estar inscriptx en Seminarios de Composición (s123) para acceder al portal de Amigx Críticx.';
      }
    } else {
      loadError = 'No se encontró tu usuario en la base de datos de Musiki.';
    }
  } catch (err: unknown) {
    console.error('[AmigxCriticxPortal] SSR load failed, will retry on client:', err);
  }
}

const initialStateJson = JSON.stringify(initialState).replace(/</g, '\\u003c');
const myOutbound = initialState?.myOutboundReview ?? null;
const myInbound = initialState?.myInboundReview ?? null;
const isSubmitted = myOutbound?.status === 'submitted';
const initialWords1 = countWords(myOutbound?.descripcion ?? '');
const initialWords2 = countWords(myOutbound?.funcionaNoFunciona ?? '');
const initialWords3 = countWords(myOutbound?.hariaDistinto ?? '');
const initialTotalWords = initialWords1 + initialWords2 + initialWords3;
const initialResponseWords = countWords(myInbound?.recipientResponse ?? '');
---

<section
  class="ac-portal"
  data-ac-portal
  data-course-id={courseId}
>
  <header class="ac-header">
    <div class="ac-header-top">
      <div>
        <p class="ac-kicker">SEMINARIOS DE COMPOSICIÓN I y II · RÚBRICA §25.4 / §27 / §31 DIM. 16</p>
        <h1 class="ac-title">Portal de Amigx Críticx</h1>
      </div>
      <div class="ac-urn-pills" data-ac-stats>
        <span class="ac-pill" title="Alumnxs activxs en el curso">
          <strong data-ac-stat-total>{initialState?.urnStats.totalStudents ?? '—'}</strong> activxs
        </span>
        <span class="ac-pill" title="Pares ya asignados en la urna">
          <strong data-ac-stat-assigned>{initialState?.urnStats.assignedCount ?? '—'}</strong> en urna
        </span>
        <span class="ac-pill ac-pill--accent" title="Informes entregados">
          <strong data-ac-stat-submitted>{initialState?.urnStats.submittedCount ?? '—'}</strong> entregados
        </span>
      </div>
    </div>

    <p class="ac-subtitle">
      Un amigx críticx (<em>critical friend</em>, Costa &amp; Kallick, 1993; MacBeath, 1999) sostiene dos cosas a la vez:
      <strong>apoyo incondicional a la persona y exigencia sin descuento sobre el material</strong>.
      Corrección uno a uno entre pares, con tono crítico realista.
    </p>

    <details class="ac-protocol-details">
      <summary class="ac-protocol-summary">
        <span>▸ Pautas reglamentarias de la Rúbrica (§27.2 – §27.4)</span>
      </summary>
      <div class="ac-protocol-body">
        <ul class="ac-protocol-list">
          <li><strong>Descripción antes que juicio (§27.3.2):</strong> Se verifica que entendiste el proyecto en sus propios términos, no en los tuyos. Un juicio emitido antes de haber descrito el proyecto se descarta.</li>
          <li><strong>Tono crítico realista y localizado (§27.3.3):</strong> Se nombran los aciertos con su procedimiento (no con adjetivos) y se dice qué no funciona localizándolo en un compás, una sección, una definición o una fuente.</li>
          <li><strong>En los términos del otro (§27.3.4):</strong> No propongas tu propia poética como solución. La pregunta es qué operación alternativa haría mejor al proyecto del par en sus propios términos y qué ganaría con ella, cerrando con una pregunta abierta.</li>
          <li><strong>Regla de urna y no reciprocidad:</strong> La elección es por orden de llegada (<em>first come, first take</em>). Cada alumnx elegido sale de la lista disponible y <strong>no se permiten amigos críticos cruzados (recíprocos)</strong>.</li>
        </ul>
      </div>
    </details>
  </header>

  {loadError ? (
    <div class="ac-alert ac-alert--error" role="alert">{loadError}</div>
  ) : (
    <>
      <div class="ac-alert" data-ac-feedback hidden role="status" aria-live="polite"></div>

      <!-- PASO 1: SELECTOR DE URNA -->
      <section class="ac-card ac-urn-card" aria-labelledby="ac-urn-heading">
        <div class="ac-card-head">
          <div>
            <span class="ac-step-badge">Paso 1 · Urna de pares</span>
            <h2 id="ac-urn-heading">Elegir compañerx a evaluar</h2>
          </div>
          <span class="ac-rule-tag" title="First come, first take · Prohibido cruce recíproco">
            Urna sin reemplazo · No recíproco
          </span>
        </div>

        <div class="ac-urn-controls">
          <label class="ac-urn-label" for="ac-recipient-select">
            <span class="ac-urn-prefix">Seré el amigx críticx de</span>
            <select
              id="ac-recipient-select"
              class="ac-select"
              data-ac-recipient-select
              disabled={Boolean(isSubmitted)}
            >
              <option value="">— Seleccionar alumnx activx de la urna —</option>
              {myOutbound && (
                <option value={myOutbound.recipientUserId} selected>
                  {myOutbound.recipientName} (tu elección actual)
                </option>
              )}
              {(initialState?.urnCandidates ?? [])
                .filter((student) => student.id !== myOutbound?.recipientUserId)
                .map((student) => (
                  <option value={student.id}>
                    {student.name}
                  </option>
                ))}
            </select>
          </label>

          <div class="ac-urn-actions">
            <button
              type="button"
              class="ac-btn ac-btn--secondary"
              data-ac-release-btn
              hidden={!myOutbound || isSubmitted}
              title="Liberar elección y devolver a la urna (solo antes de entregar)"
            >
              Liberar turno
            </button>
          </div>
        </div>

        <p class="ac-urn-hint" data-ac-urn-hint>
          {myOutbound
            ? `Asignación registrada en la urna: sos el amigx críticx de ${myOutbound.recipientName}.`
            : 'Al elegir un nombre del menú desplegable, se reserva automáticamente en la urna y deja de aparecer para el resto.'}
        </p>
      </section>

      <!-- PASO 2: FORMULARIO DE DEVOLUCIÓN (3 CAMPOS + CONTADOR DE PALABRAS + TOGGLE PÚBLICO) -->
      <form class="ac-card ac-form-card" data-ac-review-form novalidate>
        <div class="ac-card-head">
          <div>
            <span class="ac-step-badge">Paso 2 · Ficha de devolución (§25.4 / §27.4)</span>
            <h2>Informe de Amigx Críticx</h2>
          </div>
          <div class="ac-total-words" data-ac-total-words>
            Total: <strong>{initialTotalWords}</strong> {initialTotalWords === 1 ? 'palabra' : 'palabras'}
          </div>
        </div>

        <!-- Campo 1 -->
        <div class="ac-field">
          <div class="ac-field-header">
            <label for="ac-field-descripcion" class="ac-field-label">
              1. Descripción (antes de juzgar)
            </label>
            <span class="ac-word-counter" data-ac-word-count="descripcion">
              {initialWords1} {initialWords1 === 1 ? 'palabra' : 'palabras'}
            </span>
          </div>
          <p class="ac-field-help">
            ¿Qué escuché y qué leí, antes de opinar? Describí el proyecto en tres oraciones en tus propias palabras, verificando que se comprendió en sus propios términos (§27.2 mov. 1).
          </p>
          <textarea
            id="ac-field-descripcion"
            name="descripcion"
            class="ac-textarea"
            data-ac-textarea="descripcion"
            rows="4"
            placeholder="Describí el objeto, el material escuchado y el planteo del proyecto antes de emitir cualquier juicio..."
            required
          >{myOutbound?.descripcion ?? ''}</textarea>
        </div>

        <!-- Campo 2 -->
        <div class="ac-field">
          <div class="ac-field-header">
            <label for="ac-field-funciona" class="ac-field-label">
              2. Qué funciona y qué no funciona (localizado)
            </label>
            <span class="ac-word-counter" data-ac-word-count="funcionaNoFunciona">
              {initialWords2} {initialWords2 === 1 ? 'palabra' : 'palabras'}
            </span>
          </div>
          <p class="ac-field-help">
            Qué está resuelto y por qué procedimiento concreto (sin adjetivos) + dónde exactamente el proyecto no hace lo que dice hacer, localizado en compás, sección, definición o fuente (§27.2 mov. 2 y 3).
          </p>
          <textarea
            id="ac-field-funciona"
            name="funcionaNoFunciona"
            class="ac-textarea"
            data-ac-textarea="funcionaNoFunciona"
            rows="5"
            placeholder="Aciertos con su procedimiento concreto y problemas localizados (compás, sección, cláusula, fuente)..."
            required
          >{myOutbound?.funcionaNoFunciona ?? ''}</textarea>
        </div>

        <!-- Campo 3 -->
        <div class="ac-field">
          <div class="ac-field-header">
            <label for="ac-field-distinto" class="ac-field-label">
              3. Qué haría distinto y pregunta abierta
            </label>
            <span class="ac-word-counter" data-ac-word-count="hariaDistinto">
              {initialWords3} {initialWords3 === 1 ? 'palabra' : 'palabras'}
            </span>
          </div>
          <p class="ac-field-help">
            Qué operación o decisión alternativa proponés en los términos del proyecto y qué ganaría con ella + una sola pregunta abierta que el proyecto todavía no puede responder (§27.2 mov. 4).
          </p>
          <textarea
            id="ac-field-distinto"
            name="hariaDistinto"
            class="ac-textarea"
            data-ac-textarea="hariaDistinto"
            rows="4"
            placeholder="Operación alternativa, ganancia para el proyecto y pregunta abierta de cierre..."
            required
          >{myOutbound?.hariaDistinto ?? ''}</textarea>
        </div>

        <!-- Pie de formulario: Visibilidad + Botones ENTREGAR / ENTREGADO / RE-ENVIAR ENTREGA -->
        <div class="ac-form-footer">
          <div class="ac-visibility-box">
            <label class="ac-switch-label" for="ac-public-switch">
              <input
                id="ac-public-switch"
                type="checkbox"
                name="isPublic"
                class="ac-switch-input"
                data-ac-public-switch
                checked={Boolean(myOutbound?.isPublic)}
                {...({ switch: '' } as Record<string, string>)}
              />
              <span class="ac-switch-title">HACER PÚBLICO</span>
            </label>
            <p class="ac-visibility-note">
              Visibilidad garantizada a <strong>docentes</strong>, <strong>alumnx autor/a</strong> y <strong>alumnx destinatarix</strong>. Si activás <em>HACER PÚBLICO</em>, el resto de lxs alumnxs del seminario también puede ver la devolución.
            </p>
          </div>

          <div class="ac-submit-actions">
            <button
              type="submit"
              class:list={['ac-btn', isSubmitted ? 'ac-btn--submitted' : 'ac-btn--primary']}
              data-ac-submit-btn
              disabled={Boolean(isSubmitted)}
            >
              {isSubmitted ? '✓ ENTREGADO' : 'ENTREGAR'}
            </button>

            <button
              type="button"
              class="ac-btn ac-btn--resubmit"
              data-ac-resubmit-btn
              hidden={!isSubmitted}
            >
              RE-ENVIAR ENTREGA
            </button>
          </div>
        </div>
      </form>

      <!-- PASO 3: DEVOLUCIÓN RECIBIDA DE MI AMIGX CRÍTICX + RESPUESTA ESCRITA (§27.3.6) -->
      <section
        class="ac-card ac-inbound-card"
        data-ac-inbound-section
        hidden={!myInbound || myInbound.status !== 'submitted'}
        aria-labelledby="ac-inbound-heading"
      >
        <div class="ac-card-head">
          <div>
            <span class="ac-step-badge">Devolución recibida · §27.3.6</span>
            <h2 id="ac-inbound-heading" data-ac-inbound-title>
              {myInbound ? `Informe de tu amigx críticx: ${myInbound.authorName}` : 'Informe recibido de tu amigx críticx'}
            </h2>
          </div>
          <span class="ac-pill" data-ac-inbound-visibility>
            {myInbound?.isPublic ? 'Público para el curso' : 'Privado (par + docentes)'}
          </span>
        </div>

        <div class="ac-inbound-fields" data-ac-inbound-fields>
          <div class="ac-read-block">
            <h3>1. Descripción</h3>
            <p data-ac-inbound-desc>{myInbound?.descripcion ?? ''}</p>
          </div>
          <div class="ac-read-block">
            <h3>2. Qué funciona y qué no funciona</h3>
            <p data-ac-inbound-func>{myInbound?.funcionaNoFunciona ?? ''}</p>
          </div>
          <div class="ac-read-block">
            <h3>3. Qué haría distinto y pregunta abierta</h3>
            <p data-ac-inbound-dist>{myInbound?.hariaDistinto ?? ''}</p>
          </div>
        </div>

        <form class="ac-response-form" data-ac-response-form novalidate>
          <input type="hidden" name="reviewId" data-ac-inbound-id value={myInbound?.id ?? ''} />
          <div class="ac-field">
            <div class="ac-field-header">
              <label for="ac-recipient-response" class="ac-field-label">
                Respuesta escrita del par evaluado (§27.3.6 / §27.4)
              </label>
              <span class="ac-word-counter" data-ac-word-count="recipientResponse">
                {initialResponseWords} {initialResponseWords === 1 ? 'palabra' : 'palabras'}
              </span>
            </div>
            <p class="ac-field-help">
              Máximo orientativo una carilla, dentro de la semana: qué incorporás, qué rechazás y con qué argumento. Rechazar con argumento vale lo mismo que incorporar.
            </p>
            <textarea
              id="ac-recipient-response"
              name="recipientResponse"
              class="ac-textarea"
              data-ac-textarea="recipientResponse"
              rows="4"
              placeholder="Escribí tu respuesta argumentada a la devolución recibida..."
            >{myInbound?.recipientResponse ?? ''}</textarea>
          </div>
          <div class="ac-submit-actions">
            <button
              type="submit"
              class:list={['ac-btn', myInbound?.recipientRespondedAt ? 'ac-btn--submitted' : 'ac-btn--primary']}
              data-ac-response-submit-btn
              disabled={Boolean(myInbound?.recipientRespondedAt)}
            >
              {myInbound?.recipientRespondedAt ? '✓ RESPUESTA ENTREGADA' : 'ENTREGAR RESPUESTA'}
            </button>
            <button
              type="button"
              class="ac-btn ac-btn--resubmit"
              data-ac-response-resubmit-btn
              hidden={!myInbound?.recipientRespondedAt}
            >
              RE-ENVIAR RESPUESTA
            </button>
          </div>
        </form>
      </section>

      <!-- PASO 4: ARCHIVO DE DEVOLUCIONES VISIBLES (DOCENTES / PROPIAS / PÚBLICAS) -->
      <section class="ac-card ac-feed-card" aria-labelledby="ac-feed-heading">
        <div class="ac-card-head">
          <div>
            <span class="ac-step-badge">Registro del seminario</span>
            <h2 id="ac-feed-heading">
              {initialState?.currentUser.isTeacher
                ? 'Todas las devoluciones y estado de la urna (Vista Docente)'
                : 'Devoluciones visibles (tuyas y públicas del curso)'}
            </h2>
          </div>
        </div>

        <div class="ac-feed-list" data-ac-feed-list>
          {(initialState?.visibleReviews ?? []).length === 0 ? (
            <p class="ac-empty-msg">Todavía no hay devoluciones visibles registradas.</p>
          ) : (
            (initialState?.visibleReviews ?? []).map((rev) => {
              const w1 = countWords(rev.descripcion);
              const w2 = countWords(rev.funcionaNoFunciona);
              const w3 = countWords(rev.hariaDistinto);
              const totalW = w1 + w2 + w3;
              return (
                <article class="ac-review-item" data-review-id={rev.id}>
                  <header class="ac-review-item-head">
                    <div class="ac-review-pair">
                      <strong>{rev.authorName}</strong>
                      <span class="ac-pair-arrow" aria-hidden="true">→</span>
                      <span>amigx críticx de</span>
                      <strong>{rev.recipientName}</strong>
                    </div>
                    <div class="ac-review-badges">
                      <span class:list={['ac-badge', rev.status === 'submitted' ? 'ac-badge--ok' : 'ac-badge--pending']}>
                        {rev.status === 'submitted' ? 'Entregado' : 'En urna (pendiente)'}
                      </span>
                      <span class:list={['ac-badge', rev.isPublic ? 'ac-badge--public' : 'ac-badge--private']}>
                        {rev.isPublic ? 'Público' : 'Privado'}
                      </span>
                      <span class="ac-badge">{totalW} pal.</span>
                      {initialState?.currentUser.isTeacher && (
                        <button
                          type="button"
                          class="ac-teacher-reset-btn"
                          data-ac-teacher-release={rev.authorUserId}
                          title="Liberar esta asignación de la urna (Docente)"
                        >
                          Liberar urna
                        </button>
                      )}
                    </div>
                  </header>

                  {rev.status === 'submitted' && (
                    <div class="ac-review-item-body">
                      <div class="ac-read-block">
                        <h4>1. Descripción ({w1} pal.)</h4>
                        <p>{rev.descripcion}</p>
                      </div>
                      <div class="ac-read-block">
                        <h4>2. Qué funciona y qué no funciona ({w2} pal.)</h4>
                        <p>{rev.funcionaNoFunciona}</p>
                      </div>
                      <div class="ac-read-block">
                        <h4>3. Qué haría distinto y pregunta abierta ({w3} pal.)</h4>
                        <p>{rev.hariaDistinto}</p>
                      </div>
                      {rev.recipientResponse && (
                        <div class="ac-read-block ac-read-block--response">
                          <h4>Respuesta de {rev.recipientName} ({countWords(rev.recipientResponse)} pal.)</h4>
                          <p>{rev.recipientResponse}</p>
                        </div>
                      )}
                    </div>
                  )}
                </article>
              );
            })
          )}
        </div>
      </section>
    </>
  )}

  <script type="application/json" data-ac-initial-state set:html={initialStateJson}></script>
</section>

<script>
  // Progressive enhancement for <input type="checkbox" switch>
  const enhanceSwitchInputs = () => {
    const hasNativeSwitch = typeof HTMLInputElement !== 'undefined' && 'switch' in HTMLInputElement.prototype;
    document.querySelectorAll<HTMLInputElement>('input[type="checkbox"][switch]').forEach((input) => {
      if (!hasNativeSwitch) {
        input.setAttribute('role', 'switch');
        input.dataset.fallbackSwitch = 'true';
      }
    });
  };

  const countWordsClient = (text: string): number => {
    const trimmed = String(text || '').trim();
    if (!trimmed) return 0;
    return trimmed.split(/\s+/).filter(Boolean).length;
  };

  const formatWordLabel = (count: number): string =>
    `${count} ${count === 1 ? 'palabra' : 'palabras'}`;

  const esc = (value: unknown): string =>
    String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');

  function initAmigxCriticxPortal() {
    enhanceSwitchInputs();

    const root = document.querySelector<HTMLElement>('[data-ac-portal]');
    if (!root || root.dataset.acBound === 'true') return;
    root.dataset.acBound = 'true';

    const stateScript = root.querySelector<HTMLScriptElement>('[data-ac-initial-state]');
    let currentState: any = null;
    try {
      currentState = stateScript?.textContent ? JSON.parse(stateScript.textContent) : null;
    } catch {
      currentState = null;
    }

    const feedbackEl = root.querySelector<HTMLElement>('[data-ac-feedback]');
    const selectEl = root.querySelector<HTMLSelectElement>('[data-ac-recipient-select]');
    const releaseBtn = root.querySelector<HTMLButtonElement>('[data-ac-release-btn]');
    const urnHintEl = root.querySelector<HTMLElement>('[data-ac-urn-hint]');
    const reviewForm = root.querySelector<HTMLFormElement>('[data-ac-review-form]');
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-ac-submit-btn]');
    const resubmitBtn = root.querySelector<HTMLButtonElement>('[data-ac-resubmit-btn]');
    const publicSwitch = root.querySelector<HTMLInputElement>('[data-ac-public-switch]');
    const totalWordsEl = root.querySelector<HTMLElement>('[data-ac-total-words]');
    const feedListEl = root.querySelector<HTMLElement>('[data-ac-feed-list]');

    const descInput = root.querySelector<HTMLTextAreaElement>('[data-ac-textarea="descripcion"]');
    const funcInput = root.querySelector<HTMLTextAreaElement>('[data-ac-textarea="funcionaNoFunciona"]');
    const distInput = root.querySelector<HTMLTextAreaElement>('[data-ac-textarea="hariaDistinto"]');

    const inboundSection = root.querySelector<HTMLElement>('[data-ac-inbound-section]');
    const inboundTitle = root.querySelector<HTMLElement>('[data-ac-inbound-title]');
    const inboundVisibility = root.querySelector<HTMLElement>('[data-ac-inbound-visibility]');
    const inboundDesc = root.querySelector<HTMLElement>('[data-ac-inbound-desc]');
    const inboundFunc = root.querySelector<HTMLElement>('[data-ac-inbound-func]');
    const inboundDist = root.querySelector<HTMLElement>('[data-ac-inbound-dist]');
    const inboundIdInput = root.querySelector<HTMLInputElement>('[data-ac-inbound-id]');
    const responseForm = root.querySelector<HTMLFormElement>('[data-ac-response-form]');
    const responseInput = root.querySelector<HTMLTextAreaElement>('[data-ac-textarea="recipientResponse"]');
    const responseSubmitBtn = root.querySelector<HTMLButtonElement>('[data-ac-response-submit-btn]');
    const responseResubmitBtn = root.querySelector<HTMLButtonElement>('[data-ac-response-resubmit-btn]');

    const showFeedback = (msg: string, kind: 'ok' | 'error' = 'ok') => {
      if (!feedbackEl) return;
      feedbackEl.textContent = msg;
      feedbackEl.hidden = false;
      feedbackEl.className = `ac-alert ${kind === 'error' ? 'ac-alert--error' : 'ac-alert--ok'}`;
    };

    const updateWordCounters = () => {
      const w1 = countWordsClient(descInput?.value || '');
      const w2 = countWordsClient(funcInput?.value || '');
      const w3 = countWordsClient(distInput?.value || '');
      const total = w1 + w2 + w3;

      const c1 = root.querySelector<HTMLElement>('[data-ac-word-count="descripcion"]');
      const c2 = root.querySelector<HTMLElement>('[data-ac-word-count="funcionaNoFunciona"]');
      const c3 = root.querySelector<HTMLElement>('[data-ac-word-count="hariaDistinto"]');
      if (c1) c1.textContent = formatWordLabel(w1);
      if (c2) c2.textContent = formatWordLabel(w2);
      if (c3) c3.textContent = formatWordLabel(w3);
      if (totalWordsEl) {
        totalWordsEl.innerHTML = `Total: <strong>${total}</strong> ${total === 1 ? 'palabra' : 'palabras'}`;
      }

      if (responseInput) {
        const wr = countWordsClient(responseInput.value || '');
        const cr = root.querySelector<HTMLElement>('[data-ac-word-count="recipientResponse"]');
        if (cr) cr.textContent = formatWordLabel(wr);
      }
    };

    root.querySelectorAll<HTMLTextAreaElement>('[data-ac-textarea]').forEach((ta) => {
      ta.addEventListener('input', updateWordCounters);
    });

    const renderFeed = (state: any) => {
      if (!feedListEl) return;
      const reviews = Array.isArray(state?.visibleReviews) ? state.visibleReviews : [];
      const isTeacher = Boolean(state?.currentUser?.isTeacher);

      if (reviews.length === 0) {
        feedListEl.innerHTML = '<p class="ac-empty-msg">Todavía no hay devoluciones visibles registradas.</p>';
        return;
      }

      feedListEl.innerHTML = reviews
        .map((rev: any) => {
          const w1 = countWordsClient(rev.descripcion);
          const w2 = countWordsClient(rev.funcionaNoFunciona);
          const w3 = countWordsClient(rev.hariaDistinto);
          const totalW = w1 + w2 + w3;
          const isSub = rev.status === 'submitted';

          return `
            <article class="ac-review-item" data-review-id="${esc(rev.id)}">
              <header class="ac-review-item-head">
                <div class="ac-review-pair">
                  <strong>${esc(rev.authorName)}</strong>
                  <span class="ac-pair-arrow" aria-hidden="true">→</span>
                  <span>amigx críticx de</span>
                  <strong>${esc(rev.recipientName)}</strong>
                </div>
                <div class="ac-review-badges">
                  <span class="ac-badge ${isSub ? 'ac-badge--ok' : 'ac-badge--pending'}">
                    ${isSub ? 'Entregado' : 'En urna (pendiente)'}
                  </span>
                  <span class="ac-badge ${rev.isPublic ? 'ac-badge--public' : 'ac-badge--private'}">
                    ${rev.isPublic ? 'Público' : 'Privado'}
                  </span>
                  <span class="ac-badge">${totalW} pal.</span>
                  ${
                    isTeacher
                      ? `<button type="button" class="ac-teacher-reset-btn" data-ac-teacher-release="${esc(rev.authorUserId)}" title="Liberar esta asignación de la urna (Docente)">Liberar urna</button>`
                      : ''
                  }
                </div>
              </header>
              ${
                isSub
                  ? `
                <div class="ac-review-item-body">
                  <div class="ac-read-block">
                    <h4>1. Descripción (${w1} pal.)</h4>
                    <p>${esc(rev.descripcion)}</p>
                  </div>
                  <div class="ac-read-block">
                    <h4>2. Qué funciona y qué no funciona (${w2} pal.)</h4>
                    <p>${esc(rev.funcionaNoFunciona)}</p>
                  </div>
                  <div class="ac-read-block">
                    <h4>3. Qué haría distinto y pregunta abierta (${w3} pal.)</h4>
                    <p>${esc(rev.hariaDistinto)}</p>
                  </div>
                  ${
                    rev.recipientResponse
                      ? `
                    <div class="ac-read-block ac-read-block--response">
                      <h4>Respuesta de ${esc(rev.recipientName)} (${countWordsClient(rev.recipientResponse)} pal.)</h4>
                      <p>${esc(rev.recipientResponse)}</p>
                    </div>
                  `
                      : ''
                  }
                </div>
              `
                  : ''
              }
            </article>
          `;
        })
        .join('');
    };

    const applyState = (state: any, preserveDrafts = false) => {
      if (!state) return;
      currentState = state;

      // Update stats
      const statTotal = root.querySelector('[data-ac-stat-total]');
      const statAssigned = root.querySelector('[data-ac-stat-assigned]');
      const statSubmitted = root.querySelector('[data-ac-stat-submitted]');
      if (statTotal) statTotal.textContent = String(state.urnStats?.totalStudents ?? '—');
      if (statAssigned) statAssigned.textContent = String(state.urnStats?.assignedCount ?? '—');
      if (statSubmitted) statSubmitted.textContent = String(state.urnStats?.submittedCount ?? '—');

      const outbound = state.myOutboundReview || null;
      const isSub = outbound?.status === 'submitted';

      // Rebuild dropdown options
      if (selectEl) {
        const candidates = Array.isArray(state.urnCandidates) ? state.urnCandidates : [];
        const optionsHtml: string[] = [
          '<option value="">— Seleccionar alumnx activx de la urna —</option>',
        ];
        if (outbound) {
          optionsHtml.push(
            `<option value="${esc(outbound.recipientUserId)}" selected>${esc(outbound.recipientName)} (tu elección actual)</option>`,
          );
        }
        for (const cand of candidates) {
          if (outbound && cand.id === outbound.recipientUserId) continue;
          optionsHtml.push(`<option value="${esc(cand.id)}">${esc(cand.name)}</option>`);
        }
        selectEl.innerHTML = optionsHtml.join('');
        selectEl.value = outbound?.recipientUserId || '';
        selectEl.disabled = Boolean(isSub);
      }

      if (releaseBtn) {
        releaseBtn.hidden = !outbound || Boolean(isSub);
      }

      if (urnHintEl) {
        urnHintEl.textContent = outbound
          ? `Asignación registrada en la urna: sos el amigx críticx de ${outbound.recipientName}.`
          : 'Al elegir un nombre del menú desplegable, se reserva automáticamente en la urna y deja de aparecer para el resto.';
      }

      if (!preserveDrafts && outbound) {
        if (descInput) descInput.value = outbound.descripcion || '';
        if (funcInput) funcInput.value = outbound.funcionaNoFunciona || '';
        if (distInput) distInput.value = outbound.hariaDistinto || '';
        if (publicSwitch) publicSwitch.checked = Boolean(outbound.isPublic);
      }

      if (submitBtn) {
        submitBtn.disabled = Boolean(isSub);
        submitBtn.textContent = isSub ? '✓ ENTREGADO' : 'ENTREGAR';
        submitBtn.className = `ac-btn ${isSub ? 'ac-btn--submitted' : 'ac-btn--primary'}`;
      }
      if (resubmitBtn) {
        resubmitBtn.hidden = !isSub;
      }

      // Inbound review section
      const inbound = state.myInboundReview || null;
      if (inboundSection) {
        const showInbound = Boolean(inbound && inbound.status === 'submitted');
        inboundSection.hidden = !showInbound;
        if (showInbound && inbound) {
          if (inboundTitle) inboundTitle.textContent = `Informe de tu amigx críticx: ${inbound.authorName}`;
          if (inboundVisibility) {
            inboundVisibility.textContent = inbound.isPublic ? 'Público para el curso' : 'Privado (par + docentes)';
          }
          if (inboundDesc) inboundDesc.textContent = inbound.descripcion || '';
          if (inboundFunc) inboundFunc.textContent = inbound.funcionaNoFunciona || '';
          if (inboundDist) inboundDist.textContent = inbound.hariaDistinto || '';
          if (inboundIdInput) inboundIdInput.value = inbound.id || '';
          if (!preserveDrafts && responseInput) {
            responseInput.value = inbound.recipientResponse || '';
          }
          const hasResponded = Boolean(inbound.recipientRespondedAt);
          if (responseSubmitBtn) {
            responseSubmitBtn.disabled = hasResponded;
            responseSubmitBtn.textContent = hasResponded ? '✓ RESPUESTA ENTREGADA' : 'ENTREGAR RESPUESTA';
            responseSubmitBtn.className = `ac-btn ${hasResponded ? 'ac-btn--submitted' : 'ac-btn--primary'}`;
          }
          if (responseResubmitBtn) {
            responseResubmitBtn.hidden = !hasResponded;
          }
        }
      }

      updateWordCounters();
      renderFeed(state);
    };

    // Fetch fresh state if SSR state was null
    if (!currentState) {
      fetch('/api/amigx-criticx')
        .then((r) => r.json())
        .then((data) => {
          if (data?.state) applyState(data.state);
        })
        .catch(() => {});
    }

    // Handle urn recipient selection (first-come, first-served)
    selectEl?.addEventListener('change', async () => {
      const recipientUserId = selectEl.value.trim();
      if (!recipientUserId) return;

      selectEl.disabled = true;
      try {
        const res = await fetch('/api/amigx-criticx', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'select_recipient',
            recipientUserId,
          }),
        });
        const data = await res.json();
        if (!res.ok || data.error) {
          showFeedback(data.error || 'No se pudo reservar el par en la urna.', 'error');
          // Refresh state to get updated urn list
          const fresh = await fetch('/api/amigx-criticx').then((r) => r.json()).catch(() => null);
          if (fresh?.state) applyState(fresh.state, true);
          return;
        }
        applyState(data.state, true);
        showFeedback('Par reservado en la urna. Ya podés completar y entregar tu informe.');
      } catch {
        showFeedback('Error de red al reservar en la urna.', 'error');
      } finally {
        if (!currentState?.myOutboundReview || currentState.myOutboundReview.status !== 'submitted') {
          selectEl.disabled = false;
        }
      }
    });

    // Release unsubmitted claim
    releaseBtn?.addEventListener('click', async () => {
      releaseBtn.disabled = true;
      try {
        const res = await fetch('/api/amigx-criticx', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'release_recipient' }),
        });
        const data = await res.json();
        if (!res.ok || data.error) {
          showFeedback(data.error || 'No se pudo liberar la asignación.', 'error');
          return;
        }
        applyState(data.state, true);
        showFeedback('Liberaste la asignación. El nombre volvió a estar disponible en la urna.');
      } catch {
        showFeedback('Error de red al liberar turno.', 'error');
      } finally {
        releaseBtn.disabled = false;
      }
    });

    // Submit or Re-submit helper
    const sendReviewSubmission = async (isResubmit = false) => {
      const recipientUserId = (selectEl?.value || currentState?.myOutboundReview?.recipientUserId || '').trim();
      if (!recipientUserId) {
        showFeedback('Primero elegí a quién vas a evaluar en el selector de la urna (Paso 1).', 'error');
        selectEl?.focus();
        return;
      }

      const descripcion = (descInput?.value || '').trim();
      const funcionaNoFunciona = (funcInput?.value || '').trim();
      const hariaDistinto = (distInput?.value || '').trim();
      const isPublic = Boolean(publicSwitch?.checked);

      if (!descripcion || !funcionaNoFunciona || !hariaDistinto) {
        showFeedback('Completá los tres campos del informe antes de entregar.', 'error');
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      if (resubmitBtn) resubmitBtn.disabled = true;

      try {
        const res = await fetch('/api/amigx-criticx', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'submit_review',
            recipientUserId,
            descripcion,
            funcionaNoFunciona,
            hariaDistinto,
            isPublic,
          }),
        });
        const data = await res.json();
        if (!res.ok || data.error) {
          showFeedback(data.error || 'Error al guardar la entrega.', 'error');
          if (submitBtn && currentState?.myOutboundReview?.status !== 'submitted') {
            submitBtn.disabled = false;
          }
          return;
        }
        applyState(data.state, false);
        showFeedback(
          isResubmit
            ? 'Entrega actualizada y re-enviada correctamente.'
            : 'Informe entregado. Quedó grabado para docentes, tu par y vos.',
        );
      } catch {
        showFeedback('Error de red al enviar el informe.', 'error');
      } finally {
        if (resubmitBtn) resubmitBtn.disabled = false;
      }
    };

    reviewForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      void sendReviewSubmission(false);
    });

    resubmitBtn?.addEventListener('click', () => {
      void sendReviewSubmission(true);
    });

    // Toggle HACER PÚBLICO live when already assigned/submitted
    publicSwitch?.addEventListener('change', async () => {
      if (!currentState?.myOutboundReview) return;
      try {
        const res = await fetch('/api/amigx-criticx', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'toggle_public',
            isPublic: Boolean(publicSwitch.checked),
          }),
        });
        const data = await res.json();
        if (res.ok && data.state) {
          applyState(data.state, true);
          showFeedback(
            publicSwitch.checked
              ? 'Visibilidad actualizada: ahora tu devolución es pública para el curso.'
              : 'Visibilidad actualizada: solo visible para docentes, tu par y vos.',
          );
        }
      } catch {
        // Ignore transient toggle error; will save on next submit
      }
    });

    // Recipient written response submission
    const sendRecipientResponse = async (isResubmit = false) => {
      const reviewId = (inboundIdInput?.value || currentState?.myInboundReview?.id || '').trim();
      const recipientResponse = (responseInput?.value || '').trim();
      if (!reviewId || !recipientResponse) {
        showFeedback('Escribí tu respuesta antes de entregar.', 'error');
        return;
      }
      if (responseSubmitBtn) responseSubmitBtn.disabled = true;
      if (responseResubmitBtn) responseResubmitBtn.disabled = true;
      try {
        const res = await fetch('/api/amigx-criticx', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'submit_response',
            reviewId,
            recipientResponse,
          }),
        });
        const data = await res.json();
        if (!res.ok || data.error) {
          showFeedback(data.error || 'Error al guardar la respuesta.', 'error');
          return;
        }
        applyState(data.state, false);
        showFeedback(
          isResubmit
            ? 'Respuesta escrita re-enviada correctamente.'
            : 'Respuesta escrita entregada correctamente (§27.3.6).',
        );
      } catch {
        showFeedback('Error de red al guardar la respuesta.', 'error');
      } finally {
        if (responseResubmitBtn) responseResubmitBtn.disabled = false;
      }
    };

    responseForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      void sendRecipientResponse(false);
    });

    responseResubmitBtn?.addEventListener('click', () => {
      void sendRecipientResponse(true);
    });

    // Teacher release button delegation
    feedListEl?.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-ac-teacher-release]');
      if (!btn) return;
      const targetAuthorUserId = btn.dataset.acTeacherRelease;
      if (!targetAuthorUserId) return;
      if (!confirm('¿Liberar esta asignación de la urna?')) return;

      btn.disabled = true;
      try {
        const res = await fetch('/api/amigx-criticx', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'release_recipient',
            targetAuthorUserId,
          }),
        });
        const data = await res.json();
        if (res.ok && data.state) {
          applyState(data.state, true);
          showFeedback('Asignación liberada por docente.');
        } else {
          showFeedback(data.error || 'No se pudo liberar la asignación.', 'error');
        }
      } catch {
        showFeedback('Error de red.', 'error');
      } finally {
        btn.disabled = false;
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initAmigxCriticxPortal);
  document.addEventListener('astro:page-load', initAmigxCriticxPortal);
</script>

