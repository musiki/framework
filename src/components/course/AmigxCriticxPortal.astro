---
import { ensureDbUserFromSession, getForumCourseAccess } from '../../lib/forum-server';
import { isElevatedGlobalRole } from '../../lib/roles';
import { getAmigxCriticxPortalState, type AmigxCriticxPortalState } from '../../lib/amigx-criticx/service';
import { countWords } from '../../lib/amigx-criticx/logic';

interface Props {
  courseId?: string;
  session?: { user?: { name?: string; email?: string; image?: string } } | null;
  initialView?: 'form' | 'devoluciones';
}

const {
  courseId = 's123',
  session = null,
  initialView = 'form',
} = Astro.props;

let initialState: AmigxCriticxPortalState | null = null;
let loadError = '';

if (session?.user?.email) {
  try {
    const dbUser = await ensureDbUserFromSession(session as any);
    if (dbUser) {
      const access = await getForumCourseAccess(dbUser, courseId);
      const isTeacher = Boolean(access.isTeacher || isElevatedGlobalRole(dbUser.role));
      if (access.isEnrolled || isTeacher) {
        initialState = await getAmigxCriticxPortalState(courseId, {
          id: dbUser.id,
          name: dbUser.name,
          email: dbUser.email,
          isTeacher,
        });
      } else {
        loadError = 'Debés estar inscriptx en Seminarios (s123) para usar Amigx Críticx.';
      }
    } else {
      loadError = 'No se encontró tu usuario en Musiki.';
    }
  } catch (err: unknown) {
    console.error('[AmigxCriticxPortal] SSR load failed:', err);
  }
}

const initialStateJson = JSON.stringify(initialState).replace(/</g, '\\u003c');
const myOutbound = initialState?.myOutboundReview ?? null;
const isSubmitted = myOutbound?.status === 'submitted';
const initialWords1 = countWords(myOutbound?.descripcion ?? '');
const initialWords2 = countWords(myOutbound?.funcionaNoFunciona ?? '');
const initialWords3 = countWords(myOutbound?.hariaDistinto ?? '');
const submittedVisibleReviews = (initialState?.visibleReviews ?? []).filter(
  (r) => r.status === 'submitted',
);
---

<section
  class="ac-simple"
  data-ac-portal
  data-course-id={courseId}
  data-ac-view={initialView}
>
  <header class="ac-top">
    <h1 class="ac-heading">Amigx Críticx</h1>
    <nav class="ac-tabs" aria-label="Secciones de Amigx Críticx">
      <a
        href="/amigxcriticx"
        class:list={['ac-tab', { active: initialView === 'form' }]}
        data-ac-nav="form"
        data-astro-prefetch="false"
      >
        Formulario
      </a>
      <a
        href="/amigxcriticx/devoluciones"
        class:list={['ac-tab', { active: initialView === 'devoluciones' }]}
        data-ac-nav="devoluciones"
        data-astro-prefetch="false"
      >
        Devoluciones (<span data-ac-devoluciones-count>{submittedVisibleReviews.length}</span>)
      </a>
    </nav>
  </header>

  {loadError ? (
    <p class="ac-msg ac-msg--error" role="alert">{loadError}</p>
  ) : (
    <>
      <p class="ac-msg" data-ac-feedback hidden role="status" aria-live="polite"></p>

      <!-- PÁGINA 1: FORMULARIO -->
      <div class="ac-page" data-ac-page="form" hidden={initialView !== 'form'}>
        <div class="ac-mo-box">
          <p>
            <strong>Cómo usar la Matriz Operativa (§11.4 / §24):</strong> cada concepto central del proyecto se verifica en cinco columnas:
            <code>Concepto | Definición operativa | Fuente/genealogía | Operación en la obra | Evidencia</code>.
            Para hacer la devolución, leé la matriz de tu compañerx <strong>de derecha a izquierda</strong> (desde la evidencia concreta en partitura, audio o ensayo hacia la operación y el concepto): comprobá si el concepto produce decisiones compositivas localizables o si queda como ornamento retórico. Evaluá el trabajo en sus propios términos, sin imponer tu propia poética (§27.3).
          </p>
        </div>

        <form class="ac-form" data-ac-review-form novalidate>
          <div class="ac-urn-row">
            <label for="ac-recipient-select" class="ac-urn-label">
              Seré el amigx críticx de:
            </label>
            <select
              id="ac-recipient-select"
              class="ac-select"
              data-ac-recipient-select
              disabled={Boolean(isSubmitted)}
              required
            >
              <option value="">Elegir compañerx…</option>
              {myOutbound && (
                <option value={myOutbound.recipientUserId} selected>
                  {myOutbound.recipientName}
                </option>
              )}
              {(initialState?.urnCandidates ?? [])
                .filter((student) => student.id !== myOutbound?.recipientUserId)
                .map((student) => (
                  <option value={student.id}>
                    {student.name}
                  </option>
                ))}
            </select>
            <span class="ac-urn-status" data-ac-urn-hint>
              {myOutbound ? `Asignado: ${myOutbound.recipientName}` : ''}
            </span>
          </div>

          <div class="ac-field">
            <div class="ac-field-head">
              <label for="ac-field-descripcion">1. Descripción (antes de juzgar)</label>
              <span class="ac-words" data-ac-word-count="descripcion">
                {initialWords1} {initialWords1 === 1 ? 'palabra' : 'palabras'}
              </span>
            </div>
            <textarea
              id="ac-field-descripcion"
              name="descripcion"
              class="ac-textarea"
              data-ac-textarea="descripcion"
              rows="4"
              placeholder="¿Qué escuché y qué leí, antes de opinar? El proyecto en tus palabras, en sus propios términos."
              disabled={Boolean(isSubmitted)}
              required
            >{myOutbound?.descripcion ?? ''}</textarea>
          </div>

          <div class="ac-field">
            <div class="ac-field-head">
              <label for="ac-field-funciona">2. Qué funciona y qué no funciona (localizado)</label>
              <span class="ac-words" data-ac-word-count="funcionaNoFunciona">
                {initialWords2} {initialWords2 === 1 ? 'palabra' : 'palabras'}
              </span>
            </div>
            <textarea
              id="ac-field-funciona"
              name="funcionaNoFunciona"
              class="ac-textarea"
              data-ac-textarea="funcionaNoFunciona"
              rows="4"
              placeholder="Qué está resuelto y con qué procedimiento + dónde no hace lo que dice hacer (compás, sección, definición o fuente)."
              disabled={Boolean(isSubmitted)}
              required
            >{myOutbound?.funcionaNoFunciona ?? ''}</textarea>
          </div>

          <div class="ac-field">
            <div class="ac-field-head">
              <label for="ac-field-distinto">3. Qué haría distinto y pregunta abierta</label>
              <span class="ac-words" data-ac-word-count="hariaDistinto">
                {initialWords3} {initialWords3 === 1 ? 'palabra' : 'palabras'}
              </span>
            </div>
            <textarea
              id="ac-field-distinto"
              name="hariaDistinto"
              class="ac-textarea"
              data-ac-textarea="hariaDistinto"
              rows="4"
              placeholder="Una operación alternativa y qué ganaría el proyecto con ella + una pregunta abierta."
              disabled={Boolean(isSubmitted)}
              required
            >{myOutbound?.hariaDistinto ?? ''}</textarea>
          </div>

          <div class="ac-actions">
            <label class="ac-public-label" for="ac-public-switch">
              <input
                id="ac-public-switch"
                type="checkbox"
                name="isPublic"
                data-ac-public-switch
                checked={Boolean(myOutbound?.isPublic)}
                {...({ switch: '' } as Record<string, string>)}
              />
              <span>HACER PÚBLICO</span>
            </label>

            <div class="ac-buttons">
              <button
                type="submit"
                class:list={['ac-btn', isSubmitted ? 'ac-btn--done' : 'ac-btn--submit']}
                data-ac-submit-btn
                disabled={Boolean(isSubmitted)}
              >
                {isSubmitted ? 'ENTREGADO' : 'ENTREGAR'}
              </button>

              <button
                type="button"
                class="ac-btn ac-btn--edit"
                data-ac-resubmit-btn
                hidden={!isSubmitted}
              >
                RE-ENVIAR ENTREGA
              </button>
            </div>
          </div>
        </form>
      </div>

      <!-- PÁGINA 2: DEVOLUCIONES -->
      <div class="ac-page" data-ac-page="devoluciones" hidden={initialView !== 'devoluciones'}>
        <div class="ac-feed" data-ac-feed-list>
          {submittedVisibleReviews.length === 0 ? (
            <p class="ac-empty">Todavía no hay devoluciones entregadas.</p>
          ) : (
            submittedVisibleReviews.map((review) => (
              <article class="ac-review">
                <header class="ac-review-head">
                  <strong>{review.authorName} → {review.recipientName}</strong>
                  <span class="ac-review-meta">
                    {review.isPublic ? 'Público' : 'Docentes / Par'}
                  </span>
                </header>
                <div class="ac-review-section">
                  <h4>1. Descripción</h4>
                  <p>{review.descripcion}</p>
                </div>
                <div class="ac-review-section">
                  <h4>2. Qué funciona y qué no funciona</h4>
                  <p>{review.funcionaNoFunciona}</p>
                </div>
                <div class="ac-review-section">
                  <h4>3. Qué haría distinto y pregunta abierta</h4>
                  <p>{review.hariaDistinto}</p>
                </div>
              </article>
            ))
          )}
        </div>
      </div>
    </>
  )}

  <script type="application/json" data-ac-initial-state set:html={initialStateJson}></script>
</section>

<script>
  import { countWords } from '../../lib/amigx-criticx/logic';
  import type { AmigxCriticxPortalState, AmigxCriticxReviewRecord } from '../../lib/amigx-criticx/service';

  function escHtml(value: unknown): string {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formatWordLabel(count: number): string {
    return `${count} ${count === 1 ? 'palabra' : 'palabras'}`;
  }

  function setPortalView(root: HTMLElement, view: 'form' | 'devoluciones', pushUrl = false) {
    root.dataset.acView = view;
    root.querySelectorAll<HTMLElement>('[data-ac-page]').forEach((page) => {
      page.hidden = page.dataset.acPage !== view;
    });
    root.querySelectorAll<HTMLAnchorElement>('[data-ac-nav]').forEach((tab) => {
      tab.classList.toggle('active', tab.dataset.acNav === view);
    });
    document.querySelectorAll<HTMLAnchorElement>('.chapter--amigxcriticx a.lesson-link').forEach((link) => {
      const isDevolucionesLink = link.getAttribute('href')?.endsWith('/devoluciones');
      const active = view === 'devoluciones' ? Boolean(isDevolucionesLink) : !isDevolucionesLink;
      link.classList.toggle('active', active);
    });
    if (pushUrl) {
      const prefix = window.location.pathname.startsWith('/s123/') ? '/s123/amigxcriticx' : '/amigxcriticx';
      const targetUrl = view === 'devoluciones' ? `${prefix}/devoluciones` : prefix;
      if (window.location.pathname !== targetUrl) {
        window.history.pushState({}, '', targetUrl);
      }
    }
  }

  function bindPortal(root: HTMLElement) {
    if (root.dataset.acBound === 'true') return;
    root.dataset.acBound = 'true';

    const stateEl = root.querySelector<HTMLScriptElement>('[data-ac-initial-state]');
    let state: AmigxCriticxPortalState | null = null;
    try {
      state = stateEl?.textContent ? JSON.parse(stateEl.textContent) : null;
    } catch {
      state = null;
    }

    const feedbackEl = root.querySelector<HTMLElement>('[data-ac-feedback]');
    const selectEl = root.querySelector<HTMLSelectElement>('[data-ac-recipient-select]');
    const urnHintEl = root.querySelector<HTMLElement>('[data-ac-urn-hint]');
    const formEl = root.querySelector<HTMLFormElement>('[data-ac-review-form]');
    const publicSwitch = root.querySelector<HTMLInputElement>('[data-ac-public-switch]');
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-ac-submit-btn]');
    const resubmitBtn = root.querySelector<HTMLButtonElement>('[data-ac-resubmit-btn]');
    const feedListEl = root.querySelector<HTMLElement>('[data-ac-feed-list]');
    const countEl = root.querySelector<HTMLElement>('[data-ac-devoluciones-count]');

    const textareas = {
      descripcion: root.querySelector<HTMLTextAreaElement>('[data-ac-textarea="descripcion"]'),
      funcionaNoFunciona: root.querySelector<HTMLTextAreaElement>('[data-ac-textarea="funcionaNoFunciona"]'),
      hariaDistinto: root.querySelector<HTMLTextAreaElement>('[data-ac-textarea="hariaDistinto"]'),
    };
    const wordCounters = {
      descripcion: root.querySelector<HTMLElement>('[data-ac-word-count="descripcion"]'),
      funcionaNoFunciona: root.querySelector<HTMLElement>('[data-ac-word-count="funcionaNoFunciona"]'),
      hariaDistinto: root.querySelector<HTMLElement>('[data-ac-word-count="hariaDistinto"]'),
    };

    let editingUnlocked = false;

    function showFeedback(msg: string, isError = false) {
      if (!feedbackEl) return;
      if (!msg) {
        feedbackEl.hidden = true;
        feedbackEl.textContent = '';
        return;
      }
      feedbackEl.hidden = false;
      feedbackEl.textContent = msg;
      feedbackEl.classList.toggle('ac-msg--error', isError);
    }

    function updateWordCounts() {
      (['descripcion', 'funcionaNoFunciona', 'hariaDistinto'] as const).forEach((key) => {
        const count = countWords(textareas[key]?.value ?? '');
        if (wordCounters[key]) {
          wordCounters[key]!.textContent = formatWordLabel(count);
        }
      });
    }

    function renderDevoluciones(reviews: AmigxCriticxReviewRecord[]) {
      const submitted = reviews.filter((r) => r.status === 'submitted');
      if (countEl) countEl.textContent = String(submitted.length);
      if (!feedListEl) return;
      if (submitted.length === 0) {
        feedListEl.innerHTML = '<p class="ac-empty">Todavía no hay devoluciones entregadas.</p>';
        return;
      }
      feedListEl.innerHTML = submitted
        .map(
          (r) => `
          <article class="ac-review">
            <header class="ac-review-head">
              <strong>${escHtml(r.authorName)} → ${escHtml(r.recipientName)}</strong>
              <span class="ac-review-meta">${r.isPublic ? 'Público' : 'Docentes / Par'}</span>
            </header>
            <div class="ac-review-section">
              <h4>1. Descripción</h4>
              <p>${escHtml(r.descripcion)}</p>
            </div>
            <div class="ac-review-section">
              <h4>2. Qué funciona y qué no funciona</h4>
              <p>${escHtml(r.funcionaNoFunciona)}</p>
            </div>
            <div class="ac-review-section">
              <h4>3. Qué haría distinto y pregunta abierta</h4>
              <p>${escHtml(r.hariaDistinto)}</p>
            </div>
          </article>
        `,
        )
        .join('');
    }

    function applyState(nextState: AmigxCriticxPortalState, syncFields = false) {
      state = nextState;
      const myOutbound = nextState.myOutboundReview;
      const isSubmittedNow = myOutbound?.status === 'submitted';
      const locked = Boolean(isSubmittedNow && !editingUnlocked);

      if (selectEl) {
        const currentVal = myOutbound?.recipientUserId || selectEl.value || '';
        const options: string[] = ['<option value="">Elegir compañerx…</option>'];
        if (myOutbound) {
          options.push(
            `<option value="${escHtml(myOutbound.recipientUserId)}" selected>${escHtml(myOutbound.recipientName)}</option>`,
          );
        }
        for (const student of nextState.urnCandidates) {
          if (student.id === myOutbound?.recipientUserId) continue;
          const sel = !myOutbound && student.id === currentVal ? ' selected' : '';
          options.push(`<option value="${escHtml(student.id)}"${sel}>${escHtml(student.name)}</option>`);
        }
        selectEl.innerHTML = options.join('');
        selectEl.disabled = Boolean(isSubmittedNow);
      }

      if (urnHintEl) {
        urnHintEl.textContent = myOutbound ? `Asignado: ${myOutbound.recipientName}` : '';
      }

      if (syncFields && myOutbound) {
        if (textareas.descripcion) textareas.descripcion.value = myOutbound.descripcion || '';
        if (textareas.funcionaNoFunciona) textareas.funcionaNoFunciona.value = myOutbound.funcionaNoFunciona || '';
        if (textareas.hariaDistinto) textareas.hariaDistinto.value = myOutbound.hariaDistinto || '';
        if (publicSwitch) publicSwitch.checked = Boolean(myOutbound.isPublic);
      }

      (['descripcion', 'funcionaNoFunciona', 'hariaDistinto'] as const).forEach((key) => {
        if (textareas[key]) textareas[key]!.disabled = locked;
      });

      if (submitBtn) {
        submitBtn.disabled = locked;
        submitBtn.textContent = locked ? 'ENTREGADO' : 'ENTREGAR';
        submitBtn.classList.toggle('ac-btn--done', locked);
        submitBtn.classList.toggle('ac-btn--submit', !locked);
      }

      if (resubmitBtn) {
        resubmitBtn.hidden = !locked;
      }

      updateWordCounts();
      renderDevoluciones(nextState.visibleReviews);
    }

    // Live word counters
    (['descripcion', 'funcionaNoFunciona', 'hariaDistinto'] as const).forEach((key) => {
      textareas[key]?.addEventListener('input', updateWordCounts);
    });

    // Tab links inside portal
    root.querySelectorAll<HTMLAnchorElement>('[data-ac-nav]').forEach((tab) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const view = tab.dataset.acNav === 'devoluciones' ? 'devoluciones' : 'form';
        setPortalView(root, view, true);
      });
    });

    // Select recipient from urn dropdown
    selectEl?.addEventListener('change', async () => {
      const recipientUserId = selectEl.value.trim();
      if (!recipientUserId) return;
      showFeedback('');
      try {
        const res = await fetch('/api/amigx-criticx', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'select_recipient', recipientUserId }),
        });
        const data = await res.json();
        if (!res.ok || !data?.state) {
          showFeedback(data?.error || 'No se pudo asignar el compañerx.', true);
          if (state) applyState(state, false);
          return;
        }
        applyState(data.state, false);
      } catch {
        showFeedback('Error de red al guardar la elección.', true);
      }
    });

    // Toggle HACER PÚBLICO
    publicSwitch?.addEventListener('change', async () => {
      if (!state?.myOutboundReview) return;
      try {
        const res = await fetch('/api/amigx-criticx', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'toggle_public',
            isPublic: Boolean(publicSwitch.checked),
          }),
        });
        const data = await res.json();
        if (res.ok && data?.state) {
          applyState(data.state, false);
        }
      } catch {
        // ignore
      }
    });

    // Unlock editing on RE-ENVIAR ENTREGA
    resubmitBtn?.addEventListener('click', () => {
      editingUnlocked = true;
      (['descripcion', 'funcionaNoFunciona', 'hariaDistinto'] as const).forEach((key) => {
        if (textareas[key]) textareas[key]!.disabled = false;
      });
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'ENTREGAR';
        submitBtn.classList.remove('ac-btn--done');
        submitBtn.classList.add('ac-btn--submit');
      }
      resubmitBtn.hidden = true;
      textareas.descripcion?.focus();
    });

    // Submit form
    formEl?.addEventListener('submit', async (e) => {
      e.preventDefault();
      showFeedback('');

      const recipientUserId = (selectEl?.value || state?.myOutboundReview?.recipientUserId || '').trim();
      if (!recipientUserId) {
        showFeedback('Elegí primero unx compañerx en el menú desplegable.', true);
        selectEl?.focus();
        return;
      }

      const descripcion = textareas.descripcion?.value ?? '';
      const funcionaNoFunciona = textareas.funcionaNoFunciona?.value ?? '';
      const hariaDistinto = textareas.hariaDistinto?.value ?? '';

      if (!descripcion.trim() || !funcionaNoFunciona.trim() || !hariaDistinto.trim()) {
        showFeedback('Completá los tres campos antes de entregar.', true);
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Guardando…';
      }

      try {
        const res = await fetch('/api/amigx-criticx', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'submit_review',
            recipientUserId,
            descripcion,
            funcionaNoFunciona,
            hariaDistinto,
            isPublic: Boolean(publicSwitch?.checked),
          }),
        });
        const data = await res.json();
        if (!res.ok || !data?.state) {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'ENTREGAR';
          }
          showFeedback(data?.error || 'No se pudo guardar la entrega.', true);
          return;
        }
        editingUnlocked = false;
        applyState(data.state, true);
        showFeedback('Entrega guardada.');
      } catch {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'ENTREGAR';
        }
        showFeedback('Error de red al guardar la entrega.', true);
      }
    });

    if (!state) {
      fetch('/api/amigx-criticx')
        .then((r) => r.json())
        .then((data) => {
          if (data?.state) applyState(data.state, true);
        })
        .catch(() => {});
    }
  }

  function bootAll() {
    document.querySelectorAll<HTMLElement>('[data-ac-portal]').forEach(bindPortal);
  }

  bootAll();
  document.addEventListener('astro:page-load', bootAll);

  // Allow sidebar links to /amigxcriticx and /amigxcriticx/devoluciones to switch view cleanly
  // even when Dockview has open note panels.
  const win = window as any;
  if (!win.__acNavInterceptorBound) {
    win.__acNavInterceptorBound = true;
    document.addEventListener(
      'click',
      (e: MouseEvent) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
        const link = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href]');
        if (!link) return;
        const href = link.getAttribute('href') || '';
        const isAcLink = /^\/(s123\/)?amigxcriticx(\/devoluciones)?\/?$/.test(href);
        if (!isAcLink) return;

        // Always close any open Dockview panels so the portal is not hidden behind a note pod
        try {
          win.__cnwWorkspace?.closeAll?.();
        } catch {
          // ignore
        }

        const root = document.querySelector<HTMLElement>('[data-ac-portal]');
        if (root) {
          e.preventDefault();
          const targetView = href.endsWith('/devoluciones') ? 'devoluciones' : 'form';
          setPortalView(root, targetView, true);
        }
      },
      true,
    );
  }
</script>

<style>
  .ac-simple {
    max-width: 760px;
    margin: 0 auto;
    padding: 1.25rem 1rem 3rem;
    color: var(--c-fg, #e5e5e0);
  }

  .ac-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--c-border, rgba(128, 128, 128, 0.25));
    padding-bottom: 0.6rem;
    margin-bottom: 1rem;
  }

  .ac-heading {
    font-size: 1.25rem;
    font-weight: 650;
    margin: 0;
  }

  .ac-tabs {
    display: flex;
    gap: 0.75rem;
    font-size: 0.9rem;
  }

  .ac-tab {
    color: var(--c-fg-dim, #9a9a95);
    text-decoration: none;
    padding: 0.2rem 0.45rem;
    border-radius: 3px;
  }

  .ac-tab:hover {
    color: var(--c-fg, #fff);
  }

