---
import StrudelPanel from '../room/generators/strudel/StrudelPanel.astro';
---

<div class="course-strudel-workspace" id="course-strudel-workspace" aria-hidden="true">
  <section class="course-strudel-shell">
    <header class="course-strudel-header">
      <span class="course-strudel-title">STRUDEL</span>
      <div class="course-strudel-actions">
        <button
          type="button"
          class="course-strudel-header-btn course-strudel-transport"
          data-strudel-transport
          data-playing="false"
          aria-label="Play Strudel"
          aria-pressed="false"
          title="Play Strudel"
        >▶</button>
        <button
          type="button"
          class="course-strudel-header-btn course-strudel-close"
          data-course-strudel-close
          aria-label="Cerrar Strudel (Esc)"
          title="Cerrar (Esc)"
        >×</button>
      </div>
    </header>
    <div class="course-strudel-body">
      <StrudelPanel />
    </div>
  </section>
</div>

<style>
  .course-strudel-workspace {
    position: fixed;
    inset: 0 0 0 var(--ribbon-width, 44px);
    z-index: 30;
    display: flex;
    pointer-events: none;
    transform: translateY(100%);
    transition: transform 0.25s ease;
    background: var(--c-bg);
    color: var(--c-fg);
  }

  .course-strudel-workspace.is-open {
    pointer-events: auto;
    transform: translateY(0);
  }

  .course-strudel-shell {
    display: flex;
    flex: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
    background: var(--c-bg);
  }

  .course-strudel-header {
    display: flex;
    height: 22px;
    flex: 0 0 22px;
    align-items: center;
    gap: 6px;
    padding: 0 6px;
    background: transparent;
  }

  .course-strudel-title {
    flex: 1;
    overflow: hidden;
    color: #f6b26b;
    font-size: 0.5rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    line-height: 1;
    opacity: 0.75;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .course-strudel-actions {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .course-strudel-header-btn {
    display: inline-flex;
    width: 16px;
    height: 16px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: transparent;
    color: var(--c-fg);
    cursor: pointer;
    line-height: 1;
    opacity: 0.68;
  }

  .course-strudel-header-btn:hover,
  .course-strudel-header-btn:focus-visible {
    opacity: 1;
  }

  .course-strudel-transport {
    font-size: 9px;
  }

  .course-strudel-transport[data-playing='true'] {
    color: #f6b26b;
    opacity: 1;
  }

  .course-strudel-close {
    font-size: 16px;
  }

  .course-strudel-body {
    display: flex;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .course-strudel-body :global(.musiki-pod),
  .course-strudel-body :global(.conference-stage-panel--strudel) {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 0;
    flex: 1;
    background: var(--c-bg);
    color: var(--c-fg);
  }

  @media (max-width: 500px) {
    .course-strudel-workspace {
      inset: 0 0 var(--ribbon-mobile-clearance, 64px) 0;
    }
  }
</style>

<script>
  import { StrudelController } from '../../scripts/room/strudel/StrudelController';

  function boot() {
    const overlay = document.getElementById('course-strudel-workspace') as HTMLElement | null;
    if (!overlay || overlay.dataset.booted === 'true') return;
    overlay.dataset.booted = 'true';

    const strudelContainer = overlay.querySelector<HTMLElement>('.musiki-pod[data-pod="strudel"]');
    const transport = overlay.querySelector<HTMLButtonElement>('[data-strudel-transport]');
    const closeButton = overlay.querySelector<HTMLButtonElement>('[data-course-strudel-close]');
    if (!strudelContainer || !transport || !closeButton) return;

    let controller: StrudelController | null = null;
    let audioContext: AudioContext | null = null;
    let outputGain: GainNode | null = null;

    const ensureAudio = async () => {
      if (!audioContext) {
        audioContext = new AudioContext();
        outputGain = audioContext.createGain();
        outputGain.connect(audioContext.destination);
      }
      return audioContext;
    };

    const ensureController = () => {
      if (controller) return controller;
      controller = new StrudelController({
        container: strudelContainer,
        getAudioContext: ensureAudio,
        getOutputNode: () => outputGain,
        transportButton: transport,
      });
      return controller;
    };

    const open = () => {
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      ensureController();
    };

    const close = () => {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
    };

    transport.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      event.stopPropagation();
      void ensureController().toggle();
    });
    closeButton.addEventListener('click', close);
    window.addEventListener('musiki:open-strudel', open);
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && overlay.classList.contains('is-open')) close();
    });
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
