---
import PodTemplates from '../room/workspace/PodTemplates.astro';
---

<div class="course-pod-workspace" id="course-pod-workspace" aria-hidden="true">
  <button
    type="button"
    class="course-pod-workspace-close"
    id="course-pod-workspace-close"
    aria-label="Cerrar workspace (Esc)"
    title="Cerrar (Esc)"
  >×</button>
  <div
    id="course-pod-workspace-root"
    class="dockview-theme-dark"
    data-workspace-root
    data-no-default-layout
  ></div>
  <PodTemplates />
</div>

<style>
  .course-pod-workspace {
    /* Bridge conference CSS vars to site theme */
    --conference-fg: var(--c-fg);
    --conference-muted: color-mix(in srgb, var(--c-fg) 58%, transparent);
    --conference-dim: color-mix(in srgb, var(--c-fg) 32%, transparent);
    --conference-line: var(--c-border);
    --conference-line-soft: color-mix(in srgb, var(--c-fg) 6%, transparent);
    --conference-accent: var(--c-link, #2a87ff);
    --conference-accent-hi: #76d3ff;
    --conference-green: #25cf6b;
    --conference-red: #ff4d4d;
    --conference-font-ui: inherit;
    --conference-font-body: inherit;
    --conference-font-caption: inherit;

    position: fixed;
    inset: 0 0 0 var(--ribbon-width, 44px);
    z-index: 30;
    pointer-events: none;
    transform: translateY(100%);
    transition: transform 0.25s ease;
    background: var(--c-bg);
    display: flex;
    flex-direction: column;
  }

  .course-pod-workspace.is-open {
    transform: translateY(0);
    pointer-events: auto;
  }

  #course-pod-workspace-root {
    flex: 1;
    min-height: 0;
  }

  .course-pod-workspace-close {
    position: absolute;
    top: 6px;
    right: 8px;
    z-index: 10;
    width: 28px;
    height: 28px;
    border: 1px solid var(--c-border);
    border-radius: 4px;
    background: var(--c-bg);
    color: var(--c-fg);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.55;
    transition: opacity 0.15s;
  }
  .course-pod-workspace-close:hover { opacity: 1; }

  /* Override hardcoded dark colors from conference components */
  .course-pod-workspace .pod-diy-shell { background: var(--c-bg) !important; }
  .course-pod-workspace .pod-diy-header { color: var(--c-fg) !important; }
  .course-pod-workspace .pod-diy-btn { color: var(--c-fg) !important; }
  .course-pod-workspace .pod-diy-handle-dot { background: var(--c-fg) !important; }
  .course-pod-workspace .musiki-pod { background: var(--c-bg) !important; color: var(--c-fg) !important; }
  .course-pod-workspace .dv-separator { background: var(--c-border) !important; }
  .course-pod-workspace .conference-notes-body {
    background: var(--c-bg) !important;
    color: var(--c-fg) !important;
  }
  .course-pod-workspace .conference-sidebar-panel-body {
    background: var(--c-bg) !important;
    color: var(--c-fg) !important;
  }
  .course-pod-workspace .musiki-pod-btn {
    background: color-mix(in srgb, var(--c-fg) 8%, transparent) !important;
    color: var(--c-fg) !important;
  }

  /* Mobile: slide from bottom, account for ribbon at bottom */
  @media (max-width: 500px) {
    .course-pod-workspace {
      inset: 0 0 var(--ribbon-bottom-height, 54px) 0;
    }
  }
</style>

<script>
  import { RoomWorkspaceManager } from '../../scripts/room/workspace/RoomWorkspaceManager';
  import { HyperpianoController } from '../../scripts/room/hyperpiano/HyperpianoController';
  import { SonicAnalyzerController } from '../../scripts/room/sonic-analyzer';
  import { SonicVisualizerController } from '../../scripts/room/sonic-visualizer';

  function boot() {
    const overlay = document.getElementById('course-pod-workspace') as HTMLElement | null;
    if (!overlay) return;

    const root = document.getElementById('course-pod-workspace-root') as HTMLElement | null;
    if (!root) return;

    let manager: RoomWorkspaceManager | null = null;
    let isReady = false;
    let pendingPod: string | null = null;

    // Shared audio context for standalone Hyperpiano (lazy-created on first user gesture)
    let courseAudioCtx: AudioContext | null = null;
    let courseOutputGain: GainNode | null = null;

    // Mic audio tap for standalone SA (lazy-created on first SA interaction)
    let micCtx: AudioContext | null = null;
    let micAnalyser: AnalyserNode | null = null;
    let micStream: MediaStream | null = null;

    const startMic = async () => {
      if (micCtx && micAnalyser) return;
      try {
        micStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
        micCtx = new AudioContext();
        const source = micCtx.createMediaStreamSource(micStream);
        micAnalyser = micCtx.createAnalyser();
        micAnalyser.fftSize = 2048;
        source.connect(micAnalyser);
      } catch {
        // mic denied — SA will remain in idle state
      }
    };

    const onHyperpianoInit = (container: HTMLElement) => {
      const hp = new HyperpianoController({
        audioContext: null,
        container,
        outputNode: null,
        getMidiInputId: () => null,
      });
      hp.init();

      // Defer AudioContext creation to first interaction (browser autoplay policy)
      container.addEventListener('pointerdown', async () => {
        if (!courseAudioCtx) {
          courseAudioCtx = new AudioContext();
          courseOutputGain = courseAudioCtx.createGain();
          courseOutputGain!.connect(courseAudioCtx.destination);
        }
        if (courseAudioCtx.state === 'suspended') await courseAudioCtx.resume();
        hp.setAudio(courseAudioCtx, courseOutputGain!);
      }, { once: true });

      return hp;
    };

    const onSonicAnalyzerInit = (container: HTMLElement) => {
      const controller = new SonicAnalyzerController({
        container,
        getAudioTap: () => micCtx && micAnalyser
          ? { context: micCtx, masterAnalyser: micAnalyser }
          : null,
      });
      // Request mic on first container interaction
      container.addEventListener('pointerdown', () => void startMic(), { once: true });
      return { dispose: () => controller.dispose() };
    };

    const onSonicVisualizerInit = (container: HTMLElement) => {
      const controller = new SonicVisualizerController({ container });
      return { dispose: () => controller.dispose() };
    };

    function ensureInit() {
      if (manager) return;
      manager = new RoomWorkspaceManager(
        root!, () => false, () => {},
        onHyperpianoInit,
        undefined, undefined, undefined, undefined,  // whiteboard, lily, concept, media
        undefined, undefined, undefined, undefined,  // clase, chat, orf, score
        onSonicAnalyzerInit,
        onSonicVisualizerInit,
      );
      manager.init();
      // RoomWorkspaceManager.init() defers 200ms; give extra buffer
      setTimeout(() => {
        isReady = true;
        if (pendingPod) {
          manager?.togglePod(pendingPod, true);
          pendingPod = null;
        }
      }, 320);
    }

    function open(podType: string) {
      overlay!.classList.add('is-open');
      overlay!.setAttribute('aria-hidden', 'false');
      if (!manager) {
        pendingPod = podType;
        ensureInit();
      } else if (isReady) {
        manager.togglePod(podType, true);
      } else {
        pendingPod = podType;
      }
    }

    function close() {
      overlay!.classList.remove('is-open');
      overlay!.setAttribute('aria-hidden', 'true');
    }

    window.addEventListener('musiki:open-hyperpiano', () => open('hyperpiano'));
    window.addEventListener('musiki:open-sa', () => open('sonic-analyzer'));
    window.addEventListener('musiki:open-sv', () => open('sonic-visualizer'));

    const closeBtn = document.getElementById('course-pod-workspace-close');
    if (closeBtn && !closeBtn.dataset.bound) {
      closeBtn.dataset.bound = 'true';
      closeBtn.addEventListener('click', close);
    }

    // Close on Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay!.classList.contains('is-open')) close();
    });
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
