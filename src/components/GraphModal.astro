---
// Graph Modal Component - Press 'g' to toggle
const currentSlug = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '');

// Show the public/all toggle only to logged-in users (students, teachers, admins)
const isLoggedIn = Boolean((Astro.locals as any)?.session?.user);
---

<div id="graph-modal" class="graph-modal">
  <div id="graph-canvas"></div>
  <div class="graph-hud">
    <div class="graph-legend">
      <div><span class="legend-doc"></span> Documents</div>
      <div><span class="legend-tag"></span> Tags</div>
      <div><span class="legend-current"></span> Current</div>
    </div>
    <div class="graph-hud-right">
      <div id="node-preview" class="node-preview">
        <img id="preview-img" src="" alt="" />
        <div id="preview-title"></div>
      </div>
      {isLoggedIn && (
        <button id="graph-toggle-filter" title="Mostrar todo / solo público (T)">público</button>
      )}
      <button id="graph-center" title="Center on current page">⊙</button>
      <button id="graph-close" title="Close">✕</button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/force-graph"></script>

<script define:vars={{ currentSlug, isLoggedIn }}>
  // ── Per-folder visual identity ─────────────────────────────────────────────
  // shape: 'circle' | 'diamond' | 'triangle' | 'square' | 'pentagon' | 'hexagon' | 'star' | 'cross'
  // Add new folders here as musiki grows.
  const FOLDER_IDENTITY = {
    instruments:  { color: '#f59e0b', shape: 'diamond',  label: 'Instruments'  },
    instrumentos: { color: '#f59e0b', shape: 'diamond',  label: 'Instrumentos' },
    theory:       { color: '#818cf8', shape: 'triangle', label: 'Theory'       },
    history:      { color: '#fb923c', shape: 'pentagon', label: 'History'      },
    analysis:     { color: '#22d3ee', shape: 'hexagon',  label: 'Analysis'     },
    rhythm:       { color: '#f472b6', shape: 'star',     label: 'Rhythm'       },
    harmony:      { color: '#4ade80', shape: 'square',   label: 'Harmony'      },
    ear:          { color: '#f87171', shape: 'cross',    label: 'Ear Training' },
    counterpoint: { color: '#a78bfa', shape: 'diamond',  label: 'Counterpoint' },
    form:         { color: '#34d399', shape: 'hexagon',  label: 'Form'         },
    notation:     { color: '#67e8f9', shape: 'pentagon', label: 'Notation'     },
    dictionaries: { color: '#fbbf24', shape: 'star',     label: 'Dictionaries' },
    solfege:      { color: '#86efac', shape: 'triangle', label: 'Solfège'      },
  };

  const FALLBACK_SHAPES = ['square','diamond','pentagon','hexagon','star','cross','triangle'];
  const FALLBACK_COLORS = ['#a78bfa','#34d399','#fb923c','#f472b6','#38bdf8','#fbbf24','#4ade80'];

  function getFolderIdentity(folder) {
    if (!folder) return null;
    if (FOLDER_IDENTITY[folder]) return FOLDER_IDENTITY[folder];
    // Consistent hash for unlisted folders
    let hash = 0;
    for (const c of folder) hash = (hash * 31 + c.charCodeAt(0)) & 0xffff;
    return {
      color: FALLBACK_COLORS[hash % FALLBACK_COLORS.length],
      shape: FALLBACK_SHAPES[hash % FALLBACK_SHAPES.length],
      label: folder.charAt(0).toUpperCase() + folder.slice(1),
    };
  }

  function drawShape(ctx, shape, x, y, r) {
    ctx.beginPath();
    switch (shape) {
      case 'diamond': {
        ctx.moveTo(x, y - r * 1.4);
        ctx.lineTo(x + r * 1.05, y);
        ctx.lineTo(x, y + r * 1.4);
        ctx.lineTo(x - r * 1.05, y);
        ctx.closePath();
        break;
      }
      case 'triangle': {
        ctx.moveTo(x, y - r * 1.25);
        ctx.lineTo(x + r * 1.1, y + r * 0.85);
        ctx.lineTo(x - r * 1.1, y + r * 0.85);
        ctx.closePath();
        break;
      }
      case 'square': {
        const s = r * 0.92;
        ctx.rect(x - s, y - s, s * 2, s * 2);
        break;
      }
      case 'pentagon': {
        for (let i = 0; i < 5; i++) {
          const a = (i * 2 * Math.PI / 5) - Math.PI / 2;
          i === 0 ? ctx.moveTo(x + r * Math.cos(a), y + r * Math.sin(a))
                  : ctx.lineTo(x + r * Math.cos(a), y + r * Math.sin(a));
        }
        ctx.closePath();
        break;
      }
      case 'hexagon': {
        for (let i = 0; i < 6; i++) {
          const a = i * Math.PI / 3;
          i === 0 ? ctx.moveTo(x + r * Math.cos(a), y + r * Math.sin(a))
                  : ctx.lineTo(x + r * Math.cos(a), y + r * Math.sin(a));
        }
        ctx.closePath();
        break;
      }
      case 'star': {
        for (let i = 0; i < 10; i++) {
          const a = (i * Math.PI / 5) - Math.PI / 2;
          const rad = i % 2 === 0 ? r * 1.25 : r * 0.52;
          i === 0 ? ctx.moveTo(x + rad * Math.cos(a), y + rad * Math.sin(a))
                  : ctx.lineTo(x + rad * Math.cos(a), y + rad * Math.sin(a));
        }
        ctx.closePath();
        break;
      }
      case 'cross': {
        const t = r * 0.33, l = r * 1.0;
        ctx.moveTo(x - t, y - l); ctx.lineTo(x + t, y - l);
        ctx.lineTo(x + t, y - t); ctx.lineTo(x + l, y - t);
        ctx.lineTo(x + l, y + t); ctx.lineTo(x + t, y + t);
        ctx.lineTo(x + t, y + l); ctx.lineTo(x - t, y + l);
        ctx.lineTo(x - t, y + t); ctx.lineTo(x - l, y + t);
        ctx.lineTo(x - l, y - t); ctx.lineTo(x - t, y - t);
        ctx.closePath();
        break;
      }
      default: {
        ctx.arc(x, y, r, 0, 2 * Math.PI);
      }
    }
    ctx.fill();
  }

  let graphData = null;
  let graphInstance = null;
  const highlightNodes = new Set();
  const highlightLinks = new Set();
  let hoverNode = null;
  const labelOpacity = new Map();
  let showAll = false; // default: only public notes + their tags

  // Load raw graph data (no cross-linking here — done per filtered dataset)
  async function initGraph() {
    if (!graphData) {
      const response = await fetch('/graph-data.json');
      graphData = await response.json();
    }
    return graphData;
  }

  // Add neighbors/links refs to nodes for hover-highlighting
  function crossLinkNodes(data) {
    data.nodes.forEach(n => { n.neighbors = []; n.links = []; });
    data.links.forEach(link => {
      const srcId = typeof link.source === 'object' ? link.source.id : link.source;
      const tgtId = typeof link.target === 'object' ? link.target.id : link.target;
      const a = data.nodes.find(n => n.id === srcId);
      const b = data.nodes.find(n => n.id === tgtId);
      if (a && b) {
        a.neighbors.push(b); b.neighbors.push(a);
        a.links.push(link);  b.links.push(link);
      }
    });
  }

  // Return only public-folder nodes + tag nodes connected to them
  function filterPublicData(data) {
    // group === 'public' means the file is directly inside public/ (first path segment)
    const publicIds = new Set(
      data.nodes.filter(n => n.type === 'document' && n.group === 'public').map(n => n.id)
    );
    const tagIds = new Set();
    for (const link of data.links) {
      const s = typeof link.source === 'object' ? link.source.id : link.source;
      const t = typeof link.target === 'object' ? link.target.id : link.target;
      if (publicIds.has(s) && String(t).startsWith('tag:')) tagIds.add(t);
      if (publicIds.has(t) && String(s).startsWith('tag:')) tagIds.add(s);
    }
    const allowed = new Set([...publicIds, ...tagIds]);
    return {
      nodes: data.nodes.filter(n => allowed.has(n.id)),
      links: data.links.filter(l => {
        const s = typeof l.source === 'object' ? l.source.id : l.source;
        const t = typeof l.target === 'object' ? l.target.id : l.target;
        return allowed.has(s) && allowed.has(t);
      }),
    };
  }

  function updateLegend(data) {
    const legend = document.querySelector('.graph-legend');
    if (!legend) return;
    const folders = [...new Set(data.nodes.map(n => n.publicFolder).filter(Boolean))].sort();
    let html = `
      <div><span class="legend-doc"></span> Docs</div>
      <div><span class="legend-tag"></span> Tags</div>
      <div><span class="legend-current"></span> Actual</div>
    `;
    for (const folder of folders) {
      const id = getFolderIdentity(folder);
      html += `<div><span class="legend-folder" style="background:${id.color}"></span> ${id.label}</div>`;
    }
    legend.innerHTML = html;
  }

  function updateFilterButton() {
    const btn = document.getElementById('graph-toggle-filter');
    if (!btn) return;
    btn.textContent = showAll ? 'todo' : 'público';
    btn.dataset.all = showAll ? 'true' : 'false';
  }

  // Show/hide modal
  async function setModalOpen(open, source = 'local') {
    const modal = document.getElementById('graph-modal');
    if (!modal) return;

    if (open && !graphInstance) {
      await renderGraph();
    }

    modal.classList.toggle('visible', open);
    modal.classList.toggle('hidden', !open);
    modal.dataset.open = open ? 'true' : 'false';

    window.dispatchEvent(new CustomEvent('graph:statechange', {
      detail: { open, source },
    }));
  }

  function toggleModal(source = 'local') {
    const modal = document.getElementById('graph-modal');
    const isVisible = modal?.classList.contains('visible');
    void setModalOpen(!isVisible, source);
  }

  // Get current theme colors
  function getThemeColors() {
    const isDark = document.documentElement.classList.contains('dark');
    return isDark ? {
      document: '#4f83ff',
      tag: '#34d399',
      current: '#f87171',
      link: '#6b7280',
      tagLink: '#059669',
      highlight: '#fbbf24',
      hover: '#f87171',
      labelColor: '#e0e0e0',
      background: '#000'
    } : {
      document: '#2563eb',
      tag: '#059669',
      current: '#dc2626',
      link: '#9ca3af',
      tagLink: '#10b981',
      highlight: '#f59e0b',
      hover: '#dc2626',
      labelColor: '#4a4a4a',
      background: '#fff'
    };
  }

  // Render the graph
  async function renderGraph() {
    const raw = await initGraph();
    const data = showAll ? raw : filterPublicData(raw);
    crossLinkNodes(data);
    const container = document.getElementById('graph-canvas');

    // Clear container
    container.innerHTML = '';

    let colors = getThemeColors();

    const NODE_R = 3.2;

    graphInstance = ForceGraph()(container)
      .graphData(data)
      .backgroundColor(colors.background)
      .nodeId('id')
      .nodeLabel('name')
      .nodeRelSize(NODE_R)
      .nodeVal(node => {
        if (node.id === currentSlug) return 12;
        return node.type === 'tag' ? 3 : 6;
      })
      .linkColor(link => {
        if (highlightLinks.has(link)) return colors.highlight;
        return link.type === 'tag' ? colors.tagLink : colors.link;
      })
      .linkWidth(link => highlightLinks.has(link) ? 3 : 1.5)
      .linkDirectionalParticles(link => highlightLinks.has(link) ? 4 : 0)
      .linkDirectionalParticleWidth(link => highlightLinks.has(link) ? 3 : 0)
      .linkLineDash(link => link.type === 'tag' && [4, 6])
      .d3AlphaDecay(0.02)
      .d3VelocityDecay(0.3)
      .autoPauseRedraw(false)
      // 'replace' mode: we draw the node ourselves (shape + glow + label)
      .nodeCanvasObjectMode(() => 'replace')
      .nodeCanvasObject((node, ctx, globalScale) => {
        const isCurrent   = node.id === currentSlug || node.canonicalSlug === currentSlug;
        const isHighlight = highlightNodes.has(node);
        const isHover     = node === hoverNode;
        const isTag       = node.type === 'tag';

        // Base radius for drawing (independent from physics nodeVal)
        const r = isCurrent ? 7 : isTag ? 2.8 : 4.5;

        // Folder identity (null for tags and current node)
        const identity = !isTag && !isCurrent ? getFolderIdentity(node.publicFolder) : null;

        // Fill color
        let fillColor;
        if (isCurrent)        fillColor = colors.current;
        else if (isHighlight) fillColor = isHover ? colors.hover : colors.highlight;
        else if (identity)    fillColor = identity.color;
        else if (isTag)       fillColor = colors.tag;
        else                  fillColor = colors.document;

        // Glow ring on highlight
        if (isHighlight) {
          ctx.beginPath();
          ctx.arc(node.x, node.y, r * 2.0, 0, 2 * Math.PI);
          ctx.fillStyle = (isHover ? colors.hover : colors.highlight) + '2e';
          ctx.fill();
        }

        // Node shape
        ctx.fillStyle = fillColor;
        drawShape(ctx, identity ? identity.shape : 'circle', node.x, node.y, r);

        // Fade-in label when zoomed (> 0.8 globalScale)
        const shouldShowLabels = globalScale > 0.8;
        if (!labelOpacity.has(node.id)) labelOpacity.set(node.id, shouldShowLabels ? 1 : 0);
        let opacity = labelOpacity.get(node.id);
        const fadeSpeed = 0.016;
        if (shouldShowLabels && opacity < 1) opacity = Math.min(1, opacity + fadeSpeed);
        else if (!shouldShowLabels && opacity > 0) opacity = Math.max(0, opacity - fadeSpeed);
        labelOpacity.set(node.id, opacity);

        if (opacity > 0) {
          const fontSize = 12 / globalScale;
          ctx.font = `${fontSize}px Sans-Serif`;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.globalAlpha = opacity;
          ctx.fillStyle = colors.labelColor;
          ctx.fillText(node.name, node.x, node.y + r * 2.2);
          ctx.globalAlpha = 1;
        }
      })
      .onNodeHover(node => {
        highlightNodes.clear();
        highlightLinks.clear();
        
        if (node) {
          highlightNodes.add(node);
          if (node.neighbors) {
            node.neighbors.forEach(neighbor => highlightNodes.add(neighbor));
          }
          if (node.links) {
            node.links.forEach(link => highlightLinks.add(link));
          }
        }
        
        hoverNode = node || null;
        container.style.cursor = node ? 'pointer' : 'default';
        
        // Update preview
        const preview = document.getElementById('node-preview');
        const previewImg = document.getElementById('preview-img');
        const previewTitle = document.getElementById('preview-title');
        
        if (node && node.type === 'document') {
          previewTitle.textContent = node.name;
          if (node.img) {
            previewImg.src = node.img;
            previewImg.style.display = 'block';
          } else {
            previewImg.style.display = 'none';
          }
          preview.classList.add('visible');
        } else {
          preview.classList.remove('visible');
        }
      })
      .onLinkHover(link => {
        highlightNodes.clear();
        highlightLinks.clear();
        
        if (link) {
          highlightLinks.add(link);
          const source = data.nodes.find(n => n.id === link.source.id || n.id === link.source);
          const target = data.nodes.find(n => n.id === link.target.id || n.id === link.target);
          if (source) highlightNodes.add(source);
          if (target) highlightNodes.add(target);
        }
      })
      .onNodeClick((node, event) => {
        // Shift+Click to center and zoom on node
        if (event.shiftKey) {
          graphInstance.centerAt(node.x, node.y, 1000);
          graphInstance.zoom(8, 2000);
        } else {
          // Regular click to navigate
          if (node.type === 'document') {
            window.location.href = '/' + (node.canonicalSlug || node.id);
          } else if (node.type === 'tag') {
            const tag = node.id.replace('tag:', '');
            window.location.href = '/' + encodeURIComponent(tag);
          }
        }
      });
    
    updateLegend(data);
    updateFilterButton();

    // Center on current node if it exists (match by id or canonicalSlug)
    setTimeout(() => {
      const currentNode = data.nodes.find(n => n.id === currentSlug || n.canonicalSlug === currentSlug);
      if (currentNode && graphInstance) {
        graphInstance.centerAt(currentNode.x, currentNode.y, 1000);
        graphInstance.zoom(2, 1000);
      }
    }, 1000);
    
    // Animate dashed lines for tag links
    const dashLen = 4;
    const gapLen = 6;
    const st = +new Date();
    const dashAnimateTime = 800; // time to animate a single dash cycle
    
    (function animateDashes() {
      const t = ((+new Date() - st) % dashAnimateTime) / dashAnimateTime;
      const lineDash = t < 0.5 
        ? [0, gapLen * t * 2, dashLen, gapLen * (1 - t * 2)] 
        : [dashLen * (t - 0.5) * 2, gapLen, dashLen * (1 - (t - 0.5) * 2), 0];
      
      graphInstance.linkLineDash(link => link.type === 'tag' && lineDash);
      requestAnimationFrame(animateDashes);
    })();
    
    // Listen for theme changes — node colors are drawn in canvas so only bg+links need updating
    const observer = new MutationObserver(() => {
      colors = getThemeColors();
      graphInstance
        .backgroundColor(colors.background)
        .linkColor(link => highlightLinks.has(link) ? colors.highlight : link.type === 'tag' ? colors.tagLink : colors.link);
    });
    
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class']
    });
  }

  // Toggle public/all filter while graph is open
  function applyGraphFilter() {
    if (!graphInstance || !graphData) return;
    const data = showAll ? graphData : filterPublicData(graphData);
    crossLinkNodes(data);
    highlightNodes.clear();
    highlightLinks.clear();
    hoverNode = null;
    labelOpacity.clear();
    graphInstance.graphData(data);
    updateLegend(data);
    updateFilterButton();
  }

  // Center on current page
  async function centerOnCurrent() {
    if (!graphInstance) return;
    const activeNodes = graphInstance.graphData().nodes;
    const currentNode = activeNodes.find(n => n.id === currentSlug || n.canonicalSlug === currentSlug);
    if (currentNode) {
      graphInstance.centerAt(currentNode.x, currentNode.y, 1000);
      graphInstance.zoom(2, 1000);
    }
  }

  const handleGraphShortcut = (e) => {
    if (e.defaultPrevented) return;
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

    const modal = document.getElementById('graph-modal');
    const isOpen = modal?.classList.contains('visible');

    if (e.key.toLowerCase() === 'g' && (e.ctrlKey || e.metaKey) && !e.altKey && !e.shiftKey) {
      e.preventDefault();
      toggleModal();
    } else if (e.key.toLowerCase() === 't' && isOpen && isLoggedIn) {
      e.preventDefault();
      showAll = !showAll;
      applyGraphFilter();
    } else if (e.key === 'Escape' && isOpen) {
      toggleModal();
    }
  };

  const handleGraphToggleRequest = () => {
    toggleModal('remote-toggle');
  };

  const handleGraphSetRequest = (event) => {
    const nextOpen = Boolean(event?.detail?.open);
    void setModalOpen(nextOpen, event?.detail?.source || 'remote');
  };

  const handleGraphOpenRequest = () => {
    void setModalOpen(true, 'remote');
  };

  const handleGraphCloseRequest = () => {
    void setModalOpen(false, 'remote');
  };

  // Event listeners
  document.addEventListener('keydown', handleGraphShortcut);
  window.addEventListener('graph:toggle', handleGraphToggleRequest);
  window.addEventListener('graph:set', handleGraphSetRequest);
  window.addEventListener('graph:open', handleGraphOpenRequest);
  window.addEventListener('graph:close', handleGraphCloseRequest);

  document.getElementById('graph-close')?.addEventListener('click', () => {
    void setModalOpen(false, 'local');
  });
  document.getElementById('graph-center')?.addEventListener('click', centerOnCurrent);
  if (isLoggedIn) {
    document.getElementById('graph-toggle-filter')?.addEventListener('click', () => {
      showAll = !showAll;
      applyGraphFilter();
    });
  }
  
  document.getElementById('graph-modal')?.addEventListener('click', (e) => {
    if (e.target.id === 'graph-modal') {
      void setModalOpen(false, 'local');
    }
  });

  document.addEventListener(
    'astro:before-swap',
    () => {
      document.removeEventListener('keydown', handleGraphShortcut);
      window.removeEventListener('graph:toggle', handleGraphToggleRequest);
      window.removeEventListener('graph:set', handleGraphSetRequest);
      window.removeEventListener('graph:open', handleGraphOpenRequest);
      window.removeEventListener('graph:close', handleGraphCloseRequest);
    },
    { once: true }
  );
</script>

<style>
  .graph-modal {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  .graph-modal.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .graph-modal.hidden {
    display: none;
  }

  #graph-canvas {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
  }

  .graph-hud {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 1rem 2rem;
  }

  .graph-hud-right {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
  }

  .node-preview {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    opacity: 0;
    transition: opacity 1s ease;
    pointer-events: none;
    max-width: 200px;
  }

  .node-preview.visible {
    opacity: 1;
  }

  .node-preview img {
    width: 120px;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
    display: none;
  }

  .node-preview #preview-title {
    color: #888;
    font-size: 0.85rem;
    text-align: right;
    line-height: 1.3;
  }

  .graph-legend {
    display: flex;
    gap: 1.5rem;
    color: rgb(220 220 220);
    font-size: 0.85rem;
  }

  .graph-legend > div {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .graph-legend span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .legend-doc {
    background: #4f83ff;
  }

  .legend-tag {
    background: #34d399;
  }

  .legend-current {
    background: #f87171;
  }

  /* Folder identity swatches — color set dynamically by JS */
  .legend-folder {
    border-radius: 2px; /* square-ish to hint at custom shapes */
  }

  .graph-hud-right button {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    width: 2rem;
    height: 2rem;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    transition: all 0.2s;
  }

  #graph-toggle-filter {
    width: auto;
    padding: 0 0.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    font-weight: 600;
    text-transform: lowercase;
    opacity: 0.7;
  }

  #graph-toggle-filter[data-all="true"] {
    opacity: 1;
    border-color: rgba(255, 255, 255, 0.5);
  }

  .graph-hud-right button:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* Dark mode */
  :global(.dark) .graph-modal {
    background: rgb(10 10 10);
  }

  /* Light mode */
  :global(:not(.dark)) .graph-modal {
    background: rgb(250 250 250);
  }


  :global(:not(.dark)) .graph-legend {
    color: rgb(60 60 60);
  }

  :global(:not(.dark)) .graph-hud-right button {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.1);
