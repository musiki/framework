---
// Full mm page for a thread with its posts, at /f/<group>/t/<thread> (a
// thread of the group itself) or /f/<group>/<channel>/t/<thread>. The calling
// page loads the data (lib/mm/board-pages.ts loadThreadPage, which 404s a
// thread requested under a board it does not belong to) and sets the status.
// Post bodies are rendered ONLY from the core's sanitized `bodyHtml`
// (set:html is used for nothing else); the markdown source is never rendered
// as HTML. No mermaid is loaded or initialized.
// Clients: votes + adopt dialog (thread.ts), reply composer with move and
// @citekey autocomplete (composer.ts), moderation buttons (forms.ts).
import 'katex/dist/katex.min.css';
import MmLayout from '../../layouts/MmLayout.astro';
import MmStatus from './MmStatus.astro';
import MmBreadcrumbs from './MmBreadcrumbs.astro';
import { t, type MessageKey } from '../../lib/i18n';
import { POST_MOVES, type ThreadView } from '../../lib/mm/forum';
import { clientStrings } from '../../lib/mm/page-strings';
import type { PageState } from '../../lib/mm/board-pages';
import type { MmLang } from '../../lib/mm/ui-lang';
import { conceptPath, displayName, formatDate, forumCrumbs } from '../../lib/mm/view';

interface Props {
  lang: MmLang;
  isMm: boolean;
  state: PageState;
  view: ThreadView | null;
}
const { lang, isMm, state, view } = Astro.props;

const formerMember = t(lang, 'mm.common.formerMember');
const memberLabel = t(lang, 'mm.common.member');
const thread = view?.thread;
const posts = view?.posts ?? [];
const perms = view?.viewer ?? { role: null, canPost: false, canVote: false, canModerate: false, canAdopt: false };
const signedIn = Boolean(Astro.locals.session?.user);
const concept = thread?.concept ?? null;
const canAdoptHere = Boolean(concept && perms.canAdopt && !thread?.isLocked);
const authorById = new Map(posts.map((p) => [p.id, displayName(p.author, formerMember, memberLabel)]));
const langName = (l: string | null) =>
  l === 'nb' ? t(lang, 'mm.common.langNb') : l === 'nn' ? t(lang, 'mm.common.langNn') : t(lang, 'mm.common.langEn');
const strings = clientStrings(lang, {
  'reply.to': t(lang, 'mm.thread.replyingTo'),
  'cite.label': t(lang, 'mm.thread.citations.label'),
  'cite.searching': t(lang, 'mm.thread.citations.searching'),
  'cite.none': t(lang, 'mm.thread.citations.none'),
  'cite.unavailable': t(lang, 'mm.thread.citations.unavailable'),
  'adopt.lead': concept ? t(lang, 'mm.thread.adoptDialog.lead', { concept: concept.label }) : '',
  'adopt.loading': t(lang, 'mm.thread.adoptDialog.loading'),
});
const VOTES = [
  { value: 1, key: 'useful' },
  { value: 2, key: 'clarifies' },
  { value: 3, key: 'reference' },
] as const;
// Citations: the thread's board (a channel by id: its slug is only unique in its group).
const citeRef = thread?.forum ? (thread.forum.parent ? thread.forum.id : thread.forum.slug) : '';
const crumbs = thread?.forum ? forumCrumbs(thread.forum, thread.title) : [];
---
{!isMm ? (
  <html lang="en"><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>Not found</title></head><body><h1>Not found</h1></body></html>
) : state !== 'ok' || !thread ? (
  <MmStatus lang={lang} kind={state === 'unavailable' ? 'unavailable' : 'notFound'} />
) : (
  <MmLayout lang={lang} title={thread.title}>
    <div data-mm-i18n={strings}>
      <MmBreadcrumbs label={t(lang, 'mm.forum.breadcrumb')} crumbs={crumbs} />
      <h1>{thread.title}</h1>
      <p class="mm-meta">
        <span>{t(lang, 'mm.forum.startedBy', { name: displayName(thread.createdBy, formerMember, memberLabel) })}</span>
        <span>{formatDate(thread.createdAt, lang)}</span>
      </p>
      {concept && (
        <p class="mm-note">
          <a href={conceptPath(concept.slug)}>{t(lang, 'mm.thread.aboutConcept', { label: concept.label })}</a>
        </p>
      )}
      {thread.isLocked && <p class="mm-note">{t(lang, 'mm.thread.locked')}</p>}
      <p class="mm-alert" data-mm-flash role="alert" hidden></p>

      <h2 class="mm-visually-hidden">{t(lang, 'mm.thread.postsTitle')}</h2>
      {posts.length ? (
        <ol class="mm-posts">
          {posts.map((p) => {
            const author = displayName(p.author, formerMember, memberLabel);
            const visible = p.status === 'published' || (p.status === 'hidden' && perms.canModerate);
            const hasFoot = p.status === 'published'
              ? perms.canVote || p.votes.total > 0 || perms.canPost || canAdoptHere || perms.canModerate
              : p.status === 'hidden' && perms.canModerate;
            return (
              <li>
                <article id={`post-${p.id}`} class:list={['mm-post', { 'mm-post-hidden': p.status !== 'published' }]} aria-label={author}>
                  <header class="mm-post-head">
                    <span class="mm-post-author">{author}</span>
                    <time class="mm-meta" datetime={p.createdAt}>{formatDate(p.createdAt, lang)}</time>
                    {p.move && <span class="mm-badge mm-badge-move">{t(lang, `mm.moves.${p.move}` as MessageKey)}</span>}
                    {p.status === 'hidden' && <span class="mm-badge mm-badge-quiet">{t(lang, 'mm.thread.hidden')}</span>}
                    {p.parentPostId && authorById.has(p.parentPostId) && (
                      <a class="mm-meta" href={`#post-${p.parentPostId}`}>{t(lang, 'mm.thread.inReplyTo', { name: authorById.get(p.parentPostId) ?? '' })}</a>
                    )}
                  </header>
                  {p.adopted?.conceptSlug && (
                    <p class="mm-adopted">
                      <a href={conceptPath(p.adopted.conceptSlug)}>{t(lang, 'mm.thread.adopted', { lang: langName(p.adopted.lang), concept: concept?.slug === p.adopted.conceptSlug ? concept.label : p.adopted.conceptSlug })}</a>
                    </p>
                  )}
                  {visible && p.bodyHtml ? (
                    <div class="mm-post-body" set:html={p.bodyHtml} />
                  ) : (
                    <p class="mm-muted">{p.status === 'deleted' ? t(lang, 'mm.thread.deletedPost') : t(lang, 'mm.thread.hiddenPost')}</p>
                  )}
                  {hasFoot && (
                    <footer class="mm-post-foot">
                      {p.status === 'published' && (perms.canVote ? (
                        <span class="mm-votes" data-mm-votes data-post-id={p.id} role="group" aria-label={t(lang, 'mm.thread.votesLabel')}>
                          {VOTES.map((v) => (
                            <button type="button" class="mm-vote" data-mm-vote={String(v.value)} aria-pressed={String(p.myVote === v.value)}>
                              {t(lang, `mm.thread.votes.${v.key}` as MessageKey)} <span data-mm-count>{p.votes[v.key]}</span>
                            </button>
                          ))}
                        </span>
                      ) : p.votes.total > 0 ? (
                        <span class="mm-vote-static">
                          {VOTES.filter((v) => p.votes[v.key] > 0).map((v) => `${t(lang, `mm.thread.votes.${v.key}` as MessageKey)} ${p.votes[v.key]}`).join(' · ')}
                        </span>
                      ) : null)}
                      {perms.canPost && p.status === 'published' && (
                        <button type="button" class="mm-textbutton" data-mm-reply data-post-id={p.id} data-author={author}>{t(lang, 'mm.thread.reply')}</button>
                      )}
                      {canAdoptHere && p.status === 'published' && !p.adopted && (
                        <button type="button" class="mm-textbutton" data-mm-adopt data-post-id={p.id} data-author={author}>{t(lang, 'mm.thread.adopt')}</button>
                      )}
                      {perms.canModerate && p.status === 'published' && (
                        <button type="button" class="mm-textbutton" data-mm-action data-method="PATCH" data-endpoint={`/api/mm/posts/${p.id}`} data-body={JSON.stringify({ action: 'hide' })} data-then="reload" data-hash={`post-${p.id}`}>{t(lang, 'mm.thread.hide')}</button>
                      )}
                      {perms.canModerate && p.status === 'hidden' && (
                        <button type="button" class="mm-textbutton" data-mm-action data-method="PATCH" data-endpoint={`/api/mm/posts/${p.id}`} data-body={JSON.stringify({ action: 'unhide' })} data-then="reload" data-hash={`post-${p.id}`}>{t(lang, 'mm.thread.unhide')}</button>
                      )}
                    </footer>
                  )}
                </article>
              </li>
            );
          })}
        </ol>
      ) : (
        <p class="mm-muted">{t(lang, 'mm.thread.empty')}</p>
      )}

      {perms.canPost ? (
        <section aria-labelledby="mm-composer" class="mm-panel">
          <h2 id="mm-composer">{t(lang, 'mm.thread.composerTitle')}</h2>
          <form class="mm-form" data-mm-form data-mm-reply-form data-method="POST" data-endpoint={`/api/mm/threads/${thread.id}/posts`} data-then="reload-post">
            <input type="hidden" name="parentPostId" value="" />
            <p class="mm-note" data-mm-replying hidden>
              <span data-mm-replying-text></span>
              {' '}<button type="button" class="mm-textbutton" data-mm-reply-cancel>{t(lang, 'mm.thread.cancelReply')}</button>
            </p>
            <div class="mm-form-row">
              <label for="mm-post-move">{t(lang, 'mm.moves.label')}</label>
              <select id="mm-post-move" name="move" aria-describedby="mm-post-move-help">
                {POST_MOVES.map((m) => <option value={m} selected={m === 'comment'}>{t(lang, `mm.moves.${m}` as MessageKey)}</option>)}
              </select>
              <p id="mm-post-move-help" class="mm-help">{t(lang, 'mm.moves.help')}</p>
            </div>
            <div class="mm-form-row">
              <label for="mm-post-body">{t(lang, 'mm.thread.body')}</label>
              <textarea id="mm-post-body" name="body" required maxlength="20000" data-mm-cite={citeRef} aria-describedby="mm-post-body-help"></textarea>
              <p id="mm-post-body-help" class="mm-help">{t(lang, 'mm.thread.bodyHelp')}</p>
            </div>
            <p class="mm-alert" data-mm-form-status role="alert" hidden></p>
            <div class="mm-form-actions"><button class="mm-button" type="submit">{t(lang, 'mm.thread.send')}</button></div>
          </form>
        </section>
      ) : !thread.isLocked && (
        signedIn ? (
          <p class="mm-note">{t(lang, 'mm.common.membersOnly')}</p>
        ) : (
          <p><a class="mm-button" href="/join">{t(lang, 'mm.common.signInToTakePart')}</a></p>
        )
      )}

      {canAdoptHere && concept && (
        <dialog class="mm-dialog" data-mm-adopt-dialog data-thread-id={thread.id} data-concept-slug={concept.slug} aria-labelledby="mm-adopt-title">
          <form class="mm-form" method="dialog">
            <h2 id="mm-adopt-title">{t(lang, 'mm.thread.adoptDialog.title')}</h2>
            <p data-mm-adopt-lead></p>
            <fieldset>
              <legend>{t(lang, 'mm.thread.adoptDialog.lang')}</legend>
              <div class="mm-radios">
                <label><input type="radio" name="lang" value="en" checked={lang === 'en'} /> {t(lang, 'mm.common.langEn')}</label>
                <label><input type="radio" name="lang" value="nb" checked={lang === 'nb'} /> {t(lang, 'mm.common.langNb')}</label>
              </div>
            </fieldset>
            <div class="mm-form-row">
              <label for="mm-adopt-text">{t(lang, 'mm.thread.adoptDialog.text')}</label>
              <textarea id="mm-adopt-text" name="definition" maxlength="20000" aria-describedby="mm-adopt-help"></textarea>
              <p id="mm-adopt-help" class="mm-help">{t(lang, 'mm.thread.adoptDialog.textHelp')}</p>
            </div>
            <p class="mm-alert" data-mm-form-status role="alert" hidden></p>
            <div class="mm-form-actions">
              <button class="mm-button" type="submit">{t(lang, 'mm.thread.adoptDialog.confirm')}</button>
              <button class="mm-button mm-button-quiet" type="button" data-mm-dialog-close>{t(lang, 'mm.common.cancel')}</button>
            </div>
          </form>
        </dialog>
      )}
    </div>
  </MmLayout>
)}

<script>
  import '../../scripts/mm/forms.ts';
  import '../../scripts/mm/composer.ts';
  import '../../scripts/mm/thread.ts';
</script>
