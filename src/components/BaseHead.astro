---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/theme.css';
import '../styles/global.css';
import '../styles/site-themes.css';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageURL = canonicalURL.toString();

const { title, description, image } = Astro.props;
const imageURL = image
	? new URL(image, Astro.site).toString()
	: new URL('/og-image.png', Astro.site).toString();
const gaMeasurementId = String(import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-0NXGW5G7NX').trim();
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
<link rel="manifest" href="/favicon/site.webmanifest" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />

<!-- Apariencia: un solo tema por persona (claro, oscuro, invulne, dracula, lyt).
     Se aplica antes de pintar y otra vez después de cada navegación del
     ClientRouter, que reemplaza los atributos de <html> por los de la página
     nueva: sin eso, algunas notas aparecían con otro tema. -->
<script is:inline>
	(function() {
		var THEMES = {
			claro: { site: 'default', dark: false, label: 'Claro' },
			oscuro: { site: 'default', dark: true, label: 'Oscuro' },
			invulne: { site: 'invulne', dark: false, label: 'Invulne' },
			'invulne-oscuro': { site: 'invulne', dark: true, label: 'Invulne oscuro' },
			dracula: { site: 'dracula', dark: true, label: 'Dracula' },
			lyt: { site: 'lyt', dark: false, label: 'LYT' }
		};
		var KEY = 'musiki.appearance';
		var store = {
			get: function(k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
			set: function(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
		};
		// Antes había dos ejes sueltos: claro/oscuro ('theme') y el tema global
		// ('musiki.globalTheme'). Se traducen al nombre nuevo la primera vez.
		var fromLegacy = function(site) {
			var dark = store.get('theme') === 'dark';
			if ((site || store.get('musiki.globalTheme')) === 'invulne') return dark ? 'invulne-oscuro' : 'invulne';
			return dark ? 'oscuro' : 'claro';
		};
		var chosen = function() {
			var v = store.get(KEY);
			return THEMES[v] ? v : null;
		};
		var current = function() {
			try {
				var q = new URLSearchParams(window.location.search).get('theme');
				if (q === 'dark') return 'oscuro';
				if (q === 'light') return 'claro';
				if (THEMES[q]) return q;
			} catch (e) {}
			return chosen() || fromLegacy();
		};
		var apply = function(name) {
			var t = THEMES[name] || THEMES.claro;
			var root = document.documentElement;
			root.classList.toggle('dark', t.dark);
			root.dataset.theme = t.dark ? 'dark' : 'light';
			root.dataset.musikiTheme = t.site;
			root.dataset.appearance = THEMES[name] ? name : 'claro';
			window.dispatchEvent(new CustomEvent('musiki:site-theme-change', { detail: { theme: t.site } }));
			window.dispatchEvent(new CustomEvent('musiki:appearance-change', { detail: { appearance: root.dataset.appearance } }));
		};
		window.musikiAppearance = {
			themes: Object.keys(THEMES).map(function(id) { return { id: id, label: THEMES[id].label, dark: THEMES[id].dark }; }),
			get: function() { return document.documentElement.dataset.appearance || current(); },
			set: function(name) {
				if (!THEMES[name]) return;
				store.set(KEY, name);
				// Las páginas con head propio (Studio, slides) todavía leen 'theme'.
				store.set('theme', THEMES[name].dark ? 'dark' : 'light');
				apply(name);
			}
		};
		apply(current());
		document.addEventListener('astro:after-swap', function() { apply(current()); });

		// Sin elección propia, manda el tema que el admin fijó para el sitio.
		if (!chosen()) {
			fetch('/api/site/theme', { headers: { Accept: 'application/json' }, cache: 'no-store' })
				.then(function(r) { return r.ok ? r.json() : null; })
				.then(function(p) {
					if (!p || p.fallback || chosen()) return;
					store.set('musiki.globalTheme', p.theme === 'invulne' ? 'invulne' : 'default');
					apply(fromLegacy(p.theme));
				})
				.catch(function() {});
		}
	})();
</script>
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={pageURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={pageURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />

<script is:inline define:vars={{ gaMeasurementId }}>
	(() => {
		const measurementId = String(gaMeasurementId || '').trim();
		if (!measurementId) return;

		const allowedHosts = new Set(['musiki.org.ar', 'www.musiki.org.ar']);
		const hostname = String(window.location.hostname || '').toLowerCase();
		if (!allowedHosts.has(hostname)) return;

		window.dataLayer = window.dataLayer || [];
		window.gtag =
			window.gtag ||
			function gtag() {
				window.dataLayer.push(arguments);
			};

		const gtag = window.gtag;
		const pagePath = () => `${window.location.pathname}${window.location.search}`;
		const trackPageView = () => {
			const currentLocation = String(window.location.href || '');
			if (!currentLocation) return;
			if (window.__musikiAnalyticsLastLocation === currentLocation) return;
			window.__musikiAnalyticsLastLocation = currentLocation;
			gtag('event', 'page_view', {
				page_title: document.title,
				page_location: currentLocation,
				page_path: pagePath(),
			});
		};

		if (!window.__musikiAnalyticsInitialized) {
			window.__musikiAnalyticsInitialized = true;

			if (!document.querySelector(`script[data-musiki-ga="${measurementId}"]`)) {
				const script = document.createElement('script');
				script.async = true;
				script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
				script.dataset.musikiGa = measurementId;
				document.head.appendChild(script);
			}

			gtag('js', new Date());
			gtag('config', measurementId, {
				send_page_view: false,
				anonymize_ip: true,
			});

			document.addEventListener('astro:page-load', trackPageView);
			queueMicrotask(trackPageView);
			return;
		}

		trackPageView();
	})();
</script>

<script>
	import { installLilypondPlayer } from '../lib/lilypond-player';

	class MusikiLilypond extends HTMLElement {
		async connectedCallback() {
			if (this.dataset.initialized) return;
			this.dataset.initialized = 'true';
			
			const midiUrl = this.getAttribute('data-midi-url');
			if (midiUrl) {
				try {
					await installLilypondPlayer(this, midiUrl);
				} catch (err) {
					console.warn('Failed to install Lilypond Player', err);
				}
			}
		}
	}
	
	if (!customElements.get('musiki-lilypond')) {
		customElements.define('musiki-lilypond', MusikiLilypond);
	}
</script>

<script>
	import '../scripts/media-viewer.js';
</script>
