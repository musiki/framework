---
import './recursos.css';
---
<div class="musiki-pod" data-pod="recursos" data-re-dropzone>

  <div class="re-pod">

    <!-- Drop overlay (visible on dragenter) -->
    <div class="re-drop-overlay" data-re-drop-overlay aria-hidden="true">
      <span class="re-drop-label">soltar archivos aquí</span>
    </div>

    <!-- Context menu (item / folder / root right-click) -->
    <div class="re-ctx-menu" data-re-ctx-menu hidden>
      <button type="button" class="re-ctx-item" data-re-ctx-send-to-sa hidden>Enviar a SA</button>
      <button type="button" class="re-ctx-item" data-re-ctx-send-to-vs hidden>Enviar a VS</button>
      <button type="button" class="re-ctx-item" data-re-ctx-rename>Renombrar</button>
      <button type="button" class="re-ctx-item" data-re-ctx-move>Mover a…</button>
      <button type="button" class="re-ctx-item re-ctx-item--danger" data-re-ctx-delete>Borrar</button>
    </div>

    <!-- Session context menu (root right-click) -->
    <div class="re-ctx-menu" data-re-session-ctx hidden>
      <button type="button" class="re-ctx-item" data-re-sctx-new>Nueva sesión</button>
      <button type="button" class="re-ctx-item" data-re-sctx-list>Listar sesiones</button>
      <button type="button" class="re-ctx-item re-ctx-item--danger" data-re-sctx-delete>Borrar sesión</button>
    </div>

    <!-- Sessions list modal -->
    <div class="re-sessions-modal" data-re-sessions-modal hidden>
      <div class="re-sessions-header">Sesiones</div>
      <div class="re-sessions-list" data-re-sessions-list></div>
    </div>

    <!-- Filetree (header rendered as first row by JS) -->
    <div class="re-content" data-re-content></div>

    <!-- Bottom bar — teacher-only, hidden via JS for students -->
    <div class="musiki-pod-toolbar re-bottombar" data-re-bottombar>
      <button type="button" class="musiki-pod-btn re-bb-btn" data-re-fold title="Plegar/desplegar todo">⊟</button>
      <button type="button" class="musiki-pod-btn re-bb-btn" data-re-new-folder title="Nueva carpeta">+</button>
      <button type="button" class="musiki-pod-btn re-bb-btn" data-re-paste title="Pegar clipboard">⎘</button>
      <div style="flex:1;"></div>
      <button
        type="button"
        class="musiki-pod-btn re-bb-btn re-collab-btn"
        data-re-collab
        data-active="false"
        title="Permitir a estudiantes agregar recursos (desactivado)"
        style="display:none;"
      >
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" width="13" height="13" aria-hidden="true">
          <path d="M5.5 5.5a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5ZM1.5 14.5c0-2 1.5-3.5 3.5-3.5h1c2 0 3.5 1.5 3.5 3.5M10.5 5.5a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z"/>
        </svg>
      </button>
    </div>

  </div>
</div>
