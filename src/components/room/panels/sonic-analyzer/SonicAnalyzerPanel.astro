const getSaInfoLang = (): SaInfoLang => {
  try {
    return window.localStorage.getItem('musiki-sa-info-lang') === 'en' ? 'en' : 'es';
  } catch {
    return 'es';
  }
};

const setSaInfoLang = (lang: SaInfoLang) => {
  try {
    window.localStorage.setItem('musiki-sa-info-lang', lang);
  } catch {
    // Local storage can be unavailable in restricted contexts.
  }
};

const renderSaInfoModal = (modal: HTMLElement) => {
  const lang: SaInfoLang = modal.dataset.lang === 'en' ? 'en' : 'es';
  const data = SA_INFO_CONTENT[lang];
  const title = modal.querySelector<HTMLElement>('[data-sa-info-title]');
  const sub = modal.querySelector<HTMLElement>('[data-sa-info-sub]');
  const intro = modal.querySelector<HTMLElement>('[data-sa-info-intro]');
  const content = modal.querySelector<HTMLElement>('[data-sa-info-content]');
  if (!content) return;
  if (title) title.textContent = data.title;
  if (sub) sub.textContent = data.sub;
  if (intro) intro.innerHTML = data.intro;
  modal.querySelectorAll<HTMLButtonElement>('[data-sa-info-lang]').forEach((button) => {
    const active = button.dataset.saInfoLang === lang;
    button.dataset.active = active ? 'true' : 'false';
    button.setAttribute('aria-pressed', active ? 'true' : 'false');
  });
  content.innerHTML = [
    ...data.sections.map((section) => `
      <div class="sa-info-section">
        <div class="sa-info-heading">${section.heading}</div>
        <div class="sa-info-doc">
          ${section.items.map((item) => `
            <article class="sa-info-descriptor">
              <h3>${item.title}</h3>
              <div class="sa-info-steps">
                ${item.steps.map((step) => `
                  <section class="sa-info-step">
                    <h4>${step.label}</h4>
                    <p>${step.body}</p>
                  </section>
                `).join('')}
              </div>
            </article>
          `).join('')}
        </div>
      </div>
    `),
    `
      <div class="sa-info-section sa-info-refs">
        <div class="sa-info-heading">${data.refsHeading}</div>
        ${data.refs.map((ref) => `<div class="sa-info-ref">${ref}</div>`).join('')}
      </div>
    `,
  ].join('');
};

const closeSaInfoModal = (modal: HTMLElement) => {
  modal.hidden = true;
  modal.dataset.open = 'false';
  document.documentElement.dataset.saInfoOpen = 'false';
};

document.addEventListener('click', (e) => {
  const target = e.target as HTMLElement | null;
  const infoBtn = target?.closest<HTMLElement>('[data-sa-info]');
  if (infoBtn) {
    const pod = infoBtn.closest('.sa-pod');
    const existingId = infoBtn.dataset.saInfoModalId;
    const modal = (existingId ? document.getElementById(existingId) as HTMLElement | null : null)
      ?? pod?.querySelector<HTMLElement>('[data-sa-info-modal]');
    if (!modal) return;
    if (!modal.id) modal.id = `sa-info-modal-${crypto.randomUUID()}`;
    infoBtn.dataset.saInfoModalId = modal.id;
    if (modal.parentElement !== document.body) document.body.appendChild(modal);
    modal.dataset.lang = getSaInfoLang();
    renderSaInfoModal(modal);
    modal.hidden = false;
    modal.dataset.open = 'true';
    document.documentElement.dataset.saInfoOpen = 'true';
    return;
  }

  const langBtn = target?.closest<HTMLButtonElement>('[data-sa-info-lang]');
  if (langBtn) {
    const modal = langBtn.closest<HTMLElement>('[data-sa-info-modal]');
    const lang = langBtn.dataset.saInfoLang === 'en' ? 'en' : 'es';
    if (modal) {
      modal.dataset.lang = lang;
      setSaInfoLang(lang);
      renderSaInfoModal(modal);
    }
    return;
  }

  const closeBtn = target?.closest<HTMLElement>('[data-sa-info-close]');
  if (closeBtn) {
    const modal = closeBtn.closest<HTMLElement>('[data-sa-info-modal]');
    if (modal) closeSaInfoModal(modal);
    return;
  }

  const modal = target?.closest<HTMLElement>('[data-sa-info-modal]');
  if (modal && e.target === modal) closeSaInfoModal(modal);
});

document.addEventListener('keydown', (e) => {
  if (e.key !== 'Escape') return;
  document
    .querySelectorAll<HTMLElement>('[data-sa-info-modal][data-open="true"]')
    .forEach(closeSaInfoModal);
});
</script>
