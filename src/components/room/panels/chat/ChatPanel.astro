    padding: 4px 0;
  }
  :global(.mention-suggestion-item) {
    padding: 6px 12px;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background 0.15s ease;
  }
  :global(.mention-suggestion-item:hover), :global(.mention-suggestion-item[data-selected="true"]) {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  :global(.mention-suggestion-role) {
    font-size: 0.6rem;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .conference-chat-recipient-select {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.7rem;
    padding: 2px 4px;
    border-radius: 4px;
    max-width: 100px;
    cursor: pointer;
    transition: all 0.15s ease;
    align-self: center;
