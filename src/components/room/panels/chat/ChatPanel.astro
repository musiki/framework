  }
  .conference-chat-recipient-select:focus {
    outline: none;
    border-color: var(--conference-accent, #2a87ff);
    color: #fff;
  }

  /* Mention and Private Message highlighting in chat items */
  :global(.conference-chat-list .conference-chat-item[data-is-mention="true"]) {
    background: rgba(234, 179, 8, 0.08) !important;
    border-left: 3px solid #eab308 !important;
  }
  :global(.conference-chat-list .conference-chat-item[data-is-private="true"]) {
    background: rgba(168, 85, 247, 0.08) !important;
    border-left: 3px solid #a855f7 !important;
  }
  :global(.chat-private-badge) {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #a855f7;
    margin-right: 6px;
    background: rgba(168, 85, 247, 0.15);
    padding: 1px 4px;
    border-radius: 3px;
  }
  :global(.chat-mention-badge) {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #eab308;
    margin-right: 6px;
    background: rgba(234, 179, 8, 0.15);
    padding: 1px 4px;
    border-radius: 3px;
  }
</style>
