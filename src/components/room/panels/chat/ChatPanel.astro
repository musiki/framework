    color: var(--conference-accent, #2a87ff);
  }
  .conference-reply-preview-text {
    opacity: 0.6;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .conference-reply-preview-close {
    background: transparent;
    border: none;
    color: #fff;
    cursor: pointer;
    font-size: 0.75rem;
    opacity: 0.6;
    padding: 2px 6px;
    transition: opacity 0.15s ease;
  }
  .conference-reply-preview-close:hover {
    opacity: 1;
  }

  :global(.chat-header-reply-btn) {
    background: transparent;
    border: none;
    color: var(--conference-accent, #2a87ff);
    cursor: pointer;
    font-size: 0.75rem;
    padding: 0 4px;
    margin-left: 6px;
    opacity: 0;
    transition: opacity 120ms, transform 120ms;
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
  }
  :global(.conference-chat-item:hover .chat-header-reply-btn) {
    opacity: 0.45;
  }
  :global(.chat-header-reply-btn:hover) {
    opacity: 1 !important;
    transform: scale(1.15);
  }

  /* Chat Hover Action Buttons & Tooltip styling */
  :global(.conference-chat-item .chat-item-actions) {
    position: absolute;
    right: 8px;
    top: 4px;
    display: none;
    gap: 4px;
    background: rgba(20, 20, 25, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2px 4px;
    z-index: 10;
  }
  :global(.conference-chat-item:hover .chat-item-actions) {
    display: flex;
  }
  :global(.chat-action-btn) {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    padding: 2px 4px;
    font-size: 0.7rem;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.1s ease;
  }
  :global(.chat-action-btn:hover) {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .conference-mention-suggestions {
