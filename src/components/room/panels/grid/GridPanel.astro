<div class="musiki-pod" data-pod="grid-videos" data-pod-title="GRID">
  <div class="conference-stage-panel conference-stage-panel--grid">
    <div class="conference-slot conference-slot--grid" data-slot="grid" data-empty-label="Participants grid"></div>
  </div>
</div>

<div class="musiki-pod" data-pod="roster" data-pod-title="ROSTER">
  <div class="conference-sidebar-panel-body">
    <div class="conference-roster-popup-head conference-roster-pod-head">
      <span class="conference-roster-popup-title">Participantes</span>
      <button
        type="button"
        class="conference-layout-button conference-kick-button"
        data-action="session-kick-toggle"
        data-tooltip="Modo expulsar Ctrl + K"
        aria-label="Expulsar participantes"
        hidden>K</button>
    </div>
    <div class="conference-roster-scroll" style="height: 100%; overflow-y: auto;">
      <ul class="conference-roster" data-participant-list>
        <li class="conference-roster-empty">Todavia no hay participantes en la sala.</li>
      </ul>
    </div>
  </div>
  <!-- Hidden students slot to satisfy legacy selectors if needed -->
  <div class="conference-slot" data-slot="students" style="display:none !important" aria-hidden="true"></div>
</div>

<style>
  .musiki-pod[data-pod="grid-videos"],
  .musiki-pod[data-pod="roster"] {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #000;
  }
  
  .conference-roster {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .conference-roster-pod-head {
    padding: 0.65rem 0.75rem 0.35rem;
    border-bottom: 1px solid var(--conference-line-soft);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
</style>
