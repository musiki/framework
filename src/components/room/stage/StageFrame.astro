---
import './stage-frame.css';
import StageOverlays from '../overlays/StageOverlays.astro';
import PodTemplates from '../workspace/PodTemplates.astro';

type Props = {
  defaultLayout?: 'grid' | 'teacher' | 'presentation' | 'screenshare' | 'whiteboard' | 'concept' | 'lilypond';
  presentationOptions?: any[];
};

const { defaultLayout = 'presentation', presentationOptions = [] } = Astro.props as Props;
---

<section class="conference-stage-frame">
  <div class="conference-br-countdown" data-br-countdown hidden>
    <span class="conference-br-countdown-label">Volviendo a sala principal en</span>
    <span class="conference-br-countdown-secs" data-br-countdown-text></span>
  </div>

  <div id="musiki-workspace-root" class="dockview-theme-dark" data-workspace-root data-stage>
    <!-- Dockview will inject its grid here -->
  </div>

  <PodTemplates presentationOptions={presentationOptions} />
</section>

<style>
  #musiki-workspace-root {
    width: 100%;
    height: 100%;
    flex: 1;
    background: #000;
  }
  
  .conference-stage-frame {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
</style>
