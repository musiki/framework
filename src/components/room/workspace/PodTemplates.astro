---
import GraphPod from './GraphPod.astro';
import ChatPanel from '../panels/chat/ChatPanel.astro';
import OrfPanel from '../panels/orf/OrfPanel.astro';
import NotesPanel from '../panels/notes/NotesPanel.astro';
import ClasePanel from '../panels/clase/ClasePanel.astro';

type Props = {
  presentationOptions?: any[];
};

const { presentationOptions = [] } = Astro.props;
---

<div id="musiki-pod-templates" hidden aria-hidden="true" style="display: none;">
  <!-- Data storage to avoid breaking the main div tag with huge attributes -->
  <script id="musiki-presentation-data" type="application/json" set:html={JSON.stringify(presentationOptions)}></script>

  <!-- CLASE -->
  <ClasePanel />

  <!-- NOTAS -->
  <NotesPanel />

  <!-- ORF -->
  <OrfPanel />

  <!-- GRID -->
  <div class="musiki-pod" data-pod="grid-videos" data-pod-title="GRID">
    <section class="conference-stage-panel conference-stage-panel--grid" data-panel="grid">
      <div class="conference-slot conference-slot--grid" data-slot="grid" data-empty-label="Participants grid"></div>
    </section>
  </div>

  <!-- ROSTER -->
  <div class="musiki-pod" data-pod="roster" data-pod-title="ROSTER">
    <div class="conference-sidebar-panel-body">
      <div class="conference-roster-scroll" style="height: 100%; overflow-y: auto;">
        <ul class="conference-roster" data-participant-list></ul>
      </div>
    </div>
    <div class="conference-slot" data-slot="students" style="display:none !important" aria-hidden="true"></div>
  </div>

  <!-- CHAT -->
  <ChatPanel />

  <GraphPod />

  <!-- Pr: PRESENTACIÓN -->
  <div class="musiki-pod" data-pod="presentation" data-pod-title="PRESENTACIÓN">
    <section class="conference-stage-panel conference-stage-panel--presentation" data-panel="presentation">
      <div class="conference-presentation" style="flex: 1;">
        <iframe title="Presentation stage" data-presentation-frame hidden loading="lazy" allowfullscreen></iframe>
        <div class="conference-empty conference-empty--presentation" data-presentation-placeholder>
          Seleccioná una lección para cargar Reveal.
        </div>
      </div>
      <div class="musiki-pod-toolbar" data-teacher-only style="margin-top: auto;">
        <select
          name="presentation"
          class="musiki-pod-input"
          data-presentation-select
        >
          <option value="">Cerrar diapositivas</option>
          {presentationOptions.map((opt: any) => (
            <option value={opt.value} data-course-id={opt.courseId} data-lesson-id={opt.lessonId}>
              {opt.label}
            </option>
          ))}
        </select>
      </div>
    </section>
  </div>

  <!-- Lc: LILYPOND CODE -->
  <div class="musiki-pod" data-pod="lily-code" data-pod-title="LILYCODE">
    <section class="conference-stage-panel conference-stage-panel--lilypond" data-panel="lily-code">
      <div class="conference-lilypond-editor" style="padding-top: 0; height: 100%;">
        <form class="conference-lilypond-form" data-lilypond-form autocomplete="off" style="height: 100%; display: flex; flex-direction: column;">
          <textarea class="conference-lilypond-source editor-textarea" data-lilypond-body placeholder="Escribe markdown, ```mermaid o ```lilypond…" style="flex: 1; min-height: 0;"></textarea>
          <div class="musiki-pod-toolbar" data-lilypond-toolbar style="flex-shrink: 0;">
            <div class="conference-lilypond-file-manager">
              <div class="conference-lilypond-combobox" data-lilypond-combobox>
                <input type="text" class="conference-lilypond-combobox-input" data-lilypond-combobox-input placeholder="Archivo…" autocomplete="off" />
                <ul class="conference-lilypond-combobox-menu" data-lilypond-combobox-menu hidden></ul>
              </div>
            </div>
            <div class="conference-lilypond-actions" data-lilypond-actions>
              <button type="button" class="musiki-pod-btn conference-lilypond-action" data-lilypond-new title="Nuevo">N</button>
              <button type="button" class="musiki-pod-btn musiki-pod-btn--accent conference-lilypond-action conference-lilypond-action--accent" data-lilypond-save title="Render">R</button>
              <button type="button" class="musiki-pod-btn conference-lilypond-action" data-lilypond-btn-save title="Guardar">S</button>
              <button type="button" class="musiki-pod-btn musiki-pod-btn--danger conference-lilypond-action conference-lilypond-action--danger" data-lilypond-btn-erase title="Borrar">D</button>
            </div>
          </div>
        </form>
      </div>
    </section>
  </div>

  <!-- Lr: LILYPOND RENDER -->
  <div class="musiki-pod" data-pod="lily-render" data-pod-title="LILY-RENDER">
    <section class="conference-stage-panel conference-stage-panel--lilypond" data-panel="lily-render">
      <div class="conference-lilypond-preview" style="height: 100%; display: flex; flex-direction: column;">
        <div class="conference-lilypond-render-target" data-lilypond-preview style="flex: 1; min-height: 0;"></div>
        <div class="conference-empty conference-empty--lilypond" data-lilypond-placeholder aria-hidden="true"></div>
        <div class="musiki-pod-toolbar" data-lily-render-toolbar style="flex-shrink: 0; justify-content: flex-end; gap: 4px;">
           <div class="conference-lilypond-zoom-tools" data-lilypond-zoom-tools style="display: flex; gap: 4px;">
              <button type="button" class="musiki-pod-btn" data-lilypond-zoom-out title="Zoom out">-</button>
              <button type="button" class="musiki-pod-btn" data-lilypond-zoom-reset title="Reset zoom">1:1</button>
              <button type="button" class="musiki-pod-btn" data-lilypond-zoom-in title="Zoom in">+</button>
           </div>
           <button type="button" class="musiki-pod-btn" data-lilypond-btn-pdf title="Descargar PDF">PDF</button>
        </div>
      </div>
    </section>
  </div>

  <!-- Sp: SPEAKER -->
  <div class="musiki-pod" data-pod="teacher" data-pod-title="SPEAKER">
    <section class="conference-stage-panel conference-stage-panel--focus" data-panel="teacher">
      <div class="conference-slot conference-slot--focus" data-slot="teacher" data-empty-label="Speaker camera"></div>
      <div class="conference-test-vumeter" data-test-vumeter hidden></div>
      <div class="conference-test-timer" data-test-timer hidden>0s</div>
    </section>
  </div>

  <!-- Sc: SCREENSHARE -->
  <div class="musiki-pod" data-pod="screen" data-pod-title="SCREEN">
    <section class="conference-stage-panel conference-stage-panel--screen" data-panel="screen">
      <div class="conference-slot conference-slot--screen" data-slot="screen" data-empty-label="Screen share"></div>
    </section>
  </div>

  <!-- Hp: HYPERPIANO -->
  <div class="musiki-pod" data-pod="hyperpiano" data-pod-title="HYPERPIANO">
    <section class="conference-stage-panel conference-stage-panel--hyperpiano" data-panel="hyperpiano">
      <div class="hyperpiano-shell">
        <div class="piano piano--upper"></div>
        <div class="piano piano--lower"></div>
        <div class="hyperpiano-reverb-indicator"><div class="fill"></div></div>
        <div class="hyperpiano-vu-meter"><div class="fill"></div></div>
        <div class="hyperpiano-status">Initializing...</div>
      </div>
    </section>
  </div>

  <!-- Fo: FORO -->
  <div class="musiki-pod" data-pod="forum" data-pod-title="FORO">
    <section class="conference-stage-panel" data-panel="forum">
       <div class="conference-forum-shell" style="position: relative; height: 100%; display: flex; flex-direction: column;">
          <div class="forum-frame-container" style="flex: 1; min-height: 0;">
             <iframe class="forum-frame" data-forum-frame hidden loading="lazy" style="width: 100%; height: 100%; border: none;"></iframe>
             <div class="conference-empty" data-forum-placeholder>
                Cargando foro del curso…
             </div>
          </div>
          <div class="musiki-pod-toolbar">
             <button type="button" class="musiki-pod-btn" data-forum-action="home" title="Inicio del foro">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
             </button>
             <div style="flex: 1;"></div>
             <small style="font-size: 0.6rem; opacity: 0.5; text-transform: uppercase; letter-spacing: 0.05em;">Foro del Curso</small>
          </div>
       </div>
    </section>
  </div>

  <!-- Pi: PIZARRA -->
  <div class="musiki-pod" data-pod="whiteboard" data-pod-title="PIZARRA">
    <section class="conference-stage-panel conference-stage-panel--whiteboard" data-panel="whiteboard">
      <div class="conference-whiteboard-container">
        <div class="musiki-pod-toolbar musiki-pod-toolbar--top" data-whiteboard-toolbar>
           <div class="whiteboard-group">
             <button type="button" class="musiki-pod-btn" data-whiteboard-bg-btn="none" title="Blanco">◻</button>
             <button type="button" class="musiki-pod-btn" data-whiteboard-bg-btn="staff" title="Pentagrama">≣</button>
             <button type="button" class="musiki-pod-btn" data-whiteboard-bg-btn="grid" title="Grilla">▦</button>
           </div>
           <div class="whiteboard-divider"></div>
           <div class="whiteboard-group">
             <button type="button" class="musiki-pod-btn" data-whiteboard-tool="draw" title="Lápiz" data-active="true">✎</button>
             <button type="button" class="musiki-pod-btn" data-whiteboard-tool="text-sm" title="Texto Chico">T</button>
             <button type="button" class="musiki-pod-btn" data-whiteboard-tool="text-lg" title="Texto Grande" style="font-size:1.1rem">T</button>
             <button type="button" class="musiki-pod-btn" data-whiteboard-snap-btn title="Snap to Grid">S</button>
           </div>
           <div class="whiteboard-divider"></div>
           <div class="whiteboard-group whiteboard-colors">
              <button type="button" class="color-dot" style="background:#ffffff" data-whiteboard-color="#ffffff" data-active="true"></button>
              <button type="button" class="color-dot" style="background:#ff4d4d" data-whiteboard-color="#ff4d4d"></button>
              <button type="button" class="color-dot" style="background:#4dff88" data-whiteboard-color="#4dff88"></button>
              <button type="button" class="color-dot" style="background:#4da6ff" data-whiteboard-color="#4da6ff"></button>
              <button type="button" class="color-dot" style="background:#fbbf24" data-whiteboard-color="#fbbf24"></button>
           </div>
           <div style="flex: 1;"></div>
           <button type="button" class="musiki-pod-btn musiki-pod-btn--danger" data-action="whiteboard-clear" title="Limpiar">L</button>
        </div>
        <div class="whiteboard-canvas-shell" style="flex: 1; position: relative; min-height: 0;">
          <canvas class="conference-whiteboard-bg" data-whiteboard-bg-canvas></canvas>
          <canvas class="conference-whiteboard-canvas" data-whiteboard-canvas></canvas>
        </div>
      </div>
    </section>
  </div>

  <!-- Co: CONCEPTOS -->
  <div class="musiki-pod" data-pod="concept" data-pod-title="CONCEPTOS">
    <section class="conference-stage-panel" data-panel="concept">
       <div class="conference-concepts-shell" data-concepts-shell style="position: relative; height: 100%; display: flex; flex-direction: column;">
          <div class="concept-content-container" style="flex: 1; min-height: 0; overflow-y: auto;">
             <div class="concept-content prose" data-concept-content style="padding: 1.5rem; color: var(--conference-fg);">
                <p class="concept-placeholder" data-concept-placeholder>
                   Buscar conceptos en el menú inferior.
                </p>
             </div>
             <iframe class="concept-reveal-frame" data-concept-presentation-frame hidden loading="lazy" allowfullscreen style="width: 100%; height: 100%; border: none;"></iframe>
          </div>
          <div class="musiki-pod-toolbar">
            <input
              type="text"
              class="musiki-pod-input"
              placeholder="Buscar concepto..."
              data-concept-search
              autocomplete="off"
            />
            <div class="musiki-pod-toolbar-actions" style="display: flex; gap: 0.3rem;">
               <button type="button" class="musiki-pod-btn" data-concept-action="zoom-out" title="Disminuir letra">
                 <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
               </button>
               <button type="button" class="musiki-pod-btn" data-concept-action="zoom-reset" title="Restablecer tamaño (1:1)">
                 1:1
               </button>
               <button type="button" class="musiki-pod-btn" data-concept-action="zoom-in" title="Aumentar letra">
                 <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
               </button>
               <button type="button" class="musiki-pod-btn" data-concept-action="toggle-reveal" title="Vista presentación" hidden>
                 <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
               </button>
            </div>
            <div class="musiki-pod-results" data-concept-results hidden></div>
          </div>
       </div>
    </section>
  </div>

  <!-- Me: MEDIA -->
  <div class="musiki-pod" data-pod="external-media" data-pod-title="MEDIA">
    <section class="conference-stage-panel" data-panel="external-media" style="display: flex; flex-direction: column; height: 100%;">
      <div class="conference-external-media-body" style="flex: 1; position: relative; overflow: hidden;">
        <div class="conference-external-media-player" data-external-media-player-host></div>
        <div class="conference-external-media-empty" data-external-media-empty>
          <p style="color: var(--conference-dim); font-size: 0.7rem; text-align: center; margin-top: 2rem;">SIN CONTENIDO</p>
        </div>
      </div>
      <div class="musiki-pod-toolbar">
        <input
          type="search"
          name="musiki-external-media-search"
          class="musiki-pod-input"
          placeholder="YouTube URL o búsqueda"
          data-external-media-input
          autocomplete="off"
          aria-autocomplete="none"
          autocapitalize="none"
          autocorrect="off"
          data-1p-ignore="true"
          data-bwignore="true"
          data-form-type="other"
          data-lpignore="true"
          spellcheck="false"
          inputmode="search"
          enterkeyhint="search"
          style="flex: 1; min-width: 0;"
        />
        <button type="button" class="musiki-pod-btn" data-action="external-media-open">O</button>
        <button type="button" class="musiki-pod-btn musiki-pod-btn--danger" data-action="external-media-stop">C</button>
        <div class="musiki-pod-results" data-external-media-results hidden></div>
        <div class="musiki-pod-status" data-external-media-status role="status" aria-live="polite"></div>
      </div>
    </section>
  </div>
  <!-- IS: INSTANT SCORE -->
  <div class="musiki-pod" data-pod="instant-score" data-pod-title="SCORE">
    <div class="instant-score-container" data-instant-score-content></div>
  </div>
</div>

<style is:global>
  .instant-score-container {
    width: 100%;
    height: 100%;
    background: #eed;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .musiki-pod {
    height: 100%;
    width: 100%;
    overflow: hidden;
    background: #000;
    color: var(--conference-fg);
    position: relative;
    display: flex;
    flex-direction: column;
  }
  
  .musiki-pod > section,
  .musiki-pod > div,
  .musiki-pod .conference-stage-panel,
  .musiki-pod .conference-presentation,
  .musiki-pod .conference-whiteboard-container,
  .musiki-pod .conference-external-media-body,
  .musiki-pod .conference-forum-shell {
    height: 100% !important;
    width: 100% !important;
    position: relative !important;
    display: flex !important;
    flex-direction: column !important;
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
    border: none !important;
    background: transparent !important;
    inset: 0 !important;
    min-width: 0;
    flex: 1;
  }

  .musiki-pod .conference-external-media-player {
    position: relative !important;
    inset: unset !important;
    flex: 1 !important;
    min-height: 0 !important;
    width: 100% !important;
    height: auto !important;
  }

  .musiki-pod video {
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }

  .musiki-pod .conference-slot {
    height: 100% !important;
    width: 100% !important;
    position: relative !important;
    background: transparent !important;
    min-height: 0;
    min-width: 0;
    flex: 1;
  }

  .conference-whiteboard-container {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #000;
  }

  .musiki-pod-toolbar--top {
    border-top: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .whiteboard-group {
    display: flex;
    gap: 0.25rem;
    align-items: center;
  }

  .whiteboard-divider {
    width: 1px;
    height: 1rem;
    background: rgba(255, 255, 255, 0.1);
    margin: 0 0.4rem;
  }

  .whiteboard-colors {
    gap: 0.5rem;
    padding: 0 0.4rem;
  }

  .color-dot {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    cursor: pointer;
    transition: transform 0.1s ease, border-color 0.1s ease;
    padding: 0;
  }

  .color-dot:hover {
    transform: scale(1.2);
    border-color: #fff;
  }

  .color-dot[data-active="true"] {
    transform: scale(1.3);
    border-color: #fff;
    box-shadow: 0 0 8px currentColor;
  }

  .conference-whiteboard-canvas,
  .conference-whiteboard-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  .conference-whiteboard-canvas {
    z-index: 2;
  }

  .conference-whiteboard-bg {
    z-index: 1;
  }

  .musiki-pod-toolbar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.5rem;
    background: rgba(10, 10, 12, 0.96);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px);
    z-index: 500;
    min-height: 2.4rem;
    position: relative;
  }

  .musiki-pod-toolbar--floating {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: rgba(0, 0, 0, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.5rem;
    display: flex;
    flex-direction: column;
    padding: 0.45rem;
    width: auto;
    z-index: 1000;
    gap: 0.6rem;
  }

  .musiki-pod-btn {
    min-width: 1.6rem;
    height: 1.6rem;
    padding: 0 0.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.25rem;
    color: var(--conference-muted);
    font-size: 0.7rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.14s ease;
    text-transform: uppercase;
  }

  .musiki-pod-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .musiki-pod-btn--accent { border-color: rgba(35, 55, 255, 0.6); color: #76d3ff; }
  .musiki-pod-btn--danger { color: #ff4d4d; border-color: rgba(255, 77, 77, 0.3); }

  .musiki-pod-input {
    flex: 1;
    min-width: 0;
    height: 1.6rem;
    padding: 0 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.04);
    color: #f8fafc;
    font-size: 0.8rem;
    outline: none;
  }

  .musiki-pod-results {
    position: absolute;
    bottom: calc(100% + 4px);
    left: 0.5rem;
    right: 0.5rem;
    background: rgba(10, 10, 15, 0.98);
    border: 1px solid var(--conference-line);
    border-radius: 0.5rem;
    max-height: 280px;
    overflow-y: auto;
    z-index: 2000;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    padding: 0.35rem;
  }

  .musiki-pod-results[hidden] {
    display: none !important;
  }

  .musiki-pod-results button:not(.conference-external-media-result),
  .musiki-pod-result-item,
  .conference-break-rooms-item {
    width: 100%;
    padding: 0.5rem 0.7rem;
    background: transparent;
    border: none;
    border-radius: 0.25rem;
    color: #94a3b8;
    font-size: 0.75rem;
    text-align: left;
    cursor: pointer;
    transition: all 0.1s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }

  .musiki-pod-results button:hover,
  .musiki-pod-result-item:hover,
  .conference-break-rooms-item:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  /* Specific override for external media results to ensure grid works */
  .musiki-pod-results .conference-external-media-result {
    padding: 0.25rem;
    margin-bottom: 2px;
    border-radius: 0.25rem;
  }

  /* Mendeleev Aesthetics - Periodic Table Style */
  .pod-gallery-grid {
    display: flex;
    flex-wrap: wrap; 
    gap: 0.6rem;
    padding: 1rem 0.5rem;
    justify-content: flex-start;
  }

  .pod-gallery-item {
    width: 72px; 
    height: 72px;
    aspect-ratio: 1 / 1;
    background: rgba(255, 255, 255, 0.04) !important;
    border: 1px solid color-mix(in srgb, var(--pod-color) 80%, white);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 5px color-mix(in srgb, var(--pod-color) 40%, transparent);
  }

  .pod-gallery-item:hover {
    background: rgba(255, 255, 255, 0.08) !important;
    border-color: #fff;
    box-shadow: 0 0 12px var(--pod-color), inset 0 0 4px var(--pod-color);
    transform: scale(1.05);
    z-index: 10;
  }

  .pod-gallery-item-icon {
