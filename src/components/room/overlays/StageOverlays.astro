---
---

<div class="conference-recording-guide" data-recording-guide aria-hidden="true"></div>
<div class="conference-reactions-layer" data-reactions-layer aria-hidden="true"></div>
<section class="conference-external-media-shell" data-external-media-stage hidden>
  <div class="conference-external-media-chrome">
    <div class="conference-external-media-meta">
      <span class="conference-external-media-kicker" data-external-media-provider-label>External Media</span>
      <strong class="conference-external-media-title" data-external-media-title>External Media Session</strong>
    </div>
    <div class="conference-external-media-actions">
      <button
        type="button"
        class="conference-layout-button conference-external-media-action"
        data-action="external-media-play-toggle"
        title="Play / Pause"
        aria-label="Play / Pause"
      >P</button>
      <button
        type="button"
        class="conference-layout-button conference-external-media-action"
        data-action="external-media-close"
        title="Cerrar media externa"
        aria-label="Cerrar media externa"
      >C</button>
    </div>
  </div>
  <div class="conference-external-media-body">
    <div class="conference-external-media-player" data-external-media-player-host></div>
    <div class="conference-empty conference-empty--presentation conference-external-media-empty" data-external-media-empty hidden>
      Pega un link de YouTube para abrir una sesión externa sincronizada.
    </div>
  </div>
</section>
<canvas class="conference-gravity-ball-overlay" data-gravity-ball-canvas aria-hidden="true"></canvas>
<canvas class="conference-hand-overlay conference-hand-overlay--stage" data-stage-hand-overlay aria-hidden="true"></canvas>

<!-- Floating Speaker Circle (always on top of mosaic) -->
<div class="conference-speaker-circle-wrap" data-floating-circle hidden>
  <div class="conference-slot conference-slot--circle" data-slot="circle"></div>
</div>

<style is:global>
  .conference-speaker-circle-wrap {
    position: fixed;
    top: var(--conference-circle-y, 5rem);
    right: var(--conference-circle-x, 2rem);
    width: var(--conference-circle-size, 180px);
    height: var(--conference-circle-size, 180px);
    z-index: 30000;
    pointer-events: none;
    transition: width 0.2s ease, height 0.2s ease;
    display: none;
  }
  
  /* Show only when data-show-circle is true on root */
  :global([data-show-circle="true"]) .conference-speaker-circle-wrap {
    display: block;
  }
  
  @media (max-width: 500px) {
    .conference-speaker-circle-wrap {
      --conference-circle-size: calc(var(--conference-circle-base-size, 180px) * 0.5);
    }
  }
  
  .conference-speaker-circle-wrap .conference-slot--circle {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    /* border: 3px solid var(--conference-accent-hi, #76d3ff); */ /* Border removed as requested */
    box-shadow: 0 8px 32px rgba(0,0,0,0.8);
    pointer-events: auto;
    background: #000;
  }
</style>
