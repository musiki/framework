---

<details class="conference-sidebar-section conference-sidebar-section--instrument" open>
  <summary class="conference-sidebar-heading">GRAVITY BALL</summary>

  <div class="conference-field conference-field--checkbox conference-field--hand-controls">
    <label class="conference-checkbox-row" for="conference-gravity-ball-input">
      <input
        id="conference-gravity-ball-input"
        name="gravity-ball"
        type="checkbox"
        data-gravity-ball-input
      />
      <span>Gravity ball</span>
    </label>

    <label class="conference-checkbox-row" for="conference-gravity-ball-mirror-input">
      <input
        id="conference-gravity-ball-mirror-input"
        name="gravity-ball-mirror"
        type="checkbox"
        data-gravity-ball-mirror-input
      />
      <span>Escher mirror</span>
    </label>

    <label class="conference-ramp-row" for="conference-gravity-ball-gravity-input">
      <span>Gravity</span>
      <input
        id="conference-gravity-ball-gravity-input"
        name="gravity-ball-gravity"
        type="number"
        min="1.62"
        max="14.7"
        step="0.01"
        value="9.8"
        data-gravity-ball-gravity-input
      />
      <span>m/s²</span>
    </label>
  </div>
</details>
