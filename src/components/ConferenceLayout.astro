<script>
  import { mountLiveKitRoom } from "../scripts/room/index.ts";

  let teardown: ReturnType<typeof mountLiveKitRoom> | null = null;

  const mount = () => {
    const root = document.querySelector("[data-conference-root]");
    if (!(root instanceof HTMLElement)) return;

    if (typeof teardown === "function") {
      teardown();
      teardown = null;
    }

    try {
      teardown = mountLiveKitRoom(root);
      window.dispatchEvent(new CustomEvent('musiki:workspace:changed'));
    } catch (error) {
      console.error("Conference room mount failed:", error);
      root.dataset.mounted = "false";
      const status = root.querySelector("[data-room-status]");
      if (status instanceof HTMLElement) {
        status.textContent =
          error instanceof Error
            ? error.message
            : "No fue posible iniciar la sala.";
      }
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", mount, { once: true });
  } else {
    mount();
  }

  document.addEventListener("astro:page-load", mount);
  window.addEventListener("pagehide", () => {
    if (typeof teardown === "function") teardown();
    teardown = null;
  });
</script>

<script>
  // ── Invite role switch (Externos / Estudiantes) ──────────────────────
  function initInviteSwitch() {
    const toggle = document.querySelector("[data-invite-role-toggle]");
    if (!(toggle instanceof HTMLInputElement)) return;

    const panelExternal = document.querySelector(
      '[data-invite-panel="external"]',
    );
    const panelStudent = document.querySelector(
      '[data-invite-panel="student"]',
    );
    const labelExternal = document.querySelector("[data-role-label-external]");
    const labelStudent = document.querySelector("[data-role-label-student]");

    const updateSwitch = () => {
      const isStudent = toggle.checked;
      panelExternal?.classList.toggle(
        "conference-room-invite-controls--hidden",
        isStudent,
      );
      panelStudent?.classList.toggle(
        "conference-room-invite-controls--hidden",
        !isStudent,
      );
      labelExternal?.classList.toggle("active", !isStudent);
      labelStudent?.classList.toggle("active", isStudent);
    };

    toggle.addEventListener("change", updateSwitch);
    updateSwitch(); // init state
  }

  // ── Session Stats: CPU (RAF) + Bandwidth (WebRTC getStats hook) ─────
  let pcInstances: RTCPeerConnection[] = [];
  let prevBytesTotal = 0;
  let prevStatsTime = 0;

  // Intercept RTCPeerConnection to track all instances (must run before LiveKit)
  const OriginalRTCPC = window.RTCPeerConnection;
  class TrackedRTCPeerConnection extends OriginalRTCPC {
    constructor(...args: ConstructorParameters<typeof RTCPeerConnection>) {
      super(...args);
      pcInstances.push(this);
      this.addEventListener("connectionstatechange", () => {
        if (
          this.connectionState === "closed" ||
          this.connectionState === "failed"
        ) {
          pcInstances = pcInstances.filter((pc) => pc !== this);
        }
      });
    }
  }
  // @ts-ignore
  window.RTCPeerConnection = TrackedRTCPeerConnection;

  // CPU via RAF timing (measures main-thread lag)
  let rafFrameTimes: number[] = [];
  let lastRafTime = performance.now();
  const rafLoop = (now: number) => {
    const delta = now - lastRafTime;
    lastRafTime = now;
    if (delta > 0 && delta < 500) rafFrameTimes.push(delta);
    if (rafFrameTimes.length > 60) rafFrameTimes.shift();
    requestAnimationFrame(rafLoop);
  };
  requestAnimationFrame(rafLoop);

  const estimateCpuPct = (): number => {
    if (rafFrameTimes.length < 5) return 0;
    const avg = rafFrameTimes.reduce((a, b) => a + b, 0) / rafFrameTimes.length;
    // At 60fps ideal = 16.67ms. Higher avg = more lag = more CPU load.
    const lag = Math.max(0, avg - 16.67);
    return Math.min(100, Math.round((lag / 150) * 100));
  };

  const getRiskLevel = (pct: number): string => {
    if (pct < 30) return "ok";
    if (pct < 60) return "warn";
    if (pct < 85) return "high";
    return "crit";
  };

  const formatBw = (bps: number): string => {
    if (bps < 1000) return `${bps}B`;
    if (bps < 1_000_000) return `${(bps / 1000).toFixed(0)}K`;
    return `${(bps / 1_000_000).toFixed(1)}M`;
  };

  const updateStats = async () => {
    const cpuEl = document.querySelector(
      "[data-stat-cpu]",
    ) as HTMLElement | null;
    const bwEl = document.querySelector("[data-stat-bw]") as HTMLElement | null;
    if (!cpuEl || !bwEl) return;

    // CPU
    const cpu = estimateCpuPct();
    cpuEl.textContent = `${cpu}%`;
    cpuEl.dataset.risk = getRiskLevel(cpu);
    cpuEl.dataset.statTooltip = `CPU\t${cpu}%\nHilo principal\testimado RAF`;

    // Bandwidth via WebRTC
    let totalBytes = 0;
    for (const pc of pcInstances) {
      try {
        const stats = await pc.getStats();
        stats.forEach((s: RTCStats) => {
          if (s.type === "outbound-rtp" || s.type === "inbound-rtp") {
            // @ts-ignore
            totalBytes += (s.bytesSent ?? 0) + (s.bytesReceived ?? 0);
          }
        });
      } catch {
        /* pc may be closed */
      }
    }

    const now = Date.now();
    const bps = prevStatsTime
      ? Math.round(
          (totalBytes - prevBytesTotal) / ((now - prevStatsTime) / 1000),
        )
      : 0;
    prevBytesTotal = totalBytes;
    prevStatsTime = now;

    if (bps >= 0) {
      const bwPct = Math.min(100, Math.round((bps / 2_000_000) * 100)); // 2Mbps = 100%
      bwEl.textContent = formatBw(bps) + "/s";
      bwEl.dataset.risk = getRiskLevel(bwPct);
      bwEl.dataset.statTooltip = `WebRTC BW\t${formatBw(bps)}/s\nTotal acum.\t${(totalBytes / 1_000_000).toFixed(1)} MB`;
    }
  };

  let statsIntervalId = 0;

  const initStats = () => {
    if (statsIntervalId) window.clearInterval(statsIntervalId);
    statsIntervalId = window.setInterval(updateStats, 2000);
    updateStats();
  };

  // ── Stat tooltip ─────────────────────────────────────────────────────────
  const initStatTooltip = () => {
    const tip = document.createElement("div");
    tip.className = "conference-stat-tooltip";
    tip.hidden = true;
    document.body.appendChild(tip);

    const accent =
      getComputedStyle(document.documentElement)
        .getPropertyValue("--conference-accent")
        .trim() || "#00ffc8";

    const showTip = (el: HTMLElement) => {
      const raw = el.dataset.statTooltip;
      if (!raw) return;
      const lines = raw.split("\n").map((line) => {
        const [label, value] = line.split("\t");
        return `<span class="cst-row"><span class="cst-label">${label ?? ""}</span><b class="cst-value">${value ?? ""}</b></span>`;
      });
      tip.innerHTML = lines.join("");
      tip.hidden = false;
      const r = el.getBoundingClientRect();
      tip.style.left = `${r.left + r.width / 2}px`;
      tip.style.top = `${r.top - 8}px`;
    };

    const hideTip = () => {
      tip.hidden = true;
    };

    document.addEventListener("mouseover", (e) => {
      const el = (e.target as Element)?.closest(
        "[data-stat-tooltip]",
      ) as HTMLElement | null;
      if (el) showTip(el);
    });
    document.addEventListener("mouseout", (e) => {
      const el = (e.target as Element)?.closest("[data-stat-tooltip]");
      if (el) hideTip();
    });
  };

  const initExtras = () => {
    initInviteSwitch();
    initStats();
    initStatTooltip();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initExtras, { once: true });
  } else {
    initExtras();
  }
  document.addEventListener("astro:page-load", initExtras);
</script>

<style>
  /*
   * Architecture: Astro scoped CSS — all selectors get a data-astro-cid-xxx
   * attribute automatically. JS-created DOM nodes lack this attribute, so they
   * must use :global() wrappers (see Chat, Notes, Roster sections below).
   *
   * Design tokens: all colors, sizes, and spacing are CSS custom properties
   * defined on .conference-shell so every descendant can reference them.
   * Token naming: --conference-<category>-<variant>
   *
   * Layout strategy: CSS Grid for the outer shell (stage | sidebar),
   * Flexbox for bars and inline controls, absolute positioning for overlays.
   *
   * Responsive: 4 breakpoints (1080 / 900landscape / 760 / 500px).
   * Prefer clamp() over redundant breakpoint overrides where possible.
   *
   * !important usage: only two legitimate cases remain —
   *   1. Overriding LiveKit SDK inline styles on <video> elements.
   *   2. Overriding :global() rules where specificity alone is insufficient.
   *      These are clearly marked; avoid adding new !important uses.
   */

  :global(body.room-page) {
    margin: 0;
    background: #000;
    color: #f5f7fb;
    height: 100vh;
    height: 100dvh;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    overscroll-behavior: none;
  }

  :global(body.room-page > main) {
    width: 100%;
    height: 100%;
    height: 100dvh;
    max-width: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  :global(body.room-page.room-page--immersive) {
    overflow: hidden;
  }

  .conference-shell {
    /* ── Layout metrics ───────────────────────────────────────────────── */
    --conference-bar-height: 42px;
    --conference-bar-stack-height: var(--conference-bar-height);
    --conference-sidebar-size: clamp(300px, 22vw, 420px);
    --conference-instruments-size: clamp(320px, 24vw, 400px);
    /* ── Typography scale ─────────────────────────────────────────────── */
    --conference-font-caption: 0.62rem; /* tiny labels, timestamps */
    --conference-font-body: 0.8rem; /* default UI text */
    --conference-font-ui: 1rem; /* action text, chat content */
    --conference-font-title: 0.82rem; /* section titles */
    /* ── Color palette ────────────────────────────────────────────────── */
    --conference-fg: #f5f7fb;
    --conference-fg-hi: var(--conference-fg-hi); /* high-emphasis text */
    --conference-muted: rgba(245, 247, 251, 0.58); /* secondary text */
    --conference-dim: rgba(245, 247, 251, 0.32); /* disabled / hint */
    --conference-line: rgba(255, 255, 255, 0.12); /* border / divider */
    --conference-line-soft: rgba(255, 255, 255, 0.06);
    --conference-accent: #2a87ff;
    --conference-fx-delay: #76d3ff;
    --conference-fx-reverb: #ffd166;
    --conference-green: #25cf6b;
    --conference-red: #ff4d4d;
    /* ── Runtime overrides (set by JS) ────────────────────────────────── */
    --conference-local-video-flip: 1;
    --conference-self-preview-zoom: 1;
    --conference-circle-preview-zoom: 1;
    /* ── Base: override global.css body clamp(1.02rem) for this shell ─── */
    font-size: var(--conference-font-body);
    line-height: 1.4;
    position: relative;
    height: 100vh;
    height: 100dvh;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--conference-sidebar-size);
    grid-template-rows: 1fr;
    background: #000;
    color: var(--conference-fg);
    overflow: hidden;
    padding-bottom: var(--conference-bar-stack-height);
  }

  .conference-shell[data-has-sidebar="false"] {
    grid-template-columns: 1fr !important;
    grid-template-rows: 1fr !important;
  }

  @media (max-width: 1080px) {
    .conference-shell {
      grid-template-columns: 1fr !important;
      grid-template-rows: 1fr var(--conference-sidebar-size) !important;
    }
  }

  @media (max-width: 760px) {
    .conference-shell {
      grid-template-columns: 1fr !important;
      grid-template-rows: 1fr !important;
    }
  }

  .conference-concepts-popup,
  .conference-external-media-popup,
  .conference-break-rooms-popup,
  .conference-invite-gate,
  .conference-status-toast,
  .conference-welcome-modal,
  .conference-setup-modal,
  .conference-recording-guide,
  .conference-reactions-layer,
  .conference-hand-overlay {
    grid-column: 1 / -1 !important;
    grid-row: 1 / -1 !important;
  }

  /* global.css resets button/input font-size to 1rem; undo that inside the shell */
  .conference-shell button,
  .conference-shell input,
  .conference-shell select,
  .conference-shell textarea {
    font-size: inherit;
    line-height: inherit;
  }

  .conference-shell[data-show-circle="false"]
    .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus {
    display: none;
  }

  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus:has(
      .conference-tile[data-show-circle="false"]
    ) {
    display: none;
  }

  .conference-shell[data-sidebar-collapsed="true"] {
    --conference-sidebar-size: 0px;
  }

  .conference-shell[data-sidebar-collapsed="true"] .conference-sidebar {
    display: none !important;
  }

  .conference-shell[data-immersive="true"] {
    position: fixed;
    inset: 0;
    width: 100vw;
    width: 100dvw;
    height: 100vh;
    height: 100dvh;
    z-index: 999;
  }

  /* ── Layout: outer shell grid (stage | sidebar) ──────────────────── */
  .conference-stage-frame,
  .conference-sidebar {
    min-width: 0;
    min-height: 0;
    height: calc(100vh - var(--conference-bar-stack-height));
    height: calc(100dvh - var(--conference-bar-stack-height));
  }

  .conference-instruments-sidebar {
    position: absolute;
    inset: 0 auto var(--conference-bar-stack-height) 0 !important;
    z-index: 18;
    width: var(--conference-instruments-size);
    min-width: 0;
    overflow: hidden;
    border-right: 1px solid var(--conference-line);
    background: rgba(0, 0, 0, 0.98);
    transform: translateX(-100%);
    transition: transform 160ms ease;
  }

  .conference-shell[data-instruments-open="true"]
    .conference-instruments-sidebar {
    transform: translateX(0);
  }

  .conference-instruments-layout {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .conference-instruments-scroll {
    flex: 1 1 0;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: rgba(0, 0, 0, 0.98);
  }

  .conference-instruments-footer {
    flex: 0 1 auto;
    min-height: 0;
    max-height: min(70%, 34rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--conference-line);
    background: rgba(0, 0, 0, 0.98);
  }

  /* ── Stage: fullscreen video canvas, absolute-positioned panels ──── */
  .conference-stage {
    position: relative;
    width: 100%;
    height: 100%;
    background: #000;
    overflow: hidden;
  }

  .conference-stage-panel {
    position: absolute;
    inset: 0;
    min-height: 0;
    min-width: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    background: transparent;
    border-right: 1px solid var(--conference-line);
    border-bottom: 1px solid var(--conference-line);
  }

  .conference-stage-panel--presentation,
  .conference-stage-panel--focus,
  .conference-stage-panel--screen,
  .conference-stage-panel--grid {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--presentation,
  .conference-stage[data-layout="presentation"] .conference-stage-panel--focus,
  .conference-stage[data-layout="teacher"] .conference-stage-panel--focus,
  .conference-stage[data-layout="screenshare"] .conference-stage-panel--screen,
  .conference-stage[data-layout="grid"] .conference-stage-panel--grid {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--presentation,
  .conference-stage[data-layout="teacher"] .conference-stage-panel--focus,
  .conference-stage[data-layout="screenshare"] .conference-stage-panel--screen,
  .conference-stage[data-layout="grid"] .conference-stage-panel--grid {
    inset: 0;
  }

  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--presentation {
    grid-template-rows: 1fr;
  }

  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--presentation
    .conference-stage-heading {
    display: none;
  }

  .conference-stage[data-layout="presentation"] .conference-stage-panel--focus {
    inset: auto 1rem 1rem auto;
    width: clamp(101px, 13vw, 158px);
    aspect-ratio: 1;
    display: block;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-right: 1px solid rgba(255, 255, 255, 0.24);
    border-bottom: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    overflow: hidden;
    z-index: 4;
    background: rgba(0, 0, 0, 0.92);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-stage-heading,
  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--screen {
    display: none;
  }

  .conference-stage[data-layout="teacher"] .conference-stage-panel--focus {
    grid-template-rows: 1fr;
  }

  .conference-stage[data-layout="teacher"]
    .conference-stage-panel--focus
    .conference-slot--focus::before {
    display: none;
  }

  .conference-stage[data-layout="teacher"]
    .conference-stage-panel--focus
    .conference-slot--focus,
  .conference-stage[data-layout="teacher"]
    .conference-stage-panel--focus
    .conference-tile,
  .conference-stage[data-layout="teacher"]
    .conference-stage-panel--focus
    .conference-tile-media,
  .conference-stage[data-layout="teacher"]
    .conference-stage-panel--focus
    .conference-media-frame {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .conference-stage[data-layout="teacher"]
    .conference-stage-panel--focus
    .conference-slot--focus {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
  }

  .conference-stage[data-layout="teacher"]
    .conference-stage-panel--focus
    .conference-slot--focus
    > .conference-tile {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .conference-stage[data-layout="teacher"]
    .conference-stage-panel--focus
    .conference-slot--focus
    > *,
  .conference-stage[data-layout="teacher"]
    .conference-stage-panel--focus
    .conference-slot--focus
    > *
    > .conference-tile-media,
  .conference-stage[data-layout="teacher"]
    .conference-stage-panel--focus
    .conference-slot--focus
    > *
    > .conference-tile-media
    > .conference-media-frame,
  .conference-stage[data-layout="teacher"]
    .conference-stage-panel--focus
    .conference-slot--focus
    > *
    > .conference-tile-media
    > .conference-media-frame
    > video {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    min-width: 0;
    min-height: 0;
  }

  .conference-stage[data-layout="teacher"]
    .conference-stage-panel--focus
    .conference-tile {
    grid-template-rows: 1fr;
    border: 0;
    background: #000;
  }

  .conference-stage[data-layout="teacher"]
    .conference-stage-panel--focus
    .conference-tile-meta {
    position: absolute;
    inset: auto 0 0 0;
    border-top: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.8) 100%
    );
  }

  .conference-stage[data-layout="screenshare"] .conference-stage-panel--screen {
    grid-template-rows: 1fr;
  }

  .conference-stage[data-layout="screenshare"]
    .conference-stage-panel--screen
    .conference-slot--screen,
  .conference-stage[data-layout="screenshare"]
    .conference-stage-panel--screen
    .conference-tile--screen,
  .conference-stage[data-layout="screenshare"]
    .conference-stage-panel--screen
    .conference-tile-media,
  .conference-stage[data-layout="screenshare"]
    .conference-stage-panel--screen
    .conference-media-frame {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .conference-stage[data-layout="screenshare"]
    .conference-stage-panel--screen
    .conference-slot--screen {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
  }

  .conference-stage[data-layout="screenshare"]
    .conference-stage-panel--screen
    .conference-slot--screen
    > .conference-tile--screen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .conference-stage[data-layout="screenshare"]
    .conference-stage-panel--screen
    .conference-slot--screen
    > *,
  .conference-stage[data-layout="screenshare"]
    .conference-stage-panel--screen
    .conference-slot--screen
    > *
    > .conference-tile-media,
  .conference-stage[data-layout="screenshare"]
    .conference-stage-panel--screen
    .conference-slot--screen
    > *
    > .conference-tile-media
    > .conference-media-frame,
  .conference-stage[data-layout="screenshare"]
    .conference-stage-panel--screen
    .conference-slot--screen
    > *
    > .conference-tile-media
    > .conference-media-frame
    > video {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    min-width: 0;
    min-height: 0;
  }

  .conference-stage[data-layout="screenshare"]
    .conference-stage-panel--screen
    .conference-tile--screen {
    grid-template-rows: 1fr;
    border: 0;
    background: #000;
  }

  .conference-stage[data-layout="screenshare"]
    .conference-stage-panel--screen
    .conference-tile-meta {
    display: none;
  }

  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-slot--focus {
    position: absolute;
    inset: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    overflow: hidden;
  }

  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-slot--focus::before {
    display: none;
  }

  .conference-stage[data-layout="teacher"]
    .conference-stage-panel--presentation,
  .conference-stage[data-layout="teacher"] .conference-stage-panel--screen,
  .conference-stage[data-layout="teacher"] .conference-stage-panel--grid,
  .conference-stage[data-layout="screenshare"]
    .conference-stage-panel--presentation,
  .conference-stage[data-layout="screenshare"] .conference-stage-panel--focus,
  .conference-stage[data-layout="screenshare"] .conference-stage-panel--grid,
  .conference-stage[data-layout="grid"] .conference-stage-panel--presentation,
  .conference-stage[data-layout="grid"] .conference-stage-panel--focus,
  .conference-stage[data-layout="grid"] .conference-stage-panel--screen {
    display: none;
  }

  .conference-stage-heading {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    padding: 3px 0.65rem;
  }

  .conference-stage-label,
  .conference-sidebar-heading {
    --conference-sidebar-strip-padding-y: 3px;
    --conference-sidebar-strip-padding-x: 0.65rem;
    --conference-sidebar-strip-height: calc(
      (0.56rem + (var(--conference-sidebar-strip-padding-y) * 2)) * 1.2
    );
    color: var(--conference-muted);
    font-size: 0.56rem;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .conference-stage-label {
    flex: 0 0 auto;
    padding: 0;
  }

  .conference-stage-heading .conference-recent-speakers {
    flex: 1 1 auto;
    min-width: 0;
    justify-content: flex-start;
    padding: 0;
    letter-spacing: 0.16em;
    opacity: 0.5;
  }

  .conference-stage-heading .conference-recent-speakers[hidden] {
    display: none;
  }

  .conference-stage[data-layout="teacher"]
    .conference-stage-panel--focus
    .conference-stage-heading,
  .conference-stage[data-layout="screenshare"]
    .conference-stage-panel--screen
    .conference-stage-heading {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 3;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.62) 0%,
      rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
  }

  /* Foldable sections: summary acts as heading */
  summary.conference-sidebar-heading {
    list-style: none;
    cursor: pointer;
    user-select: none;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    box-sizing: border-box;
  }

  summary.conference-sidebar-heading::-webkit-details-marker {
    display: none;
  }

  summary.conference-sidebar-heading::before {
    content: "";
    position: relative;
    top: -1px;
    width: 0.42rem;
    height: 0.42rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(-45deg);
    transform-origin: center;
    opacity: 0.72;
    flex-shrink: 0;
    align-self: center;
    transition:
      transform 140ms ease,
      top 140ms ease;
  }

  details[open] > summary.conference-sidebar-heading::before {
    transform: rotate(45deg);
    top: -2px;
  }

  .conference-slot,
  .conference-presentation,
  .conference-self-preview {
    min-height: 0;
    position: relative;
    display: grid;
    place-items: stretch;
    overflow: hidden;
    background: #000;
  }

  .conference-slot::before,
  .conference-self-preview::before {
    content: attr(data-empty-label);
    position: absolute;
    left: 0.8rem;
    bottom: 0.7rem;
    color: var(--conference-dim);
    font-size: var(--conference-font-body);
    letter-spacing: 0.02em;
    pointer-events: none;
    z-index: 0;
  }

  .conference-slot:has(.conference-tile)::before,
  .conference-slot:has(.conference-media-frame)::before,
  .conference-self-preview:has(.conference-media-frame)::before {
    content: "";
  }

  .conference-slot--grid {
    padding: 0.8rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    grid-auto-rows: minmax(187px, 1fr);
    gap: 0.8rem;
    align-content: start;
    overflow: auto;
  }

  .conference-presentation iframe {
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
  }

  .conference-empty {
    display: grid;
    place-items: center;
    padding: 1rem;
    color: var(--conference-dim);
    text-align: center;
    line-height: 1.45;
  }

  .conference-empty--tile {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .conference-empty[hidden],
  .conference-presentation > iframe[hidden],
  .conference-presentation > .conference-empty--presentation[hidden] {
    display: none !important;
  }

  /* Eurorack module style: compact title strip, content flush below */
  .conference-sidebar-section--instrument > summary.conference-sidebar-heading,
  .conference-mixer-summary,
  .conference-mixer-fx-summary {
    width: 100%;
    height: var(--conference-sidebar-strip-height);
    min-height: var(--conference-sidebar-strip-height);
    padding: 0 var(--conference-sidebar-strip-padding-x);
    margin: 0;
    box-sizing: border-box;
  }

  .conference-sidebar-section--instrument > div,
  .conference-sidebar-section--instrument > .conference-field {
    padding: 0.55rem 0.65rem;
  }

  .conference-sidebar-section--mixer {
    flex: 0 0 auto;
    position: relative;
    z-index: 2;
    gap: 0;
    padding: 0;
    border-top: 1px solid var(--conference-line);
    border-bottom: 0;
    background: rgba(0, 0, 0, 0.98);
  }

  .conference-mixer-foldable {
    margin: 0;
    display: block;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .conference-sidebar-section {
    display: grid;
    gap: clamp(0.44rem, 0.6vw, 0.52rem);
    padding: clamp(0.52rem, 0.7vw, 0.62rem) clamp(0.65rem, 1vw, 0.86rem)
      clamp(0.55rem, 0.8vw, 0.72rem);
    border-bottom: 1px solid var(--conference-line);
  }

  .conference-sidebar-section.conference-sidebar-section--instrument {
    gap: 0;
    padding: 0;
    margin: 0; /* reset any browser <details> default margin */
  }

  .conference-sidebar-section.conference-sidebar-section--mixer {
    flex: 0 0 auto;
    position: relative;
    z-index: 2;
    gap: 0;
    padding: 0;
    border-top: 1px solid var(--conference-line);
    border-bottom: 0;
    background: rgba(0, 0, 0, 0.98);
  }

  .conference-self-preview-shell {
    min-width: 0;
  }

  /* ── Sidebar fields: label + input rows for device selects, checkboxes ── */
  .conference-field {
    display: grid;
    gap: 0.28rem;
  }

  .conference-field label {
    color: var(--conference-muted);
    font-size: var(--conference-font-caption);
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .conference-field input,
  .conference-field select,
  .conference-chat-compose textarea,
  .conference-chat-compose button,
  .conference-bottombar select,
  .conference-device-panel select {
    font: inherit;
  }

  .conference-field input:not([type="range"]):not([type="checkbox"]),
  .conference-field select,
  .conference-chat-compose textarea,
  .conference-bottombar select,
  .conference-device-panel select {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--conference-line);
    background: transparent;
    color: var(--conference-fg);
    padding: 0.28rem 0 0.32rem;
    outline: none;
    box-shadow: none;
    font-size: var(--conference-font-body);
  }

  .conference-field input:focus,
  .conference-field select:focus,
  .conference-chat-compose textarea:focus,
  .conference-bottombar select:focus,
  .conference-device-panel select:focus {
    border-bottom-color: var(--conference-accent);
  }

  .conference-range-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
  }

  .conference-range-row input[type="range"] {
    width: 100%;
    margin: 0;
    appearance: none;
    -webkit-appearance: none;
    height: 3px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: transparent;
  }

  .conference-range-row input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.88);
    background: #02050b;
    box-shadow: none;
  }

  .conference-range-row input[type="range"]::-moz-range-thumb {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.88);
    background: #02050b;
    box-shadow: none;
  }

  .conference-range-row output {
    color: var(--conference-muted);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .conference-synth-meters {
    display: grid;
    gap: 0.72rem;
  }

  .conference-synth-meter {
    display: grid;
    gap: 0.34rem;
  }

  .conference-synth-meter label {
    display: inline-flex;
    align-items: center;
    gap: 0.34rem;
    color: var(--conference-muted);
    font-size: 0.64rem;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .conference-synth-meter-label {
    justify-content: space-between;
  }

  .conference-synth-formula-shell {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    color: var(--conference-accent);
    font-size: 0.58rem;
    line-height: 1;
    cursor: help;
    outline: none;
  }

  .conference-synth-formula-tooltip {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.36rem);
    min-width: 12rem;
    padding: 0.38rem 0.48rem;
    border: 1px solid rgba(143, 227, 255, 0.16);
    background: rgba(0, 0, 0, 0.92);
    color: var(--conference-fg);
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.2rem);
    transition:
      opacity 140ms ease,
      transform 140ms ease;
    z-index: 6;
  }

  .conference-synth-formula-shell:hover .conference-synth-formula-tooltip,
  .conference-synth-formula-shell:focus-visible
    .conference-synth-formula-tooltip {
    opacity: 1;
    transform: translateY(0);
  }

  .conference-synth-formula-tooltip math {
    font-size: 0.76rem;
  }

  .conference-synth-meter-row {
    display: grid;
    grid-template-columns: 0.7rem minmax(0, 1fr) 0.7rem auto;
    gap: 0.38rem;
    align-items: center;
  }

  .conference-synth-map-button {
    width: 0.58rem;
    height: 0.58rem;
    padding: 0;
    border: 1px solid rgba(143, 227, 255, 0.18);
    background: transparent;
    cursor: pointer;
    transition:
      border-color 140ms ease,
      background-color 140ms ease;
  }

  .conference-synth-map-button:hover,
  .conference-synth-map-button:focus-visible {
    border-color: rgba(143, 227, 255, 0.5);
    background: rgba(143, 227, 255, 0.08);
    outline: none;
  }

  .conference-synth-meter-row input[type="range"] {
    width: 100%;
    margin: 0;
    appearance: none;
    -webkit-appearance: none;
    height: 3px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: transparent;
    pointer-events: none;
    opacity: 0.88;
  }

  .conference-synth-meter-row input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.88);
    background: #02050b;
    box-shadow: none;
  }

  .conference-synth-meter-row input[type="range"]::-moz-range-thumb {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.88);
    background: #02050b;
    box-shadow: none;
  }

  .conference-synth-meter-row output {
    color: var(--conference-muted);
    font-size: 0.7rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* ── Mixer: 4-column audio bus ───────────────────────────────── */
  .conference-mixer {
    display: grid;
    grid-template-columns: repeat(8, minmax(2.5rem, 1fr));
    gap: 0.34rem 0.22rem;
    align-items: start;
    min-height: 0;
    padding: 0.34rem 0.42rem 0.48rem;
  }

  .conference-mixer-channel {
    display: grid;
    justify-items: center;
    grid-template-rows: auto auto 1fr auto auto;
    gap: 0.18rem;
    min-height: 0;
    padding: 0.18rem 0.08rem 0.14rem;
    border: 0;
    background: transparent;
  }

  .conference-mixer-channel--placeholder {
    opacity: 0.38;
  }

  .conference-mixer-channel-label {
    display: grid;
    gap: 0.1rem;
    justify-items: center;
    color: var(--conference-muted);
    font-size: 0.48rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
  }

  .conference-mixer-channel-label strong {
    color: var(--conference-fg);
    font-size: 0.56rem;
  }

  .conference-mixer-send-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.12rem;
    width: 100%;
    justify-items: center;
  }

  .conference-mixer-send-row--disabled {
    opacity: 0.34;
  }

  .conference-mixer-send {
    display: grid;
    justify-items: center;
    gap: 0.08rem;
    min-width: 0;
  }

  .conference-mixer-send-label {
    color: var(--conference-muted);
    font-size: 0.32rem;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .conference-mixer-send-label--reverb {
    color: var(--conference-fx-reverb);
  }

  .conference-mixer-send-label--delay {
    color: var(--conference-fx-delay);
  }

  .conference-mixer-fader {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    writing-mode: vertical-lr;
    direction: rtl;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: 0;
  }

  .conference-mixer-fader::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 6px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.92);
    background: #02050b;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.24);
  }

  .conference-mixer-fader::-moz-range-thumb {
    width: 16px;
    height: 6px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.92);
    background: #02050b;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.24);
  }

  .conference-mixer-fader-shell {
    position: relative;
    width: 13px;
    height: 4.8rem;
    display: grid;
    place-items: center;
  }

  .conference-mixer-vumeter {
    --conference-meter-level: 0;
    position: absolute;
    inset: 0.05rem 0.35rem;
    border: 0;
    background: linear-gradient(
      to top,
      rgba(69, 211, 132, 0.04) 0%,
      rgba(69, 211, 132, 0.04) 58%,
      rgba(255, 216, 77, 0.04) 58%,
      rgba(255, 216, 77, 0.04) 82%,
      rgba(255, 92, 92, 0.04) 82%,
      rgba(255, 92, 92, 0.04) 100%
    );
    overflow: hidden;
    pointer-events: none;
  }

  .conference-mixer-vumeter::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(69, 211, 132, 0.96) 0%,
      rgba(69, 211, 132, 0.96) 58%,
      rgba(255, 216, 77, 0.96) 58%,
      rgba(255, 216, 77, 0.96) 82%,
      rgba(255, 92, 92, 0.96) 82%,
      rgba(255, 92, 92, 0.96) 100%
    );
    transform: scaleY(var(--conference-meter-level));
    transform-origin: bottom center;
    box-shadow: 0 0 10px rgba(143, 227, 255, 0.18);
  }

  .conference-mixer-vumeter--placeholder::before {
    transform: scaleY(0.08);
    box-shadow: none;
    opacity: 0.18;
  }

  .conference-mixer-led {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(69, 211, 132, 0.96);
    box-shadow: 0 0 8px rgba(69, 211, 132, 0.42);
    transition:
      opacity 140ms ease,
      box-shadow 140ms ease;
  }

  .conference-mixer-led--mute {
    display: grid;
    place-items: center;
    color: #05080d;
    font-size: 0.3rem;
    font-weight: 800;
    line-height: 1;
  }

  .conference-mixer-channel-toggle,
  .conference-mixer-fx-led-toggle {
    border: 0;
    background: transparent;
    color: var(--conference-fg);
    padding: 0;
    margin: 0;
    cursor: pointer;
  }

  .conference-mixer-fx-led-toggle {
    width: 8px;
    height: 8px;
    display: inline-grid;
    place-items: center;
    justify-self: end;
  }

  .conference-mixer-channel-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 12px;
  }

  .conference-mixer-channel-toggle:disabled {
    cursor: default;
  }

  .conference-mixer-channel-toggle:disabled .conference-mixer-led {
    opacity: 0.16;
    box-shadow: none;
  }

  .conference-mixer-channel-toggle[data-active="false"] .conference-mixer-led,
  .conference-mixer-fx-led-toggle[data-active="false"] .conference-mixer-led {
    opacity: 0.2;
    box-shadow: none;
  }

  .conference-mixer-knob-stack {
    display: grid;
    justify-items: center;
    gap: 0.12rem;
  }

  .conference-mixer-knob-stack--pan {
    margin-top: 0.02rem;
  }

  .conference-mixer-pan-input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    padding: 0;
    opacity: 0;
    pointer-events: none;
  }

  .conference-mixer-knob-control {
    --conference-knob-color: var(--conference-accent);
    --angle: 0deg;
    position: relative;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.26);
    background: transparent;
    cursor: ns-resize;
    touch-action: none;
    padding: 0;
    box-shadow: none;
  }

  .conference-mixer-knob-control::before {
    content: "L/R";
    position: absolute;
    left: 50%;
    bottom: -0.62rem;
    transform: translateX(-50%);
    color: var(--conference-muted);
    font-size: 0.42rem;
    line-height: 1;
    letter-spacing: 0.12em;
  }

  .conference-mixer-knob-control--plain::before {
    content: none;
  }

  .conference-mixer-knob-control--video {
    width: 22px;
    height: 22px;
    justify-self: center;
  }

  .conference-mixer-knob-control--send {
    width: 26px;
    height: 26px;
  }

  .conference-mixer-knob-control--send .conference-mixer-knob-indicator {
    height: 7px;
  }

  .conference-mixer-knob-control--send-reverb {
    --conference-knob-color: var(--conference-fx-reverb);
  }

  .conference-mixer-knob-control--send-delay {
    --conference-knob-color: var(--conference-fx-delay);
  }

  .conference-mixer-knob-control--disabled {
    --conference-knob-color: rgba(245, 247, 251, 0.28);
    opacity: 0.42;
    cursor: default;
  }

  .conference-mixer-knob-control--video .conference-mixer-knob-indicator {
    height: 6px;
  }

  .conference-video-module {
    display: grid;
    gap: 0.42rem;
  }

  .conference-video-module-head {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .conference-video-module-reset {
    margin-left: auto;
    position: relative;
    min-width: 1.5rem;
    transition:
      min-width 140ms ease,
      color 140ms ease;
  }

  .conference-video-module-reset::after {
    content: "RESET";
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    color: var(--conference-fg);
    transition: opacity 140ms ease;
    pointer-events: none;
  }

  .conference-video-module-reset:hover,
  .conference-video-module-reset:focus-visible {
    min-width: 4.1rem;
    color: transparent;
  }

  .conference-video-module-reset:hover::after,
  .conference-video-module-reset:focus-visible::after {
    opacity: 1;
  }

  .conference-video-mixer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.16rem;
    align-content: start;
    min-height: 0;
    width: 100%;
    height: auto;
    padding: 0.18rem 0.1rem;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.02);
    overflow: hidden;
  }

  .conference-video-mixer-grid--module {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.34rem 0.24rem;
    padding: 0.26rem 0.18rem 0.22rem;
  }

  .conference-video-mixer-control {
    display: grid;
    justify-items: center;
    gap: 0.08rem;
    min-width: 0;
  }

  .conference-video-mixer-control--wide {
    /* no span needed in single-column layout */
  }

  .conference-video-mixer-label {
    color: var(--conference-muted);
    font-size: 0.38rem;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
  }

  .conference-mixer-knob-control:hover,
  .conference-mixer-knob-control:focus-visible {
    border-color: color-mix(
      in srgb,
      var(--conference-knob-color) 38%,
      rgba(255, 255, 255, 0.22)
    );
    outline: none;
  }

  .conference-mixer-knob-indicator {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2px;
    height: 9px;
    border-radius: 999px;
    background: var(--conference-knob-color);
    transform: translate(-50%, -100%) rotate(var(--angle));
    transform-origin: 50% 100%;
    box-shadow: 0 0 8px
      color-mix(in srgb, var(--conference-knob-color) 48%, transparent);
  }

  /* FX — independent bottom module, sibling of MIXER */
  .conference-mixer-fx-details {
    margin: 0;
    display: block;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    border-top: 1px solid var(--conference-line);
  }

  /* FX summary inherits .conference-sidebar-heading — only need to clear defaults */
  .conference-mixer-fx-summary::-webkit-details-marker {
    display: none;
  }

  .conference-mixer-fx-details[open] .conference-mixer-fx-summary::before {
    transform: rotate(45deg);
  }

  .conference-mixer-fx {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    padding: 0.3rem 0.5rem 0.5rem;
  }

  .conference-mixer-fx-pair {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .conference-mixer-fx-card {
    flex: 1 1 0;
    padding: 10px;
    border: 0;
    background: transparent;
  }

  .conference-mixer-fx-card--reverb .conference-mixer-fx-head h4 {
    color: var(--conference-fx-reverb);
  }

  .conference-mixer-fx-card--delay .conference-mixer-fx-head h4 {
    color: var(--conference-fx-delay);
  }

  .conference-mixer-fx-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 3px 0;
  }

  .conference-mixer-fx-head h4 {
    margin: 0;
    color: var(--conference-accent);
    font-size: 0.58rem;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .conference-mixer-fx-badge {
    color: rgba(255, 226, 107, 0.78);
    font-size: 0.5rem;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .conference-mixer-fx-badge--reverb {
    color: color-mix(in srgb, var(--conference-fx-reverb) 78%, white 22%);
  }

  .conference-mixer-fx-badge--delay {
    color: color-mix(in srgb, var(--conference-fx-delay) 78%, white 22%);
  }

  .conference-mixer-fx-grid {
    display: grid;
    gap: 0.28rem;
  }

  .conference-mixer-fx-grid--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.34rem;
  }

  .conference-mixer-fx-grid--stacked {
    grid-template-columns: 1fr;
    gap: 0.34rem;
  }

  .conference-mixer-fx-control--wide {
    grid-column: 1 / -1;
  }

  .conference-mixer-fx-control {
    display: grid;
    gap: 0.16rem;
    margin-top: 0.34rem;
  }

  .conference-mixer-fx-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--conference-muted);
    font-size: 0.52rem;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .conference-mixer-fx-label-row output {
    color: var(--conference-fg);
    font-size: 0.5rem;
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
  }

  .conference-mixer-fx-control input[type="range"] {
    width: 100%;
    margin: 0;
    appearance: none;
    -webkit-appearance: none;
    height: 3px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: transparent;
  }

  .conference-mixer-fx-control input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.88);
    background: #02050b;
    box-shadow: none;
  }

  .conference-mixer-fx-control input[type="range"]::-moz-range-thumb {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.88);
    background: #02050b;
    box-shadow: none;
  }

  .conference-field--checkbox {
    gap: 0.38rem;
  }

  .conference-field--hand-controls {
    display: flex;
    align-items: center;
    gap: 0.42rem;
    flex-wrap: nowrap;
  }

  .conference-checkbox-row {
    display: inline-flex;
    align-items: center;
    gap: 0.58rem;
    color: var(--conference-fg);
    font-size: 0.76rem;
    letter-spacing: 0.01em;
    text-transform: none;
    cursor: pointer;
  }

  .conference-checkbox-row input[type="checkbox"] {
    margin: 0;
    accent-color: var(--conference-accent);
  }

  .conference-ramp-row {
    display: inline-flex;
    align-items: center;
    gap: 0.36rem;
    color: var(--conference-muted);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .conference-ramp-row input[type="number"] {
    width: 4rem;
    min-height: 1.5rem;
    padding: 0.1rem 0.28rem;
    border: 1px solid var(--conference-line-soft);
    background: transparent;
    color: var(--conference-fg);
    font: inherit;
  }

  .conference-ramp-reset {
    width: 1.5rem;
    height: 1.5rem;
    min-height: 1.5rem;
    padding: 0;
    border: 1px solid var(--conference-line-soft);
    background: transparent;
    color: var(--conference-muted);
    font: inherit;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    margin-left: auto;
  }

  .conference-ramp-reset--wide {
    width: auto;
    min-width: 4.1rem;
    padding: 0 0.42rem;
    font-size: 0.5rem;
    letter-spacing: 0.12em;
  }

  .conference-ramp-reset:hover,
  .conference-ramp-reset:focus-visible {
    border-color: rgba(143, 227, 255, 0.5);
    color: var(--conference-fg);
    outline: none;
  }

  .conference-session-controls:not([hidden]) {
    display: grid;
    gap: 0.72rem;
    padding-top: 0.24rem;
    border-top: 1px solid var(--conference-line-soft);
  }

  .conference-session-controls-heading {
    color: var(--conference-muted);
    font-size: var(--conference-font-caption);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .conference-streaming-setup {
    border-top: 1px solid var(--conference-line-soft);
    padding-top: 0.24rem;
  }

  .conference-streaming-setup-summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    user-select: none;
  }

  .conference-streaming-setup-summary::-webkit-details-marker {
    display: none;
  }

  .conference-streaming-setup-summary::before {
    content: "▸";
    font-size: 0.5rem;
    color: var(--conference-muted);
    transition: transform 200ms ease;
  }

  .conference-streaming-setup[open]
    .conference-streaming-setup-summary::before {
    transform: rotate(90deg);
  }

  .conference-streaming-setup-body {
    display: grid;
    gap: 0.5rem;
    padding-top: 0.4rem;
  }

  .conference-session-action {
    min-height: 1.7rem;
    padding: 0.18rem 0.38rem;
    border: 1px solid var(--conference-line-soft);
    background: transparent;
    color: var(--conference-fg);
    font: inherit;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .conference-session-action--compact {
    width: 1.68rem;
    min-width: 1.68rem;
    min-height: 1.68rem;
    padding: 0;
    justify-self: start;
    place-self: start;
  }

  .conference-session-action:hover,
  .conference-session-action:focus-visible {
    border-color: rgba(143, 227, 255, 0.5);
    color: var(--conference-fg);
    outline: none;
  }

  /* Invite G/C/R wireframe colors */
  .conference-session-action[data-action$="-create"],
  .conference-session-action[data-action$="-invite-create"] {
    border-color: rgba(160, 160, 170, 0.35);
    color: rgba(245, 247, 251, 0.55);
  }
  .conference-session-action[data-action$="-create"]:hover {
    border-color: rgba(160, 160, 170, 0.7);
    color: var(--conference-fg-hi);
  }

  .conference-session-action[data-action$="-copy"] {
    border-color: rgba(80, 160, 220, 0.4);
    color: rgba(100, 180, 240, 0.7);
  }
  .conference-session-action[data-action$="-copy"]:hover {
    border-color: rgba(100, 180, 240, 0.75);
    color: rgba(140, 210, 255, 0.95);
    background: rgba(60, 140, 200, 0.07);
  }

  .conference-session-action[data-action$="-revoke"] {
    border-color: rgba(220, 80, 80, 0.4);
    color: rgba(240, 100, 100, 0.65);
  }
  .conference-session-action[data-action$="-revoke"]:hover {
    border-color: rgba(240, 100, 100, 0.7);
    color: rgba(255, 130, 130, 0.9);
    background: rgba(200, 60, 60, 0.07);
  }

  .conference-session-action:disabled {
    opacity: 0.38;
    cursor: not-allowed;
  }

  .conference-session-action-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.34rem;
  }

  .conference-session-action-row--triple {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .conference-room-invite-controls {
    display: grid;
    gap: 0.48rem;
    padding-top: 0.08rem;
  }

  .conference-room-invite-controls--hidden {
    display: none;
  }

  /* Invite role switch */
  .conference-invite-role-switch {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0 0.2rem;
  }

  .conference-invite-role-label {
    font-size: calc(var(--conference-font-body) * 0.85);
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .conference-invite-role-label.active {
    opacity: 1;
    font-weight: 600;
  }

  /* ── Toggle switch: CSS-only checkbox → pill slider pattern ──────── */
  .conference-switch {
    position: relative;
    display: inline-block;
    width: 2.4rem;
    height: 1.2rem;
    flex-shrink: 0;
  }

  .conference-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .conference-switch-slider {
    position: absolute;
    inset: 0;
    background: var(--conference-color-border, #555);
    border-radius: 1.2rem;
    cursor: pointer;
    transition: background 0.2s;
  }

  .conference-switch-slider::before {
    content: "";
    position: absolute;
    height: 0.9rem;
    width: 0.9rem;
    left: 0.15rem;
    top: 50%;
    transform: translateY(-50%);
    background: #fff;
    border-radius: 50%;
    transition: transform 0.2s;
  }

  .conference-switch input:checked + .conference-switch-slider {
    background: var(--conference-color-accent, #6a8);
  }

  .conference-switch input:checked + .conference-switch-slider::before {
    transform: translateY(-50%) translateX(1.2rem);
  }

  .conference-invite-link-output {
    font-size: calc(var(--conference-font-body) * 0.9);
  }

  .conference-invite-link-output::placeholder {
    font-size: calc(var(--conference-font-body) * 0.8);
    line-height: 1.1;
    letter-spacing: 0.01em;
  }

  .conference-room-invite-panel {
    display: grid;
    gap: 0.28rem;
    padding-top: 0.06rem;
  }

  .conference-room-invite-panel-summary {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    list-style: none;
    color: var(--conference-muted);
    font-size: var(--conference-font-caption);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .conference-room-invite-panel-summary::-webkit-details-marker {
    display: none;
  }

  .conference-room-invite-panel-summary::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(-45deg);
    transform-origin: center;
    opacity: 0.72;
    transition: transform 140ms ease;
  }

  .conference-room-invite-panel[open]
    .conference-room-invite-panel-summary::before {
    transform: rotate(45deg);
  }

  .conference-session-note {
    margin: 0;
    color: var(--conference-muted);
    font-size: var(--conference-font-body);
    line-height: 1.35;
  }

  .conference-session-note[data-error="true"],
  .conference-invite-note[data-error="true"] {
    color: #ff8787;
  }

  /* ── Break rooms ──────────────────────────────────────────────────── */
  .conference-break-rooms-panel {
    display: grid;
    gap: 0.28rem;
    padding-top: 0.06rem;
  }

  .conference-break-rooms-section {
    display: grid;
    gap: 0.3rem;
    padding-top: 0.2rem;
  }

  .conference-break-rooms-section .conference-session-action-row {
    grid-template-columns: auto 1fr;
  }

  /* R = green (create), G = blue (group), matches INVITAR palette */
  .conference-session-action[data-action="break-rooms-random"] {
    border-color: rgba(100, 220, 140, 0.4);
    color: rgba(120, 220, 150, 0.7);
  }
  .conference-session-action[data-action="break-rooms-random"]:hover {
    border-color: rgba(120, 240, 160, 0.7);
    color: rgba(160, 255, 180, 0.95);
    background: rgba(60, 180, 100, 0.07);
  }
  .conference-session-action[data-action="break-rooms-grupos"] {
    border-color: rgba(80, 160, 220, 0.4);
    color: rgba(100, 180, 240, 0.7);
  }
  .conference-session-action[data-action="break-rooms-grupos"]:hover {
    border-color: rgba(100, 180, 240, 0.75);
    color: rgba(140, 210, 255, 0.95);
    background: rgba(60, 140, 200, 0.07);
  }
  .conference-session-action[data-action="break-rooms-custom"] {
    border-color: rgba(160, 160, 170, 0.35);
    color: rgba(245, 247, 251, 0.55);
  }
  .conference-session-action[data-action="break-rooms-custom"]:hover {
    border-color: rgba(160, 160, 170, 0.7);
    color: var(--conference-fg-hi);
  }

  .conference-break-rooms-size-input {
    width: 3.4rem;
    background: transparent;
    color: var(--conference-fg);
    border: 1px solid var(--conference-line-soft);
    padding: 0.1rem 0.3rem;
    text-align: center;
    font-size: var(--conference-font-ui);
  }

  .conference-break-rooms-custom-inputs {
    display: grid;
    gap: 0.24rem;
  }

  .conference-break-rooms-custom-name {
    background: transparent;
    color: var(--conference-fg);
    border: 0;
    border-bottom: 1px solid var(--conference-line-soft);
    padding: 0.18rem 0.1rem;
    width: 100%;
    font: inherit;
    font-size: var(--conference-font-ui);
  }

  .conference-break-rooms-custom-name:focus {
    outline: none;
    border-bottom-color: rgba(143, 227, 255, 0.45);
  }

  .conference-break-rooms-custom-name::placeholder {
    color: var(--conference-muted);
    opacity: 0.45;
  }

  /* B / E / O shells: keep inline with layout bar */
  .conference-break-rooms-shell,
  .conference-external-media-controls-shell,
  .conference-concepts-shell {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: middle;
  }
  .conference-break-rooms-shell[hidden],
  .conference-external-media-controls-shell[hidden],
  .conference-concepts-shell[hidden],
  .conference-break-rooms-end-btn[hidden],
  .conference-break-rooms-kill-btn[hidden] {
    display: none;
  }

  .conference-external-media-controls-shell[data-active="true"]
    .conference-external-media-btn {
    color: rgba(143, 227, 255, 0.92);
  }

  .conference-concepts-popup,
  .conference-external-media-popup,
  .conference-break-rooms-popup {
    position: absolute;
    bottom: calc(100% + 1px);
    left: 1rem;
    min-width: 248px;
    max-width: 320px;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--conference-line);
    background: rgba(0, 0, 0, 0.98);
    z-index: 16000;
    display: grid;
    gap: 0.45rem;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.6);
  }

  .conference-concepts-popup[hidden],
  .conference-external-media-popup[hidden],
  .conference-break-rooms-popup[hidden] {
    display: none;
  }
.conference-status-toast {
  position: fixed;
  bottom: calc(var(--conference-bar-height) + 0.5rem);
  left: 1rem;
  z-index: 17000;
  pointer-events: none;
  max-width: min(28rem, calc(100vw - 2rem));
}

.conference-status-toast[data-visible="false"] {
  display: none;
}

  .conference-external-media-input {
    min-width: 14rem;
  }

  .conference-external-media-actions-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .conference-session-action[data-action="external-media-open"] {
    border-color: rgba(143, 227, 255, 0.36);
    color: rgba(160, 232, 255, 0.76);
  }

  .conference-session-action[data-action="external-media-open"]:hover {
    border-color: rgba(143, 227, 255, 0.72);
    color: rgba(214, 248, 255, 0.98);
    background: rgba(42, 122, 145, 0.08);
  }

  .conference-session-action[data-action="external-media-stop"] {
    border-color: rgba(240, 100, 100, 0.34);
    color: rgba(255, 170, 170, 0.7);
  }

  .conference-session-action[data-action="external-media-stop"]:hover {
    border-color: rgba(240, 100, 100, 0.68);
    color: rgba(255, 205, 205, 0.94);
    background: rgba(140, 52, 52, 0.08);
  }

  .conference-external-media-note {
    margin: 0;
    color: var(--conference-muted);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  /* B active = yellow when break rooms are active */
  .conference-break-rooms-shell[data-active="true"]
    .conference-break-rooms-btn {
    color: rgba(255, 226, 107, 0.9);
  }

  @keyframes conference-br-blink {
    0%,
    100% {
      color: rgba(255, 226, 107, 0.95);
    }
    50% {
      color: rgba(255, 226, 107, 0.1);
    }
  }

  .conference-break-rooms-btn--blink {
    animation: conference-br-blink 0.55s ease-in-out infinite;
  }

  /* C button: countdown-end, red-ish tone */
  .conference-break-rooms-end-btn {
    color: rgba(240, 100, 100, 0.65) !important;
  }
  .conference-break-rooms-end-btn:hover {
    color: rgba(255, 130, 130, 0.9) !important;
  }

  /* T button: immediate kill, red text */
  .conference-break-rooms-kill-btn {
    color: rgba(240, 80, 80, 0.8) !important;
  }
  .conference-break-rooms-kill-btn:hover {
    color: rgba(255, 100, 100, 1) !important;
  }

  /* Drop-up popup — same chrome as .conference-roster-popup */
  .conference-break-rooms-popup {
    position: absolute;
    bottom: calc(100% + 1px);
    left: 0;
    min-width: 240px;
    max-width: 320px;
    max-height: 40vh;
    overflow-y: auto;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--conference-line);
    background: rgba(0, 0, 0, 0.98);
    z-index: 100;
    display: grid;
    gap: 0.45rem;
  }

  .conference-break-rooms-popup[hidden] {
    display: none;
  }

  .conference-break-rooms-popup-setup {
    padding-bottom: 0.1rem;
  }

  .conference-break-rooms-popup-divider {
    height: 1px;
    background: var(--conference-line-soft);
  }

  .conference-break-rooms-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.12rem;
  }

  .conference-break-rooms-list li {
    display: block;
  }

  /* Each room entry mirrors .conference-roster-item */
  .conference-break-rooms-list button {
    display: block;
    width: 100%;
    background: #000;
    color: var(--conference-fg);
    font: inherit;
    font-size: 0.72rem;
    line-height: 0.87;
    padding: 0.12rem 0;
    text-align: left;
    cursor: pointer;
    border: 0;
    border-bottom: 1px solid var(--conference-line-soft);
    letter-spacing: 0.02em;
  }

  .conference-break-rooms-list button:hover:not(:disabled) {
    background: #000;
    color: var(--conference-fg-hi);
  }

  .conference-break-rooms-list button:disabled {
    background: #000;
    color: rgba(245, 247, 251, 0.5);
    font-size: 0.53rem;
    line-height: 0.92;
    cursor: default;
  }

  .conference-break-rooms-list button[data-active="true"] {
    color: rgba(143, 227, 255, 0.9);
  }

  /* "Terminar" option — red, mirrors .conference-session-action revoke palette */
  .conference-break-rooms-list button[data-end="true"] {
    color: rgba(240, 100, 100, 0.65);
    font-size: 0.54rem;
  }
  .conference-break-rooms-list button[data-end="true"]:hover {
    color: rgba(255, 130, 130, 0.9);
  }

  .conference-break-rooms-list .conference-break-rooms-divider {
    height: 1px;
    background: var(--conference-line-soft);
    margin: 0.14rem 0;
    list-style: none;
  }

  /* Break rooms countdown overlay — upper-right of stage */
  .conference-br-countdown {
    position: absolute;
    top: 0.8rem;
    right: 1rem;
    z-index: 30;
    pointer-events: none;
    background: rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(10px) saturate(0.7);
    -webkit-backdrop-filter: blur(10px) saturate(0.7);
    padding: 0.55rem 1rem 0.6rem;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
  }

  .conference-br-countdown[hidden] {
    display: none;
  }

  .conference-br-countdown-label {
    display: block;
    color: rgba(255, 226, 107, 0.9);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .conference-br-countdown-secs {
    display: block;
    color: rgba(255, 226, 107, 1);
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.1;
  }

  .conference-shell[data-instruments-allowed="false"][data-role="student"]
    .conference-sidebar-section--instrument,
  .conference-shell[data-instruments-allowed="false"][data-role="external"]
    .conference-sidebar-section--instrument {
    opacity: 0.52;
  }

  .conference-shell[data-instruments-allowed="false"][data-role="student"]
    .conference-sidebar-section--instrument
    .conference-checkbox-row,
  .conference-shell[data-instruments-allowed="false"][data-role="external"]
    .conference-sidebar-section--instrument
    .conference-checkbox-row,
  .conference-shell[data-instruments-allowed="false"][data-role="student"]
    .conference-sidebar-section--instrument
    .conference-ramp-row,
  .conference-shell[data-instruments-allowed="false"][data-role="external"]
    .conference-sidebar-section--instrument
    .conference-ramp-row,
  .conference-shell[data-instruments-allowed="false"][data-role="student"]
    .conference-sidebar-section--instrument
    .conference-synth-meter
    label,
  .conference-shell[data-instruments-allowed="false"][data-role="external"]
    .conference-sidebar-section--instrument
    .conference-synth-meter
    label {
    color: var(--conference-muted);
  }

  .conference-name-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.55rem;
    align-items: end;
  }

  .conference-role-tag {
    color: var(--conference-muted);
    font-size: 0.78rem;
    white-space: nowrap;
    text-transform: lowercase;
  }

  .conference-self-preview {
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--conference-line-soft);
  }

  .conference-self-preview,
  .conference-self-preview .conference-media-frame,
  .conference-self-preview .conference-media-frame > video {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .conference-self-preview .conference-media-frame > video {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: contain !important;
    object-position: 50% 70% !important;
    transform: scale(var(--conference-local-preview-zoom, 1)) !important;
    transform-origin: center center;
  }

  /* ── Tile/media system: video cards in grid and presentation layouts ── */
  .conference-tile {
    min-height: 0;
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    background: #020202;
    border: 1px solid var(--conference-line-soft);
    overflow: hidden;
    transition: box-shadow 120ms ease;
  }

  .conference-tile[data-speaking="true"] {
    box-shadow:
      0 0 0 2px #22c55e,
      0 0 10px rgba(34, 197, 94, 0.3);
  }

  .conference-slot--grid .conference-tile {
    aspect-ratio: 8 / 5;
  }

  .conference-tile--participant {
    grid-template-rows: 1fr;
  }

  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-tile,
  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-media-frame,
  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-tile-media,
  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-empty--tile {
    width: 100%;
    height: 100%;
    border-radius: 999px;
    border: 0;
  }

  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-tile {
    grid-template-rows: 1fr;
    background: transparent;
  }

  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-media-frame
    video {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: cover !important;
    object-position: 50% 68% !important;
    transform: none !important;
  }

  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-media-frame,
  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-media-frame
    > video,
  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-tile-media {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .conference-tile-media,
  .conference-media-frame {
    min-height: 0;
    position: relative;
    width: 100%;
    height: 100%;
    background: #000;
    overflow: hidden;
  }

  .conference-media-frame > video,
  .conference-media-frame > audio,
  .conference-media-frame > img,
  .conference-media-frame > canvas,
  .conference-tile-media > video,
  .conference-tile-media > img,
  .conference-tile-media > canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: cover;
    object-position: center;
    background: #000;
  }

  .conference-hand-overlay {
    position: absolute;
    inset: 0;
    z-index: 8;
    width: 100%;
    height: 100%;
    background: transparent !important;
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: screen;
    transition: opacity 160ms ease;
  }

  .conference-shell[data-hand-track="true"] .conference-hand-overlay {
    opacity: 1;
  }

  .conference-gravity-ball-overlay {
    position: absolute;
    inset: 0;
    z-index: 7;
    width: 100%;
    height: 100%;
    background: transparent !important;
    pointer-events: none;
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .conference-shell[data-gravity-ball="true"][data-gravity-ball-stage-visible="true"]
    .conference-gravity-ball-overlay {
    opacity: 1;
  }

  .conference-recording-guide {
    position: absolute;
    z-index: 8;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    border: 1px dashed
      color-mix(in srgb, var(--conference-accent) 78%, transparent);
    background: transparent;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.34);
    pointer-events: none;
    opacity: 0;
    transition: opacity 140ms ease;
  }

  .conference-shell[data-recording-guide-visible="true"][data-recording-guide-suppressed="false"]
    .conference-recording-guide {
    opacity: 0.92;
  }

  .conference-stage-frame {
    position: relative;
  }

  .conference-hand-overlay--stage {
    inset: 0;
  }

  .conference-reactions-layer {
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
    z-index: 8;
  }

  .conference-reaction-burst {
    align-items: center;
    animation: conference-reaction-burst 1.5s ease-out forwards;
    color: rgba(255, 255, 255, 0.96);
    display: inline-flex;
    font-size: 2rem;
    gap: 0.35rem;
    left: 50%;
    line-height: 1;
    position: absolute;
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.55);
    top: 62%;
    transform: translate(-50%, 0);
    white-space: nowrap;
  }

  .conference-reaction-burst-name {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @keyframes conference-reaction-burst {
    0% {
      opacity: 0;
      transform: translate(-50%, 16px) scale(0.88);
    }

    12% {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }

    100% {
      opacity: 0;
      transform: translate(-50%, -88px) scale(1.08);
    }
  }

  @media (max-width: 720px) {
    .conference-mixer-fx-pair {
      flex-direction: column;
    }
  }

  .conference-media-frame--screen video {
    object-fit: contain;
  }

  .conference-self-preview .conference-media-frame--local-preview,
  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-media-frame {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .conference-self-preview .conference-media-frame--local-preview > video,
  .conference-media-frame--local-preview > video {
    position: relative !important;
    inset: auto !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    min-width: 0 !important;
    min-height: 0 !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: contain !important;
    object-position: 50% 62% !important;
    background: #000;
    transform: scaleX(var(--conference-local-video-flip, 1))
      scale(var(--conference-self-preview-zoom, 1)) !important;
  }

  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-media-frame
    > video {
    position: relative !important;
    inset: auto !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    min-width: 0 !important;
    min-height: 0 !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: contain !important;
    object-position: 50% 62% !important;
    background: #000;
    transform: scale(
      var(
        --conference-participant-preview-zoom,
        var(--conference-circle-preview-zoom, 1)
      )
    ) !important;
  }

  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-media-frame--local-camera
    > video {
    transform: scaleX(var(--conference-local-video-flip, 1))
      scale(
        var(
          --conference-participant-preview-zoom,
          var(--conference-circle-preview-zoom, 1)
        )
      ) !important;
  }

  .conference-media-frame--local-camera > video,
  .conference-stage[data-layout="teacher"]
    .conference-media-frame--local-camera
    > video,
  .conference-slot--grid .conference-media-frame--local-camera > video {
    position: absolute;
    inset: 0;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    min-width: 0 !important;
    min-height: 0 !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: cover !important;
    object-position: 50% 58% !important;
    transform: scaleX(var(--conference-local-video-flip, 1)) !important;
    background: #000;
  }

  .conference-tile-meta {
    display: grid;
    gap: 0.08rem;
    padding: 0.4rem 0.45rem;
    border-top: 1px solid var(--conference-line-soft);
    background: rgba(0, 0, 0, 0.88);
  }

  .conference-stage[data-layout="presentation"]
    .conference-stage-panel--focus
    .conference-tile-meta {
    display: none;
  }

  .conference-tile--participant .conference-tile-meta {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: flex-end;
    min-height: 2rem;
    padding: 0.5rem 0.6rem 0.45rem;
    border-top: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.76) 100%
    );
    pointer-events: none;
  }

  .conference-tile-hand {
    position: absolute;
    top: 0.45rem;
    right: 0.5rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    min-height: 3rem;
    font-size: 2rem;
    line-height: 1;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.45));
    pointer-events: none;
  }

  .conference-tile-hand[hidden] {
    display: none !important;
  }

  .conference-tile-meta strong {
    color: var(--conference-fg);
    font-size: 0.76rem;
    font-weight: 600;
  }

  /* ── Bottom bar: control groups in a horizontal scrollable flex row ── */
  .conference-bottombar {
    position: fixed !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    z-index: 10000 !important;
    height: var(--conference-bar-height) !important;
    display: flex;
    align-items: stretch;
    border-top: 1px solid var(--conference-line);
    background: rgba(0, 0, 0, 0.98);
    overflow: visible;
  }

  .conference-bar-group {
    flex: 0 0 auto;
    display: flex;
    align-items: stretch;
    border-right: 1px solid var(--conference-line);
  }

  .conference-bar-group--unified {
    border-right: 0;
  }

  .conference-bar-group--fixed-left,
  .conference-bar-group--fixed-right {
    flex: 0 0 auto;
    z-index: 2;
    background: inherit;
  }

  .conference-bar-group--fixed-right {
    border-right: 0;
    border-left: 1px solid var(--conference-line);
    justify-content: flex-end;
  }

  .conference-bar-scrollable-wrap {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: stretch;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    background: inherit;
    touch-action: pan-x;
  }

  .conference-bar-scrollable-wrap::-webkit-scrollbar {
    display: none;
  }

  .conference-bar-scrollable-wrap .conference-bar-group:last-child {
    border-right: 0;
  }

  .conference-mute-all-button {
    color: #ef4444;
    opacity: 0.7;
  }

  .conference-mute-all-button:not(:disabled):hover {
    opacity: 1;
    color: #ef4444;
  }

  .conference-mute-all-button:disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }

  .conference-bar-group--presentation {
    padding: 0 0.65rem;
  }

  .conference-bar-group--presentation select {
    min-width: min(100%, 24rem);
    border-bottom: 0;
    align-self: stretch;
    color: var(--conference-muted);
  }

  .conference-bar-group--exit {
    border-right: 0;
    justify-content: flex-end;
  }

  .conference-connect-button,
  .conference-icon-button,
  .conference-layout-button,
  .conference-share-button,
  .conference-exit-button,
  .conference-record-button,
  .conference-count-button,
  .conference-live-activity {
    border: 0;
    background: transparent;
    color: var(--conference-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    cursor: pointer;
    text-decoration: none;
  }

  .conference-connect-button {
    min-width: 58px;
    padding: 0 0.9rem;
    color: var(--conference-green);
  }

  .conference-connect-button[data-connected="true"] {
    color: var(--conference-red);
  }

  .conference-connect-arrow {
    width: 18px;
    height: 18px;
    display: block;
  }

  .conference-connect-arrow--out {
    display: none;
  }

  .conference-connect-button[data-connected="true"]
    .conference-connect-arrow--in {
    display: none;
  }

  .conference-connect-button[data-connected="true"]
    .conference-connect-arrow--out {
    display: block;
  }

  .conference-connect-button:hover:not(:disabled),
  .conference-icon-button:hover:not(:disabled),
  .conference-layout-button:hover:not(:disabled),
  .conference-share-button:hover:not(:disabled),
  .conference-record-button:hover:not(:disabled),
  .conference-exit-button:hover,
  .conference-count-button:hover,
  .conference-live-activity:hover {
    color: var(--conference-fg);
    background: rgba(255, 255, 255, 0.04);
  }

  .conference-connect-button:disabled,
  .conference-icon-button:disabled,
  .conference-layout-button:disabled,
  .conference-share-button:disabled,
  .conference-record-button:disabled,
  .conference-live-activity:disabled {
    opacity: 0.36;
    cursor: not-allowed;
  }

  .conference-icon-button,
  .conference-layout-button,
  .conference-share-button,
  .conference-record-button,
  .conference-exit-button {
    position: relative;
    min-width: 40px;
    padding: 0 0.72rem;
  }

  .conference-exit-button {
    min-width: 46px;
    padding: 0 0.8rem;
  }

  .conference-shortcuts-button {
    font-size: 0.92rem;
    font-weight: 700;
  }

  .conference-layout-button,
  .conference-share-button,
  .conference-exit-button,
  .conference-live-timer {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .conference-icon {
    width: 15px;
    height: 15px;
    display: block;
  }

  .conference-exit-icon {
    width: 19px;
    height: 19px;
    display: block;
  }

  /* ── Bottom bar tooltips ── */
  .conference-bottombar [data-tooltip] {
    position: relative;
  }

  .conference-bottombar [data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    background: rgba(20, 20, 20, 0.96);
    color: #e5e5e5;
    font-size: 0.62rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms ease;
    z-index: 1200;
