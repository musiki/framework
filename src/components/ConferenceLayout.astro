---
import InstrumentsSidebar from "./room/core/InstrumentsSidebar.astro";
import RoomSidebar from "./room/panels/RoomSidebar.astro";
import SetupModal from "./room/panels/setup/SetupModal.astro";
import WelcomeModal from "./room/overlays/WelcomeModal.astro";
import StageFrame from "./room/stage/StageFrame.astro";
import StageOverlays from "./room/overlays/StageOverlays.astro";
import type { RoomPresentationOption } from "../lib/live/presentation-options";

type Props = {
  livekitUrl?: string;
  courseId?: string;
  courseHomeHref?: string;
  defaultIdentity?: string;
  defaultLayout?: "grid" | "teacher" | "presentation" | "screenshare" | "whiteboard" | "concept" | "lilypond";
  defaultName?: string;
  defaultPresentation?: string;
  defaultRole?: "teacher" | "student";
  defaultRoom?: string;
  inviteCode?: string;
  inviteError?: string;
  inviteLabel?: string;
  inviteMode?: "none" | "external" | "invalid";
  presentationOptions?: RoomPresentationOption[];
};

const {
  livekitUrl = "",
  courseId = "",
  courseHomeHref = "/cursos",
  defaultIdentity = "",
  defaultLayout = "presentation",
  defaultName = "",
  defaultPresentation = "",
  defaultRole = "student",
  defaultRoom = "musiki-stage",
  inviteCode = "",
  inviteError = "",
  inviteLabel = "Acceso externo",
  inviteMode = "none",
  presentationOptions = [],
} = Astro.props as Props;

const normalizedPresentationOptions = Array.isArray(presentationOptions)
  ? [...presentationOptions]
  : [];

if (
  defaultPresentation &&
  !normalizedPresentationOptions.some(
    (option) => option.value === defaultPresentation,
  )
) {
  normalizedPresentationOptions.unshift({
    courseId: "",
    label: defaultPresentation,
    lessonId: "",
    theme: "",
    value: defaultPresentation,
  });
}
---

<div
  data-conference-root
  data-has-sidebar={defaultRole === 'teacher' ? 'true' : 'false'}
  data-livekit-url={livekitUrl}
  data-course-id={courseId}
  data-gravity-ball="false"
  data-gravity-ball-stage-visible="true"
  data-instruments-open="false"
  data-instruments-allowed="true"
  data-recording-guide-suppressed="false"
  data-recording-guide-visible="false"
  data-invite-code={inviteCode}
  data-invite-error={inviteError}
  data-invite-label={inviteLabel}
  data-invite-mode={inviteMode}
  data-role={defaultRole}
  data-sidebar-collapsed="false"
  data-show-circle="false"
>
<section
  class="conference-shell"
  data-has-sidebar={defaultRole === 'teacher' ? 'true' : 'false'}
  data-livekit-url={livekitUrl}
  data-course-id={courseId}
  data-gravity-ball="false"
  data-gravity-ball-stage-visible="true"
  data-instruments-open="false"
  data-instruments-allowed="true"
  data-recording-guide-suppressed="false"
  data-recording-guide-visible="false"
  data-invite-code={inviteCode}
  data-invite-error={inviteError}
  data-invite-label={inviteLabel}
  data-invite-mode={inviteMode}
  data-role={defaultRole}
  data-sidebar-collapsed="false"
  data-show-circle="false"
>
  <InstrumentsSidebar />

  <StageFrame defaultLayout={defaultLayout} presentationOptions={normalizedPresentationOptions} />

  {defaultRole === 'teacher' && (
    <RoomSidebar
      defaultIdentity={defaultIdentity}
      defaultName={defaultName}
      defaultRole={defaultRole}
      defaultRoom={defaultRoom}
    />
  )}

  <StageOverlays />

  <footer class="conference-bottombar">
    <!-- FIXED LEFT -->
    <div class="conference-bar-group conference-bar-group--fixed-left">
      <button
        type="button"
        class="conference-connect-button"
        data-action="connect-toggle"
        aria-label="Conectar a la sala"
        data-tooltip="Conectar Ctrl + J"
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          class="conference-connect-arrow conference-connect-arrow--in"
        >
          <path
            d="M4 12h12.2l-3.6-3.6 1.4-1.4L20 13l-6 6-1.4-1.4 3.6-3.6H4z"
            fill="currentColor"></path>
        </svg>
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          class="conference-connect-arrow conference-connect-arrow--out"
        >
          <path
            d="M20 12H7.8l3.6 3.6-1.4 1.4L4 11l6-6 1.4 1.4L7.8 10H20z"
            fill="currentColor"></path>
        </svg>
        <span class="conference-sr-only">Connect</span>
      </button>

      <button
        type="button"
        class="conference-layout-button conference-setup-trigger-button"
        data-action="setup-modal-toggle"
        aria-label="Ajustes"
        data-tooltip="Ajustes (Cmd + ,)"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="conference-icon">
          <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84a.484.484 0 0 0-.48.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.488.488 0 0 0-.59.22L3.34 8.88a.487.487 0 0 0 .12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.27.41.48.41h3.84c.24 0 .44-.17.48-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47.01.59-.22l1.92-3.32a.49.49 0 0 0-.12-.61l-2.03-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" fill="currentColor"/>
        </svg>
      </button>

      <div class="conference-device-stack">
        <button
          type="button"
          class="conference-icon-button"
          data-action="microphone"
          aria-label="Activar o silenciar microfono"
          title="Microphone. Shift + click para elegir dispositivo."
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="conference-icon">
            <path
              d="M12 15.5a3.5 3.5 0 0 0 3.5-3.5V7A3.5 3.5 0 1 0 8.5 7v5a3.5 3.5 0 0 0 3.5 3.5Zm-6-3a1 1 0 1 1 2 0 4 4 0 1 0 8 0 1 1 0 1 1 2 0 6 6 0 0 1-5 5.91V21h2a1 1 0 1 1 0 2H9a1 1 0 1 1 0-2h2v-2.59A6 6 0 0 1 6 12.5Z"
              fill="currentColor"></path>
          </svg>
          <span class="conference-mic-meter" data-mic-meter hidden></span>
          <span class="conference-sr-only">Microphone</span>
        </button>
        <div class="conference-device-panel" data-audio-input-panel hidden>
          <label for="conference-audio-input-select">Microphone</label>
          <select
            id="conference-audio-input-select"
            name="audio-input"
            data-audio-input-select
          >
            <option value="">Selecciona un microfono</option>
          </select>
        </div>
      </div>

      <div class="conference-device-stack">
        <button
          type="button"
          class="conference-icon-button"
          data-action="camera"
          aria-label="Activar o apagar camara"
          title="Camera. Shift + click para elegir dispositivo."
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="conference-icon">
            <path
              d="M4 7.5A2.5 2.5 0 0 1 6.5 5h7A2.5 2.5 0 0 1 16 7.5v1.13l2.76-1.85A1.5 1.5 0 0 1 21 8.03v7.94a1.5 1.5 0 0 1-2.24 1.25L16 15.37v1.13A2.5 2.5 0 0 1 13.5 19h-7A2.5 2.5 0 0 1 4 16.5v-9Z"
              fill="currentColor"></path>
          </svg>
          <span class="conference-sr-only">Camera</span>
        </button>
        <div class="conference-device-panel" data-video-input-panel hidden>
          <label for="conference-video-input-select">Camera</label>
          <select
            id="conference-video-input-select"
            name="video-input"
            data-video-input-select
          >
            <option value="">Selecciona una camara</option>
          </select>
        </div>
      </div>
    </div>

    <!-- SCROLLABLE CENTER -->
    <div class="conference-bar-scrollable-wrap">
      <div class="conference-bar-group conference-bar-group--unified">
        {defaultRole !== 'admin' && (
          <button
            type="button"
            class="conference-layout-button conference-test-button"
            data-action="welcome-modal-open"
            aria-label="Configuración inicial"
            data-tooltip="Configuración inicial">CONFIG</button
          >
        )}

        <div class="conference-count-shell">
          <button
            type="button"
            class="conference-count-button"
            aria-label="Participantes conectados"
          >
            <span
              class="conference-count"
              data-participant-count
              data-compact="true">0</span
            >
          </button>
          <div class="conference-roster-popup">
            <div class="conference-roster-popup-head">
              <span class="conference-roster-popup-title">Participantes</span>
              <button
                type="button"
                class="conference-layout-button conference-kick-button"
                data-action="session-kick-toggle"
                data-tooltip="Modo expulsar Ctrl + K"
                aria-label="Expulsar participantes"
                hidden>K</button
              >
            </div>
            <div class="conference-roster-scroll">
              <ul class="conference-roster" data-participant-list>
                <li class="conference-roster-empty">
                  Todavia no hay participantes en la sala.
                </li>
              </ul>
            </div>
          </div>
        </div>

        <button
          type="button"
          class="conference-live-activity"
          data-live-activity-button
          aria-label="Abrir interacción en vivo"
          title="Abrir interacción en vivo"
          hidden
        >
          <span class="conference-live-led" aria-hidden="true"></span>
          <span class="conference-live-timer" data-live-activity-timer>--:--</span
          >
        </button>

        <button
          type="button"
          class="conference-layout-button conference-mute-all-button"
          data-session-mute-all-button
          data-tooltip="Silenciar todos Ctrl + M"
          aria-label="Silenciar a todos">M</button
        >

        <button
          type="button"
          class="conference-layout-button conference-instruments-button"
          data-action="instruments-toggle"
          aria-label="Instruments"
          data-tooltip="Instruments Ctrl + I"
        >
          I
        </button>

        <button
          type="button"
          class="conference-layout-button"
          data-layout-choice="teacher"
          data-tooltip="Full Speaker Ctrl + F">F</button
        >
        <button
          type="button"
          class="conference-layout-button"
          data-layout-choice="screenshare"
          data-tooltip="Share Screen Ctrl + S">S</button
        >
        <button
          type="button"
          class="conference-layout-button"
          data-layout-choice="presentation"
          data-tooltip="Presentación Ctrl + P">P</button
        >
        <button
          type="button"
          class="conference-layout-button"
          data-layout-choice="grid"
          data-tooltip="Grid Ctrl + Shift + G">G</button
        >
        <div
          class="conference-external-media-controls-shell"
          data-external-media-controls-shell
          style="display: contents;"
        >
          <button
            type="button"
            class="conference-layout-button conference-external-media-btn"
            data-action="external-media-toggle"
            data-external-media-btn
            data-tooltip="Media externa Ctrl + E"
            aria-label="External Media Session">E</button
          >
        </div>

        <button
          type="button"
          class="conference-layout-button"
          data-layout-choice="clase"
          data-tooltip="Clase (Markdown) Ctrl + D">C</button
        >
        <button
          type="button"
          class="conference-layout-button"
          data-layout-choice="graph"
          data-tooltip="Graph Ctrl + G">G</button
        >
        <button
          type="button"
          class="conference-layout-button"
          data-layout-choice="whiteboard"
          data-tooltip="Pizarra Ctrl + Z">Z</button
        >
        <button
          type="button"
          class="conference-layout-button"
          data-layout-choice="lilypond"
          data-tooltip="LilyPond Live">L</button
        >

        <div class="conference-concepts-shell" data-concepts-shell hidden>
          <button
            type="button"
            class="conference-layout-button conference-concepts-btn"
            data-action="concepts-toggle"
            data-concepts-btn
            data-tooltip="Conceptos Ctrl + O"
            aria-label="Conceptos">O</button
          >
        </div>

        <button
          type="button"
          class="conference-layout-button conference-chat-focus-btn"
          data-action="chat-focus"
          data-tooltip="Chat Ctrl + C"
          >C<span class="conference-chat-unread-dot" data-chat-unread hidden
          ></span></button
        >

        <button
          type="button"
          class="conference-layout-button conference-forum-btn"
          data-action="forum-toggle"
          data-tooltip="Foro Ctrl + Shift + F"
          >Fr</button
        >

        <div class="conference-break-rooms-shell" data-break-rooms-shell hidden>
          <button
            type="button"
            class="conference-layout-button conference-break-rooms-btn"
            data-action="break-rooms-toggle"
            data-break-rooms-btn
            data-tooltip="Break Rooms Ctrl + B"
            aria-label="Break Rooms">B</button
          >
          <button
            type="button"
            class="conference-layout-button conference-break-rooms-end-btn"
            data-action="break-rooms-end"
            data-break-rooms-end-btn
            title="Terminar Break Rooms (con cuenta regresiva)"
            aria-label="Terminar Break Rooms"
            hidden>C</button
          >
          <button
            type="button"
            class="conference-layout-button conference-break-rooms-kill-btn"
            data-action="break-rooms-kill"
            data-break-rooms-kill-btn
            title="Terminar Break Rooms inmediatamente"
            aria-label="Terminar Break Rooms ahora"
            hidden>T</button
          >
        </div>
        <select
          class="conference-sr-only"
          data-layout-input
          aria-hidden="true"
          tabindex="-1"
        >
          <option value="teacher" selected={defaultLayout === "teacher"}
            >Focus</option
          >
          <option value="screenshare" selected={defaultLayout === "screenshare"}
            >Share</option
          >
          <option value="presentation" selected={defaultLayout === "presentation"}
            >Presentation</option
          >
          <option value="clase" selected={defaultLayout === "clase"}
            >Clase</option
          >
          <option value="grid" selected={defaultLayout === "grid"}>Grid</option>
          <option value="graph" selected={defaultLayout === "graph"}>Graph</option>
          <option value="whiteboard" selected={defaultLayout === "whiteboard"}
            >Whiteboard</option
          >
          <option value="lilypond" selected={defaultLayout === "lilypond"}
            >LilyPond</option
          >
          <option value="concept" selected={defaultLayout === "concept"}
            >Concept</option
          >
        </select>

        <button
          type="button"
          class="conference-share-button"
          data-action="screen-share"
          title="Compartir pantalla"
        >
          SHARE
        </button>
        <button
          type="button"
          class="conference-icon-button conference-screenshare-audio-btn"
          data-action="screenshare-audio-toggle"
          title="Screen share: audio del sistema"
          aria-pressed="false"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="conference-icon" width="14" height="14">
            <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z" fill="currentColor"/>
          </svg>
          <span class="conference-sr-only">Audio pantalla</span>
        </button>
        <button
          type="button"
          class="conference-record-button"
          data-action="record"
          aria-label="Grabar transmision"
          title="Grabar transmision"
        >
          <span class="conference-record-dot" aria-hidden="true"></span>
        </button>
        <button
          type="button"
          class="conference-icon-button conference-fullscreen-button"
          data-action="fullscreen"
          aria-label="Pantalla completa"
          title="Pantalla completa"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="conference-icon">
            <path
              d="M4 9V4h5v2H6v3H4Zm10-5h6v6h-2V6h-4V4ZM4 20v-6h2v4h4v2H4Zm14-2v-4h2v6h-6v-2h4Z"
              fill="currentColor"></path>
          </svg>
          <span class="conference-sr-only">Fullscreen</span>
        </button>
        <button
          type="button"
          class="conference-icon-button conference-shortcuts-button"
          data-action="shortcuts-help"
          aria-label="Atajos"
          title="Atajos"
        >
          <span aria-hidden="true">?</span>
          <span class="conference-sr-only">Atajos</span>
        </button>

        {defaultRole === 'teacher' && (
          <div class="conference-bar-group conference-bar-group--stats" style="border-right: 0; border-left: 1px solid var(--conference-line); margin-left: 0.5rem; padding-left: 0.5rem;">
            <span
              class="conference-stat-indicator"
              data-stat-cpu
              title="CPU · uso del hilo principal estimado por RAF"
              aria-label="CPU usage">--</span
            >
            <span
              class="conference-stat-indicator"
              data-stat-bw
              title="Ancho de banda · bytes/s WebRTC"
              aria-label="Bandwidth">--</span
            >
          </div>
        )}
        <span class="conference-session-timer" data-session-timer>00:00:00</span>
      </div>
    </div>

    <!-- FIXED RIGHT -->
    <div class="conference-bar-group conference-bar-group--fixed-right">
      <a
        href={courseHomeHref}
        class="conference-exit-button"
        aria-label="Volver"
        title="Volver"
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          class="conference-exit-icon"
        >
          <path
            d="M6.5 6.5 17.5 17.5M17.5 6.5 6.5 17.5"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.6"></path>
        </svg>
        <span class="conference-sr-only">Volver</span>
      </a>
    </div>

    <!-- Popups Layer (Outside flex groups to avoid deforming the bar) -->
    <div class="conference-break-rooms-popup" data-break-rooms-popup hidden>
      <ul class="conference-break-rooms-list" data-break-rooms-list></ul>
    </div>
  </footer>

  <template data-template="participant-card">
    <article class="conference-tile conference-tile--participant">
      <div class="conference-tile-media" data-card-media></div>
      <div
        class="conference-empty conference-empty--tile"
        data-card-placeholder
      >
      </div>
      <span class="conference-tile-hand" data-card-hand hidden>✋</span>
      <footer class="conference-tile-meta">
        <div class="conference-tile-name-row">
          <strong data-card-name>Participant</strong>
          <span class="conference-speaker-icon" data-card-speaking-icon hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true" width="12" height="12">
              <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" fill="currentColor"></path>
            </svg>
          </span>
        </div>
      </footer>
    </article>
  </template>

  <template data-template="screen-card">
    <article class="conference-tile conference-tile--screen">
      <div class="conference-tile-media" data-screen-media></div>
      <footer class="conference-tile-meta">
        <strong data-screen-name>Screen share</strong>
        <span>Shared display</span>
      </footer>
    </article>
  </template>

  <div class="conference-shortcuts-modal" data-shortcuts-modal hidden>
    <div
      class="conference-shortcuts-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="conference-shortcuts-title"
    >
      <div class="conference-shortcuts-head">
        <strong id="conference-shortcuts-title">Shortcuts</strong>
        <button
          type="button"
          class="conference-icon-button conference-shortcuts-close"
          data-shortcuts-close
          aria-label="Cerrar atajos"
          title="Cerrar"
        >
          <span aria-hidden="true">×</span>
        </button>
      </div>

      <div class="conference-shortcuts-grid">
        <section class="conference-shortcuts-section">
          <h3>Reveal</h3>
          <ul>
            <li><kbd>Shift</kbd> + <kbd>O</kbd> overview</li>
            <li><kbd>Shift</kbd> + <kbd>P</kbd> laser pointer</li>
            <li><kbd>Shift</kbd> + <kbd>S</kbd> speaker view</li>
            <li><kbd>K</kbd> / <kbd>L</kbd> previous / next slide</li>
            <li><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>G</kbd> go to slide</li>
          </ul>
        </section>

        <section class="conference-shortcuts-section">
          <h3>Stage</h3>
          <ul>
            <li><kbd>Ctrl</kbd> + <kbd>F</kbd> full stage</li>
            <li><kbd>Ctrl</kbd> + <kbd>S</kbd> share stage</li>
            <li><kbd>Ctrl</kbd> + <kbd>P</kbd> presentation stage</li>
            <li><kbd>L</kbd> boton del stage bar abre LilyPond live</li>
            <li><kbd>Ctrl</kbd> + <kbd>G</kbd> grid stage</li>
            <li><kbd>Ctrl</kbd> + <kbd>Z</kbd> whiteboard</li>
          </ul>
        </section>

        <section class="conference-shortcuts-section">
          <h3>Panels</h3>
          <ul>
            <li><kbd>Ctrl</kbd> + <kbd>O</kbd> concepts</li>
            <li><kbd>Ctrl</kbd> + <kbd>C</kbd> focus chat</li>
            <li><kbd>Ctrl</kbd> + <kbd>E</kbd> external media</li>
            <li><kbd>Ctrl</kbd> + <kbd>B</kbd> break rooms</li>
            <li><kbd>Ctrl</kbd> + <kbd>I</kbd> instruments</li>
            <li><kbd>Ctrl</kbd> + <kbd>K</kbd> kick mode</li>
          </ul>
        </section>

        <section class="conference-shortcuts-section">
          <h3>Media</h3>
          <ul>
            <li><kbd>Ctrl</kbd> + <kbd>J</kbd> join / leave room</li>
            <li><kbd>Ctrl</kbd> + <kbd>M</kbd> mute all</li>
            <li><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>S</kbd> share screen</li>
            <li><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>V</kbd> camera on / off</li>
            <li><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>N</kbd> next camera</li>
            <li><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>R</kbd> record</li>
