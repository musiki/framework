          </div>
        </div>

        <script is:inline>
          const initWelcomeActions = () => {
            const container = document.getElementById('welcome-actions-container');
            const btnResume = document.getElementById('btn-resume-course');
            const resumeLabel = document.getElementById('resume-course-label');
            const btnOpenBrowser = document.getElementById('btn-open-browser');
            const divider = document.getElementById('welcome-download-divider');
            const platforms = document.getElementById('welcome-download-platforms');

            if (!container) return;

            // Robust and pure JavaScript Tauri environment check
            const isTauri = typeof window !== 'undefined' && (
              window.__TAURI__ !== undefined ||
              window.__TAURI_INTERNALS__ !== undefined ||
              /tauri/i.test(navigator.userAgent)
            );

            const lastCourseRaw = localStorage.getItem('musiki:last-opened-course');
            let lastCourse = null;
            if (lastCourseRaw) {
              try {
                lastCourse = JSON.parse(lastCourseRaw);
              } catch (e) {
                console.warn('Failed to parse last opened course:', e);
              }
            }

            if (isTauri) {
              // Tauri client: Go directly to the last opened course, or /cursos if none.
              if (lastCourse && lastCourse.slug) {
                window.location.replace(lastCourse.slug);
              } else {
                window.location.replace('/cursos');
              }
              return;
            }

            // Web Browser: Show landing page with downloads
            if (lastCourse && lastCourse.title && lastCourse.slug) {
              if (btnResume && resumeLabel) {
                btnResume.href = lastCourse.slug;
                resumeLabel.textContent = `Continuar con ${lastCourse.title.toLowerCase()}`;
                btnResume.style.display = 'inline-flex';
              }
            }

            if (btnOpenBrowser) btnOpenBrowser.style.display = 'inline-flex';
            if (divider) divider.style.display = 'block';
            if (platforms) platforms.style.display = 'flex';
            container.style.display = 'flex';
          };

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initWelcomeActions);
          } else {
            initWelcomeActions();
          }
          document.addEventListener('astro:page-load', initWelcomeActions);
        </script>

        <div class="home-search-wrap" data-search-endpoint={hasSearchSession ? '/search.json' : '/public-search.json'}>
          <input
            type="search"
            class="home-search-input"
            id="home-search-input"
            placeholder="Buscar contenidos..."
            autocomplete="off"
            spellcheck="false"
            aria-label="Buscar contenidos públicos"
            aria-controls="home-search-results"
            aria-autocomplete="list"
          />
          <div class="home-search-filters" id="home-search-filters" aria-label="Filtrar resultados por tipo" hidden></div>
          <div
            class="home-search-results"
            id="home-search-results"
            role="listbox"
            hidden
          ></div>
        </div>
      </section>

      {featuredItems.length > 0 && (
        <section class="mosaic-section">
          <h2 class="mosaic-title">destacados</h2>
          <div class="mosaic-grid">
            {featuredItems.map((item) => (
              <a class="mosaic-card" href={item.slug.replace(/^\/cursos\//, '/')}>
                <div class="mosaic-img-container">
                  {item.img ? (
                    <img src={item.img} alt={item.title} class="mosaic-img" loading="lazy" />
                  ) : (
                    <div class="mosaic-img-placeholder">
                      <span class="mosaic-placeholder-title">{item.title}</span>
                    </div>
                  )}
                </div>
                <div class="mosaic-body">
                  <h3 class="mosaic-card-title">{item.title}</h3>
                  <div class="mosaic-meta">
                    <time datetime={item.date.toISOString()}>{item.dateHuman}</time>
                    <span class="mosaic-comments-count" title={`${item.commentCount} comentarios`}>
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle; opacity:0.8;">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                      </svg>
                      {item.commentCount}
                    </span>
                  </div>
                  <p class="mosaic-desc">{item.description}</p>
                  {item.isCourse && (
                    <div class="mosaic-footer">
                      <span class="mosaic-course-link">Ir al curso público</span>
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <div class="legal-links">
        <a href="/privacy">Política de privacidad</a>
        <a href="/terms">Términos del servicio</a>
      </div>
    </main>

    <script>
      type SearchItem = { title: string; slug: string; content: string; type: string; def?: string; sinopsis?: string };

      let searchData: SearchItem[] | null = null;
      let fetchPromise: Promise<void> | null = null;
      let activeSearchFilter = 'all';

      const getSearchType = (item: SearchItem) => {
        const raw = String(item.type || 'Otros').trim().toLocaleLowerCase('es');
        if (['concept', 'concepto', 'conceptos'].includes(raw)) return { key: 'concepts', label: 'Conceptos' };
        if (['glossary', 'glosario'].includes(raw)) return { key: 'glossary', label: 'Glosario' };
        if (['lesson', 'lessons', 'lección', 'lecciones', 'clase', 'clases'].includes(raw)) return { key: 'lessons', label: 'Clases' };
        const label = String(item.type || 'Otros').trim() || 'Otros';
        return { key: `type:${raw}`, label };
      };

      const ensureData = () => {
        if (searchData !== null) return Promise.resolve();
        if (!fetchPromise) {
          const wrap = document.querySelector<HTMLElement>('.home-search-wrap');
          const endpoint = wrap?.dataset.searchEndpoint || '/public-search.json';
          fetchPromise = fetch(endpoint)
            .then((r) => r.json())
            .then((payload: unknown) => {
              searchData = Array.isArray(payload)
                ? (payload as SearchItem[]).filter((x) => x && typeof x.title === 'string')
                : [];
            })
            .catch(() => { searchData = []; });
        }
        return fetchPromise;
      };

      const highlight = (text: string, query: string) => {
        if (!query) return text;
        const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return text.replace(
          new RegExp(`(${escaped})`, 'gi'),
          '<mark class="home-search-highlight">$1</mark>',
        );
      };

      const getSnippet = (item: SearchItem, query: string): string => {
        if (item.def) {
          const raw = `Definición: ${item.def}`;
          return highlight(raw, query);
        }
        if (item.sinopsis) {
          const raw = `Sinopsis: ${item.sinopsis}`;
          return highlight(raw, query);
        }
        const content = item.content || '';
        if (!content) return '';
        const lower = content.toLowerCase();
        const idx = lower.indexOf(query.toLowerCase());
        if (idx === -1) return content.slice(0, 80) + (content.length > 80 ? '…' : '');
        const start = Math.max(0, idx - 35);
        const end = Math.min(content.length, idx + query.length + 60);
        const raw = (start > 0 ? '…' : '') + content.slice(start, end) + (end < content.length ? '…' : '');
        return highlight(raw, query);
      };

      const initHomeSearch = () => {
        const input = document.getElementById('home-search-input');
        const results = document.getElementById('home-search-results');
        const filters = document.getElementById('home-search-filters');
        if (!(input instanceof HTMLInputElement) || !(results instanceof HTMLElement) || !(filters instanceof HTMLElement)) return;
        if (input.dataset.searchBound === 'true') return;
        input.dataset.searchBound = 'true';
        const wrap = input.closest('.home-search-wrap');

        const renderFilters = () => {
          if (!searchData) return;
          const counts = new Map<string, { label: string; count: number }>();
          searchData.forEach((item) => {
            const type = getSearchType(item);
            const current = counts.get(type.key) || { label: type.label, count: 0 };
            current.count += 1;
            counts.set(type.key, current);
          });
          const preferred = ['concepts', 'glossary', 'lessons'];
          const entries = Array.from(counts.entries()).sort(([leftKey, left], [rightKey, right]) => {
            const leftOrder = preferred.indexOf(leftKey);
            const rightOrder = preferred.indexOf(rightKey);
            if (leftOrder !== -1 || rightOrder !== -1) return (leftOrder === -1 ? 99 : leftOrder) - (rightOrder === -1 ? 99 : rightOrder);
            return left.label.localeCompare(right.label, 'es');
          });
          filters.innerHTML = [
            `<button type="button" class="home-search-filter ${activeSearchFilter === 'all' ? 'is-active' : ''}" data-search-filter="all">Todas (${searchData.length})</button>`,
            ...entries.map(([key, value]) => `<button type="button" class="home-search-filter ${activeSearchFilter === key ? 'is-active' : ''}" data-search-filter="${key}">${value.label} (${value.count})</button>`),
          ].join('');
          filters.hidden = false;
        };

        // Prefetch on focus
        input.addEventListener('focus', () => void ensureData().then(renderFilters), { once: true });

        const clear = () => {
          results.hidden = true;
          results.innerHTML = '';
        };

        const render = (query: string) => {
          if (!searchData || query.length < 2) { clear(); return; }

          const q = query.toLowerCase();
          const matched = searchData
            .filter((item) => activeSearchFilter === 'all' || getSearchType(item).key === activeSearchFilter)
            .filter((item) => [item.title, item.content, item.def, item.sinopsis].some((value) => String(value || '').toLowerCase().includes(q)))
            .slice(0, 8);

          if (matched.length === 0) { clear(); return; }

          results.innerHTML = matched.map((item) => {
            const titleHl = highlight(item.title, query);
            const snippet = getSnippet(item, query);
            const slug = item.slug.replace(/^\/cursos\//, '/');
            return `<a class="home-search-result-item" href="${slug}" role="option">
              <p class="home-search-result-title">${titleHl}</p>
              ${snippet ? `<p class="home-search-result-meta">${snippet}</p>` : ''}
            </a>`;
          }).join('');

          results.hidden = false;
        };

        input.addEventListener('input', (e) => {
          const q = (e.target as HTMLInputElement).value.trim();
          if (q.length < 2) { clear(); return; }
          void ensureData().then(() => render(q));
        });

        filters.addEventListener('click', (e) => {
          const button = e.target instanceof Element ? e.target.closest<HTMLButtonElement>('[data-search-filter]') : null;
          if (!button) return;
          activeSearchFilter = button.dataset.searchFilter || 'all';
          renderFilters();
          render(input.value.trim());
        });

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            const first = results.querySelector<HTMLAnchorElement>('a');
            if (first) { window.location.href = first.getAttribute('href') || ''; }
          }
          if (e.key === 'Escape') clear();
        });

        document.addEventListener('click', (e) => {
          if (!(e.target instanceof Element)) return;
          if (!(wrap instanceof HTMLElement) || !wrap.contains(e.target)) clear();
        });
      };

      document.addEventListener('astro:page-load', initHomeSearch);
      initHomeSearch();
    </script>
  </body>
</html>
