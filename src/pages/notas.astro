---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { createSupabaseServerClient, ensureDbUserFromSession } from '../lib/forum-server';
import '../styles/theme.css';

export const prerender = false;

const session = (Astro.locals as any).session;
if (!session?.user) return Astro.redirect('/login?redirect=/notas');

const supabase = createSupabaseServerClient();
const user = await ensureDbUserFromSession(supabase, session);
if (!user) return Astro.redirect('/login?redirect=/notas');

const url = new URL(Astro.request.url);
const activeId = url.searchParams.get('id') || null;

const { data: notes } = await supabase
  .from('LiveClassNote')
  .select('id, title, body, renderedHtml, noteDate, courseId, roomName, createdAt, updatedAt')
  .eq('userId', user.id)
  .order('noteDate', { ascending: false })
  .order('updatedAt', { ascending: false })
  .limit(200);

const allNotes = notes ?? [];
const activeNote = activeId
  ? allNotes.find(n => n.id === activeId) ?? allNotes[0] ?? null
  : allNotes[0] ?? null;

// Group: courseId → dateGroup → notes[]
const byCourse: Record<string, Record<string, typeof allNotes>> = {};
for (const note of allNotes) {
  const course = note.courseId || 'sin_curso';
  const date   = note.noteDate ?? 'sin fecha';
  if (!byCourse[course]) byCourse[course] = {};
  if (!byCourse[course][date]) byCourse[course][date] = [];
  byCourse[course][date].push(note);
}

// editing = no active note, or just landed fresh
const startInEditMode = !activeNote;
---

<html lang="es">
  <head>
    <BaseHead title="Mis notas" description="Notas de clase personal" />
    <style>
      .notas-shell {
        display: grid;
        grid-template-columns: 210px 1fr;
        min-height: calc(100dvh - var(--musiki-header-height, 4rem));
        max-width: 1080px;
        margin: 0 auto;
        padding: 1.5rem 1rem;
        gap: 1.5rem;
        align-items: start;
      }

      @media (max-width: 640px) {
        .notas-shell { grid-template-columns: 1fr; padding: 0.75rem 0.5rem; gap: 1rem; }
        .notas-sidebar { order: 2; }
        .notas-main   { order: 1; }
      }

      /* ── Sidebar ── */
      .notas-sidebar {
        position: sticky;
        top: calc(var(--musiki-header-height, 4rem) + 1rem);
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        max-height: calc(100dvh - var(--musiki-header-height, 4rem) - 2rem);
        overflow-y: auto;
      }

      .notas-sidebar-heading {
        font-size: 0.62rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--gray, #6c7a9e);
        opacity: 0.5;
        padding: 0.5rem 0 0.2rem;
        position: sticky;
        top: 0;
        background: var(--c-bg, #fff);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.3rem;
      }

      .notas-course-block { margin-bottom: 0.5rem; }

      .notas-course-label {
        font-size: 0.6rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray, #6c7a9e);
        opacity: 0.6;
        padding: 0.25rem 0.3rem;
        border-bottom: 1px solid rgba(100,100,120,0.12);
        margin-bottom: 0.15rem;
      }

      .notas-date-label {
        font-size: 0.58rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--gray, #6c7a9e);
        opacity: 0.4;
        padding: 0.2rem 0.3rem 0.05rem;
      }

      .notas-list-item {
        display: block;
        padding: 0.22rem 0.5rem;
        font-size: 0.75rem;
        color: var(--c-fg, #333);
        text-decoration: none;
        border-radius: 3px;
        border-left: 2px solid transparent;
        opacity: 0.55;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: opacity 120ms, border-color 120ms;
      }
      .notas-list-item:hover { opacity: 0.85; }
      .notas-list-item.active {
        opacity: 1;
        border-left-color: var(--accent, #2337ff);
        color: var(--accent, #2337ff);
      }

      .notas-empty-sidebar { font-size: 0.78rem; opacity: 0.4; padding: 0.5rem 0; }

      /* ── Main ── */
      .notas-main { min-width: 0; }

      .notas-toolbar {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-bottom: 1rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid rgba(100,100,120,0.12);
        flex-wrap: wrap;
      }
      .notas-toolbar[hidden] { display: none; }

      .notas-toolbar-title {
        font-size: 1rem;
        font-weight: 700;
        margin: 0;
        flex: 1;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .notas-toolbar-meta {
        font-size: 0.68rem;
        opacity: 0.4;
        letter-spacing: 0.04em;
        white-space: nowrap;
      }

      .notas-room-tag {
        font-size: 0.62rem;
        padding: 0.1rem 0.38rem;
        border: 1px solid rgba(100,100,120,0.28);
        border-radius: 2px;
        opacity: 0.5;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      /* wireframe action buttons */
      .notas-btn {
        padding: 0.22rem 0.6rem;
        border-radius: 2px;
        background: transparent;
        font: inherit;
        font-size: 0.68rem;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        cursor: pointer;
        transition: border-color 150ms, color 150ms, background 150ms;
        display: inline-flex;
        align-items: center;
      }
      .notas-btn[hidden] { display: none !important; }

      .notas-btn--new {
        border: 1px solid rgba(60,140,80,0.4);
        color: rgba(40,120,60,0.75);
      }
      .notas-btn--new:hover {
        border-color: rgba(60,160,80,0.75);
        color: rgba(30,110,50,0.95);
        background: rgba(60,140,70,0.05);
      }

      .notas-btn--save {
        border: 1px solid rgba(160,160,170,0.35);
        color: rgba(60,60,80,0.6);
      }
      .notas-btn--save:hover {
        border-color: rgba(160,160,170,0.7);
        color: rgba(20,20,40,0.9);
      }

      .notas-btn--cancel {
        border: 1px solid rgba(120,120,130,0.3);
        color: rgba(80,80,100,0.5);
      }
      .notas-btn--cancel:hover {
        border-color: rgba(120,120,130,0.6);
        color: rgba(60,60,80,0.8);
      }

      .notas-btn--edit {
        border: 1px solid rgba(80,140,220,0.4);
        color: rgba(60,110,200,0.7);
      }
      .notas-btn--edit:hover {
        border-color: rgba(80,140,220,0.8);
        color: rgba(40,90,200,0.95);
        background: rgba(60,120,200,0.05);
      }

      .notas-btn--delete {
        border: 1px solid rgba(200,70,70,0.35);
        color: rgba(180,60,60,0.6);
      }
      .notas-btn--delete:hover {
        border-color: rgba(220,80,80,0.7);
        color: rgba(200,50,50,0.9);
        background: rgba(200,60,60,0.05);
      }

      /* Edit form */
      .notas-edit-form { display: flex; flex-direction: column; gap: 0.5rem; }
      .notas-edit-form[hidden] { display: none; }

      .notas-input-title {
        font-size: 1rem;
        font-weight: 700;
        padding: 0.3rem 0;
        border: 0;
        border-bottom: 1px solid rgba(100,100,120,0.2);
        background: transparent;
        width: 100%;
        color: inherit;
        font-family: inherit;
      }
      .notas-input-title:focus { outline: none; border-bottom-color: var(--accent, #2337ff); }

      .notas-input-body {
        font-size: 0.9rem;
        padding: 0.5rem;
        border: 1px solid rgba(100,100,120,0.2);
        border-radius: 3px;
        background: transparent;
        width: 100%;
        min-height: 12rem;
        resize: vertical;
        color: inherit;
        font-family: var(--font-family-mono, monospace);
        line-height: 1.6;
      }
      .notas-input-body:focus { outline: none; border-color: var(--accent, #2337ff); }

      /* Dropzone wrapper injected by enhanceMarkdownTextarea */
      .notas-editor-dropzone {
        position: relative;
        display: flex;
        flex-direction: column;
      }
      .notas-editor-dropzone[hidden] { display: none; }

      .notas-editor-dropzone-overlay {
        position: absolute;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        border-radius: 3px;
        background: rgba(35, 55, 255, 0.08);
        border: 2px dashed rgba(35, 55, 255, 0.35);
        pointer-events: none;
        z-index: 2;
      }
      .notas-editor-dropzone.is-upload-target .notas-editor-dropzone-overlay { display: flex; }

      .notas-editor-dropzone-label {
        font-size: 0.7rem;
        color: var(--accent, #2337ff);
        opacity: 0.8;
        letter-spacing: 0.06em;
      }

      /* CodeMirror host */
      .notas-editor-cm {
        width: 100%;
        min-height: 12rem;
        border: 1px solid rgba(100,100,120,0.2);
        border-radius: 3px;
        background: transparent;
        color: inherit;
        font-size: 0.9rem;
        line-height: 1.6;
      }
      .notas-editor-cm .cm-editor { background: transparent; }
      .notas-editor-cm .cm-editor.cm-focused { outline: none; }
      .notas-editor-cm.is-upload-target { border-color: var(--accent, #2337ff); }

      /* Template + upload buttons row */
      .notas-editor-actions {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        flex-wrap: wrap;
      }

      .notas-editor-action-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.8rem;
        height: 1.8rem;
        padding: 0;
        border: 1px solid rgba(100,100,120,0.28);
        border-radius: 2px;
        background: transparent;
        color: rgba(80,80,100,0.55);
        cursor: pointer;
        flex-shrink: 0;
        font: inherit;
        font-size: 0.72rem;
        transition: border-color 140ms, color 140ms;
      }
      .notas-editor-action-btn svg {
        width: 1rem;
        height: 1rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .notas-editor-action-btn:hover {
        border-color: rgba(100,100,130,0.6);
        color: rgba(40,40,70,0.9);
      }
      .notas-editor-action-spacer { flex: 1; }

      /* Rendered content */
      .notas-body {
        font-size: var(--font-size-base, 1rem);
        line-height: var(--line-height-base, 1.72);
      }
      .notas-body[hidden] { display: none; }
      .notas-body img { max-width: 100%; height: auto; }
      .notas-body pre { overflow-x: auto; }
      .notas-body .mermaid {
        padding: 0.5rem;
        border: 1px dashed rgba(100,100,120,0.2);
        border-radius: 3px;
      }

      /* Empty state */
      .notas-empty { padding: 2.5rem 1rem; opacity: 0.38; font-size: 0.9rem; }

      .notas-status {
        font-size: 0.72rem;
        opacity: 0;
        transition: opacity 200ms;
        color: var(--accent, #2337ff);
        padding-left: 0.25rem;
      }
      .notas-status.visible { opacity: 1; }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="notas-shell">

        <!-- Sidebar -->
        <aside class="notas-sidebar">
          <div class="notas-sidebar-heading">
            <span>Notas</span>
            <span style="display:inline-flex;gap:0.3rem;align-items:center">
              <button type="button" class="notas-btn notas-btn--new" id="notas-new-btn">+ Nueva</button>
              {allNotes.length > 0 && (
                <button type="button" class="notas-btn notas-btn--save" id="notas-dump-btn"
                  style="font-size:0.6rem;padding:0.1rem 0.4rem">↓ todo</button>
              )}
            </span>
          </div>

          {allNotes.length === 0 ? (
            <p class="notas-empty-sidebar">Sin notas aún.</p>
          ) : (
            Object.entries(byCourse).map(([courseKey, dateGroups]) => (
              <div class="notas-course-block">
                {Object.keys(byCourse).length > 1 && (
                  <div class="notas-course-label">
                    {courseKey === 'sin_curso' ? 'General' : courseKey}
                  </div>
                )}
                {Object.entries(dateGroups).map(([date, dateNotes]) => (
                  <div>
                    <div class="notas-date-label">{date}</div>
                    {dateNotes.map(note => (
                      <a
                        href={`/notas?id=${note.id}`}
                        class:list={['notas-list-item', activeNote?.id === note.id ? 'active' : '']}
                        title={note.title || '(sin título)'}
                      >
                        {note.title || '(sin título)'}
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            ))
          )}
        </aside>

        <!-- Main -->
        <section class="notas-main">

          <!-- Read-mode toolbar (hidden when no active note or in edit mode) -->
          <div class="notas-toolbar" id="notas-toolbar" hidden={startInEditMode}>
            <h1 class="notas-toolbar-title" id="notas-display-title">
              {activeNote?.title || '(sin título)'}
            </h1>
            <span class="notas-toolbar-meta" id="notas-display-meta">
              {activeNote?.noteDate ?? ''}
            </span>
            {activeNote?.roomName && (
              <span class="notas-room-tag" id="notas-display-room">{activeNote.roomName}</span>
            )}
            <button type="button" class="notas-btn notas-btn--edit" id="notas-edit-btn">Editar</button>
            <button type="button" class="notas-btn notas-btn--delete" id="notas-delete-btn">Borrar</button>
            <span class="notas-status" id="notas-status-view"></span>
          </div>

          <!-- Edit form -->
          <form class="notas-edit-form" id="notas-form" hidden={!startInEditMode}>
            <input
              class="notas-input-title"
              id="notas-input-title"
              type="text"
              value={activeNote?.title ?? ''}
              placeholder="Título"
              maxlength="160"
            />
            <textarea
              class="notas-input-body"
              id="notas-input-body"
              rows="14"
              placeholder="Escribe tu nota… (markdown, ```mermaid, ```lilypond)"
            >{activeNote?.body ?? ''}</textarea>
            <!-- Action buttons row — template buttons prepended here by enhanceMarkdownTextarea -->
            <div class="notas-editor-actions" id="notas-editor-actions">
              <button type="submit" class="notas-btn notas-btn--save">Guardar</button>
              <button type="button" class="notas-btn notas-btn--cancel" id="notas-cancel-btn"
                hidden={startInEditMode && allNotes.length === 0}>Cancelar</button>
              <span class="notas-status" id="notas-status"></span>
            </div>
          </form>

          <!-- Rendered body (read mode) -->
          <div class="notas-body" id="notas-body" hidden={startInEditMode}>
            {activeNote?.renderedHtml ? (
              <Fragment set:html={activeNote.renderedHtml} />
            ) : activeNote ? (
              <pre style="white-space:pre-wrap;font-size:0.9rem;opacity:0.7">{activeNote.body}</pre>
            ) : null}
          </div>

          {allNotes.length === 0 && (
            <p class="notas-empty" id="notas-empty" hidden>Sin notas aún.</p>
          )}
        </section>
      </div>
    </main>

    <!-- Expose enhanceMarkdownTextarea from the bundled module -->
    <script>
      import { enhanceMarkdownTextarea } from '../scripts/markdown-editor-tools.ts';
      (window as any).__notesEnhanceTextarea = enhanceMarkdownTextarea;
    </script>

    <script define:vars={{
      activeNoteId: activeNote?.id ?? null,
      allNotesData: allNotes.map(n => ({ title: n.title, body: n.body, noteDate: n.noteDate, courseId: n.courseId, roomName: n.roomName })),
      hasNotes: allNotes.length > 0,
    }}>
      // ── Elements ──────────────────────────────────────────────────────────
      const toolbar    = document.getElementById('notas-toolbar');
      const form       = document.getElementById('notas-form');
      const bodyEl     = document.getElementById('notas-body');
      const titleInput = document.getElementById('notas-input-title');
      const bodyInput  = document.getElementById('notas-input-body');
      const actionsEl  = document.getElementById('notas-editor-actions');
      const editBtn    = document.getElementById('notas-edit-btn');
      const deleteBtn  = document.getElementById('notas-delete-btn');
      const cancelBtn  = document.getElementById('notas-cancel-btn');
      const newBtn     = document.getElementById('notas-new-btn');
      const dumpBtn    = document.getElementById('notas-dump-btn');
      const statusEl   = document.getElementById('notas-status');
      const statusViewEl = document.getElementById('notas-status-view');
      const displayTitle = document.getElementById('notas-display-title');
      const displayMeta  = document.getElementById('notas-display-meta');

      // Current note being edited (null = new note)
      let currentNoteId = activeNoteId;

      // ── Status helper ─────────────────────────────────────────────────────
      let statusTimer = 0;
      const setStatus = (msg, ok = true, el = statusEl) => {
        if (!el) return;
        el.textContent = msg;
        el.style.color = ok ? 'var(--accent, #2337ff)' : '#c03030';
        el.classList.add('visible');
        clearTimeout(statusTimer);
        statusTimer = setTimeout(() => el.classList.remove('visible'), 2800);
      };

      // ── CodeMirror attachment ─────────────────────────────────────────────
      let editorAttached = false;
      const attachEditor = () => {
        if (editorAttached) return;
        const enhance = window.__notesEnhanceTextarea;
        if (typeof enhance !== 'function' || !(bodyInput instanceof HTMLTextAreaElement)) return;
        editorAttached = true;
        enhance(bodyInput, {
          actionsContainer: actionsEl instanceof HTMLElement ? actionsEl : null,
          status: (msg, tone) => setStatus(msg, tone !== 'error'),
          buttonClassName: 'notas-editor-action-btn',
          actionSpacerClassName: 'notas-editor-action-spacer',
          dropzoneClassName: 'notas-editor-dropzone',
          dropzoneOverlayClassName: 'notas-editor-dropzone-overlay',
          dropzoneLabelClassName: 'notas-editor-dropzone-label',
          inputClassName: 'notas-editor-cm',
          dropLabel: 'Soltar archivo',
          useCodeMirror: true,
        });
      };

      // Set body textarea value and sync to CodeMirror
      const setBodyValue = (val) => {
        if (!(bodyInput instanceof HTMLTextAreaElement)) return;
        bodyInput.value = val;
        bodyInput.dispatchEvent(new Event('input', { bubbles: true }));
      };

      // Get the editor container (dropzone wrapper after CM, raw textarea before)
      const getEditorContainer = () =>
        bodyInput?.closest('.notas-editor-dropzone') ?? bodyInput;

      // ── Mode switching ────────────────────────────────────────────────────
      const enterEditMode = (note) => {
        // note = { id, title, body } or null for new
        currentNoteId = note?.id ?? null;

        if (titleInput instanceof HTMLInputElement)
          titleInput.value = note?.title ?? '';
        setBodyValue(note?.body ?? '');

        attachEditor();

        // Show form, hide body + toolbar
        form?.removeAttribute('hidden');
        bodyEl?.setAttribute('hidden', '');
        toolbar?.setAttribute('hidden', '');

        // Show cancel only when editing existing note
        if (note) {
          cancelBtn?.removeAttribute('hidden');
        } else {
          cancelBtn?.setAttribute('hidden', '');
        }

        titleInput?.focus();
      };

      const enterReadMode = (note) => {
        // note = { id, title, body, renderedHtml, noteDate, roomName }
        currentNoteId = note?.id ?? null;

        if (displayTitle) displayTitle.textContent = note?.title || '(sin título)';
        if (displayMeta)  displayMeta.textContent  = note?.noteDate ?? '';

        // Update rendered content
        if (bodyEl) {
          if (note?.renderedHtml) {
            bodyEl.innerHTML = note.renderedHtml;
          } else if (note?.body) {
            bodyEl.innerHTML = `<pre style="white-space:pre-wrap;font-size:0.9rem;opacity:0.7">${escapeHtml(note.body)}</pre>`;
          } else {
            bodyEl.innerHTML = '';
          }
          runMermaid(bodyEl);
          if (typeof window.hydrateLilypondBlocks === 'function')
            window.hydrateLilypondBlocks(bodyEl);
        }

        // Show toolbar + body, hide form
        toolbar?.removeAttribute('hidden');
        bodyEl?.removeAttribute('hidden');
        form?.setAttribute('hidden', '');

        // Update sidebar active item
        document.querySelectorAll('.notas-list-item').forEach(el => {
          el.classList.toggle('active', el.getAttribute('href') === `/notas?id=${note?.id}`);
        });

        // Update URL without reload
        if (note?.id) history.replaceState(null, '', `/notas?id=${note.id}`);
      };

      // ── Save ──────────────────────────────────────────────────────────────
      const doSave = async () => {
        const title = (titleInput instanceof HTMLInputElement) ? titleInput.value.trim() : '';
        const body  = (bodyInput instanceof HTMLTextAreaElement) ? bodyInput.value : '';
        if (!body.trim()) { setStatus('El cuerpo no puede estar vacío', false); return; }

        const payload = {
          title,
          body,
          noteDate: new Date().toISOString().slice(0, 10),
          ...(currentNoteId ? { id: currentNoteId } : {}),
        };

        const res = await fetch('/api/live/notes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }).catch(() => null);

        if (!res?.ok) { setStatus('Error al guardar', false); return; }
        const data = await res.json().catch(() => null);
        const saved = data?.note;

        setStatus('Guardado');

        // Switch to read mode with server data (or fallback to local)
        const noteForRead = {
          id:          saved?.id ?? currentNoteId,
          title,
          body,
          noteDate:    saved?.noteDate ?? new Date().toISOString().slice(0, 10),
          roomName:    saved?.roomName ?? null,
          renderedHtml: null, // start without, then poll
        };
        enterReadMode(noteForRead);

        // Add to sidebar if new note
        if (!currentNoteId && saved?.id) {
          addSidebarItem(saved);
        }

        // Poll for server-rendered HTML (LilyPond etc.)
        const pollId = saved?.id;
        if (pollId) {
          setTimeout(async () => {
            if (currentNoteId !== pollId) return;
            const r = await fetch(`/api/live/notes?limit=1&id=${pollId}`).catch(() => null);
            if (!r?.ok) return;
            const d = await r.json().catch(() => null);
            const updated = (d?.notes ?? []).find(n => n.id === pollId);
            if (updated?.renderedHtml && bodyEl && currentNoteId === pollId) {
              bodyEl.innerHTML = updated.renderedHtml;
              runMermaid(bodyEl);
              if (typeof window.hydrateLilypondBlocks === 'function')
                window.hydrateLilypondBlocks(bodyEl);
            }
          }, 3000);
        }
      };

      // ── Delete ────────────────────────────────────────────────────────────
      const doDelete = async () => {
        if (!currentNoteId) return;
        if (!confirm('¿Borrar esta nota?')) return;
        const res = await fetch(`/api/live/notes?id=${currentNoteId}`, { method: 'DELETE' }).catch(() => null);
        if (!res?.ok) { setStatus('Error al borrar', false, statusViewEl); return; }
        // Remove from sidebar
        document.querySelector(`.notas-list-item[href="/notas?id=${currentNoteId}"]`)?.closest('a')?.remove();
        // Navigate to first remaining note or empty state
        const next = document.querySelector('.notas-list-item');
        if (next) {
          const nextId = new URL(next.getAttribute('href'), location.origin).searchParams.get('id');
          if (nextId) { window.location.href = `/notas?id=${nextId}`; return; }
        }
        window.location.href = '/notas';
      };

      // ── Sidebar item injection (after creating a note) ────────────────────
      const addSidebarItem = (note) => {
        // Find or create a sidebar course block (we'll use the page's first block)
        const sidebar = document.querySelector('.notas-sidebar');
        if (!sidebar) return;
        let block = sidebar.querySelector('.notas-course-block');
        if (!block) {
          // Remove the "Sin notas" text if present
          sidebar.querySelector('.notas-empty-sidebar')?.remove();
          block = document.createElement('div');
          block.className = 'notas-course-block';
          sidebar.appendChild(block);
        }
        const link = document.createElement('a');
        link.href = `/notas?id=${note.id}`;
        link.className = 'notas-list-item active';
        link.title = note.title || '(sin título)';
        link.textContent = note.title || '(sin título)';
        block.prepend(link);
        document.querySelectorAll('.notas-list-item').forEach(el => {
          if (el !== link) el.classList.remove('active');
        });
      };

      // ── Helpers ───────────────────────────────────────────────────────────
      const escapeHtml = (s) =>
        s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

      function runMermaid(container) {
        const nodes = Array.from(container.querySelectorAll('.mermaid'));
        if (!nodes.length) return;
        const load = () => {
          if (window.mermaid?.run) return Promise.resolve(window.mermaid);
          if (window.__notesPageMermaid) return window.__notesPageMermaid;
          window.__notesPageMermaid = new Promise(resolve => {
            const s = document.createElement('script');
            s.src = 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js';
            s.onload = () => resolve(window.mermaid ?? null);
            s.onerror = () => resolve(null);
            document.head.appendChild(s);
          });
          return window.__notesPageMermaid;
        };
        load().then(m => {
          if (!m?.run) return;
          try { m.initialize({ startOnLoad: false, theme: 'default' }); m.run({ nodes }); } catch {}
        });
      }

      // ── Event wiring ──────────────────────────────────────────────────────
      // Nueva nota
      newBtn?.addEventListener('click', () => enterEditMode(null));

      // Edit existing
      editBtn?.addEventListener('click', () => {
        const body = bodyEl?.querySelector('pre')?.textContent
          ?? bodyEl?.innerText
          ?? '';
        const title = displayTitle?.textContent ?? '';
        // We don't have the raw body available directly; reload from API
        fetch(`/api/live/notes?limit=1&id=${currentNoteId}`)
          .then(r => r.json())
          .then(d => {
            const note = (d?.notes ?? []).find(n => n.id === currentNoteId);
            if (note) enterEditMode(note);
          })
          .catch(() => {
            // Fallback with what we have
            enterEditMode({ id: currentNoteId, title, body });
          });
      });

      // Cancel
      cancelBtn?.addEventListener('click', () => {
        // Go back to reading the current note
        fetch(`/api/live/notes?limit=1&id=${currentNoteId}`)
          .then(r => r.json())
          .then(d => {
            const note = (d?.notes ?? []).find(n => n.id === currentNoteId);
            if (note) enterReadMode(note);
          })
          .catch(() => toolbar?.removeAttribute('hidden'));
      });

      // Save via form submit
      form?.addEventListener('submit', e => { e.preventDefault(); doSave(); });

      // Delete
      deleteBtn?.addEventListener('click', doDelete);

      // Ctrl/Cmd+Enter anywhere in the form
      form?.addEventListener('keydown', e => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
          e.preventDefault();
          doSave();
        }
      });

      // Dump all notes
      dumpBtn?.addEventListener('click', () => {
        const chunks = allNotesData.map(n => {
          const meta = [n.noteDate, n.courseId, n.roomName].filter(Boolean).join(' · ');
          return `# ${n.title || '(sin título)'}\n${meta ? `_${meta}_\n` : ''}\n${n.body || ''}`;
        });
        const text = chunks.join('\n\n---\n\n');
        const blob = new Blob([text], { type: 'text/markdown; charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a'); a.href = url;
        a.download = `notas-${new Date().toISOString().slice(0, 10)}.md`;
        a.click(); URL.revokeObjectURL(url);
      });

      // ── Init ──────────────────────────────────────────────────────────────
      // Attach editor on DOMContentLoaded if form is visible (no active note = new note mode)
      document.addEventListener('DOMContentLoaded', () => {
        if (!activeNoteId) attachEditor();

        // Run mermaid + lilypond on initial rendered body
        const initialBody = document.getElementById('notas-body');
        if (initialBody && !initialBody.hidden) {
          runMermaid(initialBody);
          if (typeof window.hydrateLilypondBlocks === 'function')
            window.hydrateLilypondBlocks(initialBody);
        }
      });
    </script>

    <script>
      import { hydrateLilypondBlocks, setupLilypondAutoHydration } from '../lib/lilypond-player';
      (window as any).hydrateLilypondBlocks = hydrateLilypondBlocks;
      setupLilypondAutoHydration();
    </script>
  </body>
</html>
