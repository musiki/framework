        color: #fecaca;
      }
      :root.dark .dashboard-progress__track {
        background: color-mix(in srgb, var(--c-bg) 72%, #fff 6%);
      }
      :root.dark .dashboard-progress--high {
        color: #bbf7d0;
      }
      :root.dark .dashboard-progress--mid {
        color: #fde68a;
      }
      :root.dark .dashboard-progress--low {
        color: #fecaca;
      }
      :root.dark .dashboard-pill--absence-warning {
        color: #fde68a;
      }
      :root.dark .dashboard-pill--absence-critical {
        color: #fecaca;
      }
      :root.dark .attendance-config-state[data-state="saved"] {
        color: #86efac;
      }
      :root.dark .attendance-config-state[data-state="saving"] {
        color: #fcd34d;
      }
      :root.dark .attendance-config-state[data-state="error"] {
        color: #fca5a5;
      }
      :root.dark .dashboard-pill--absence {
        color: #fecaca;
      }
      :root.dark .dashboard-pill--risk-bajo {
        color: #bbf7d0;
      }
      :root.dark .dashboard-pill--risk-medio {
        color: #fde68a;
      }
      :root.dark .dashboard-pill--risk-alto {
        color: #fecaca;
      }
      :root.dark .dashboard-attendance-fill-btn:hover {
        color: #bbf7d0;
        background: rgba(34, 197, 94, 0.12);
      }
      :root.dark .dashboard-attendance-chip--present {
        color: #bbf7d0;
      }
      :root.dark .dashboard-attendance-chip--room {
        background: rgba(139, 92, 246, 0.2);
        color: #c4b5fd;
      }
      :root.dark .dashboard-attendance-chip--partial {
        color: #fde68a;
      }
      @media (max-width: 720px) {
        .dashboard-annotation-modal__grid {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 499px) {
        .dashboard-tabulator .tabulator-frozen,
        .dashboard-tabulator .tabulator-frozen-left,
        .dashboard-tabulator .tabulator-frozen-right {
          position: relative !important;
          left: auto !important;
        }
        .dashboard-tabulator .tabulator-tableholder {
          overflow-x: auto !important;
        }
        .teacher-grid-shell {
          overflow-x: auto;
        }
      }
      .eval-id-anchor {
        border: none;
        background: transparent;
        color: inherit;
        font: inherit;
        cursor: help;
        padding: 0;
      }
      .eval-id-anchor code {
        text-decoration: underline dotted;
        text-underline-offset: 2px;
      }
      .eval-preview-tooltip {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 2400;
        max-width: min(440px, 92vw);
        border: 1px solid var(--c-border);
        border-radius: 8px;
        background: var(--c-bg);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
        padding: 0.55rem 0.65rem;
        pointer-events: none;
      }
      .eval-preview-tooltip[hidden] {
        display: none !important;
      }
      .eval-preview-tooltip h4 {
        margin: 0 0 0.4rem 0;
        font-size: 0.85rem;
      }
      .eval-preview-tooltip p {
        margin: 0 0 0.35rem 0;
        font-size: 0.79rem;
        line-height: 1.42;
      }
      .eval-preview-tooltip ul {
        margin: 0 0 0.35rem 1rem;
        padding: 0;
        font-size: 0.79rem;
        line-height: 1.4;
      }
      .eval-preview-tooltip li {
        margin: 0 0 0.2rem 0;
      }
      .eval-preview-tooltip code {
        font-size: 0.75rem;
      }
      @media (max-width: 1130px) {
        .dashboard-topbar-tabs {
          flex: 0 0 auto;
          min-width: max-content;
        }
        .dashboard-topbar-controls {
          flex: 1 1 auto;
          min-width: 0;
          justify-content: flex-start;
        }
        .dashboard-topbar-context--search {
          flex: 1 1 auto;
          min-width: 6rem;
        }
        .dashboard-topbar-search {
          width: 100%;
          min-width: 0;
        }
        .dashboard-scope-field--inline {
          flex: 0 0 auto;
          min-width: 9.2rem;
        }
      }
      @media (max-width: 900px) {
        .wrap {
          padding: 0;
        }
        .dashboard-shell {
          grid-template-columns: 1fr;
          height: auto;
          max-height: none;
          overflow: visible;
        }
        .dashboard-sidebar {
          position: static;
          height: auto;
          max-height: none;
          overflow: visible;
        }
        .dashboard-main {
          height: auto;
          overflow: visible;
          padding-right: 0;
        }
        .dashboard-shell[data-left-open="false"] .dashboard-sidebar,
        .dashboard-shell[data-left-open="true"] .dashboard-sidebar {
          overflow: visible;
          pointer-events: all;
          padding: 0.4rem 0.62rem 0;
        }
        .dashboard-sidebar-header {
          display: none;
        }
        .dashboard-sidebar-handle,
        .dashboard-sidebar-toggle {
          display: none !important;
        }
        .log-toolbar {
          grid-template-columns: 1fr;
        }
        .tabs {
          display: flex;
          flex-wrap: wrap;
          border-bottom: 1px solid var(--c-border);
          margin-bottom: 0.2rem;
          grid-template-columns: unset;
        }
        .dashboard-scope-controls {
          display: flex;
          flex-wrap: nowrap;
          align-items: flex-end;
          gap: 0.55rem;
          width: 100%;
          padding-top: 0.7rem;
          grid-column: unset;
          overflow-x: auto;
          overflow-y: hidden;
          scrollbar-width: thin;
        }
        .dashboard-scope-field {
          display: inline-flex;
          flex-direction: column;
          flex: 0 0 auto;
          min-width: 144px;
        }
        .tab {
          border-left: 0;
          border-bottom: 2px solid transparent;
          font-size: 0.88rem;
          padding: 0.38rem 0.55rem;
        }
        .tab.active {
          border-left-color: transparent;
          border-bottom-color: var(--c-link);
        }
        .teacher-grid-toolbar,
        .teacher-grid-toolbar--section {
          display: flex;
          flex-wrap: nowrap;
          overflow-x: auto;
          overflow-y: hidden;
        }
        .attendance-config-bar--toolbar {
          flex-wrap: nowrap;
        }
        .attendance-config-bar--toolbar .attendance-config-input {
          width: 8.2rem;
          min-width: 8.2rem;
          max-width: 8.2rem;
        }
        .agenda-config-bar {
          width: 100%;
        }
        .agenda-grid {
          min-width: 42rem;
        }
        .agenda-grid__day-head {
          min-width: 6.8rem;
        }
        .agenda-modal__dialog,
        .agenda-modal__dialog--wide {
          width: calc(100vw - 1rem);
          max-width: calc(100vw - 1rem);
        }
        .dashboard-grid-actions {
          justify-content: flex-start;
          margin-left: 0;
        }
      }
    </style>
  </head>
  <body>
    <Header
      courseId={activeCourseId}
      activeCourseId={activeCourseId}
      activeCourseCode={activeCourseCode}
    />
    <main class="wrap">
      <div class:list={['dashboard-shell', isTeacher ? 'dashboard-shell--teacher' : '']} data-left-open="true">
          {!isTeacher && (
            <aside class="dashboard-sidebar" aria-label="Navegacion del panel">
              <nav class="dashboard-sidebar-nav" aria-label="Secciones del panel">
                <a href="#student-profile" class="tab active">Perfil</a>
                <a href="#student-deliveries" class="tab">Entregas</a>
                <a href="#student-attendance" class="tab">Asistencia</a>
                {studentAgendaVisible && <a href="#student-agenda" class="tab">Agenda</a>}
                <a href="#student-log" class="tab">Log</a>
              </nav>
              <div class="dashboard-scope-controls">
                <label class="dashboard-scope-field">
                  <span>Curso</span>
                  <select data-dashboard-scope="course">
                    {availableCourseMeta.length === 0 ? (
                      <option value="">Sin cursos</option>
                    ) : (
                      availableCourseMeta.map((course) => (
                        <option value={course.courseId} selected={course.courseId === activeCourseId}>
                          {course.title}
                        </option>
                      ))
                    )}
                  </select>
                </label>
                <label class="dashboard-scope-field">
                  <span>Año</span>
                  <select data-dashboard-scope="year">
                    {availableYears.map((year) => (
                      <option value={year} selected={year === activeYear}>{year}</option>
                    ))}
                  </select>
                </label>
              </div>
            </aside>
          )}
        <section class="dashboard-main" data-dashboard-root>
          <div data-dashboard-toast class="dashboard-toast" role="status" aria-live="polite" hidden></div>
      {isTeacher && (
        <>
        <nav class="dashboard-topbar" aria-label="Navegacion del dashboard docente">
          <div class="dashboard-topbar-tabs">
            <div class:list={['tab', initialTeacherDashboardTab === 'main' ? 'active' : '']} data-dashboard-tab="main">Tabla</div>
            <div class:list={['tab', initialTeacherDashboardTab === 'admin' ? 'active' : '']} data-dashboard-tab="admin">Admin</div>
            <div class:list={['tab', initialTeacherDashboardTab === 'agenda' ? 'active' : '']} data-dashboard-tab="agenda">Agenda</div>
            <div class:list={['tab', initialTeacherDashboardTab === 'log' ? 'active' : '']} data-dashboard-tab="log">Log</div>
          </div>
          <div class="dashboard-topbar-controls">
            <div class="dashboard-topbar-context dashboard-topbar-context--search" data-dashboard-topbar-context="main" hidden={initialTeacherDashboardTab !== 'main'}>
              <input
                type="search"
                class="dashboard-grid-search dashboard-topbar-search"
                data-dashboard-search="teacher-main"
                placeholder="Buscar estudiante, email, turno, grupo, día, clase..."
                aria-label="Buscar en tabla principal"
              />
            </div>
            <div class="dashboard-topbar-context dashboard-topbar-context--search" data-dashboard-topbar-context="admin" hidden={initialTeacherDashboardTab !== 'admin'}>
              <input
                type="search"
                class="dashboard-grid-search dashboard-topbar-search"
                data-dashboard-search="admin"
                placeholder="Buscar nombre, email, rol, actividad..."
                aria-label="Buscar en admin"
              />
            </div>
            <div
              class="dashboard-topbar-context dashboard-topbar-context--scope"
              data-dashboard-topbar-contexts="main,agenda,log"
              hidden={initialTeacherDashboardTab === 'admin'}
            >
              <label class="dashboard-scope-field dashboard-scope-field--inline">
                <select data-dashboard-scope="course" title="Curso">
                  {availableCourseMeta.length === 0 ? (
                    <option value="">Sin cursos</option>
                  ) : (
                    availableCourseMeta.map((course) => (
                      <option value={course.courseId} selected={course.courseId === activeCourseId}>
                        {course.title}
                      </option>
                    ))
                  )}
                </select>
              </label>
              <label class="dashboard-scope-field dashboard-scope-field--inline dashboard-scope-field--year">
                <select data-dashboard-scope="year" title="Año">
                  {availableYears.map((year) => (
                    <option value={year} selected={year === activeYear}>{year}</option>
                  ))}
                </select>
              </label>
            </div>
            <div
              class="dashboard-topbar-context"
              data-dashboard-topbar-context="main"
              hidden={initialTeacherDashboardTab !== 'main'}
            >
              <div
                class="attendance-config-bar attendance-config-bar--toolbar"
                data-attendance-config
                data-course-id={activeCourseId}
                data-year={activeYear}
              >
                <div class="attendance-range-group">
                  <span class="attendance-config-label">rango de cursada</span>
                  <div class="attendance-range-inputs">
                    <input
                      type="date"
                      class="attendance-config-input"
                      data-attendance-config-input="startDate"
                      value={activeAttendanceConfig.startDate}
                      title="Fecha de comienzo de cursada"
                    />
                    <input
                      type="date"
                      class="attendance-config-input"
                      data-attendance-config-input="endDate"
                      value={activeAttendanceConfig.endDate}
                      title="Fecha de fin de cuatrimestre"
                    />
                  </div>
                </div>
              </div>
            </div>
            <div class="dashboard-topbar-context" data-dashboard-topbar-context="main" hidden={initialTeacherDashboardTab !== 'main'}>
              <button
                type="button"
                class="dashboard-grid-btn dashboard-grid-btn--square"
                data-dashboard-fold-all="teacher-main"
                title="Pliega todas las columnas de la tabla principal."
                aria-label="Plegar todas las columnas"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline><line x1="19" y1="6" x2="19" y2="18"></line><polyline points="10 18 4 12 10 6"></polyline></svg>
              </button>
              <button
                type="button"
                class="dashboard-grid-btn dashboard-grid-btn--square"
                data-dashboard-unfold-all="teacher-main"
                title="Despliega todas las columnas de la tabla principal."
                aria-label="Desplegar todas las columnas"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline><line x1="5" y1="6" x2="5" y2="18"></line><polyline points="14 18 20 12 14 6"></polyline></svg>
              </button>
              <button
                type="button"
                class="dashboard-grid-btn dashboard-grid-btn--square dashboard-grid-btn--icon"
                data-dashboard-import-clipboard
                title="Importar estudiantes desde portapapeles."
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
              </button>
              <button
                type="button"
                class="dashboard-grid-btn dashboard-grid-btn--square"
                data-dashboard-download="teacher-main"
                title="Exportar la tabla principal como CSV."
                aria-label="Exportar la tabla principal como CSV"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              </button>
              <button
                type="button"
                class="dashboard-grid-btn dashboard-grid-btn--square"
                data-dashboard-import-csv
                title="Importar estudiantes desde archivo CSV."
                aria-label="Importar estudiantes desde archivo CSV"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              </button>
              <input type="file" accept=".csv,.tsv,.txt" data-dashboard-import-csv-input style="display:none">
              <button
                type="button"
                class="dashboard-grid-btn dashboard-grid-btn--square dashboard-grid-btn--icon"
                data-dashboard-add-student
                title="Agregar estudiante manualmente"
                aria-label="Agregar estudiante"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <button
                type="button"
                class="dashboard-grid-btn dashboard-grid-btn--square"
                data-dashboard-hide-abandoned
                title="Ocultar los abandonos."
                aria-label="Ocultar los abandonos"
                aria-pressed="false"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20C7 20 2.73 16.89 1 12c.92-2.6 2.65-4.77 4.94-6.22"/><path d="M10.58 10.58A2 2 0 0 0 12 14a2 2 0 0 0 1.42-.58"/><path d="M9.88 5.09A10.94 10.94 0 0 1 12 4c5 0 9.27 3.11 11 8a11.77 11.77 0 0 1-1.67 2.68"/><line x1="1" y1="1" x2="23" y2="23"></line></svg>
              </button>
              <button
                type="button"
                class="dashboard-grid-btn dashboard-grid-btn--square dashboard-grid-btn--icon"
                data-dashboard-fill-empty-present
                title="Completar celdas vacías de la columna activa con presente (/)."
                aria-label="Completar celdas vacías con presente"
              >
                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" width="12" height="12"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/></svg>
              </button>
              <button
                type="button"
                class="dashboard-save-indicator"
                data-dashboard-save-indicator
                data-state="idle"
                title="Sin actividad de guardado reciente."
                aria-label="Estado de guardado"
              >
                <span class="dashboard-save-indicator-dot" aria-hidden="true"></span>
              </button>
            </div>
            <div class="dashboard-topbar-context" data-dashboard-topbar-context="admin" hidden={initialTeacherDashboardTab !== 'admin'}>
              <button
                type="button"
                class="dashboard-grid-btn dashboard-grid-btn--square"
                data-dashboard-download="admin"
                title="Exportar la tabla de admin como CSV."
                aria-label="Exportar la tabla de admin como CSV"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              </button>
              <button
                type="button"
                class="dashboard-grid-btn dashboard-grid-btn--square dashboard-grid-btn--danger"
                data-dashboard-admin-delete-selected
                title="Seleccioná usuarios con los checkboxes para borrarlos."
                aria-label="Borrar usuarios seleccionados"
                disabled
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
              </button>
              <button
                type="button"
                class="dashboard-save-indicator"
                data-dashboard-save-indicator
                data-state="idle"
                title="Sin actividad de guardado reciente."
                aria-label="Estado de guardado"
              >
                <span class="dashboard-save-indicator-dot" aria-hidden="true"></span>
              </button>
            </div>
          </div>
        </nav>
        <div class="teacher-dashboard-panels">
          <div
            class="teacher-panel"
            data-dashboard-tab-panel="main"
            hidden={initialTeacherDashboardTab !== 'main'}
          >
            <div class="teacher-grid-shell">
              <div class="dashboard-tabulator" data-dashboard-grid="teacher-main"></div>
            </div>
          </div>

          <div
            class="teacher-panel"
            data-dashboard-tab-panel="agenda"
            hidden={initialTeacherDashboardTab !== 'agenda'}
          >
            <div class="teacher-grid-shell">
              <div class="dashboard-agenda-host" data-dashboard-agenda data-dashboard-agenda-mode="teacher"></div>
            </div>
          </div>

          <div
            class="teacher-panel"
            data-dashboard-tab-panel="log"
            hidden={initialTeacherDashboardTab !== 'log'}
          >
            <div class="log-subtab-shell">
              <nav class="log-subtab-nav" aria-label="Subpestañas de log">
                <button class="log-subtab-btn active" data-log-tab="room">room</button>
                <button class="log-subtab-btn" data-log-tab="anotaciones">anotaciones</button>
                <button class="log-subtab-btn" data-log-tab="ingresos">ingresos</button>
                <button class="log-subtab-btn" data-log-tab="evals">evals</button>
              </nav>
              <div class="log-subtab-panels">
                <div class="log-subtab-panel" data-log-subtab-panel="room">
                  <div class="teacher-grid-toolbar teacher-grid-toolbar--section">
                    <input
                      type="search"
                      class="dashboard-grid-search"
                      data-dashboard-search="attendance-log"
                      placeholder="Buscar en log: estudiante, email, clase, día..."
                      aria-label="Buscar en log de asistencia"
                    />
                    <div class="dashboard-grid-actions">
                      <button
                        type="button"
                        class="dashboard-grid-btn dashboard-grid-btn--square"
                        data-dashboard-download="attendance-log"
                        title="Exportar el log de asistencias como CSV."
                        aria-label="Exportar el log de asistencias como CSV"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                      </button>
                    </div>
                  </div>
                  <div class="dashboard-tabulator" data-dashboard-grid="attendance-log"></div>
                </div>
                <div class="log-subtab-panel" data-log-subtab-panel="anotaciones" hidden>
                  <div class="teacher-grid-toolbar teacher-grid-toolbar--section">
                    <input
                      type="search"
                      class="dashboard-grid-search"
                      data-dashboard-search="comments"
                      placeholder="Buscar estudiante, scope, color, comentario..."
                      aria-label="Buscar en comentarios y anotaciones"
                    />
                    <div class="dashboard-grid-actions">
                      <button
                        type="button"
                        class="dashboard-grid-btn dashboard-grid-btn--square"
                        data-dashboard-download="comments"
                        title="Exportar comentarios y anotaciones como CSV."
                        aria-label="Exportar comentarios y anotaciones como CSV"
                      >
