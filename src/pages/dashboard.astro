      /* ── Toast notification ──────────────────────────────────────── */
      .dashboard-toast {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 9999;
        max-width: 340px;
        padding: 0.65rem 1rem;
        border-radius: 8px;
        font-size: 0.83rem;
        font-weight: 500;
        line-height: 1.4;
        color: #fff;
        background: #1e293b;
        box-shadow: 0 4px 16px rgba(0,0,0,0.35);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.18s ease, transform 0.18s ease;
        pointer-events: none;
      }
      .dashboard-toast:not([hidden]) {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }
      .dashboard-toast[data-toast-type="success"] { background: #15803d; }
      .dashboard-toast[data-toast-type="error"]   { background: #b91c1c; }
      .dashboard-toast[data-toast-type="loading"] { background: #1e40af; }

      /* ── Turno picker dialog ─────────────────────────────────────── */
      .dashboard-turno-dialog {
