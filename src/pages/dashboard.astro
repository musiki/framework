const attendanceDayCountByStudentKey = (() => {
  const daysByKey = new Map<string, Set<string>>();
  if (!isTeacher) return daysByKey;

  scopedLiveAttendance
    .filter((attendance: any) => normalizeRole(attendance?.role) === 'student')
    .forEach((attendance: any) => {
      const userId = String(attendance?.userId || '').trim();
      if (!userId || Number(attendance?.joinCount || 0) <= 0) return;
      const session = scopedLiveSessionById.get(String(attendance?.sessionId || '')) || null;
      const courseId = canonicalizeCourseId(getLiveRecordCourseId(session || attendance));
      const year = getLiveSessionYear(session || attendance);
      const dayKey = getAttendanceDayKey(session, attendance);
      if (!courseId || !year || !dayKey) return;

      const mapKey = `${normalizeTextLower(courseId)}::${year}::${userId}`;
      if (!daysByKey.has(mapKey)) daysByKey.set(mapKey, new Set<string>());
      daysByKey.get(mapKey)?.add(dayKey);
    });

  courseAttendanceManualByKey.forEach((manualDays, mapKey) => {
    const nextSet = daysByKey.get(mapKey) || new Set<string>();
    Object.entries(manualDays || {}).forEach(([dayKey, count]) => {
      if (!/^\d{4}-\d{2}-\d{2}$/.test(String(dayKey || ''))) return;
      if (Number(count || 0) <= 0) return;
      nextSet.add(String(dayKey));
    });
    if (nextSet.size > 0) {
      daysByKey.set(mapKey, nextSet);
    }
  });

  return daysByKey;
})();

const defaultAttendanceRange = (() => {
  const dayKeys = Array.from(
    new Set(
      attendanceSessionRows
        .map((session: any) => normalizeText(session?.dayKey || ''))
        .filter((dayKey) => /^\d{4}-\d{2}-\d{2}$/.test(dayKey)),
    ),
  ).sort();

  if (dayKeys.length > 0) {
    return {
      startDate: dayKeys[0],
      endDate: dayKeys[dayKeys.length - 1],
    };
  }

  const fallbackStart = `${activeYear || new Date().getFullYear()}-01-01`;
  const parsedFallbackStart = parseDateOnly(fallbackStart);
  const fallbackEnd = parsedFallbackStart ? formatDateOnly(addUtcDays(parsedFallbackStart, 7 * 14)) : fallbackStart;
  return {
    startDate: fallbackStart,
    endDate: fallbackEnd,
  };
})();

const activeAttendanceConfigKey = `${normalizeTextLower(activeCourseId)}::${activeYear}`;
const savedAttendanceConfig = courseAttendanceConfigByKey.get(activeAttendanceConfigKey);
const activeAttendanceConfig = {
  courseId: activeCourseId,
  year: activeYear,
  startDate: normalizeText(savedAttendanceConfig?.startDate || defaultAttendanceRange.startDate),
  endDate: normalizeText(savedAttendanceConfig?.endDate || defaultAttendanceRange.endDate),
};

const todayAttendanceDateKey = formatDateOnly(new Date()) || '';
const attendanceScheduleGrid = buildAttendanceScheduleColumns(
  activeAttendanceConfig.startDate,
  activeAttendanceConfig.endDate,
);

const ROOM_ATTENDANCE_THRESHOLD = 0.70; // min fraction of session duration to earn 'R'

const attendanceLiveValueByStudentDayKey = (() => {
  const values = new Map<string, number>();
  if (!isTeacher) return values;

  scopedTeacherLiveAttendance
    .filter((attendance: any) => normalizeRole(attendance?.role) === 'student')
    .forEach((attendance: any) => {
      const userId = normalizeText(attendance?.userId || '');
      const session = scopedTeacherLiveSessionById.get(String(attendance?.sessionId || '')) || null;
      const courseId = canonicalizeCourseId(getLiveRecordCourseId(session || attendance));
      const year = getLiveSessionYear(session || attendance);
      const dayKey = getAttendanceDayKey(session, attendance);
      if (!userId || !courseId || !year || !dayKey) return;
      if (Number(attendance?.joinCount || 0) <= 0) return;

      const sessionDurationMs = Math.max(
        0,
        getDateTimestamp(session?.finishedAt || session?.lastEventAt)
        - getDateTimestamp(session?.startedAt),
      );
      const studentDurationMs = computeAttendanceDurationMs(attendance, session);
      // If session has no computed duration (still live or no timestamps), fall back to joinCount check only
      const meetsThreshold = sessionDurationMs > 0
        ? studentDurationMs / sessionDurationMs >= ROOM_ATTENDANCE_THRESHOLD
        : true;
      if (!meetsThreshold) return;

      const mapKey = `${normalizeTextLower(courseId)}::${year}::${userId}::${dayKey}`;
      values.set(mapKey, 1);
    });

  return values;
})();

// Dates where a class actually happened: at least one live join OR any manual override.
// Only these dates contribute to absence counts.
const activeDateKeysForCourse = (() => {
  const active = new Set<string>();
  const courseYearPrefix = `${normalizeTextLower(activeCourseId)}::${activeYear}::`;

  attendanceLiveValueByStudentDayKey.forEach((_val, key) => {
    if (!key.startsWith(courseYearPrefix)) return;
    const remainder = key.slice(courseYearPrefix.length); // userId::dateKey
    const sep = remainder.lastIndexOf('::');
    if (sep < 0) return;
    const dateKey = remainder.slice(sep + 2);
    if (/^\d{4}-\d{2}-\d{2}$/.test(dateKey)) active.add(dateKey);
  });

  courseAttendanceManualByKey.forEach((manualDays, key) => {
    if (!key.startsWith(courseYearPrefix)) return;
    Object.keys(manualDays || {}).forEach((dateKey) => {
      if (/^\d{4}-\d{2}-\d{2}$/.test(dateKey)) active.add(dateKey);
    });
  });

  return active;
})();

const attendanceGridRows = (() => {
  if (!isTeacher) return [] as any[];
  const studentEnrollmentsById = new Map<string, any>();
  scopedTeacherEnrollments
    .filter((enrollment: any) => normalizeRole(enrollment?.roleInCourse) === 'student')
    .forEach((enrollment: any) => {
      const userId = normalizeText(enrollment?.userId || '');
      if (!userId || studentEnrollmentsById.has(userId)) return;
      studentEnrollmentsById.set(userId, enrollment);
    });

  return Array.from(studentEnrollmentsById.values())
    .map((enrollment: any) => {
      const userId = normalizeText(enrollment?.userId || '');
      const user = allUsersById.get(userId);
      const displayName = String(user?.name || user?.email || userId);
      const { firstName, lastName } = splitAttendanceName(displayName);
      const metaKey = `${normalizeTextLower(activeCourseId)}::${activeYear}::${userId}`;
      const savedMeta = courseStudentMetaByKey.get(metaKey);
      const manualDays = courseAttendanceManualByKey.get(metaKey) || {};
      const turnoRaw = normalizeText(savedMeta?.turno || enrollment?.turno || user?.turno || '').toUpperCase();
      const turnoValue = ['M', 'T', 'N'].includes(turnoRaw) ? turnoRaw : '—';
      const groupValue = normalizeText(
        savedMeta?.grupo
          || enrollment?.group
          || enrollment?.grupo
          || user?.group
          || user?.grupo
          || '',
      ) || '—';

      let absenceUnits = 0;
      const columns = attendanceScheduleGrid.columns.map((column: any) => {
        const liveValue = attendanceLiveValueByStudentDayKey.get(
          `${normalizeTextLower(activeCourseId)}::${activeYear}::${userId}::${column.dateKey}`,
        ) || 0;
        const hasManualOverride = Object.prototype.hasOwnProperty.call(manualDays, column.dateKey);
        const manualValue = hasManualOverride ? normalizeAttendanceValue(manualDays?.[column.dateKey]) : 0;
        const effectiveValue = hasManualOverride ? manualValue : liveValue;
        const isClassDay = activeDateKeysForCourse.has(column.dateKey);
        // Blank cell (no manual override, no live presence) counts as present by default
        const hasAnyData = hasManualOverride || liveValue > 0;
        const effectivePresence = hasAnyData ? effectiveValue : 1;
        const absenceValue = (column.dateKey <= todayAttendanceDateKey && isClassDay)
          ? Math.max(0, 1 - effectivePresence)
          : 0;
        const isFuture = column.dateKey > todayAttendanceDateKey;
        const liveLabel = formatAttendanceValue(liveValue, { isFuture }) || '—';
        const manualLabel = hasManualOverride
          ? formatAttendanceValue(manualValue, { isFuture }) || '—'
          : 'auto';
        const effectiveLabel = formatAttendanceValue(effectiveValue, { isFuture }) || '—';

        absenceUnits += absenceValue;

        return {
          ...column,
          liveValue,
          manualValue,
          hasManualOverride,
          effectiveValue,
          absenceValue,
          isClassDay,
          displayValue: hasManualOverride
            ? formatAttendanceValue(manualValue, { isFuture })
            : liveValue > 0
              ? 'r'
              : formatAttendanceValue(liveValue, { isFuture }),
          title: `Room: ${liveLabel} • Override: ${manualLabel} • Final: ${effectiveLabel} • ${ATTENDANCE_VALUE_HELP}`,
        };
      });

      return {
        userId,
        name: displayName,
        firstName,
        lastName,
        email: String(user?.email || ''),
        turno: turnoValue,
        grupo: groupValue,
        absenceUnits,
        absenceDisplay: formatAbsenceValue(absenceUnits),
        rowState: absenceUnits >= 4 ? 'critical' : absenceUnits >= 3 ? 'warning' : '',
        columns,
      };
    })
    .sort((left: any, right: any) => {
      const lastNameDiff = String(left.lastName || '').localeCompare(String(right.lastName || ''), 'es');
      if (lastNameDiff !== 0) return lastNameDiff;
      return String(left.firstName || left.name || '').localeCompare(String(right.firstName || right.name || ''), 'es');
    });
})();

let agendaSourceEnrollments = [] as any[];
let agendaSourceSubmissions = [] as any[];
let agendaSourceUsersById = new Map<string, any>();

if (activeCourseId && activeYear) {
  if (isTeacher) {
    agendaSourceEnrollments = scopedTeacherEnrollments || [];
    agendaSourceSubmissions = (teacherMetaSubmissions || []).filter((submission: any) =>
      isAgendaMetaAssignmentId(submission?.assignmentId),
    );
    agendaSourceUsersById = allUsersById;
  } else {
    try {
      const { query } = await import('../lib/db/pool');
      const { data: rosterEnrollments, error: rosterEnrollmentError } = await query(
        `SELECT * FROM "Enrollment" WHERE "courseId" = $1`,
        [activeCourseId]
      );
      if (rosterEnrollmentError) {
        console.error('Error loading agenda enrollments:', rosterEnrollmentError);
      } else {
        agendaSourceEnrollments = (rosterEnrollments || []).filter((enrollment: any) => {
          if (activeYear && getEnrollmentYear(enrollment) !== activeYear) return false;
          return true;
        });
      }

      const agendaUserIds = Array.from(
        new Set(
          agendaSourceEnrollments
            .map((enrollment: any) => String(enrollment?.userId || '').trim())
            .filter(Boolean),
        ),
      );
      if (agendaUserIds.length > 0) {
        const { data: rosterUsers, error: rosterUsersError } = await query(
          `SELECT * FROM "User" WHERE "id" = ANY($1)`,
          [agendaUserIds]
        );
        if (rosterUsersError) {
          console.error('Error loading agenda roster users:', rosterUsersError);
        } else {
          agendaSourceUsersById = new Map(
            (rosterUsers || []).map((user: any) => [String(user?.id || ''), user]),
          );
        }
      }

      const { data: agendaRows, error: agendaRowsError } = await query(
        `SELECT * FROM "Submission" 
         WHERE "assignmentId" LIKE $1 
         ORDER BY "submittedAt" DESC`,
        [`${COURSE_AGENDA_META_ASSIGNMENT_PREFIX}%`]
      );
      if (agendaRowsError) {
        console.error('Error loading agenda submissions:', agendaRowsError);
      } else {
        agendaSourceSubmissions = agendaRows || [];
      }
    } catch (error) {
      console.error('Error initializing dashboard agenda data:', error);
    }
  }
}

let activeAgendaConfig = buildAgendaDefaultConfig(activeCourseId, normalizeAgendaYear(activeYear));
let activeAgendaConfigUpdatedAt = '';
const agendaStudentPayloadById = new Map<string, any>();
let activeAgendaEvents = [] as any[];
let activeAgendaEventsUpdatedAt = '';

agendaSourceSubmissions.forEach((submission: any) => {
  const metaKind = getSubmissionMetaKind(submission);
  const payload = asPayloadObject(submission?.payload);
  const rawPayloadCourseId = payload?.courseId || payload?.course || payload?.courseSlug || '';
  const payloadCourseId = normalizeTextLower(canonicalizeCourseId(rawPayloadCourseId));
  const year = normalizeText(payload?.year || getSubmissionYear(submission));
  
  // Robust match: check canonical ID, raw ID, or presence in assignmentId string
  const activeCourseIdLower = normalizeTextLower(activeCourseId);
  const isActiveCourse = 
    payloadCourseId === activeCourseIdLower || 
    normalizeTextLower(rawPayloadCourseId) === activeCourseIdLower ||
    (submission?.assignmentId && String(submission.assignmentId).toLowerCase().includes(`:${activeCourseIdLower}:`)) ||
    (submission?.assignmentId && String(submission.assignmentId).toLowerCase().includes(`:${encodeURIComponent(activeCourseIdLower).toLowerCase()}:`));

  if (!isActiveCourse || year !== activeYear) return;

  const updatedAt = normalizeText(payload?.updatedAt || submission?.submittedAt || submission?.updatedAt || '');

  if (metaKind === COURSE_AGENDA_CONFIG_META_KIND) {
    if (!activeAgendaConfigUpdatedAt || getDateTimestamp(updatedAt) >= getDateTimestamp(activeAgendaConfigUpdatedAt)) {
      activeAgendaConfig = normalizeAgendaConfigPayload(payload, activeCourseId, activeYear);
      activeAgendaConfigUpdatedAt = updatedAt;
    }
    return;
  }

  if (metaKind === COURSE_AGENDA_STUDENT_META_KIND) {
    const studentId = normalizeText(payload?.studentId || submission?.userId);
    if (!studentId) return;
    const existing = agendaStudentPayloadById.get(studentId);
    const existingUpdatedAt = normalizeText(existing?.updatedAt || '');
    if (existing && existingUpdatedAt && getDateTimestamp(existingUpdatedAt) > getDateTimestamp(updatedAt)) {
      return;
    }
    const normalizedPayload = normalizeAgendaStudentPayload(payload, activeCourseId, activeYear, studentId);
    if (normalizedPayload) agendaStudentPayloadById.set(studentId, normalizedPayload);
    return;
  }

  if (metaKind === COURSE_AGENDA_EVENTS_META_KIND) {
    if (!activeAgendaEventsUpdatedAt || getDateTimestamp(updatedAt) >= getDateTimestamp(activeAgendaEventsUpdatedAt)) {
      const normalizedPayload = normalizeAgendaEventsPayload(payload, activeCourseId, activeYear);
      activeAgendaEvents = normalizedPayload.events || [];
      activeAgendaEventsUpdatedAt = updatedAt;
    }
  }
});

const agendaRosterStudentEnrollments = Array.from(
  new Map(
    agendaSourceEnrollments
      .filter((enrollment: any) => normalizeRole(enrollment?.roleInCourse || 'student') === 'student')
