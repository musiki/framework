      // Only redirect if the target is truly different to avoid infinite loops.
      // Normalize slashes and trailing slashes for comparison.
      const normalize = (u: string) => decodeURIComponent(u).replace(/\/+/g, '/').replace(/\/$/, '');
      if (normalize(targetUrl) !== normalize(currentUrl)) {
