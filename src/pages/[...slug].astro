      .lesson-link {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.4rem;
        padding: 0.4rem 0.45rem;
        border-radius: 4px;
        text-decoration: none;
        color: var(--c-fg);
        font-size: 1rem;
        transition: all 0.15s;
        line-height: 1.2;
      }

      .lesson-link-text {
        flex: 1 1 auto;
        min-width: 0;
        overflow-wrap: anywhere;
      }

      .lesson-link-trailing {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-left: auto;
        flex: 0 0 auto;
      }

      .lesson-link:hover {
        background: var(--c-bg-mute);
      }

      /* Starlight-style current item: accent left rail + subtle tint. */
      .lesson-link.active {
        background: color-mix(in srgb, var(--accent) 12%, transparent);
        color: var(--accent);
        font-weight: 600;
        box-shadow: inset 2px 0 0 0 var(--accent);
        border-radius: 0 4px 4px 0;
      }

      /* ── Course progress state markers (read / completed / evaluated) ─────── */
      .lesson-state {
        font-size: 0.72rem;
        line-height: 1;
        width: 1em;
        text-align: center;
        flex: 0 0 auto;
        opacity: 0.9;
      }
      .lesson-link.is-completed .lesson-state { color: #22c55e; }
      .lesson-link.is-evaluated:not(.is-completed) .lesson-state { color: var(--accent); }
      .lesson-link.is-read:not(.is-evaluated):not(.is-completed) .lesson-state { color: var(--c-fg-dim); }
      .lesson-link.is-read:not(.active) .lesson-link-text { color: var(--c-fg-dim); }

      .reading-end-sentinel {
        height: 1px;
        width: 100%;
        margin: 0;
        pointer-events: none;
      }

      /* ── Moodle-style inline TOC nested under the active lesson ───────────── */
      .class-toc--inline {
        margin: 0.15rem 0 0.4rem 0;
        padding-left: 0.55rem;
        border-left: 1px solid color-mix(in srgb, var(--accent) 35%, var(--c-border));
      }
      .class-toc--inline > details > summary.chapter-title {
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--c-fg-dim);
        padding: 0.15rem 0;
      }
      .class-toc--inline .class-toc-list {
        margin: 0.1rem 0 0 0;
      }
      .class-toc--inline .class-toc-link {
        font-size: 0.85rem;
        padding: 0.12rem 0.3rem;
      }
      /* The "Contenido" block is hidden until reparented under a lesson. */
      .class-toc.class-toc--inline[hidden] { display: none; }

      /* ── Starlight-aligned reading column ────────────────────────────────── */
      .content-area > .class-content {
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      .content-area > .class-content :is(p, li, blockquote) {
        line-height: 1.75;
      }
      .content-area > .class-content :is(h1, h2, h3, h4) {
        line-height: 1.25;
        letter-spacing: -0.01em;
      }
      .content-area > .class-content :is(h2, h3) {
        margin-top: 2.2rem;
      }

      :global(.lesson-icon) {
