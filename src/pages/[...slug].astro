        padding-top: 0;
      }

      .class-toc summary {
        cursor: pointer;
        user-select: none;
        list-style: none;
        padding: 0;
      }

      .class-toc summary::-webkit-details-marker {
        display: none;
      }

      :global(.sidebar--left details > summary.chapter-title) {
        list-style: none;
      }

      :global(.sidebar--left details > summary.chapter-title::-webkit-details-marker) {
        display: none;
      }

      :global(.sidebar--left details > summary.chapter-title::marker) {
        content: "";
      }

      .class-toc-list {
        margin-top: 0.4rem;
        padding-left: 0.65rem;
      }

      .class-toc-item {
        margin-bottom: 0.05rem;
      }

      .class-toc-branch {
        margin: 0;
      }

      .class-toc-summary {
        list-style: none;
        display: flex;
        align-items: flex-start;
        gap: 0.12rem;
      }

      .class-toc-summary::-webkit-details-marker {
        display: none;
      }

      .class-toc-summary::marker {
        content: "";
      }

      .class-toc-children {
        margin-left: 0.5rem;
        padding-left: 0.4rem;
        border-left: 1px solid color-mix(in srgb, var(--c-border) 70%, transparent);
      }

      .class-toc-link {
        display: block;
        text-decoration: none;
        color: var(--c-fg-subtle);
        padding: 0.18rem 0.25rem;
        border-radius: 3px;
        font-size: 0.775rem;
