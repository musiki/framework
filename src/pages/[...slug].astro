      :global(#course-forum-subnav .forum-switcher-link) {
        --forum-switcher-color: var(--forum-text-primary);
        --forum-switcher-border-color: var(--forum-switcher-color);
        --forum-switcher-bg-hover: color-mix(in srgb, var(--forum-switcher-color) 8%, transparent);
        --forum-switcher-bg-active: color-mix(in srgb, var(--forum-switcher-color) 10%, transparent);
        width: 1.98rem;
        min-width: 1.98rem;
        height: 1.98rem;
        min-height: 1.98rem;
        border: 1px solid var(--forum-switcher-border-color);
        border-radius: 0;
        background: transparent;
        color: var(--forum-text-primary) !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.14rem;
        text-decoration: none;
        line-height: 1;
        letter-spacing: 0.03em;
        font-weight: 900;
