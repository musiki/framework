      :global(.sidebar--left .recursos-sidebar-folder-name::-webkit-details-marker) { display: none; }
      :global(.sidebar--left .recursos-sidebar-folder-name::marker) { display: none; }
      :global(.sidebar--left .recursos-sidebar-folder-caret) {
        flex-shrink: 0;
        font-size: 1.01rem;
        display: inline-block;
        transition: transform 0.15s;
      }
      :global(.sidebar--left .recursos-sidebar-folder[open] > .recursos-sidebar-folder-name .recursos-sidebar-folder-caret) {
        transform: rotate(90deg);
