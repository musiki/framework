      :global(#course-forum-subnav .forum-switcher-link.has-unread .forum-switcher-unread-dot) {
        opacity: 1;
        transform: scale(1);
      }

      :global(#course-forum-subnav .forum-switcher-add) {
        font-size: 1.58rem;
        font-weight: 700;
        line-height: 1;
      }

      :global(#course-forum-subnav .forum-switcher-add-mark) {
        display: block;
        line-height: 1;
        transform: translate(1px, -1px);
