      }
      .patch-ai-form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .patch-ai-textarea {
        min-height: 18rem;
        width: 100%;
        padding: 0.9rem 1rem;
        border: 1px solid var(--c-border);
        border-radius: 8px;
        background: var(--c-bg);
        color: var(--c-fg);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-size: 0.92rem;
        line-height: 1.45;
