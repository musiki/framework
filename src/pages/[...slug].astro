const publicGraphRelations = (() => {
  if (!isPublicWikiPage) return { outlinks: [], inlinks: [], hasAny: false };

  const graph = buildGraphData({ publicOnly: true });
  const nodeById = new Map(graph.nodes.map((node: any) => [String(node.id), node]));
  const currentNode =
    nodeById.get(publicGraphNodeId) ||
    graph.nodes.find((node: any) => String(node.canonicalSlug || '').trim() === normalizedRequestedSlug);

  if (!currentNode) return { outlinks: [], inlinks: [], hasAny: false };

  const currentId = String((currentNode as any).id || '');
  const toRelationItem = (id: unknown) => {
    const node = nodeById.get(String(id));
    if (!node) return null;
    const slug = String((node as any).canonicalSlug || '').trim();
    if (!slug) return null;
    return {
      id: String((node as any).id || slug),
      title: String((node as any).name || slug),
      href: `/${slug}`,
    };
  };
  const uniqueItems = (items: Array<{ id: string; title: string; href: string } | null>) => {
    const seen = new Set<string>();
    return items
      .filter((item): item is { id: string; title: string; href: string } => Boolean(item))
      .filter((item) => {
        if (seen.has(item.id)) return false;
        seen.add(item.id);
        return true;
      })
      .sort((left, right) => left.title.localeCompare(right.title, undefined, { sensitivity: 'base' }));
  };

  const linkEdges = graph.links.filter((link: any) => String(link.type || '') === 'link');
  const outlinks = uniqueItems(
    linkEdges
      .filter((link: any) => String(link.source) === currentId)
      .map((link: any) => toRelationItem(link.target)),
  );
  const inlinks = uniqueItems(
    linkEdges
      .filter((link: any) => String(link.target) === currentId)
      .map((link: any) => toRelationItem(link.source)),
  );

  return { outlinks, inlinks, hasAny: outlinks.length > 0 || inlinks.length > 0 };
})();
