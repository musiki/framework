      }

      :global(#course-forum-subnav .forum-switcher-unread-dot) {
        position: absolute;
        right: 0.18rem;
        bottom: 0.18rem;
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: #dc2626;
        box-shadow: 0 0 0 1px var(--c-bg);
        opacity: 0;
        transform: scale(0.8);
        transition: opacity 140ms ease, transform 140ms ease;
        pointer-events: none;
