      .forum-board-context-action:hover,
      .forum-board-context-action:focus-visible {
        border-color: var(--forum-border-strong);
        background: var(--forum-bg-subtle);
        outline: none;
      }

      .forum-board-context-action--danger {
        border-color: color-mix(in srgb, #b91c1c 32%, var(--forum-border-soft));
        color: #8f1d1d;
      }

      .forum-grid {
        display: grid;
        grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
        gap: 1rem;
      }

      .sidebar--right .forum-grid {
        grid-template-columns: 1fr;
        grid-template-rows: minmax(0, 1fr);
        gap: 0.75rem;
        min-height: 0;
        min-width: 0;
        max-width: 100%;
        overflow: hidden;
      }

      .forum-panel {
        border: 1px solid var(--forum-border-soft);
