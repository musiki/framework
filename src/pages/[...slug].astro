        font-size: 0.84rem;
      }
      .poll-countdown {
        margin: 0.45rem 0 0;
        font-variant-numeric: tabular-nums;
        font-size: 0.92rem;
        font-weight: 600;
      }
      .poll-countdown.is-closing {
        color: #b3261e;
      }
      .poll-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.55rem;
        margin-top: 0.9rem;
      }
      .poll-control-button {
        margin-top: 0;
      }
      .poll-control-danger {
        background: #8b1f1f;
      }
      .poll-live-link {
        display: inline-flex;
        align-items: center;
        padding: 0.6rem 0.75rem;
        border-radius: 6px;
        border: 1px solid var(--c-border);
        color: var(--c-fg);
        text-decoration: none;
        font-size: 0.88rem;
      }
      .poll-form {
        margin-top: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .poll-option {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        border: 1px solid var(--c-border);
        border-radius: 8px;
        padding: 0.65rem 0.7rem;
      }
      .poll-option input {
        margin: 0;
      }
      .poll-submit {
        margin-top: 0.8rem;
      }
      .poll-feedback[data-error=\"true\"] {
        border-color: #b3261e;
      }
      .poll-results {
        margin-top: 1rem;
        display: grid;
        gap: 0.5rem;
      }
      .poll-result-row {
        border: 1px solid var(--c-border);
        border-radius: 8px;
        padding: 0.45rem 0.55rem;
        background: var(--c-bg);
      }
      .poll-result-meta {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.6rem;
        font-size: 0.85rem;
      }
      .poll-result-label {
        font-weight: 600;
      }
      .poll-result-count {
        color: var(--c-fg-dim);
      }
      .poll-result-track {
        margin-top: 0.35rem;
        width: 100%;
        height: 0.42rem;
        border-radius: 999px;
        overflow: hidden;
        background: color-mix(in srgb, var(--c-border) 45%, transparent);
      }
      .poll-result-fill {
        width: 0%;
        height: 100%;
        background: linear-gradient(90deg, #1f8f45, #38bc64);
      }
      .wordcloud-block {
        border-style: solid;
      }
      .wordcloud-form {
        margin-top: 1rem;
        display: grid;
        gap: 0.65rem;
      }
      .wordcloud-suggestions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
      }
      .wordcloud-suggestion {
        border: 1px solid var(--c-border);
        border-radius: 999px;
        padding: 0.35rem 0.7rem;
        background: var(--c-bg);
        color: var(--c-fg);
        font: inherit;
        font-size: 0.86rem;
        cursor: pointer;
      }
      .wordcloud-suggestion.is-active {
        border-color: var(--accent);
        color: var(--accent);
      }
      .wordcloud-input {
        width: 100%;
        border: 1px solid var(--c-border);
        border-radius: 8px;
        padding: 0.62rem 0.72rem;
        background: var(--c-bg);
        color: var(--c-fg);
        font: inherit;
      }
      .wordcloud-results {
        margin-top: 1rem;
      }
      .wordcloud-visual {
        position: relative;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--c-border) 82%, transparent);
        border-radius: 18px;
        background:
          radial-gradient(circle at top left, color-mix(in srgb, var(--accent) 10%, #fff8e8) 0%, transparent 42%),
          linear-gradient(180deg, #fffdf7 0%, #f7f0df 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.42);
      }
      .wordcloud-image,
      .wordcloud-svg {
        display: block;
        width: 100%;
        height: auto;
      }
      .wordcloud-visual-fallback[hidden] {
        display: none;
      }
      .wordcloud-summary {
        margin: 0.6rem 0 0;
        color: var(--c-fg-dim);
        font-size: 0.82rem;
      }

      /* ── GLOBAL overrides for raw-HTML-injected sidebar/content ────────────
         The lessons tree and note content are injected as raw HTML (no Astro
         scope attribute), so scoped rules don't match them. These must be
         global and come after the earlier sidebar rules to win. */
      .sidebar--left .lesson-link.active {
        background: color-mix(in srgb, var(--accent) 12%, transparent);
        color: var(--accent);
        font-weight: 600;
        box-shadow: inset 2px 0 0 0 var(--accent);
        border-radius: 0 4px 4px 0;
      }
      .lesson-state {
        font-size: 0.72rem;
        line-height: 1;
        width: 1em;
        text-align: center;
        flex: 0 0 auto;
        opacity: 0.9;
      }
      .lesson-link.is-completed .lesson-state { color: #22c55e; }
      .lesson-link.is-evaluated:not(.is-completed) .lesson-state { color: var(--accent); }
      .lesson-link.is-read:not(.is-evaluated):not(.is-completed) .lesson-state { color: var(--c-fg-dim); }
      .lesson-link.is-read:not(.active) .lesson-link-text { color: var(--c-fg-dim); }
      .reading-end-sentinel { height: 1px; width: 100%; pointer-events: none; }

      .class-toc--inline {
        margin: 0.15rem 0 0.4rem 0;
        padding-left: 0.55rem;
        border-left: 1px solid color-mix(in srgb, var(--accent) 35%, var(--c-border));
      }
      .class-toc--inline > details > summary.chapter-title {
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--c-fg-dim);
        padding: 0.15rem 0;
      }
      .class-toc--inline .class-toc-list { margin: 0.1rem 0 0 0; }
      .class-toc--inline .class-toc-link { font-size: 0.85rem; padding: 0.12rem 0.3rem; }
      .class-toc.class-toc--inline[hidden] { display: none; }

      /* Starlight-aligned reading column (also for Dockview panel content). */
      .content-area > .class-content,
      .cnw-md {
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      .content-area > .class-content :is(p, li, blockquote),
      .cnw-md :is(p, li, blockquote) { line-height: 1.75; }
      .content-area > .class-content :is(h1, h2, h3, h4),
      .cnw-md :is(h1, h2, h3, h4) { line-height: 1.25; letter-spacing: -0.01em; }
      .content-area > .class-content :is(h2, h3),
      .cnw-md :is(h2, h3) { margin-top: 2.2rem; }
    </style>
    <GraphModal />
    <Search searchEndpoint={isPublicReaderMode ? '/public-search.json' : '/search.json'} />
    {session?.user && canonicalCourseIdToUse && (
      <script>
        import { loadNotesTree, renderNotesTree, renderNotesTreeError, beginRootNoteCreation, beginInlineFolderCreation } from '../scripts/course/notes-sidebar';

        async function bootNotasSidebar() {
          const sidebarEls = document.querySelectorAll<HTMLElement>('[data-notas-sidebar], [data-notes-sidebar]');
          sidebarEls.forEach(sidebarEl => {
            const courseId = sidebarEl.dataset.notasCourseId ?? sidebarEl.dataset.notesCourseId ?? sidebarEl.dataset.courseId ?? '';
            if (!courseId) return;
            const boundKey = sidebarEl.dataset.notasSidebarBound ?? sidebarEl.dataset.notesSidebarBound ?? '';
            if (boundKey === courseId) return;
            sidebarEl.dataset.notasSidebarBound = courseId;
            sidebarEl.dataset.notesSidebarBound = courseId;

            const reload = async (): Promise<boolean> => {
              const currentTreeEl = sidebarEl.querySelector<HTMLElement>('.notas-sb-tree');
              if (!currentTreeEl) return false;
              try {
                const { folders, notes, currentUserId } = await loadNotesTree(courseId);
                renderNotesTree(currentTreeEl, folders, notes, courseId, currentUserId);
                return true;
              } catch (error) {
                renderNotesTreeError(currentTreeEl, error);
                return false;
              }
            };

            let loaded = false;

            const ensureRefreshButton = () => {
              const summary = sidebarEl.querySelector<HTMLElement>('summary.chapter-title');
              const actionHost = summary?.querySelector<HTMLElement>('.chapter-title-main') || summary;
              if (!actionHost || actionHost.querySelector('.notas-sb-refresh-btn')) return;
              const button = document.createElement('button');
              button.type = 'button';
              button.className = 'chapter-editor-link notas-sb-refresh-btn';
              button.title = 'Refrescar notas';
              button.setAttribute('aria-label', 'Refrescar notas');
              button.textContent = '↻';
              button.style.cssText = 'border:none;background:none;cursor:pointer;padding:0 3px;opacity:.6;font-size:.82rem;line-height:1';
              actionHost.appendChild(button);
            };
            ensureRefreshButton();

            const refreshFromExternalChange = async (detailCourseId = '') => {
              if (detailCourseId && detailCourseId !== courseId) return;
              const details = sidebarEl.querySelector<HTMLDetailsElement>('details');
              if (details && !details.open) details.open = true;
              loaded = await reload();
            };

            sidebarEl.addEventListener('musiki:notes-sidebar-refresh-local', () => {
              void refreshFromExternalChange(courseId);
            });

            // Handle toggle loading using event capturing delegation
            sidebarEl.addEventListener('toggle', async (e) => {
              const details = e.target as HTMLDetailsElement;
              if (
                details.tagName !== 'DETAILS'
                || !details.open
                || loaded
                || !details.querySelector('.notas-sb-tree')
              ) return;
              loaded = await reload();
            }, { capture: true });

            // Event delegation for clicks on summary / buttons
            sidebarEl.addEventListener('click', async (e) => {
              const target = e.target as HTMLElement;

              // 1. Fold toggle override
              const summary = target.closest('summary.chapter-title');
              const summaryDetails = summary?.closest('details');
              if (summary && summaryDetails?.querySelector('.notas-sb-tree') && !target.closest('button, a')) {
                e.preventDefault();
                e.stopPropagation();
                if (summaryDetails) {
                  summaryDetails.open = !summaryDetails.open;
                }
                return;
              }

              // 2. New Note / Folder Actions
              const newBtn = target.closest('.notas-sb-new-btn');
              const newFolderBtn = target.closest('.notas-sb-new-folder-btn');
              const refreshBtn = target.closest('.notas-sb-refresh-btn');
              if (refreshBtn) {
                e.stopPropagation();
                e.preventDefault();
                loaded = await reload();
                return;
              }
              if (newBtn || newFolderBtn) {
                e.stopPropagation();
                e.preventDefault();
                const details = target.closest('details');
                if (details && !details.open) {
                  details.open = true;
                  loaded = false;
                }
                loaded = await reload();
                const currentTreeEl = sidebarEl.querySelector<HTMLElement>('.notas-sb-tree');
                if (currentTreeEl) {
                  if (newBtn) {
                    beginRootNoteCreation(currentTreeEl);
                  } else {
                    beginInlineFolderCreation(currentTreeEl, courseId);
                  }
                }
              }
            }, { capture: true });

            const initiallyOpenNotesDetails = Array.from(sidebarEl.querySelectorAll<HTMLDetailsElement>('details'))
              .find(details => details.open && Boolean(details.querySelector('.notas-sb-tree')));
            if (initiallyOpenNotesDetails) {
              void (async () => {
                loaded = await reload();
              })();
            }
          });

          const notasRefreshWin = window as any;
          if (notasRefreshWin.__musikiNotasSidebarRefreshBound !== true) {
            notasRefreshWin.__musikiNotasSidebarRefreshBound = true;
            const triggerRefresh = (courseId = '') => {
              document.querySelectorAll<HTMLElement>('[data-notas-sidebar], [data-notes-sidebar]').forEach((sidebarEl) => {
                const sidebarCourseId = sidebarEl.dataset.notasCourseId ?? sidebarEl.dataset.notesCourseId ?? sidebarEl.dataset.courseId ?? '';
                if (courseId && sidebarCourseId && sidebarCourseId !== courseId) return;
                sidebarEl.dispatchEvent(new CustomEvent('musiki:notes-sidebar-refresh-local'));
              });
            };
            window.addEventListener('musiki:notes-sidebar-refresh', (event) => {
              triggerRefresh((event as CustomEvent)?.detail?.courseId || '');
            });
            window.addEventListener('notes-sidebar-refresh', () => triggerRefresh(''));
            window.addEventListener('storage', (event) => {
              if (event.key !== 'musiki:notes-sidebar-refresh') return;
              try {
                const detail = event.newValue ? JSON.parse(event.newValue) : {};
                triggerRefresh(String(detail.courseId || ''));
              } catch {
                triggerRefresh('');
              }
            });
          }

          // Ribbon NOTAS button: focus/open this section
          const notasWin = window as any;
          if (notasWin.__musikiNotasSidebarOpenBound !== true) {
            notasWin.__musikiNotasSidebarOpenBound = true;
            window.addEventListener('musiki:open-notas', () => {
              const sidebarCandidates = Array.from(document.querySelectorAll<HTMLElement>('[data-notas-sidebar], [data-notes-sidebar]'));
              const visibleSidebar = sidebarCandidates.find((el) => el.offsetParent !== null && Boolean(el.querySelector('.notas-sb-tree')))
                || sidebarCandidates.find((el) => Boolean(el.querySelector('.notas-sb-tree')))
                || sidebarCandidates[0];
              const details = visibleSidebar?.querySelector<HTMLDetailsElement>('details');
              if (details && !details.open) details.open = true;
              visibleSidebar?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            });
          }
        }

        bootNotasSidebar();
        document.addEventListener('astro:page-load', bootNotasSidebar);
      </script>
    )}
  </body>
</html>
