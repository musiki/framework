        flex: 1 1 auto;
        min-height: 0;
        max-height: none;
        padding: 0.6rem 0.6rem 0.4rem;
      }

      .sidebar--right .forum-thread-column {
        display: grid !important;
        grid-template-rows: minmax(0, 1fr);
        height: 100%;
        max-height: none;
        min-height: 0;
        overflow: hidden;
      }

      .sidebar--right .forum-thread-list {
        flex: 1 1 auto;
        min-height: 0;
        max-height: none;
        overflow-y: auto;
      }

      .sidebar--right .forum-thread-stage {
