	        gap: 1px;
	        margin-top: 0.16rem;
	        margin-bottom: 0.34rem;
	        margin-left: 0.75rem;
	        padding-left: 0.45rem;
	        border-left: 1px solid color-mix(in srgb, var(--c-border) 72%, transparent);
	      }

