        font-size: 0.9em;
        user-select: none;
      }
      :global(.sidebar--left .chapter-drag-handle:active) {
        cursor: grabbing;
      }

	      :global(.sidebar--left .notas-sb-item) {
	        display: flex;
	        align-items: flex-start;
	        gap: 0.4rem;
        padding: 0.12rem 0.25rem;
        border-radius: 4px;
        text-decoration: none;
        color: var(--c-fg);
        font-size: 0.84rem;
        line-height: 1.2;
        transition: all 0.15s;
      }

      :global(.sidebar--left .notas-sb-item:hover) {
        background: color-mix(in srgb, var(--accent) 9%, transparent);
        color: var(--accent);
      }

	      :global(.sidebar--left .notas-sb-folder) {
	        display: flex;
	        align-items: flex-start;
	        gap: 0.25rem;
        cursor: pointer;
        list-style: none;
        color: var(--c-fg);
        font-size: 0.72rem;
        font-weight: 700;
        line-height: 1.2;
        padding: 0.12rem 0.25rem;
        user-select: none;
      }

      :global(.sidebar--left .notas-sb-folder:hover) {
        background: color-mix(in srgb, var(--accent) 9%, transparent);
        color: var(--accent);
      }

      :global(.sidebar--left .notas-sb-placeholder) {
        padding: 0.12rem 0.25rem;
        font-size: 0.84rem;
        line-height: 1.2;
        color: var(--c-fg-subtle);
        transition: all 0.15s;
      }

      :global(.sidebar--left .notas-sb-placeholder:hover) {
        background: color-mix(in srgb, var(--accent) 9%, transparent);
        color: var(--accent);
      }

      .lesson-type {
        font-size: 0.75rem;
        opacity: 0.7;
        margin-left: 0;
      }

      :global(.lesson-status-badge) {
        font-size: 0.6rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.04em;
        padding: 0.15em 0.4em 0.15em 0.25em;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 0.25em;
        white-space: nowrap;
        flex-shrink: 0;
      }

      :global(.lesson-status-blob) {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 999px;
        flex: 0 0 auto;
      }

      :global(.lesson-status-badge--draft) {
        color: #b45309;
        background: rgba(245, 158, 11, 0.15);
      }

      :global(.lesson-status-badge--draft .lesson-status-blob) {
        background: #f59e0b;
        box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.5);
      }

      :global(.lesson-status-badge--private) {
        color: #6d28d9;
        background: rgba(139, 92, 246, 0.15);
      }

      :global(.lesson-status-badge--private .lesson-status-blob) {
        background: #8b5cf6;
        box-shadow: 0 0 0 0 rgba(139, 92, 246, 0.5);
      }

      .lesson-activity-indicators {
        display: inline-flex;
        align-items: center;
        gap: 0.32rem;
      }

      .lesson-live-indicator,
      .lesson-room-indicator {
        display: inline-flex;
        align-items: center;
        gap: 0.28rem;
        font-size: 0.68rem;
        line-height: 1;
        color: var(--c-fg-dim);
        white-space: nowrap;
        cursor: pointer;
      }

      .lesson-live-indicator[hidden],
      .lesson-room-indicator[hidden] {
        display: none !important;
      }

      .lesson-live-led {
        width: 0.52rem;
        height: 0.52rem;
        border-radius: 999px;
        background: #ff3030;
        box-shadow: 0 0 0 0 rgba(255, 48, 48, 0.56);
        flex: 0 0 auto;
      }

      .lesson-live-led--room {
        background: #2196f3;
        box-shadow:
          0 0 0 0 rgba(33, 150, 243, 0.42),
          0 0 8px rgba(33, 150, 243, 0.5);
      }

      .lesson-live-indicator.is-live .lesson-live-led {
        animation: lesson-live-pulse 1.2s ease-in-out infinite;
      }

      .lesson-room-indicator.is-live .lesson-live-led--room {
        animation: lesson-live-pulse 1.35s ease-in-out infinite;
      }

      .lesson-live-indicator:focus-visible {
        outline: 2px solid color-mix(in srgb, var(--accent) 70%, white 30%);
        outline-offset: 2px;
        border-radius: 999px;
      }

      .lesson-live-indicator.is-closing .lesson-live-led {
        background: #ff5b5b;
        box-shadow: 0 0 0 2px rgba(255, 91, 91, 0.35);
      }

      .lesson-live-countdown {
        font-size: 0.84rem;
        line-height: 1;
        min-width: 2rem;
        text-align: center;
        font-variant-numeric: tabular-nums;
      }

      @keyframes lesson-live-pulse {
        0% {
          transform: scale(1);
          opacity: 1;
        }
        50% {
          transform: scale(1.1);
          opacity: 0.72;
        }
        100% {
          transform: scale(1);
          opacity: 1;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .lesson-live-indicator.is-live .lesson-live-led,
        .lesson-room-indicator.is-live .lesson-live-led--room {
          animation: none;
        }
      }

      :global(#course-forum-subnav .forum-subforum-link) {
        color: inherit;
        text-decoration: none;
      }

      :global(#course-forum-subnav .forum-subforum-link:link),
      :global(#course-forum-subnav .forum-subforum-link:visited),
      :global(#course-forum-subnav .forum-subforum-link:hover),
      :global(#course-forum-subnav .forum-subforum-link:active),
      :global(#course-forum-subnav .forum-subforum-link:focus-visible) {
        color: inherit;
        text-decoration: none;
      }

      :global(#course-forum-subnav .forum-subforum-link.is-loading),
      :global(#course-forum-subnav .forum-subforum-link.is-disabled) {
        cursor: default;
        pointer-events: none;
        opacity: 0.8;
      }

      .scroll-shortcuts {
        position: sticky;
        bottom: 0.8rem;
        margin-left: auto;
        width: max-content;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        z-index: 35;
        pointer-events: auto;
      }

      .scroll-shortcut-btn {
        width: 2.4rem;
        height: 2.4rem;
        border-radius: 999px;
        border: 1px solid var(--c-border);
        background: color-mix(in srgb, var(--c-bg) 88%, var(--c-bg-mute) 12%);
        color: var(--c-fg);
        font-size: 1.05rem;
        cursor: pointer;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.12);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
      }
      .scroll-shortcut-btn svg {
        width: 1.15rem;
        height: 1.15rem;
      }

      .sidebar-maximize-btn {
        display: inline-flex;
      }

      .course-container[data-right-maximized='true'] .sidebar--right {
        position: fixed;
        left: calc(
          var(--ribbon-width) +
          clamp(0.7rem, 1.5vw, 1.4rem) +
          var(--left-sidebar-width) +
          clamp(0.9rem, 1.35vw, 1.3rem)
        );
        right: clamp(0.7rem, 1.5vw, 1.4rem);
        top: var(--course-shell-top);
        width: auto;
        max-width: none;
        height: calc(100dvh - var(--course-shell-top) - var(--course-shell-bottom-gap));
        z-index: 43;
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.18);
      }

      .course-container[data-left-open='false'][data-right-maximized='true'] .sidebar--right {
        left: clamp(0.7rem, 1.5vw, 1.4rem);
      }

      .scroll-shortcut-btn:hover {
        background: var(--c-bg-mute);
      }

      .class-toc[hidden] {
        display: none;
      }

      .class-toc details {
