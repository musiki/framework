    .sidebar--left details > summary::-webkit-details-marker {
      display: none !important;
    }
    .sidebar--left details > summary::marker {
      display: none !important;
      content: "" !important;
    }
    .sidebar--left details > summary {
      list-style: none !important;
    }

    .sidebar--left .lesson-item {
      margin: 0 !important;
      padding: 0 !important;
      position: static !important;
    }

    .sidebar--left .lesson-item::before {
      content: none !important;
      display: none !important;
    }

	    .sidebar--left .class-toc-link {
	      display: flex !important;
	      align-items: flex-start !important;
	      gap: 0.25rem !important;
	      font-size: 0.76rem !important;
	      padding: 0 0.3rem !important;
	      line-height: 1.15 !important;
	      color: var(--c-fg) !important;
	      overflow-wrap: anywhere !important;
	    }

	    .sidebar--left .class-toc-link.level-1 {
	      color: color-mix(in srgb, var(--c-fg) 88%, var(--accent)) !important;
	      font-weight: 700 !important;
	    }

    .sidebar--left .class-toc-link.level-1,
    .sidebar--left .class-toc-link.level-2,
    .sidebar--left .class-toc-link.level-3,
    .sidebar--left .class-toc-link.level-4,
    .sidebar--left .class-toc-link.level-5,
    .sidebar--left .class-toc-link.level-6 {
      padding-left: 0.3rem !important;
    }

    .sidebar--left .class-toc-children {
      margin-left: 0.4rem !important;
      padding-left: 0.3rem !important;
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      gap: 0 !important;
      border-left: 1px solid color-mix(in srgb, var(--c-border) 55%, transparent) !important;
    }

    .sidebar--left .class-toc-list {
      margin-left: 0.15rem !important;
      margin-top: 0.05rem !important;
      margin-bottom: 0.05rem !important;
      padding-left: 0.3rem !important;
      border-left: 1px solid color-mix(in srgb, var(--c-border) 55%, transparent) !important;
    }

    .sidebar--left .class-toc-item {
      margin-bottom: 0 !important;
    }

    .sidebar--left .class-toc-summary {
      list-style: none !important;
      display: block !important;
      appearance: none !important;
      -webkit-appearance: none !important;
      padding-left: 0 !important;
    }

    .sidebar--left .class-toc-summary::-webkit-details-marker {
      display: none !important;
    }

    .sidebar--left .class-toc-summary::marker {
      content: none !important;
      font-size: 0 !important;
    }

    .content-area .content-fold-summary {
      list-style: none !important;
      display: block !important;
      appearance: none !important;
      -webkit-appearance: none !important;
      padding: 0.95rem 0 !important;
    }

    .content-area .content-fold-summary::-webkit-details-marker {
      display: none !important;
    }

    .content-area .content-fold-summary::marker {
      content: none !important;
      font-size: 0 !important;
    }

    .content-area .content-fold-summary::before,
    .content-area .content-fold[open] > .content-fold-summary::before {
      content: none !important;
      display: none !important;
    }

    .content-area .content-fold-summary h2 {
      margin: 0 !important;
      line-height: 1.24 !important;
      min-width: 0;
      display: block !important;
    }

    .content-area .content-fold-summary:hover,
    .content-area .content-fold-summary:hover *,
    .sidebar--left .class-toc-summary:hover,
    .sidebar--left .class-toc-summary:hover * {
      cursor: var(--course-fold-cursor-down) !important;
    }

    .content-area .content-fold[open] > .content-fold-summary:hover,
    .content-area .content-fold[open] > .content-fold-summary:hover *,
    .sidebar--left .class-toc-branch[open] > .class-toc-summary:hover,
    .sidebar--left .class-toc-branch[open] > .class-toc-summary:hover * {
      cursor: var(--course-fold-cursor-up) !important;
    }

    [data-musiki-no-list-marker='true'] {
      position: static !important;
      padding-left: 0 !important;
      list-style: none !important;
    }

    [data-musiki-no-list-marker='true']::before,
    [data-musiki-no-list-marker='true']::marker {
      content: none !important;
      display: none !important;
    }

    [data-musiki-no-summary-marker='true'] {
      display: block !important;
      list-style: none !important;
      appearance: none !important;
      -webkit-appearance: none !important;
      padding-left: 0 !important;
    }

    [data-musiki-no-summary-marker='true']::-webkit-details-marker {
      display: none !important;
    }

    [data-musiki-no-summary-marker='true']::before,
    [data-musiki-no-summary-marker='true']::marker {
      content: none !important;
      display: none !important;
    }
    </style>
  </head>
  <body>
    <main
      class="course-container"
      data-course-layout-root
      data-user-key={String(session?.user?.email || '').trim()}
      data-left-open={isPublicWikiPage && !session ? "false" : "true"}
      data-right-open="false"
      data-right-maximized="false"
      data-public-reader={isPublicReaderMode ? 'true' : 'false'}
      data-authenticated={session ? 'true' : 'false'}
      data-has-right-sidebar={hasForumSidebar ? 'true' : 'false'}
      data-can-manage-live-interactions={canManageLiveInteractions ? 'true' : 'false'}
      data-live-course-id={canonicalCourseId || courseSlug}
      data-live-page-slug={livePageSlug}
    >
      <Ribbon
        courseId={canonicalCourseId || courseSlug}
        courseHref={courseHref}
        performativeRoomHref={performativeRoomHref}
        activeCourseCode={activeCourseCode}
        session={session}
        revealHref={presentationHref || undefined}
        publicReaderMode={isPublicReaderMode}
      />
      <div class="course-sidebar-overlay" data-course-sidebar-overlay></div>
      <button
        type="button"
        class="course-sidebar-edge-toggle course-sidebar-edge-toggle--left"
        data-sidebar-edge-toggle="left"
        aria-label="Mostrar navegación del curso"
        title="Mostrar navegación del curso"
      ></button>

      <!-- Sidebar Navigation -->
      <aside class="sidebar sidebar--left" data-course-sidebar="left">
        <div
          class="course-sidebar-resize-handle"
          data-left-sidebar-resize
          role="separator"
          aria-orientation="vertical"
          aria-label="Redimensionar navegación"
          title="Redimensionar navegación"
        ></div>
        <div class="course-title">
          <div class="course-title-row">
            <a href={courseHref} class="course-title-link">
              <span class="course-title-link-text">{courseIndex?.data?.title && courseIndex.data.title !== '_index' ? courseIndex.data.title : (canonicalCourseIdToUse || courseSlug)}</span>
            </a>
            <div class="course-title-actions">
              <button
                type="button"
                class="sidebar-toggle-btn sidebar-fold-all-btn"
                id="sidebar-fold-all-btn"
                aria-label="Desplegar todas las secciones"
                title="Desplegar todas las secciones"
                data-folded="true"
              >
                <svg class="icon-unfold-all" viewBox="0 0 1024 1024" fill="currentColor" width="30" height="30">
                  <path d="M620.6 562.3l36.2 36.2L512 743.3 367.2 598.5l36.2-36.2L512 670.9l108.6-108.6zM512 353.1l108.6 108.6 36.2-36.2L512 280.7 367.2 425.5l36.2 36.2L512 353.1z"/>
                </svg>
                <svg class="icon-fold-all" viewBox="0 0 1024 1024" fill="currentColor" width="30" height="30" style="transform: rotate(90deg);">
                  <path d="M562.19 511.799l-144.6 145.718-36.15-36.43L489.89 511.8l-108.45-109.29 36.15-36.429zM691.2 657.92H640V366.08h51.2z" />
                </svg>
              </button>
              <button
                type="button"
                class="sidebar-toggle-btn"
                data-sidebar-toggle="left"
                aria-label="Ocultar navegación del curso"
                title="Ocultar navegación del curso (⌘/Ctrl + \\)"
              >
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M16.1795 3.26875C15.7889 2.87823 15.1558 2.87823 14.7652 3.26875L8.12078 9.91322C6.94952 11.0845 6.94916 12.9833 8.11996 14.155L14.6903 20.7304C15.0808 21.121 15.714 21.121 16.1045 20.7304C16.495 20.3399 16.495 19.7067 16.1045 19.3162L9.53246 12.7442C9.14194 12.3536 9.14194 11.7205 9.53246 11.33L16.1795 4.68297C16.57 4.29244 16.57 3.65928 16.1795 3.26875Z" fill="currentColor"/>
                </svg>
              </button>
            </div>
          </div>
          {performativeRoomHref && (isLessonPage || isLiveEnabled) && (
            <div class="course-title-secondary">
              <a href={performativeRoomHref} class="performative-room-link">
                Sala performativa
              </a>
            </div>
          )}
        </div>

        {canManageLiveInteractions ? (
          <>
            {localContentAdminEnabled && (
              <>
                <div
                  data-notes-sidebar
                  data-course-id={canonicalCourseId || courseSlug}
                  data-course-href={courseHref}
                  data-active-slug={currentEntrySourcePath || ''}
                  data-global-concepts={JSON.stringify(globalConcepts.map(entry => ({
                    id: entry.id,
                    data: {
                      title: entry.data.title,
                      type: entry.data.type,
                      status: entry.data.status,
                      project: entry.data.project,
                      order: entry.data.order,
                    }
                  })))}
                ></div>
                <div style="display: none;">
                  <div id="recursos-sidebar-tree-container">
                    {recursosSidebarGroups.length > 0 && (
                      <div class="recursos-sidebar-tree" data-recursos-sidebar data-room={`${recursosCourseId}-stage`} data-clase={recursosCourseId}>
                        {recursosSidebarGroups.map((group) => {
                          const { root, folders } = groupByFolder(group.resources);
                          return (
                            <details class="recursos-sidebar-session" data-node-id={group.session?.id || ''} data-node-kind={group.session?.id ? 'session' : ''}>
                              <summary class="recursos-sidebar-session-name">
                                <span class="recursos-sidebar-session-caret">▸</span>
                                {group.session?.name || 'Sin sesión'}
                              </summary>
                              <ul class="recursos-sidebar-resource-list">
                                {root.map((resource) => {
                                  const ic = iconFor(resource.type, resource.url, resource.name);
                                  return (
                                    <li class="recursos-sidebar-resource-item" data-id={resource.id}>
                                      <a href={resource.url} class="recursos-sidebar-resource-link" target="_blank" rel="noreferrer" title={resource.url}>
                                        <span class="recursos-sidebar-resource-icon" style={`color:${ic.color}`}>{ic.char}</span>
                                        <span class="recursos-sidebar-resource-name">{resource.name}</span>
                                      </a>
                                    </li>
                                  );
                                })}
                                {[...folders.entries()].map(([folderName, items]) => (
                                  <li class="recursos-sidebar-resource-item">
                                    <details class="recursos-sidebar-folder" data-node-id={recursosLegacyFolderId(recursosCourseId, group.session?.id, folderName)} data-node-kind="folder">
                                      <summary class="recursos-sidebar-folder-name">
                                        <span class="recursos-sidebar-folder-caret">▸</span>
                                        <span style="color:#4e6070">⊟</span>
                                        {folderName}
                                      </summary>
                                      <ul class="recursos-sidebar-folder-items">
                                        {items.map((resource) => {
                                          const ic = iconFor(resource.type, resource.url, resource.name);
                                          return (
                                            <li class="recursos-sidebar-resource-item" data-id={resource.id}>
                                              <a href={resource.url} class="recursos-sidebar-resource-link" target="_blank" rel="noreferrer" title={resource.url}>
                                                <span class="recursos-sidebar-resource-icon" style={`color:${ic.color}`}>{ic.char}</span>
                                                <span class="recursos-sidebar-resource-name">{resource.name}</span>
                                              </a>
                                            </li>
                                          );
                                        })}
                                      </ul>
                                    </details>
                                  </li>
                                ))}
                              </ul>
                            </details>
                          );
                        })}
                      </div>
                    )}
                  </div>
                  <div id="notas-sidebar-tree-container">
                    <div class="chapter chapter--notas" data-notes-sidebar data-notes-course-id={canonicalCourseId || courseSlug}>
                      <details class="chapter-details">
                        <summary class="chapter-title">
                          <span class="chapter-title-main">
                            <span class="chapter-caret">▸</span>
                            <span class="chapter-title-text">90 NOTAS</span>
                            <button type="button" class="chapter-editor-link notas-sb-new-btn" title="Nueva nota" onclick="event.stopPropagation()" style="border:none;background:none;cursor:pointer;padding:0 3px;opacity:.6;font-size:.85rem;line-height:1">+</button>
                            <button type="button" class="chapter-editor-link notas-sb-new-folder-btn" title="Nueva carpeta" onclick="event.stopPropagation()" style="border:none;background:none;cursor:pointer;padding:0 3px;opacity:.6;font-size:.75rem;line-height:1">⊟+</button>
                          </span>
                        </summary>
                        <div class="notas-sb-tree" style="padding:.24rem 0"></div>
                      </details>
                    </div>
                  </div>
                </div>
              </>
            )}
            {sidebarChapterEntries.filter(e =>
              !localContentAdminEnabled && (
                (e.kind === 'recursos')
                || (e.kind === 'chapter')
              )
            ).map((entry) => {
          if (entry.kind === 'recursos') {
            return (
              <div class="chapter chapter--recursos">
                <details class="chapter-details" open={isRecursosEditorPage}>
                  <summary class="chapter-title">
                    <span class="chapter-title-main">
                      <span class="chapter-caret">▸</span>
                      <span class="chapter-title-text">80 RECURSOS</span>
                      <a
                        href={`${courseHref}/recursos`}
                        class:list={['chapter-editor-link', { active: isRecursosEditorPage }]}
                        title="Editor de recursos"
                        aria-label="Editor de recursos"
                        onclick="event.stopPropagation()"
	                        >
	                          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
	                            <path d="M12 20h9" />
	                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
	                          </svg>
	                        </a>
	                        <button type="button" class="chapter-editor-link recursos-sidebar-fold-all-btn" title="Desplegar árbol de recursos" aria-label="Desplegar árbol de recursos">
	                          <svg viewBox="0 0 24 24" aria-hidden="true" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
	                            <path d="M4 6h16" />
	                            <path d="M7 12h10" />
	                            <path d="M10 18h4" />
	                          </svg>
	                        </button>
	                      </span>
                  </summary>
                  {recursosSidebarGroups.length > 0 && (
                    <div class="recursos-sidebar-tree" data-recursos-sidebar data-room={`${recursosCourseId}-stage`} data-clase={recursosCourseId}>
                      {recursosSidebarGroups.map((group) => {
                        const { root, folders } = groupByFolder(group.resources);
                        return (
                          <details class="recursos-sidebar-session" data-node-id={group.session?.id || ''} data-node-kind={group.session?.id ? 'session' : ''}>
                            <summary class="recursos-sidebar-session-name">
                              <span class="recursos-sidebar-session-caret">▸</span>
                              {group.session?.name || 'Sin sesión'}
                            </summary>
                             <ul class="recursos-sidebar-resource-list">
                              {root.map((resource) => {
                                const ic = iconFor(resource.type, resource.url, resource.name);
                                return (
                                  <li class="recursos-sidebar-resource-item" data-id={resource.id}>
                                    <a href={resource.url} class="recursos-sidebar-resource-link" target="_blank" rel="noreferrer" title={resource.url}>
                                      <span class="recursos-sidebar-resource-icon" style={`color:${ic.color}`}>{ic.char}</span>
                                      <span class="recursos-sidebar-resource-name">{resource.name}</span>
                                    </a>
                                  </li>
                                );
                              })}
                              {[...folders.entries()].map(([folderName, items]) => (
                                <li class="recursos-sidebar-resource-item">
                                  <details class="recursos-sidebar-folder" data-node-id={recursosLegacyFolderId(recursosCourseId, group.session?.id, folderName)} data-node-kind="folder">
                                    <summary class="recursos-sidebar-folder-name">
                                      <span class="recursos-sidebar-folder-caret">▸</span>
                                      <span style="color:#4e6070">⊟</span>
                                      {folderName}
                                    </summary>
                                    <ul class="recursos-sidebar-folder-items">
                                      {items.map((resource) => {
                                        const ic = iconFor(resource.type, resource.url, resource.name);
                                        return (
                                          <li class="recursos-sidebar-resource-item" data-id={resource.id}>
                                            <a href={resource.url} class="recursos-sidebar-resource-link" target="_blank" rel="noreferrer" title={resource.url}>
                                              <span class="recursos-sidebar-resource-icon" style={`color:${ic.color}`}>{ic.char}</span>
                                              <span class="recursos-sidebar-resource-name">{resource.name}</span>
                                            </a>
                                          </li>
                                        );
                                      })}
                                    </ul>
                                  </details>
                                </li>
                              ))}
                            </ul>
                          </details>
                        );
                      })}
                    </div>
                  )}
                </details>
              </div>
            );
          }
          const { chapterName } = entry;
          const lessons = localContentAdminEnabled
            ? entry.lessons.filter((lesson) => (lesson as any).collection === 'content')
            : entry.lessons;
          if (lessons.length === 0) return null;
          const isPublicFolder = /^[79]\d /.test(chapterName);
          const displayTitle = isPublicFolder ? chapterName.toUpperCase() : chapterName.replace(/-/g, ' ');
          const isTOC = chapterName === 'TOC de clase';
          const isRecursosChapter = normalizeContentSlug(chapterName) === '80-recursos';
          const isConceptos = displayTitle.toUpperCase().includes('CONCEPTOS');
          const isRecursos = displayTitle.toUpperCase().includes('RECURSOS');
          const isNotas = displayTitle.toUpperCase().includes('NOTAS');

          return (
            <div class:list={["chapter", { "chapter--conceptos": isConceptos, "chapter--recursos": isRecursos, "chapter--notas": isNotas }]}>
              <details class="chapter-details" open={isRecursosEditorPage || lessons.some(l => currentEntry?.id === l.id)}>
                <summary class="chapter-title">
                  <span class="chapter-title-main">
                    <span class="chapter-caret">▸</span>
                    <span class="chapter-title-text">{displayTitle}</span>
	                    {canManageLiveInteractions && isRecursosChapter && (
	                      <>
	                        <a
	                          href={`${courseHref}/recursos`}
	                          class:list={['chapter-editor-link', { active: isRecursosEditorPage }]}
	                          title="Editor de recursos"
	                          aria-label="Editor de recursos"
	                          onclick="event.stopPropagation()"
	                        >
	                          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
	                            <path d="M12 20h9" />
	                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
	                          </svg>
	                        </a>
	                        <button type="button" class="chapter-editor-link recursos-sidebar-fold-all-btn" title="Desplegar árbol de recursos" aria-label="Desplegar árbol de recursos">
	                          <svg viewBox="0 0 24 24" aria-hidden="true" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
	                            <path d="M4 6h16" />
	                            <path d="M7 12h10" />
	                            <path d="M10 18h4" />
	                          </svg>
	                        </button>
	                      </>
	                    )}
                  </span>
                </summary>
                {isRecursosChapter && recursosSidebarGroups.length > 0 ? (
                  <div class="recursos-sidebar-tree" data-recursos-sidebar data-room={`${recursosCourseId}-stage`} data-clase={recursosCourseId}>
                    {recursosSidebarGroups.map((group) => {
                      const { root, folders } = groupByFolder(group.resources);
                      return (
                        <details class="recursos-sidebar-session" data-node-id={group.session?.id || ''} data-node-kind={group.session?.id ? 'session' : ''}>
                          <summary class="recursos-sidebar-session-name">
                            <span class="recursos-sidebar-session-caret">▸</span>
                            {group.session?.name || 'Sin sesión'}
                          </summary>
                          <ul class="recursos-sidebar-resource-list">
                            {root.map((resource) => {
                              const ic = iconFor(resource.type, resource.url, resource.name);
                              return (
                                <li class="recursos-sidebar-resource-item">
                                  <a href={resource.url} class="recursos-sidebar-resource-link" target="_blank" rel="noreferrer" title={resource.url}>
                                    <span class="recursos-sidebar-resource-icon" style={`color:${ic.color}`}>{ic.char}</span>
                                    <span class="recursos-sidebar-resource-name">{resource.name}</span>
                                  </a>
                                </li>
                              );
                            })}
                            {[...folders.entries()].map(([folderName, items]) => (
                              <li class="recursos-sidebar-resource-item">
                                <details class="recursos-sidebar-folder" data-node-id={recursosLegacyFolderId(recursosCourseId, group.session?.id, folderName)} data-node-kind="folder">
                                  <summary class="recursos-sidebar-folder-name">
                                    <span class="recursos-sidebar-folder-caret">▸</span>
                                    <span style="color:#4e6070">⊟</span>
                                    {folderName}
                                  </summary>
                                  <ul class="recursos-sidebar-folder-items">
                                    {items.map((resource) => {
                                      const ic = iconFor(resource.type, resource.url, resource.name);
                                      return (
                                        <li>
                                          <a href={resource.url} class="recursos-sidebar-resource-link" target="_blank" rel="noreferrer" title={resource.url}>
                                            <span class="recursos-sidebar-resource-icon" style={`color:${ic.color}`}>{ic.char}</span>
                                            <span class="recursos-sidebar-resource-name">{resource.name}</span>
                                          </a>
                                        </li>
                                      );
                                    })}
                                  </ul>
                                </details>
                              </li>
                            ))}
                          </ul>
                        </details>
                      );
                    })}
                  </div>
                ) : (
                  <ul class="lesson-list">
                    {lessons.map((lesson) => {
                    const isContentCollection = (lesson as any).collection === 'content';
                    const lessonType = String(lesson.data.type || '').trim().toLowerCase();
                    const isConceptGlossary = conceptGlossaryTypes.has(lessonType);
                    const ic = getLessonIconInfo(lesson);

                    // IF logged in and it belongs to this course, we prefer the course-prefixed URL
                    // ELSE we use the generic top-level URL for public notes
                    let lessonHref;
                    if (session && (isConceptGlossary || isContentCollection)) {
                      lessonHref = buildCourseLessonHref(
                          canonicalCourseIdToUse || '',
                          courseData,
                          lesson as any,
                          lessonPathIndex,
                        );
                    } else if (isContentCollection || isConceptGlossary) {
                      lessonHref = `/${getContentCanonicalSlug(lesson as any)}`;
                    } else {
                      lessonHref = buildCourseLessonHref(
                          canonicalCourseIdToUse || '',
                          courseData,
                          lesson as any,
                          lessonPathIndex,
                        );
                    }

                    const lessonPageSlug = isContentCollection
                      ? getContentCanonicalSlug(lesson as any)
                      : (lessonPathIndex.pathByEntryId.get(lesson.id)
                         || getCourseEntryLegacyPath(lesson as any, canonicalCourseIdToUse || ''));

                    const isActive = currentEntry?.id === lesson.id;
                    const lessonStatus = String(lesson.data.status || '').trim().toLowerCase();

                    return (
                      <li class="lesson-item">
                        <a
                          href={lessonHref}
                          class:list={['lesson-link', { active: isActive }]}
                          data-astro-prefetch="false"
                          data-course-id={canonicalCourseIdToUse || courseSlug}
