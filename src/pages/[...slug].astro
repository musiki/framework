        function renderPosts(targetPostList, threadId, posts, canReply, canVote) {
          if (!(targetPostList instanceof HTMLElement)) return;
          targetPostList.innerHTML = '';
          if (String(threadId || '').trim() === String(forumState.selectedThreadId || '').trim()) {
            updateReplyFormVisibility(canReply);
          }

          const visiblePosts = Array.isArray(posts)
            ? posts.filter((post) => String(post?.status || '').toLowerCase() !== 'deleted')
            : [];

          if (visiblePosts.length === 0) {
            const empty = document.createElement('p');
            empty.className = 'forum-empty';
            empty.textContent = 'Este hilo todavía no tiene mensajes.';
            targetPostList.appendChild(empty);
            return;
          }

          const renderedThreadId = String(threadId || '').trim();
          const postsById = new Map(visiblePosts.map((post) => [post.id, post]));
          const childrenByParent = new Map();

          visiblePosts.forEach((post) => {
            const parentKey = post.parentPostId && postsById.has(post.parentPostId) ? post.parentPostId : 'root';
            if (!childrenByParent.has(parentKey)) childrenByParent.set(parentKey, []);
            childrenByParent.get(parentKey).push(post);
          });

          const fragment = document.createDocumentFragment();
          const rootPosts = childrenByParent.get('root') || [];
          const opPostId = rootPosts[0]?.id || visiblePosts[0]?.id || '';
          let lastRenderedDayKey = '';

          const appendChildren = (parentId, depth) => {
            const children = childrenByParent.get(parentId) || [];
            children.forEach((post) => {
              const dayKey = getForumDayKey(post.createdAt);
              if (dayKey !== lastRenderedDayKey) {
                const dateSeparator = document.createElement('div');
                dateSeparator.className = 'forum-post-date-separator';
                dateSeparator.textContent = formatForumDayLabel(post.createdAt);
                fragment.appendChild(dateSeparator);
                lastRenderedDayKey = dayKey;
              }

              const card = document.createElement('article');
              card.className = 'forum-post';
              card.dataset.postId = post.id;
              if (depth > 0) {
                card.classList.add('forum-post-reply');
                card.style.marginLeft = `${Math.min(depth, 2) * 0.72}rem`;
              }
              if (post.id === opPostId) {
                card.classList.add('forum-post-op');
              }
              const normalizedRole = String(post.authorRole || '').trim().toLowerCase();
              if (normalizedRole === 'teacher') {
                card.classList.add('forum-post-role-instructor');
              } else if (normalizedRole === 'student') {
                card.classList.add('forum-post-role-student');
              }

              const identity = document.createElement('aside');
              identity.className = 'forum-post-identity';

              const authorName = post.authorName || 'Usuario';
              const avatar = createForumAvatar(authorName, post.authorImage);
              identity.appendChild(avatar);

              const metaInline = document.createElement('div');
              metaInline.className = 'forum-post-meta-inline';

              const author = document.createElement('span');
              author.className = 'forum-post-name';
              author.textContent = authorName;
              metaInline.appendChild(author);

              const date = document.createElement('span');
              date.className = 'forum-post-date';
              const createdLabel = formatForumDate(post.createdAt);
              if (isForumPostEdited(post)) {
                date.textContent = `${createdLabel} • editado ${formatForumDate(post.updatedAt)}`;
              } else {
                date.textContent = createdLabel;
              }
              metaInline.appendChild(date);
              identity.appendChild(metaInline);

              const main = document.createElement('div');
              main.className = 'forum-post-main';

              const body = document.createElement('div');
              body.className = 'forum-post-body';
              setForumBodyContent(body, post);
              main.appendChild(body);

              const canEditPost = Boolean(post.canEdit);
              const canDeletePost = Boolean(post.canDelete);
              const canVotePost = Boolean(canVote);
              if (canReply || canEditPost || canDeletePost || canVotePost) {
                const actions = document.createElement('div');
                actions.className = 'forum-post-actions';
                actions.hidden = true;
                const syncPostActionsVisibility = () => {
                  actions.hidden = !Array.from(actions.children).some(
                    (child) => child instanceof HTMLElement && !child.hidden && child.style.display !== 'none',
                  );
                };

                /** @type {HTMLButtonElement | null} */
                let replyButton = null;
                /** @type {HTMLButtonElement[]} */
                let reactionButtons = [];
                /** @type {HTMLButtonElement[]} */
                let reactionSummaryButtons = [];
                /** @type {HTMLButtonElement | null} */
                let reactionMoreButton = null;
                /** @type {HTMLDivElement | null} */
                let reactionGroup = null;
                /** @type {HTMLDivElement | null} */
                let quickActions = null;
                /** @type {HTMLDivElement | null} */
                let quickTray = null;
                const quickButtonByReactionValue = new Map();
                const summaryButtonByReactionValue = new Map();
                /** @type {Record<string, HTMLSpanElement>} */
                const reactionCountEls = {};
                /** @type {Record<string, HTMLDivElement>} */
                const reactionSummaryItems = {};
                const closeSiblingQuickMenus = () => {
                  document.querySelectorAll('.forum-post.is-quick-open').forEach((node) => {
                    if (node !== card) node.classList.remove('is-quick-open');
                  });
                };
                const setQuickMenuOpen = (isOpen) => {
                  if (!quickActions) return;
                  if (isOpen) closeSiblingQuickMenus();
                  card.classList.toggle('is-quick-open', Boolean(isOpen));
                };
                const canOpenQuickMenu = canVotePost || canEditPost || canDeletePost || canReply;

                if (canOpenQuickMenu) {
                  quickActions = document.createElement('div');
                  quickActions.className = 'forum-post-quick-actions';

                  quickTray = document.createElement('div');
                  quickTray.className = 'forum-post-quick-tray';
                  quickActions.appendChild(quickTray);
                  main.appendChild(quickActions);

                  let longPressTimer = 0;
                  let longPressTriggered = false;
                  const clearLongPress = () => {
                    if (longPressTimer) {
                      window.clearTimeout(longPressTimer);
                      longPressTimer = 0;
                    }
                  };
                  const isTouchReveal = () =>
                    typeof window !== 'undefined'
                    && typeof window.matchMedia === 'function'
                    && window.matchMedia('(hover: none), (pointer: coarse)').matches;

                  card.addEventListener('pointerdown', (event) => {
                    if (!isTouchReveal()) return;
                    if (event.pointerType === 'mouse') return;
                    if (event.target instanceof Element && event.target.closest('button, a, input, textarea, select, summary, .forum-post-body')) return;
                    longPressTriggered = false;
                    clearLongPress();
                    longPressTimer = window.setTimeout(() => {
                      longPressTriggered = true;
                      setQuickMenuOpen(true);
                    }, 420);
                  });

                  ['pointerup', 'pointercancel', 'pointerleave'].forEach((eventName) => {
                    card.addEventListener(eventName, clearLongPress);
                  });

                  card.addEventListener('click', (event) => {
                    if (!longPressTriggered) return;
                    longPressTriggered = false;
                    event.preventDefault();
                    event.stopPropagation();
                  });

                  quickTray.addEventListener('keydown', (event) => {
                    if (event.key !== 'Escape') return;
                    setQuickMenuOpen(false);
                    if (reactionMoreButton) reactionMoreButton.focus();
                  });
                }

                if (canReply) {
                  replyButton = document.createElement('button');
                  replyButton.type = 'button';
                  replyButton.className = 'forum-post-reply-btn forum-action-btn';
                  replyButton.innerHTML = '<svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 3L1 7.5l4.5 4.5"/><path d="M1 7.5H10a5 5 0 0 1 5 5"/></svg>';
                  replyButton.dataset.tooltip = 'Responder';
                  replyButton.title = 'Responder';
                  replyButton.setAttribute('aria-label', 'Responder');
                  replyButton.addEventListener('click', () => {
                    setQuickMenuOpen(false);
                    setReplyTarget(renderedThreadId, post.id, post.authorName || 'usuario');
                  });
                }

                if (canVotePost) {
                  reactionGroup = document.createElement('div');
                  reactionGroup.className = 'forum-post-reactions';

                  const reactionDefs = [
                    { value: 1, key: 'useful', icon: '👍', label: 'Útil', className: 'forum-post-reaction-useful' },
                    { value: 2, key: 'clarifies', icon: '💡', label: 'Aclara', className: 'forum-post-reaction-clarifies' },
                    { value: 3, key: 'reference', icon: '📎', label: 'Referencia valiosa', className: 'forum-post-reaction-reference' },
                  ];

                  const initialCounts = (post && typeof post.reactionCounts === 'object' && post.reactionCounts)
                    ? post.reactionCounts
                    : null;
                  const reactionCounts = {
                    useful: Math.max(0, Number(initialCounts?.useful) || 0),
                    clarifies: Math.max(0, Number(initialCounts?.clarifies) || 0),
                    reference: Math.max(0, Number(initialCounts?.reference) || 0),
                  };

                  let currentMyReaction = Number(post?.myReaction ?? post?.myVote ?? 0);
                  if (currentMyReaction !== 1 && currentMyReaction !== 2 && currentMyReaction !== 3) {
                    currentMyReaction = 0;
                  }

                  const applyReactionState = () => {
                    let hasVisibleSummary = false;
                    reactionDefs.forEach((def) => {
                      const isActive = currentMyReaction === def.value;
                      const quickButton = quickButtonByReactionValue.get(def.value);
                      if (quickButton) {
                        quickButton.classList.toggle('is-active', isActive);
                        quickButton.setAttribute('aria-pressed', isActive ? 'true' : 'false');
                      }
                      const summaryButton = summaryButtonByReactionValue.get(def.value);
                      if (summaryButton) {
                        summaryButton.classList.toggle('is-active', isActive);
                        summaryButton.setAttribute('aria-pressed', isActive ? 'true' : 'false');
                      }
                      const count = Math.max(0, Number(reactionCounts[def.key]) || 0);
                      const summaryItem = reactionSummaryItems[def.key];
                      if (summaryItem) {
                        summaryItem.hidden = count <= 0;
                        if (count > 0) hasVisibleSummary = true;
                      }
                      const countEl = reactionCountEls[def.key];
                      if (countEl) {
                        countEl.textContent = String(count);
                      }
                    });
                    if (reactionGroup) reactionGroup.hidden = !hasVisibleSummary;
                    if (reactionMoreButton) reactionMoreButton.hidden = !hasVisibleSummary;
                    if (replyButton) {
                      actions.hidden = false;
                    } else {
                      actions.hidden = !hasVisibleSummary;
                    }
                    card.classList.toggle('forum-post-has-reaction-summary', hasVisibleSummary);
                  };

                  const submitReaction = async (nextReaction) => {
                    if (!canVotePost) return;
                    setQuickMenuOpen(false);

                    reactionButtons.forEach((button) => {
                      button.disabled = true;
                    });
                    reactionSummaryButtons.forEach((button) => {
                      button.disabled = true;
                    });
                    if (reactionMoreButton) reactionMoreButton.disabled = true;

                    try {
                      const response = await fetch(`/api/forum/posts/${encodeURIComponent(post.id)}/vote`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ value: nextReaction }),
                      });
                      const payload = await response.json().catch(() => ({}));
                      if (!response.ok) {
                        throw new Error(payload?.error || 'No se pudo registrar la reacción.');
                      }

                      const payloadCounts = payload?.reactionCounts;
                      if (payloadCounts && typeof payloadCounts === 'object') {
                        reactionCounts.useful = Math.max(0, Number(payloadCounts.useful) || 0);
                        reactionCounts.clarifies = Math.max(0, Number(payloadCounts.clarifies) || 0);
                        reactionCounts.reference = Math.max(0, Number(payloadCounts.reference) || 0);
                      }

                      const nextMyReaction = Number(payload?.myReaction ?? payload?.myVote ?? 0);
                      if (nextMyReaction === 1 || nextMyReaction === 2 || nextMyReaction === 3) {
                        currentMyReaction = nextMyReaction;
                      } else {
                        currentMyReaction = 0;
                      }

                      invalidateForumPostsCache(renderedThreadId);
                      applyReactionState();
                    } catch (error) {
                      console.error('Forum reaction error:', error);
                      setForumStatus(error?.message || 'No se pudo registrar la reacción.', 'error');
                    } finally {
                      reactionButtons.forEach((button) => {
                        button.disabled = false;
                      });
                      reactionSummaryButtons.forEach((button) => {
                        button.disabled = false;
                      });
                      if (reactionMoreButton) reactionMoreButton.disabled = false;
                    }
                  };

                  reactionDefs.forEach((def) => {
                    const quickReactionButton = document.createElement('button');
                    quickReactionButton.type = 'button';
                    quickReactionButton.className = `forum-post-reaction-btn forum-post-quick-reaction-btn forum-action-btn ${def.className}`;
                    quickReactionButton.textContent = def.icon;
                    quickReactionButton.dataset.tooltip = def.label;
                    quickReactionButton.title = def.label;
                    quickReactionButton.setAttribute('aria-label', def.label);
                    quickReactionButton.setAttribute('aria-pressed', 'false');
                    quickReactionButton.addEventListener('click', () => {
                      submitReaction(currentMyReaction === def.value ? 0 : def.value);
                    });
                    quickButtonByReactionValue.set(def.value, quickReactionButton);
                    reactionButtons.push(quickReactionButton);
                    if (quickTray) quickTray.appendChild(quickReactionButton);

                    const reactionItem = document.createElement('div');
                    reactionItem.className = 'forum-post-reaction-item';
                    reactionSummaryItems[def.key] = reactionItem;

                    const summaryButton = document.createElement('button');
                    summaryButton.type = 'button';
                    summaryButton.className = `forum-post-reaction-btn forum-post-reaction-summary-btn forum-action-btn ${def.className}`;
                    summaryButton.textContent = def.icon;
                    summaryButton.dataset.tooltip = def.label;
                    summaryButton.title = def.label;
                    summaryButton.setAttribute('aria-label', def.label);
                    summaryButton.setAttribute('aria-pressed', 'false');
                    summaryButton.addEventListener('click', () => {
                      submitReaction(currentMyReaction === def.value ? 0 : def.value);
                    });

                    const countEl = document.createElement('span');
                    countEl.className = 'forum-post-reaction-count';
                    countEl.dataset.countKey = def.key;
                    reactionCountEls[def.key] = countEl;

                    summaryButtonByReactionValue.set(def.value, summaryButton);
                    reactionSummaryButtons.push(summaryButton);

                    reactionItem.appendChild(summaryButton);
                    reactionItem.appendChild(countEl);
                    reactionGroup.appendChild(reactionItem);
                  });

                  reactionMoreButton = document.createElement('button');
                  reactionMoreButton.type = 'button';
                  reactionMoreButton.className = 'forum-post-more-btn forum-action-btn forum-action-more';
                  reactionMoreButton.textContent = '···';
                  reactionMoreButton.dataset.tooltip = 'Mas acciones';
                  reactionMoreButton.title = 'Mas acciones';
                  reactionMoreButton.setAttribute('aria-label', 'Mas acciones');
                  reactionMoreButton.addEventListener('click', (event) => {
                    event.preventDefault();
                    event.stopPropagation();
                    const nextOpenState = !card.classList.contains('is-quick-open');
                    setQuickMenuOpen(nextOpenState);
                  });

                  applyReactionState();
                  if (replyButton && quickTray) {
                    quickTray.insertBefore(replyButton, quickTray.firstChild);
                  }
                  actions.appendChild(reactionGroup);
                  actions.appendChild(reactionMoreButton);
                }

                /** @type {HTMLButtonElement | null} */
                let editButton = null;
                /** @type {HTMLButtonElement | null} */
                let deleteButton = null;
                /** @type {HTMLDivElement | null} */
                let editContainer = null;
                /** @type {HTMLTextAreaElement | null} */
                let editTextarea = null;
                /** @type {HTMLButtonElement | null} */
                let saveEditButton = null;
                /** @type {HTMLButtonElement | null} */
                let cancelEditButton = null;

                /** @param {boolean} isEditing */
                function setEditMode(isEditing) {
                  if (!editContainer || !editTextarea || !editButton) return;
                  setQuickMenuOpen(false);
                  editContainer.hidden = !isEditing;
                  body.hidden = isEditing;
                  editButton.hidden = isEditing;
                  if (replyButton) replyButton.disabled = isEditing;
                  reactionButtons.forEach((button) => {
                    button.disabled = isEditing;
                  });
                  reactionSummaryButtons.forEach((button) => {
                    button.disabled = isEditing;
                  });
                  if (reactionMoreButton) reactionMoreButton.disabled = isEditing;
                  if (deleteButton) deleteButton.disabled = isEditing;
                  if (isEditing) {
                    actions.hidden = false;
                  } else {
                    syncPostActionsVisibility();
                  }

                  if (isEditing) {
                    editTextarea.value = post.body || '';
                    editTextarea.setSelectionRange(editTextarea.value.length, editTextarea.value.length);
                    editTextarea.dispatchEvent(new Event('input', { bubbles: true }));
                  }
                }

                if (canEditPost) {
                  editButton = document.createElement('button');
                  editButton.type = 'button';
                  editButton.className = 'forum-post-edit-btn forum-action-btn forum-action-e';
                  editButton.textContent = 'E';
                  editButton.dataset.tooltip = 'Editar';
                  editButton.title = 'Editar';
                  editButton.setAttribute('aria-label', 'Editar');
                  editButton.addEventListener('click', () => {
                    setEditMode(true);
                  });
                  if (quickTray) quickTray.appendChild(editButton);

                  editContainer = document.createElement('div');
                  editContainer.className = 'forum-edit-form';
                  editContainer.hidden = true;

                  editTextarea = document.createElement('textarea');
                  editTextarea.className = 'forum-textarea forum-edit-textarea';
                  editTextarea.maxLength = 4000;
                  editTextarea.placeholder = 'Edita tu mensaje...';
                  editTextarea.value = post.body || '';
                  editTextarea.addEventListener('keydown', (event) => {
                    if (event.key !== 'Enter') return;
                    if (!(event.metaKey || event.ctrlKey)) return;
                    event.preventDefault();
                    if (saveEditButton) saveEditButton.click();
                  });
                  editContainer.appendChild(editTextarea);

                  const editActions = document.createElement('div');
                  editActions.className = 'forum-form-actions';

                  saveEditButton = document.createElement('button');
                  saveEditButton.type = 'button';
                  saveEditButton.className = 'forum-post-save-btn forum-action-btn forum-action-g';
                  saveEditButton.textContent = 'G';
                  saveEditButton.dataset.tooltip = 'Guardar cambios';
                  saveEditButton.title = 'Guardar cambios';
                  saveEditButton.setAttribute('aria-label', 'Guardar cambios');
                  saveEditButton.addEventListener('click', async () => {
                    if (!editTextarea) return;

                    const nextBody = editTextarea.value.trim();
                    if (!nextBody) {
                      setForumStatus('El mensaje no puede quedar vacío.', 'error');
                      return;
                    }

                    if (saveEditButton) saveEditButton.disabled = true;
                    if (cancelEditButton) cancelEditButton.disabled = true;

                    try {
                      const response = await fetch(`/api/forum/posts/${encodeURIComponent(post.id)}?renderContext=course`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                          body: nextBody,
                        }),
                      });

                      const payload = await response.json().catch(() => /** @type {{ error?: string }} */ ({}));
                      if (!response.ok) {
                        throw new Error(payload?.error || 'No se pudo editar el mensaje.');
                      }

                      invalidateForumPostsCache(renderedThreadId);
                      invalidateForumThreadCache();
                      setForumStatus('Mensaje actualizado.', 'info');
                      await loadPosts(renderedThreadId);
                    } catch (error) {
                      console.error('Forum post edit error:', error);
                      const message = error instanceof Error ? error.message : 'No se pudo editar el mensaje.';
                      setForumStatus(message, 'error');
                    } finally {
                      if (saveEditButton) saveEditButton.disabled = false;
                      if (cancelEditButton) cancelEditButton.disabled = false;
                    }
                  });
                  editActions.appendChild(saveEditButton);

                  cancelEditButton = document.createElement('button');
                  cancelEditButton.type = 'button';
                  cancelEditButton.className = 'forum-post-cancel-btn forum-action-btn forum-action-c';
                  cancelEditButton.textContent = 'C';
                  cancelEditButton.dataset.tooltip = 'Cancelar edición';
                  cancelEditButton.title = 'Cancelar edición';
                  cancelEditButton.setAttribute('aria-label', 'Cancelar edición');
                  cancelEditButton.addEventListener('click', () => {
                    setEditMode(false);
                  });
                  editActions.appendChild(cancelEditButton);

                  editContainer.appendChild(editActions);
                  attachForumEditor(editTextarea, editActions);
                  syncPostActionsVisibility();
                }

                if (canDeletePost) {
                  deleteButton = document.createElement('button');
                  deleteButton.type = 'button';
                  deleteButton.className = 'forum-post-delete-btn forum-action-btn forum-action-b';
                  deleteButton.textContent = 'B';
                  deleteButton.dataset.tooltip = 'Borrar';
                  deleteButton.title = 'Borrar';
                  deleteButton.setAttribute('aria-label', 'Borrar');
                  deleteButton.addEventListener('click', async () => {
                    setQuickMenuOpen(false);
                    if (!confirm('¿Seguro que quieres borrar este mensaje?')) return;

                    if (deleteButton) deleteButton.disabled = true;
                    if (editButton) editButton.disabled = true;
                    if (replyButton) replyButton.disabled = true;

                    try {
                      const response = await fetch(`/api/forum/posts/${encodeURIComponent(post.id)}`, {
                        method: 'DELETE',
                      });

                      const payload = await response.json().catch(() => /** @type {{ error?: string }} */ ({}));
                      if (!response.ok) {
                        throw new Error(payload?.error || 'No se pudo borrar el mensaje.');
                      }

                      invalidateForumPostsCache(renderedThreadId);
                      invalidateForumThreadCache();
                      setForumStatus('Mensaje borrado.', 'info');
                      await loadThreads({ preserveSelection: true });
                    } catch (error) {
                      console.error('Forum post delete error:', error);
                      const message = error instanceof Error ? error.message : 'No se pudo borrar el mensaje.';
                      setForumStatus(message, 'error');
                    } finally {
                      if (deleteButton) deleteButton.disabled = false;
                      if (editButton) editButton.disabled = false;
                      if (replyButton) replyButton.disabled = false;
                    }
                  });
                  if (quickTray) quickTray.appendChild(deleteButton);
                }

                if (replyButton && !replyButton.isConnected) {
                  if (quickTray) {
                    quickTray.insertBefore(replyButton, quickTray.firstChild);
                  } else {
                    actions.appendChild(replyButton);
                    actions.hidden = false;
                  }
                }
                main.appendChild(actions);

                if (editContainer) {
                  main.appendChild(editContainer);
                }
              }

              card.appendChild(identity);
              card.appendChild(main);
              fragment.appendChild(card);
              appendChildren(post.id, depth + 1);
            });
          };

          appendChildren('root', 0);
          targetPostList.appendChild(fragment);
          renderForumMermaid(targetPostList);
        }

        async function loadPosts(threadId) {
          if (!threadId) {
            unsubscribeForumRealtime();
            return;
          }
          subscribeForumRealtime(threadId);

          const cacheKey = getForumPostsCacheKey(threadId);
          const cachedPayload = getForumCachedPayload(forumQueryCache.posts, cacheKey);
          const applyPayloadIfOpen = (payload) => {
            if (!forumState.openThreadIds.has(String(threadId || '').trim())) return;
            applyForumPostsPayload(threadId, payload);
          };

          if (cachedPayload) {
            applyPayloadIfOpen(cachedPayload);

            if (!isForumCacheFresh(forumQueryCache.posts, cacheKey, FORUM_POST_CACHE_TTL_MS)) {
              void requestForumCachedPayload(
                forumQueryCache.posts,
                cacheKey,
                () => fetchForumPostsFromNetwork(threadId),
              )
                .then((payload) => {
                  applyPayloadIfOpen(payload);
                })
                .catch((error) => {
                  console.error('Forum load posts background error:', error);
                });
            }

            return cachedPayload;
          }

          setThreadLoadingState(threadId);

          try {
            const payload = await requestForumCachedPayload(
              forumQueryCache.posts,
              cacheKey,
              () => fetchForumPostsFromNetwork(threadId),
            );

            applyPayloadIfOpen(payload);
            return payload;
          } catch (error) {
            console.error('Forum load posts error:', error);
            if (forumState.openThreadIds.has(String(threadId || '').trim())) {
              const target = findThreadPostList(threadId);
              renderPosts(target, threadId, [], false, false);
              setForumStatus(error?.message || 'No se pudieron cargar los mensajes del hilo.', 'error');
            }
            return null;
          }
        }

        // ─── Forum Realtime ───────────────────────────────────────────────────────
        // Subscribe to a thread channel via Supabase Broadcast.
        // One lightweight WebSocket per page, swapped when the active thread changes.

        function patchForumPostReactionSummary(postId, rawCounts) {
          const postSelector = `[data-post-id="${CSS.escape(String(postId || '').trim())}"]`;
          const postEl = threadListEl.querySelector(postSelector);
          if (!(postEl instanceof HTMLElement)) return;

          const reactionCounts = {
            useful: Math.max(0, Number(rawCounts?.useful) || 0),
            clarifies: Math.max(0, Number(rawCounts?.clarifies) || 0),
            reference: Math.max(0, Number(rawCounts?.reference) || 0),
          };

          let hasVisibleSummary = false;
          ['useful', 'clarifies', 'reference'].forEach((key) => {
            const count = reactionCounts[key];
            const countEl = postEl.querySelector(`[data-count-key="${key}"]`);
            if (countEl instanceof HTMLElement) {
              countEl.textContent = String(count);
              const summaryItem = countEl.closest('.forum-post-reaction-item');
              if (summaryItem instanceof HTMLElement) {
                summaryItem.hidden = count <= 0;
              }
            }
            if (count > 0) hasVisibleSummary = true;
          });

          const reactionGroup = postEl.querySelector('.forum-post-reactions');
          if (reactionGroup instanceof HTMLElement) {
            reactionGroup.hidden = !hasVisibleSummary;
          }

          const reactionMoreButton = postEl.querySelector('.forum-post-more-btn');
          if (reactionMoreButton instanceof HTMLElement) {
            reactionMoreButton.hidden = !hasVisibleSummary;
          }

          const replyButton = postEl.querySelector('.forum-post-reply-btn');
          const actions = postEl.querySelector('.forum-post-actions');
          if (actions instanceof HTMLElement) {
            actions.hidden = !hasVisibleSummary && !(replyButton instanceof HTMLElement);
          }

          postEl.classList.toggle('forum-post-has-reaction-summary', hasVisibleSummary);
        }

        /** @type {any} */
        let _forumRtChannel = null;
        /** @type {any} */
        let _forumRtClient  = null;

        function unsubscribeForumRealtime() {
          if (_forumRtChannel && _forumRtClient) {
            _forumRtClient.removeChannel(_forumRtChannel).catch(() => {});
          }
          _forumRtChannel = null;
        }

        /** @param {string} threadId */
        function subscribeForumRealtime(threadId) {
          // Realtime disabled (previously Supabase)
          return;
        }

        // ─────────────────────────────────────────────────────────────────────────

        async function fetchForumBoards({ forceNetwork = false, silent = false } = {}) {
          const cacheKey = getForumBoardsCacheKey();
          if (!cacheKey) return null;
          if (forceNetwork) invalidateForumBoardsCache();

          const cachedPayload = !forceNetwork
            ? getForumCachedPayload(forumQueryCache.boards, cacheKey)
            : null;

          if (cachedPayload && isForumCacheFresh(forumQueryCache.boards, cacheKey, FORUM_BOARD_CACHE_TTL_MS)) {
            applyForumBoardsPayload(cachedPayload);
            return cachedPayload;
          }

          try {
            const payload = await requestForumCachedPayload(
              forumQueryCache.boards,
              cacheKey,
              () => fetchForumBoardsFromNetwork(forumState.courseId, { force: forceNetwork }),
            );
            applyForumBoardsPayload(payload);
            return payload;
          } catch (error) {
            if (cachedPayload) {
              applyForumBoardsPayload(cachedPayload);
              if (!silent) {
                console.error('Forum board refresh error:', error);
              }
              return cachedPayload;
            }
            throw error;
          }
        }

        async function loadBoards({ preferredSlug = '', syncHistory = true } = {}) {
          if (forumState.mode !== 'board') return;

          await fetchForumBoards();

          const slugs = forumState.boards
            .map((board) => normalizeForumBoardSlug(board?.slug))
            .filter(Boolean);
          const targetSlug = normalizeForumBoardSlug(preferredSlug || forumState.boardSlug);
          if (targetSlug && slugs.includes(targetSlug)) {
            forumState.boardSlug = targetSlug;
          } else {
            forumState.boardSlug = slugs[0] || '';
          }

          if (syncHistory) {
            syncBoardQueryParam();
          }
          await refreshCourseForumSubnav({
            preferredBoardSlug: forumState.boardSlug,
            boards: forumState.boards,
            activeMode: 'board',
          });
        }

        async function loadThreads({ preserveSelection = true, autoOpenNewThreads = true } = {}) {
          const scope = resolveForumScopeDescriptor();
          const cacheKey = getForumScopeCacheKey(scope);
          const requestToken = ++latestThreadRequestToken;
          const cachedPayload = getForumCachedPayload(forumQueryCache.threads, cacheKey);

          const applyPayloadIfCurrent = async (payload) => {
            if (requestToken !== latestThreadRequestToken) return;
            if (!isForumScopeCurrent(scope)) return;

            const openThreadIds = applyForumThreadsPayload(payload, { preserveSelection, autoOpenNewThreads });
            syncCourseForumSubnavScopeMetrics(scope, payload?.threads || []);

            await Promise.all(openThreadIds.map((threadId) => loadPosts(threadId)));

            if (!forumState.canWrite) {
              setForumStatus('Puedes leer este foro, pero necesitas inscripción para publicar.', 'info');
            } else {
              setForumStatus('');
            }

            markForumScopeAsRead();
          };

          if (cachedPayload) {
            await applyPayloadIfCurrent(cachedPayload);

            if (!isForumCacheFresh(forumQueryCache.threads, cacheKey, FORUM_THREAD_CACHE_TTL_MS)) {
              void requestForumCachedPayload(
                forumQueryCache.threads,
                cacheKey,
                () => fetchForumThreadsFromNetwork(scope),
              )
                .then((payload) => {
                  void applyPayloadIfCurrent(payload);
                  const firstThreadId = String(payload?.threads?.[0]?.id || '').trim();
                  if (firstThreadId && autoOpenNewThreads) {
                    void prefetchForumPosts(firstThreadId);
                  }
                })
                .catch((error) => {
                  console.error('Forum load threads background error:', error);
                });
            }

            return cachedPayload;
          }

          setThreadListLoadingState();

          try {
            const payload = await requestForumCachedPayload(
              forumQueryCache.threads,
              cacheKey,
              () => fetchForumThreadsFromNetwork(scope),
            );

            await applyPayloadIfCurrent(payload);

            const firstThreadId = String(payload?.threads?.[0]?.id || '').trim();
            if (firstThreadId && autoOpenNewThreads) {
              void prefetchForumPosts(firstThreadId);
            }

            return payload;
          } catch (error) {
            console.error('Forum load threads error:', error);
            if (requestToken === latestThreadRequestToken) {
              forumState.threads = [];
              forumState.selectedThreadId = '';
              forumState.openThreadIds = new Set();
              forumState.canWrite = false;
              newThreadForm.hidden = true;
              if (newThreadContainer) newThreadContainer.hidden = true;
              renderThreadList();
              setForumStatus(error?.message || 'No se pudieron cargar los hilos del foro.', 'error');
            }
            return null;
          }
        }

