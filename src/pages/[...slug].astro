      {!isPublicReaderMode && <CoursePodWorkspace />}
    </main>
    <script>
      import { hydrateLazyYouTubeEmbeds } from '../scripts/course/lazy-youtube.ts';
      import { initStrudelBlocks } from '../scripts/course/strudel-blocks.ts';

      const win = window as any;
      function bootLazyYouTubeEmbeds() {
        hydrateLazyYouTubeEmbeds(document);
      }

      function bootStrudelBlocks() {
        initStrudelBlocks(document);
      }

      bootLazyYouTubeEmbeds();
      bootStrudelBlocks();
      if (win.__musikiLazyYouTubeBootBound !== true) {
        win.__musikiLazyYouTubeBootBound = true;
        document.addEventListener('astro:page-load', bootLazyYouTubeEmbeds);
      }
      if (win.__musikiStrudelBlocksBootBound !== true) {
        win.__musikiStrudelBlocksBootBound = true;
        document.addEventListener('astro:page-load', bootStrudelBlocks);
      }
    </script>
    {canManageLiveInteractions && (
      <script>
        import { initNotesSidebar } from '../scripts/course/sidebar/notes-sidebar.ts';

        function bootNotesSidebar() {
          const container = document.querySelector<HTMLElement>('[data-notes-sidebar]');
          if (!container) return;
          const courseId = container.dataset.courseId ?? '';
          const courseHref = container.dataset.courseHref ?? '';
          const activeSlug = container.dataset.activeSlug || null;
          if (courseId) initNotesSidebar(container, courseId, courseHref, activeSlug);
        }

        bootNotesSidebar();
        document.addEventListener('astro:page-load', bootNotesSidebar);
      </script>
    )}
    {canonicalCourseIdToUse && (
      <script>
        import { initDockviewWorkspace } from '../scripts/course/dockview-workspace.ts';

        function bootWorkspace() {
          const container = document.getElementById('cnw-root');
          if (!container) return;
          const layoutRoot = document.querySelector<HTMLElement>('[data-course-layout-root]');
          const courseId = layoutRoot?.dataset.liveCourseId ?? '';
          if (!courseId) return;
          try {
            const ws = initDockviewWorkspace(container, courseId, null, null);
            (window as any).__cnwWorkspace = ws;
          } catch (e) {
            console.error('[dockview] initDockviewWorkspace threw:', e);
          }
        }

        bootWorkspace();
        document.addEventListener('astro:page-load', bootWorkspace);

        // Open recursos media items in bottom dockview pod
        const win = window as any;
        if (typeof win.__musikiCourseResourceClickHandler === 'function') {
          document.removeEventListener('click', win.__musikiCourseResourceClickHandler, true);
        }
        win.__musikiCourseResourceClickHandler = (e: MouseEvent) => {
          const link = (e.target as Element)?.closest<HTMLAnchorElement>('.recursos-sidebar-resource-link');
          if (!link) return;
          const ws = (window as any).__cnwWorkspace;
          if (!ws) return;
          const url = link.href;
          const name = link.querySelector('.recursos-sidebar-resource-name')?.textContent?.trim() || url;
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          ws.openMedia(url, name, 'bottom');
        };
        document.addEventListener('click', win.__musikiCourseResourceClickHandler, true);

        // Open course lesson/note sidebar links inside dockview (not full navigation).
        // Global concepts can live in src/content/public, so they arrive without the
        // courseId prefix and still need to open as preview pods.
        if (typeof win.__musikiCourseLessonClickHandler === 'function') {
          document.removeEventListener('click', win.__musikiCourseLessonClickHandler, true);
        }
        win.__musikiCourseLessonClickHandler = (e: MouseEvent) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
          const target = e.target instanceof Element ? e.target : null;
          const link = target?.closest<HTMLAnchorElement>('.lesson-link');
          if (!link) return;
          const ws = win.__cnwWorkspace;
          if (!ws) return;
          const slug = link.dataset.lessonPageSlug;
          if (!slug) return;
          const cid = link.dataset.courseId || '';
          const noteSlug = cid && slug.startsWith(cid + '/')
            ? slug.slice(cid.length + 1)
            : slug;
          if (!noteSlug) return;
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          // Alt+click = split; plain click = replace current panel
          ws.openNote(noteSlug, 'preview', e.altKey);
	        };
	        document.addEventListener('click', win.__musikiCourseLessonClickHandler, true);
	      </script>
	    )}
	    <script>
	      const recursosFoldWin = window as any;

	      function normalizeRecursosFoldLabel(value: string) {
	        return value
	          .replace(/[▸⊟]/g, ' ')
	          .replace(/\s+/g, ' ')
	          .trim()
	          .toLowerCase();
	      }

	      function getRecursosFoldDetails(tree: HTMLElement) {
	        return Array.from(
	          tree.querySelectorAll<HTMLDetailsElement>('details.recursos-sidebar-session, details.recursos-sidebar-folder')
	        );
	      }

	      function getRecursosFoldStorageKey(tree: HTMLElement) {
	        const rawCourse = String(tree.dataset.clase || tree.dataset.courseId || tree.dataset.room || '').split('/')[0];
	        return `musiki:recursos-sidebar-fold-state:${rawCourse || location.pathname}`;
	      }

	      function readRecursosFoldState(tree: HTMLElement): Record<string, boolean> {
	        try {
	          const raw = localStorage.getItem(getRecursosFoldStorageKey(tree));
	          const parsed = raw ? JSON.parse(raw) : {};
	          return parsed && typeof parsed === 'object' ? parsed : {};
	        } catch {
	          return {};
	        }
	      }

	      function getRecursosFoldNodeKey(details: HTMLDetailsElement): string {
	        const summary = details.querySelector('summary');
	        const label = normalizeRecursosFoldLabel(summary?.textContent || '');
	        if (details.classList.contains('recursos-sidebar-folder')) {
	          const session = details.closest<HTMLDetailsElement>('details.recursos-sidebar-session');
	          const sessionKey = session ? getRecursosFoldNodeKey(session) : 'session:root';
	          return `${sessionKey}/folder:${label || 'sin-carpeta'}`;
	        }
	        return `session:${label || 'sin-sesion'}`;
	      }

	      function writeRecursosFoldState(tree: HTMLElement) {
	        const state: Record<string, boolean> = {};
	        for (const details of getRecursosFoldDetails(tree)) {
	          state[getRecursosFoldNodeKey(details)] = details.open;
	        }
	        try {
	          localStorage.setItem(getRecursosFoldStorageKey(tree), JSON.stringify(state));
	        } catch {}
	      }

	      function updateRecursosFoldButtons(tree: HTMLElement) {
	        const details = getRecursosFoldDetails(tree);
	        const canOpen = details.some(d => !d.open);
	        const chapter = tree.closest<HTMLElement>('.chapter--recursos');
	        const buttons = chapter
	          ? Array.from(chapter.querySelectorAll<HTMLButtonElement>('.recursos-sidebar-fold-all-btn'))
	          : Array.from(document.querySelectorAll<HTMLButtonElement>('.recursos-sidebar-fold-all-btn'));
	        for (const button of buttons) {
	          const label = canOpen ? 'Desplegar árbol de recursos' : 'Plegar árbol de recursos';
	          button.title = label;
	          button.setAttribute('aria-label', label);
	          button.dataset.recursosFoldState = canOpen ? 'closed' : 'open';
	        }
	      }

	      function applyRecursosFoldState(tree: HTMLElement) {
	        const state = readRecursosFoldState(tree);
	        const hasStoredState = Object.keys(state).length > 0;
	        for (const details of getRecursosFoldDetails(tree)) {
	          const key = getRecursosFoldNodeKey(details);
	          details.open = hasStoredState ? state[key] === true : false;
	        }
	        updateRecursosFoldButtons(tree);
	      }

	      function recursosSidebarEsc(value: unknown) {
	        return String(value ?? '').replace(/[&<>"']/g, (ch) => ({
	          '&': '&amp;',
	          '<': '&lt;',
	          '>': '&gt;',
	          '"': '&quot;',
	          "'": '&#39;',
	        }[ch] || ch));
	      }

	      function recursosSidebarIcon(type: string, url = '', name = '') {
	        const lower = `${type} ${url} ${name}`.toLowerCase();
	        if (lower.includes('pdf') || /\.pdf(\?|$)/.test(lower)) return { char: '■', color: '#c85f5f' };
	        if (lower.includes('audio') || /\.(mp3|wav|ogg|m4a|aac|flac)(\?|$)/.test(lower)) return { char: '■', color: '#45d384' };
	        if (lower.includes('video') || /\.(mp4|mov|webm)(\?|$)/.test(lower)) return { char: '■', color: '#7e9cc8' };
	        if (lower.includes('image') || /\.(png|jpe?g|gif|webp|svg)(\?|$)/.test(lower)) return { char: '■', color: '#c8a87e' };
	        if (lower.includes('pptx') || /\.pptx(\?|$)/.test(lower)) return { char: '■', color: '#c87e45' };
	        return { char: '■', color: '#8a8f98' };
	      }

	      function renderRecursosSidebarTreePayload(tree: HTMLElement, payload: any) {
	        const nodes = Array.isArray(payload?.nodes) ? payload.nodes : [];
	        const assetsByNode = new Map<string, any>(
	          (Array.isArray(payload?.assets) ? payload.assets : []).map((asset: any) => [String(asset.nodeId || ''), asset])
	        );
	        const children = new Map<string, any[]>();
	        for (const node of nodes) {
	          const parentId = String(node?.parentId || '');
	          if (!children.has(parentId)) children.set(parentId, []);
	          children.get(parentId)!.push(node);
	        }
	        const byName = (a: any, b: any) => String(a?.name || a?.sortKey || '')
	          .localeCompare(String(b?.name || b?.sortKey || ''), 'es', { sensitivity: 'base', numeric: true });
	        for (const list of children.values()) list.sort(byName);

	        const isSession = (node: any) => String(node?.kind || '') === 'session';
	        const isFolder = (node: any) => String(node?.kind || '') === 'folder';
	        const renderResource = (node: any) => {
	          const asset = assetsByNode.get(String(node?.id || ''));
	          const url = String(asset?.externalUrl || '');
	          if (!url) return '';
	          const name = String(node?.name || 'Recurso');
	          const ic = recursosSidebarIcon(String(asset?.resourceType || node?.kind || ''), url, name);
	          return `
	            <li class="recursos-sidebar-resource-item" data-id="${recursosSidebarEsc(node.id)}" draggable="true">
	              <a href="${recursosSidebarEsc(url)}" class="recursos-sidebar-resource-link" target="_blank" rel="noreferrer" title="${recursosSidebarEsc(url)}" draggable="false">
	                <span class="recursos-sidebar-resource-icon" style="color:${recursosSidebarEsc(ic.color)}">${recursosSidebarEsc(ic.char)}</span>
	                <span class="recursos-sidebar-resource-name">${recursosSidebarEsc(name)}</span>
	              </a>
	            </li>
	          `;
	        };
	        const renderFolder = (node: any) => {
	          const nested = renderChildren(String(node?.id || ''));
	          if (!nested.trim()) return '';
	          return `
	            <li class="recursos-sidebar-resource-item">
	              <details class="recursos-sidebar-folder" data-node-id="${recursosSidebarEsc(node?.id || '')}" data-node-kind="folder">
	                <summary class="recursos-sidebar-folder-name">
	                  <span class="recursos-sidebar-folder-caret">▸</span>
	                  <span style="color:#4e6070">⊟</span>
	                  ${recursosSidebarEsc(node?.name || 'Carpeta')}
	                </summary>
	                <ul class="recursos-sidebar-folder-items">${nested}</ul>
	              </details>
	            </li>
	          `;
	        };
	        const renderChild = (node: any) => isFolder(node) ? renderFolder(node) : renderResource(node);
	        const renderChildren = (parentId: string): string => (children.get(parentId) || [])
	          .map(renderChild)
	          .join('');

	        const rootChildren = children.get('') || [];
	        const topSessions = rootChildren.filter(isSession);
	        const unsessioned = rootChildren.filter((node) => !isSession(node)).map(renderChild).join('');
	        const groups = topSessions.map((node) => {
	          const nested = renderChildren(String(node?.id || ''));
	          if (!nested.trim()) return '';
	          return `
	            <details class="recursos-sidebar-session" data-node-id="${recursosSidebarEsc(node?.id || '')}" data-node-kind="session">
	              <summary class="recursos-sidebar-session-name">
	                <span class="recursos-sidebar-session-caret">▸</span>
	                ${recursosSidebarEsc(node?.name || 'Sesión')}
	              </summary>
	              <ul class="recursos-sidebar-resource-list">${nested}</ul>
	            </details>
	          `;
	        }).filter(Boolean);
	        if (unsessioned.trim()) {
	          groups.unshift(`<ul class="recursos-sidebar-resource-list recursos-sidebar-resource-list--root">${unsessioned}</ul>`);
	        }
	        tree.innerHTML = groups.length
	          ? groups.join('')
	          : '<div class="course-sidebar-state-note">Sin recursos vinculados.</div>';
	      }

	      async function refreshRecursosSidebarTree(tree: HTMLElement) {
	        const courseId = String(tree.dataset.clase || tree.dataset.courseId || tree.dataset.room || '').split('/')[0].replace(/-stage$/, '');
	        if (!courseId) return;
	        tree.setAttribute('aria-busy', 'true');
	        try {
	          const response = await fetch(`/api/class-workspace/resources?courseId=${encodeURIComponent(courseId)}`);
	          const payload = await response.json().catch(() => ({}));
	          if (!response.ok) throw new Error(payload?.error || `HTTP ${response.status}`);
	          renderRecursosSidebarTreePayload(tree, payload);
	          tree.dataset.recursosFoldBound = '';
	          bootRecursosSidebarFolding();
	          window.dispatchEvent(new CustomEvent('musiki:recursos-sidebar-mounted'));
	        } catch (error) {
	          tree.innerHTML = `<div class="course-sidebar-state-note">${recursosSidebarEsc((error as Error)?.message || error || 'Error al refrescar recursos.')}</div>`;
	        } finally {
	          tree.removeAttribute('aria-busy');
	        }
	      }

	      function refreshRecursosSidebars(courseId = '') {
	        document.querySelectorAll<HTMLElement>('[data-recursos-sidebar]').forEach((tree) => {
	          const treeCourse = String(tree.dataset.clase || tree.dataset.courseId || tree.dataset.room || '').split('/')[0].replace(/-stage$/, '');
	          if (courseId && treeCourse && treeCourse !== courseId) return;
	          void refreshRecursosSidebarTree(tree);
	        });
	      }

	      function findRecursosTreeForButton(button: HTMLElement) {
	        const chapter = button.closest<HTMLElement>('.chapter--recursos');
	        return chapter?.querySelector<HTMLElement>('[data-recursos-sidebar]')
	          || document.querySelector<HTMLElement>('#recursos-sidebar-tree-container [data-recursos-sidebar]')
	          || document.querySelector<HTMLElement>('[data-recursos-sidebar]');
	      }

	      function toggleRecursosTreeForButton(button: HTMLElement) {
	        const tree = findRecursosTreeForButton(button);
	        if (!tree) return;
	        const details = getRecursosFoldDetails(tree);
	        const shouldOpen = details.some(d => !d.open);
	        for (const detail of details) detail.open = shouldOpen;
	        writeRecursosFoldState(tree);
	        updateRecursosFoldButtons(tree);
	      }

	      function bootRecursosSidebarFolding() {
	        document.querySelectorAll<HTMLElement>('[data-recursos-sidebar]').forEach(tree => {
	          if (!tree.dataset.recursosFoldBound) {
	            tree.dataset.recursosFoldBound = 'true';
	            tree.addEventListener('toggle', event => {
	              const target = event.target;
	              if (!(target instanceof HTMLDetailsElement)) return;
	              if (!target.matches('.recursos-sidebar-session, .recursos-sidebar-folder')) return;
	              window.setTimeout(() => {
	                writeRecursosFoldState(tree);
	                updateRecursosFoldButtons(tree);
	              }, 0);
	            }, { capture: true });
	          }
	          applyRecursosFoldState(tree);
	        });
	      }

	      if (typeof recursosFoldWin.__musikiRecursosFoldClickHandler === 'function') {
	        document.removeEventListener('click', recursosFoldWin.__musikiRecursosFoldClickHandler, true);
	      }
	      recursosFoldWin.__musikiRecursosFoldClickHandler = (event: MouseEvent) => {
	        const target = event.target instanceof Element ? event.target : null;
	        const button = target?.closest<HTMLElement>('.recursos-sidebar-fold-all-btn');
	        if (!button) return;
	        event.preventDefault();
	        event.stopPropagation();
	        toggleRecursosTreeForButton(button);
	      };
	      document.addEventListener('click', recursosFoldWin.__musikiRecursosFoldClickHandler, true);

	      bootRecursosSidebarFolding();
	      window.setTimeout(() => refreshRecursosSidebars(''), 0);
	      document.addEventListener('astro:page-load', bootRecursosSidebarFolding);
	      window.addEventListener('notes-sidebar-refresh', () => window.setTimeout(bootRecursosSidebarFolding, 0));
	      window.addEventListener('musiki:recursos-sidebar-mounted', () => window.setTimeout(bootRecursosSidebarFolding, 0));
	      window.addEventListener('musiki:recursos-sidebar-refresh', (event) => {
	        refreshRecursosSidebars(String((event as CustomEvent)?.detail?.courseId || ''));
	      });
	      window.addEventListener('storage', (event) => {
	        if (event.key !== 'musiki:recursos-sidebar-refresh') return;
	        try {
	          const detail = event.newValue ? JSON.parse(event.newValue) : {};
	          refreshRecursosSidebars(String(detail.courseId || ''));
	        } catch {
	          refreshRecursosSidebars('');
	        }
	      });
	    </script>
	    {canManageLiveInteractions && (
	      <script>
	        // ── Recursos sidebar context menus ──────────────────────────────────
        let _activeRecursosMenu: HTMLElement | null = null;

        function closeRecursosMenu() {
          _activeRecursosMenu?.remove();
          _activeRecursosMenu = null;
        }

        function recursosSidebarNormalizeLabel(value: string) {
          return String(value || '').replace(/[▸⊟]/g, ' ').replace(/\s+/g, ' ').trim();
        }

        function recursosSidebarCourseIdFor(tree: HTMLElement) {
          return (tree.dataset.clase || tree.dataset.courseId || tree.dataset.room || '').split('/')[0].replace(/-stage$/, '');
        }

        function recursosSidebarBroadcastRefresh(courseId: string) {
          const detail = { courseId, at: Date.now() };
          window.dispatchEvent(new CustomEvent('musiki:recursos-sidebar-refresh', { detail }));
          try {
            localStorage.setItem('musiki:recursos-sidebar-refresh', JSON.stringify(detail));
          } catch {}
        }

        async function recursosWorkspaceCommand(courseId: string, commandPayload: any) {
          const response = await fetch('/api/class-workspace/command', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              courseId,
              roomName: `${courseId}-stage`,
              command: commandPayload,
            }),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(payload?.error || `HTTP ${response.status}`);
          return payload;
        }

        function recursosSidebarMenuTarget(rawTarget: Element | null) {
          if (!rawTarget) return null;
          const resourceItem = rawTarget.closest<HTMLElement>('.recursos-sidebar-resource-item[data-id]');
          if (resourceItem && rawTarget.closest('.recursos-sidebar-resource-link')) {
            const name = resourceItem.querySelector<HTMLElement>('.recursos-sidebar-resource-name')?.textContent?.trim() || 'Recurso';
            return {
              element: resourceItem,
              id: resourceItem.dataset.id || '',
              kind: 'resource',
              label: name,
            };
          }
          const folder = rawTarget.closest<HTMLElement>('details.recursos-sidebar-folder[data-node-id]');
          if (folder && rawTarget.closest('summary.recursos-sidebar-folder-name')) {
            return {
              element: folder,
              id: folder.dataset.nodeId || '',
              kind: 'folder',
              label: recursosSidebarNormalizeLabel(folder.querySelector('summary')?.textContent || 'Carpeta'),
            };
          }
          const session = rawTarget.closest<HTMLElement>('details.recursos-sidebar-session[data-node-id]');
          if (session && rawTarget.closest('summary.recursos-sidebar-session-name')) {
            return {
              element: session,
              id: session.dataset.nodeId || '',
              kind: 'session',
              label: recursosSidebarNormalizeLabel(session.querySelector('summary')?.textContent || 'Sesión'),
            };
          }
          return null;
        }

        function showRecursosMenu(
          x: number,
          y: number,
          targetInfo: { element: HTMLElement; id: string; kind: string; label: string },
          courseId: string,
        ) {
          closeRecursosMenu();
          const menu = document.createElement('div');
          menu.style.cssText = [
            `position:fixed;left:${x}px;top:${y}px;`,
            'background:var(--c-bg-surface,var(--c-bg-mute));',
            'border:1px solid var(--c-border);border-radius:4px;',
            'padding:3px 0;z-index:9999;min-width:168px;',
            'box-shadow:0 4px 12px rgba(0,0,0,.4);',
          ].join('');

          const currentName = targetInfo.label || 'Recurso';
          const canMove = targetInfo.kind === 'resource';

          const items: Array<{ label: string; danger?: boolean; action: () => Promise<void> } | { sep: true }> = [
            {
              label: 'Renombrar',
              action: async () => {
                const newName = prompt('Nuevo nombre:', currentName);
                if (!newName || newName === currentName) return;
                await recursosWorkspaceCommand(courseId, {
                  type: 'node.rename',
                  nodeId: targetInfo.id,
                  name: newName,
                });
                recursosSidebarBroadcastRefresh(courseId);
              },
            },
            ...(canMove ? [{
              label: 'Mover a carpeta',
              action: async () => {
                const folder = prompt('Carpeta (vacío = raíz):');
                if (folder === null) return;
                const r = await fetch('/api/live/recursos/editor', {
                  method: 'PATCH',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ id: targetInfo.id, folder: folder.trim(), courseId }),
                });
                if (r.ok) {
                  recursosSidebarBroadcastRefresh(courseId);
                } else {
                  alert('Error al mover');
                }
              },
            }] : []),
            { sep: true },
            {
              label: 'Eliminar',
              danger: true,
              action: async () => {
                if (!confirm(`¿Eliminar "${currentName}"?`)) return;
                await recursosWorkspaceCommand(courseId, {
                  type: 'node.delete',
                  nodeIds: [targetInfo.id],
                });
                recursosSidebarBroadcastRefresh(courseId);
              },
            },
          ];

          for (const item of items) {
            if ('sep' in item) {
              const sep = document.createElement('hr');
              sep.style.cssText = 'border:none;border-top:1px solid var(--c-border);margin:3px 0;';
              menu.appendChild(sep);
              continue;
            }
            const el = document.createElement('div');
            el.textContent = item.label;
            el.style.cssText = `padding:4px 12px;font-size:11px;cursor:pointer;color:${item.danger ? '#c87e7e' : 'var(--c-fg)'};`;
            el.addEventListener('mouseenter', () => { el.style.background = 'var(--c-bg-alt,var(--c-bg-mute))'; });
            el.addEventListener('mouseleave', () => { el.style.background = ''; });
            el.addEventListener('click', () => {
              closeRecursosMenu();
              item.action().catch((error) => alert((error as Error)?.message || 'No se pudo completar la acción.'));
            });
            menu.appendChild(el);
          }

          _activeRecursosMenu = menu;
          document.body.appendChild(menu);
          requestAnimationFrame(() => {
            const rect = menu.getBoundingClientRect();
            if (rect.bottom > window.innerHeight) menu.style.top = `${y - rect.height}px`;
            if (rect.right > window.innerWidth) menu.style.left = `${x - rect.width}px`;
          });
        }

        document.addEventListener('click', closeRecursosMenu);
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeRecursosMenu(); });

        function clearRecursosSidebarDropState(tree: HTMLElement) {
          tree.classList.remove('recursos-sidebar-drop-root');
          tree.querySelectorAll<HTMLElement>('[data-drop-target="true"]').forEach(el => {
            el.dataset.dropTarget = 'false';
          });
        }

        function recursosSidebarDropTarget(rawTarget: Element | null, tree: HTMLElement) {
          const folder = rawTarget?.closest<HTMLElement>('details.recursos-sidebar-folder[data-node-id]');
          if (folder?.dataset.nodeId) return { element: folder, parentId: folder.dataset.nodeId };
          const session = rawTarget?.closest<HTMLElement>('details.recursos-sidebar-session[data-node-id]');
          if (session?.dataset.nodeId) return { element: session, parentId: session.dataset.nodeId };
          return { element: tree, parentId: '' };
        }

        async function moveRecursosSidebarResource(tree: HTMLElement, resourceId: string, parentId: string) {
          const courseId = recursosSidebarCourseIdFor(tree);
          if (!courseId || !resourceId) return;
          await recursosWorkspaceCommand(courseId, {
            type: 'node.move',
            nodeIds: [resourceId],
            targetParentId: parentId || null,
          });
          recursosSidebarBroadcastRefresh(courseId);
        }

        function bootRecursosSidebar() {
          document.querySelectorAll<HTMLElement>('[data-recursos-sidebar]').forEach(tree => {
            const courseId = recursosSidebarCourseIdFor(tree);
            if (!courseId) return;
            if (tree.dataset.recursosContextBound) return;
            tree.dataset.recursosContextBound = 'true';
            tree.querySelectorAll<HTMLElement>('.recursos-sidebar-resource-item[data-id]').forEach(item => {
              item.draggable = true;
              item.querySelectorAll<HTMLAnchorElement>('a').forEach(anchor => {
                anchor.draggable = false;
              });
            });
            tree.addEventListener('contextmenu', e => {
              const target = recursosSidebarMenuTarget(e.target instanceof Element ? e.target : null);
              if (!target?.id) return;
              e.preventDefault();
              e.stopPropagation();
              showRecursosMenu(e.clientX, e.clientY, target, courseId);
            });
            tree.addEventListener('dragstart', e => {
              const target = e.target instanceof Element ? e.target.closest<HTMLElement>('.recursos-sidebar-resource-item[data-id]') : null;
              if (!target?.dataset.id) return;
              target.dataset.dragging = 'true';
              e.dataTransfer?.setData('application/x-musiki-recurso-id', target.dataset.id);
              e.dataTransfer?.setData('text/plain', target.dataset.id);
              if (e.dataTransfer) {
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.dropEffect = 'move';
              }
            });
            tree.addEventListener('dragend', e => {
              const target = e.target instanceof Element ? e.target.closest<HTMLElement>('.recursos-sidebar-resource-item[data-id]') : null;
              if (target) target.dataset.dragging = 'false';
              clearRecursosSidebarDropState(tree);
            });
            tree.addEventListener('dragover', e => {
              const resourceId = e.dataTransfer?.getData('application/x-musiki-recurso-id') || '';
              if (!resourceId && !Array.from(e.dataTransfer?.types || []).includes('application/x-musiki-recurso-id')) return;
              e.preventDefault();
              if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
              clearRecursosSidebarDropState(tree);
              const target = recursosSidebarDropTarget(e.target instanceof Element ? e.target : null, tree);
              if (target.element === tree) tree.classList.add('recursos-sidebar-drop-root');
              else target.element.dataset.dropTarget = 'true';
            });
            tree.addEventListener('dragleave', e => {
              const related = e.relatedTarget instanceof Node ? e.relatedTarget : null;
              if (related && tree.contains(related)) return;
              clearRecursosSidebarDropState(tree);
            });
            tree.addEventListener('drop', e => {
              const resourceId = e.dataTransfer?.getData('application/x-musiki-recurso-id') || '';
              if (!resourceId) return;
              e.preventDefault();
              const target = recursosSidebarDropTarget(e.target instanceof Element ? e.target : null, tree);
              clearRecursosSidebarDropState(tree);
              moveRecursosSidebarResource(tree, resourceId, target.parentId).catch((error) => {
                alert((error as Error)?.message || 'No se pudo mover el recurso.');
              });
            });
          });
        }

        bootRecursosSidebar();
        document.addEventListener('astro:page-load', bootRecursosSidebar);
        window.addEventListener('musiki:recursos-sidebar-mounted', () => window.setTimeout(bootRecursosSidebar, 0));
      </script>
    )}
    {canManageLiveInteractions && (
      <script>
        function bootInlineEditor() {
          const mountEl = document.getElementById('notes-editor-mount') as HTMLElement | null;
          const contentEl = document.querySelector<HTMLElement>('[data-class-content]');
          if (!mountEl || !contentEl) return;

          document.querySelectorAll<HTMLElement>('[data-notes-action]').forEach(btn => {
            if (btn.dataset.notesBound) return;
            btn.dataset.notesBound = 'true';
            btn.addEventListener('click', async () => {
              const mode = (btn.dataset.notesAction || 'edit') as 'edit' | 'create';
              const courseId = btn.dataset.courseId || '';
              const slug = btn.dataset.slug || null;
              const { mountInlineNotesEditor } = await import('../scripts/course/notes/inline-editor.ts');
              mountInlineNotesEditor({ mountEl: mountEl!, contentEl: contentEl!, courseId, slug, mode });
            });
          });
        }

        bootInlineEditor();
        document.addEventListener('astro:page-load', bootInlineEditor);
      </script>
    )}
    <div id="forum-media-modal" class="forum-media-modal" hidden aria-hidden="true">
      <div class="forum-media-modal-stage" role="dialog" aria-modal="true" aria-label="Media ampliado">
        <button
          id="forum-media-modal-close"
          class="forum-media-modal-close"
          type="button"
          aria-label="Cerrar media ampliado"
          title="Cerrar"
        >×</button>
        <div id="forum-media-modal-content" class="forum-media-modal-content"></div>
      </div>
      </div>

      <script>

      declare global {
        interface Window {
          __musikiCourseLayoutKeyHandler?: (event: KeyboardEvent) => void;
          __musikiCourseLayoutResizeHandler?: () => void;
          __musikiCourseLayoutTouchStartHandler?: (event: TouchEvent) => void;
          __musikiCourseLayoutTouchMoveHandler?: (event: TouchEvent) => void;
          __musikiCourseLayoutTouchEndHandler?: (event: TouchEvent) => void;
          __musikiCourseLayoutTouchCancelHandler?: () => void;
        }
      }

      const mountCourseLayout = () => {
        const root = document.querySelector('[data-course-layout-root]');
        if (!(root instanceof HTMLElement)) return;

        const overlay = root.querySelector('[data-course-sidebar-overlay]');
        const leftSidebar = root.querySelector('[data-course-sidebar="left"]');
        const rightSidebar = root.querySelector('[data-course-sidebar="right"]');
	        const leftButtons = Array.from(root.querySelectorAll('[data-sidebar-toggle="left"], [data-sidebar-handle="left"]'));
	        const rightButtons = Array.from(root.querySelectorAll('[data-sidebar-toggle="right"], [data-sidebar-handle="right"]'));
	        const leftEdgeButtons = Array.from(root.querySelectorAll('[data-sidebar-edge-toggle="left"]'));
	        const leftResizeHandle = root.querySelector('[data-left-sidebar-resize]');
	        const rightMaximizeButtons = Array.from(root.querySelectorAll('[data-sidebar-maximize="right"]'));
	        const hasRightSidebar = root.dataset.hasRightSidebar === 'true';

        const isMobileViewport = () => window.matchMedia('(max-width: 1024px)').matches;
        const isBottomBarViewport = () => window.matchMedia('(max-width: 500px)').matches;

        const coerceBoolean = (value: string | null, fallback: boolean): boolean => {
          if (value === 'true') return true;
          if (value === 'false') return false;
          return fallback;
        };

        let leftOpen = coerceBoolean(
          window.localStorage.getItem('musiki:course:left-open'),
          root.dataset.leftOpen !== 'false',
        );
        let rightOpen = hasRightSidebar && coerceBoolean(
          window.localStorage.getItem('musiki:course:right-open'),
          root.dataset.rightOpen !== 'false',
        );
	        let rightMaximized = hasRightSidebar && coerceBoolean(
	          window.localStorage.getItem('musiki:course:right-maximized'),
	          root.dataset.rightMaximized === 'true',
	        );
	        let leftSidebarWidth = Number.parseInt(window.localStorage.getItem('musiki:course:left-width') || '', 10);

	        const getLeftSidebarWidthBounds = () => {
	          const viewport = window.innerWidth || 0;
	          const min = Math.min(320, Math.max(220, viewport - 180));
	          const max = Math.max(min, Math.min(620, Math.round(viewport * 0.42)));
	          return { min, max };
	        };

	        const applyLeftSidebarWidth = (width: number, persist = false) => {
	          if (!Number.isFinite(width)) {
	            root.style.removeProperty('--left-sidebar-width');
	            return;
	          }
	          const { min, max } = getLeftSidebarWidthBounds();
	          leftSidebarWidth = Math.min(max, Math.max(min, Math.round(width)));
	          root.style.setProperty('--left-sidebar-width', `${leftSidebarWidth}px`);
	          if (persist) {
	            window.localStorage.setItem('musiki:course:left-width', String(leftSidebarWidth));
	          }
	        };

	        if (Number.isFinite(leftSidebarWidth)) {
	          applyLeftSidebarWidth(leftSidebarWidth, false);
	        }

        const syncShellOffsets = () => {
          const rootRect = root.getBoundingClientRect();
          const viewportBottomGap = Math.max(0, Math.round(window.innerHeight - rootRect.bottom));
          root.style.removeProperty('--course-shell-top');
          root.style.setProperty('--course-shell-bottom-gap', `${viewportBottomGap}px`);
        };

        const syncLayoutState = () => {
          syncShellOffsets();

          if (!hasRightSidebar) {
            rightOpen = false;
            rightMaximized = false;
          }

          if (isMobileViewport()) {
            rightMaximized = false;
          }

          root.dataset.leftOpen = leftOpen ? 'true' : 'false';
          root.dataset.rightOpen = rightOpen ? 'true' : 'false';
          root.dataset.rightMaximized = rightOpen && rightMaximized ? 'true' : 'false';

          const overlayActive = isMobileViewport() && (leftOpen || rightOpen);
          root.classList.toggle('is-overlay-active', overlayActive);
          if (overlay instanceof HTMLElement) {
            overlay.toggleAttribute('hidden', !overlayActive);
          }

          document.documentElement.classList.toggle('course-sidebars-open', overlayActive);
          document.body.classList.toggle('course-sidebars-open', overlayActive);

          const leftHandle = root.querySelector('[data-sidebar-handle="left"]');
          if (leftHandle instanceof HTMLButtonElement) {
            const nextLabel = leftOpen ? 'Ocultar navegación del curso' : 'Mostrar navegación del curso';
            leftHandle.setAttribute('aria-label', nextLabel);
            leftHandle.title = `${nextLabel} (⌘/Ctrl + \\)`;
          }

          leftEdgeButtons.forEach((button) => {
            if (!(button instanceof HTMLButtonElement)) return;
            const nextLabel = leftOpen ? 'Ocultar navegación del curso' : 'Mostrar navegación del curso';
            button.setAttribute('aria-label', nextLabel);
            button.title = nextLabel;
          });

          const rightHandle = root.querySelector('[data-sidebar-handle="right"]');
          if (rightHandle instanceof HTMLButtonElement) {
            const nextLabel = rightOpen ? 'Ocultar foros' : 'Mostrar foros';
            rightHandle.setAttribute('aria-label', nextLabel);
            rightHandle.title = nextLabel;
          }

          rightMaximizeButtons.forEach((button) => {
            if (!(button instanceof HTMLButtonElement)) return;
            const active = rightOpen && rightMaximized;
            button.dataset.active = active ? 'true' : 'false';
            button.setAttribute('aria-label', active ? 'Minimizar foros' : 'Maximizar foros');
            button.title = active ? 'Minimizar foros' : 'Maximizar foros';
            button.textContent = active ? '⤡' : '⤢';
          });
        };

        const persistLayoutState = () => {
          window.localStorage.setItem('musiki:course:left-open', leftOpen ? 'true' : 'false');
          window.localStorage.setItem('musiki:course:right-open', rightOpen ? 'true' : 'false');
          window.localStorage.setItem('musiki:course:right-maximized', rightMaximized ? 'true' : 'false');
        };

        const applySidebarState = (side: 'left' | 'right', open: boolean) => {
          if (side === 'left') {
            leftOpen = open;
          } else if (hasRightSidebar) {
            rightOpen = open;
            if (!open) {
              rightMaximized = false;
            }
          }

          persistLayoutState();
          syncLayoutState();
        };

        const toggleSidebar = (side: 'left' | 'right') => {
          if (side === 'left') {
            leftOpen = !leftOpen;
          } else if (side === 'right' && hasRightSidebar) {
            rightOpen = !rightOpen;
            if (!rightOpen) {
              rightMaximized = false;
            }
          }

          persistLayoutState();
          syncLayoutState();
        };

        const toggleRightMaximized = () => {
          if (!hasRightSidebar || isMobileViewport()) return;
          rightOpen = true;
          rightMaximized = !rightMaximized;
          persistLayoutState();
          syncLayoutState();
        };

        leftButtons.forEach((button) => {
          if (!(button instanceof HTMLElement) || button.dataset.boundCourseSidebar === 'true') return;
          button.dataset.boundCourseSidebar = 'true';
          button.addEventListener('click', () => toggleSidebar('left'));
        });

        leftEdgeButtons.forEach((button) => {
          if (!(button instanceof HTMLElement) || button.dataset.boundCourseSidebar === 'true') return;
          button.dataset.boundCourseSidebar = 'true';
          button.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            if (!isBottomBarViewport()) return;
            if (rightOpen) {
              rightOpen = false;
              rightMaximized = false;
            }
            applySidebarState('left', !leftOpen);
          });
        });

        rightButtons.forEach((button) => {
          if (!(button instanceof HTMLElement) || button.dataset.boundCourseSidebar === 'true') return;
          button.dataset.boundCourseSidebar = 'true';
          // The edge/forum button switches to (or toggles) the forum pod.
          button.addEventListener('click', () => toggleRightPod('forum'));
        });

        rightMaximizeButtons.forEach((button) => {
          if (!(button instanceof HTMLElement) || button.dataset.boundCourseSidebar === 'true') return;
          button.dataset.boundCourseSidebar = 'true';
          button.addEventListener('click', () => toggleRightMaximized());
        });

        if (leftSidebar instanceof HTMLElement && leftSidebar.dataset.boundCourseSidebarNav !== 'true') {
          leftSidebar.dataset.boundCourseSidebarNav = 'true';
          leftSidebar.addEventListener('click', (event) => {
            if (!isMobileViewport()) return;
            const target = event.target;
            if (!(target instanceof Element)) return;
            const navigationLink = target.closest('.lesson-link, .class-toc-link, .course-title-link, .recursos-sidebar-resource-link, .notas-sb-item');
            if (!(navigationLink instanceof HTMLElement)) return;
            applySidebarState('left', false);
          });
        }

        if (overlay instanceof HTMLElement && overlay.dataset.boundCourseSidebar !== 'true') {
          overlay.dataset.boundCourseSidebar = 'true';
          overlay.addEventListener('click', () => {
            leftOpen = false;
            rightOpen = false;
            rightMaximized = false;
            persistLayoutState();
            syncLayoutState();
          });
        }

        if (typeof window.__musikiCourseLayoutKeyHandler === 'function') {
          document.removeEventListener('keydown', window.__musikiCourseLayoutKeyHandler);
        }

        // ── Right sidebar pods (Obsidian-like stack: "forum" + "info") ───────
        // Single source of truth for which pod is visible: data-page-info-open
        // ('true' = info pod overlay, 'false' = forum pod base). `rightOpen`
        // controls whether the column shows at all.
        const podOf = () => (root.dataset.pageInfoOpen === 'true' ? 'info' : 'forum');
        const syncRightPodTabs = () => {
          const pod = podOf();
          document.querySelectorAll('[data-right-pod]').forEach((tab) => {
            if (!(tab instanceof HTMLElement)) return;
            tab.classList.toggle('is-active', rightOpen && tab.dataset.rightPod === pod);
            tab.setAttribute('aria-pressed', rightOpen && tab.dataset.rightPod === pod ? 'true' : 'false');
          });
          const panel = document.getElementById('page-info-sidebar');
          if (panel) panel.setAttribute('aria-hidden', pod === 'info' && rightOpen ? 'false' : 'true');
        };
        // Switch to a pod (open the column, no close).
        const setRightPod = (pod) => {
          rightOpen = true;
          root.dataset.pageInfoOpen = pod === 'info' ? 'true' : 'false';
          persistLayoutState();
          syncLayoutState();
          syncRightPodTabs();
        };
        // Pod-aware toggle for the edge buttons: open+show, switch, or close.
        const toggleRightPod = (pod) => {
          const targetPod = (pod === 'forum' && !hasRightSidebar) ? 'info' : pod;
          if (rightOpen && podOf() === targetPod) {
            rightOpen = false;
            rightMaximized = false;
          } else {
            rightOpen = true;
            root.dataset.pageInfoOpen = targetPod === 'info' ? 'true' : 'false';
          }
          persistLayoutState();
          syncLayoutState();
          syncRightPodTabs();
        };
        const closePageInfo = () => { toggleRightPod('forum'); };

        document.querySelectorAll('[data-page-info-close]').forEach((btn) => {
          if (btn instanceof HTMLElement && !btn.dataset.boundPageInfo) {
            btn.dataset.boundPageInfo = 'true';
            btn.addEventListener('click', () => {
              // From the info pod, the × returns to the forum pod if present,
              // otherwise closes the column.
              if (hasRightSidebar) setRightPod('forum');
              else { rightOpen = false; persistLayoutState(); syncLayoutState(); syncRightPodTabs(); }
            });
          }
        });

        // Pod tab bar (Foro / Info).
        document.querySelectorAll('[data-right-pod]').forEach((tab) => {
          if (tab instanceof HTMLElement && !tab.dataset.boundRightPod) {
            tab.dataset.boundRightPod = 'true';
            tab.addEventListener('click', () => setRightPod(tab.dataset.rightPod || 'forum'));
          }
        });

        window.addEventListener('musiki:open-page-info', () => toggleRightPod('info'));
        syncRightPodTabs();

        const keyHandler = (event: KeyboardEvent) => {
          if (event.defaultPrevented) return;
          if (!(event.metaKey || event.ctrlKey) || event.altKey) return;

          const key = String(event.key || '').toLowerCase();
          const code = String(event.code || '').toLowerCase();
          const isBackslash = code === 'backslash';
          const isKeyI = key === 'i';

          if (!isBackslash && !isKeyI) return;

          const target = event.target;
          const isEditable =
            target instanceof HTMLElement &&
            (target.isContentEditable ||
              /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName) ||
              target.closest('.cm-editor'));
          if (isEditable) return;

          event.preventDefault();

          if (isBackslash) {
            if (event.shiftKey) {
              // c+shift+\ toggles right forum sidebar (no info!)
              const isForumOpen = rightOpen && root.dataset.pageInfoOpen !== 'true';
              if (isForumOpen) {
                rightOpen = false;
                rightMaximized = false;
              } else {
                rightOpen = true;
                root.dataset.pageInfoOpen = 'false';
                const panel = document.getElementById('page-info-sidebar');
                if (panel) panel.setAttribute('aria-hidden', 'true');
              }
              persistLayoutState();
              syncLayoutState();
            } else {
              // c\ toggles left sidebar
              toggleSidebar('left');
            }
          } else if (isKeyI) {
            // ⌘/Ctrl+I toggles the right INFO pod
            toggleRightPod('info');
          }
        };

        document.addEventListener('keydown', keyHandler);
        window.__musikiCourseLayoutKeyHandler = keyHandler;

        if (typeof window.__musikiCourseLayoutResizeHandler === 'function') {
          window.removeEventListener('resize', window.__musikiCourseLayoutResizeHandler);
        }

	        const resizeHandler = () => {
	          if (Number.isFinite(leftSidebarWidth)) {
	            applyLeftSidebarWidth(leftSidebarWidth, true);
	          }
	          syncLayoutState();
	        };

	        window.addEventListener('resize', resizeHandler);
	        window.__musikiCourseLayoutResizeHandler = resizeHandler;

	        if (leftResizeHandle instanceof HTMLElement && leftResizeHandle.dataset.boundLeftSidebarResize !== 'true') {
	          leftResizeHandle.dataset.boundLeftSidebarResize = 'true';
	          let resizeStartX = 0;
	          let resizeStartWidth = 0;

	          const stopResize = (event?: PointerEvent) => {
	            root.classList.remove('is-left-resizing');
	            if (event && leftResizeHandle.hasPointerCapture(event.pointerId)) {
	              leftResizeHandle.releasePointerCapture(event.pointerId);
	            }
	          };

	          leftResizeHandle.addEventListener('pointerdown', (event) => {
	            if (isMobileViewport() || event.button !== 0 || !(leftSidebar instanceof HTMLElement)) return;
	            event.preventDefault();
	            resizeStartX = event.clientX;
	            resizeStartWidth = leftSidebar.getBoundingClientRect().width;
	            leftResizeHandle.setPointerCapture(event.pointerId);
	            root.classList.add('is-left-resizing');
	          });

	          leftResizeHandle.addEventListener('pointermove', (event) => {
	            if (!root.classList.contains('is-left-resizing')) return;
	            event.preventDefault();
	            applyLeftSidebarWidth(resizeStartWidth + event.clientX - resizeStartX, true);
	          });

	          leftResizeHandle.addEventListener('pointerup', stopResize);
	          leftResizeHandle.addEventListener('pointercancel', stopResize);
	          leftResizeHandle.addEventListener('lostpointercapture', () => {
	            root.classList.remove('is-left-resizing');
	          });
	        }

        if (typeof window.__musikiCourseLayoutTouchStartHandler === 'function') {
          document.removeEventListener('touchstart', window.__musikiCourseLayoutTouchStartHandler);
        }
        if (typeof window.__musikiCourseLayoutTouchMoveHandler === 'function') {
          document.removeEventListener('touchmove', window.__musikiCourseLayoutTouchMoveHandler);
        }
        if (typeof window.__musikiCourseLayoutTouchEndHandler === 'function') {
          document.removeEventListener('touchend', window.__musikiCourseLayoutTouchEndHandler);
        }
        if (typeof window.__musikiCourseLayoutTouchCancelHandler === 'function') {
          document.removeEventListener('touchcancel', window.__musikiCourseLayoutTouchCancelHandler);
        }

        const getEdgeSwipeZonePx = () => isBottomBarViewport() ? 72 : 28;
        const SWIPE_TRIGGER_DISTANCE_PX = 58;
        const SWIPE_MAX_VERTICAL_DRIFT_PX = 48;
        const SWIPE_HORIZONTAL_RATIO = 1.2;
        let activeSwipe:
          | {
              side: 'left' | 'right';
              action: 'open' | 'close';
              startX: number;
              startY: number;
              lastX: number;
              lastY: number;
            }
          | null = null;

        const isEditableTouchTarget = (target: EventTarget | null) =>
          target instanceof HTMLElement &&
          (
            target.isContentEditable ||
            Boolean(target.closest('input, textarea, select, option, [contenteditable="true"]'))
          );

        const resolveSwipeIntent = (target: EventTarget | null, startX: number) => {
          if (!isMobileViewport()) return null;

          const viewportWidth = window.innerWidth;
          const targetNode = target instanceof Node ? target : null;
          const edgeSwipeZonePx = getEdgeSwipeZonePx();

          if (!leftOpen && startX <= edgeSwipeZonePx) {
            return { side: 'left' as const, action: 'open' as const };
          }

          if (isEditableTouchTarget(target)) return null;

          if (leftOpen && leftSidebar instanceof HTMLElement && targetNode && leftSidebar.contains(targetNode)) {
            return { side: 'left' as const, action: 'close' as const };
          }

          if (hasRightSidebar && !rightOpen && startX >= viewportWidth - edgeSwipeZonePx) {
            return { side: 'right' as const, action: 'open' as const };
          }

          if (hasRightSidebar && rightOpen && rightSidebar instanceof HTMLElement && targetNode && rightSidebar.contains(targetNode)) {
            return { side: 'right' as const, action: 'close' as const };
          }

          return null;
        };

        const clearActiveSwipe = () => {
          activeSwipe = null;
        };

        const touchStartHandler = (event: TouchEvent) => {
          if (event.touches.length !== 1) {
            clearActiveSwipe();
            return;
          }

          const touch = event.touches[0];
          const intent = resolveSwipeIntent(event.target, touch.clientX);
          if (!intent) {
            clearActiveSwipe();
            return;
          }

          activeSwipe = {
            ...intent,
            startX: touch.clientX,
            startY: touch.clientY,
            lastX: touch.clientX,
            lastY: touch.clientY,
          };
        };

        const touchMoveHandler = (event: TouchEvent) => {
          if (!activeSwipe || event.touches.length !== 1) return;
          const touch = event.touches[0];
          activeSwipe.lastX = touch.clientX;
          activeSwipe.lastY = touch.clientY;
        };

        const touchEndHandler = (event: TouchEvent) => {
          if (!activeSwipe) return;

          const touch = event.changedTouches[0];
          const endX = touch?.clientX ?? activeSwipe.lastX;
          const endY = touch?.clientY ?? activeSwipe.lastY;
          const deltaX = endX - activeSwipe.startX;
          const deltaY = endY - activeSwipe.startY;
          const absDeltaX = Math.abs(deltaX);
          const absDeltaY = Math.abs(deltaY);

          const isHorizontalSwipe =
            absDeltaX >= SWIPE_TRIGGER_DISTANCE_PX &&
            absDeltaY <= SWIPE_MAX_VERTICAL_DRIFT_PX &&
            absDeltaX >= absDeltaY * SWIPE_HORIZONTAL_RATIO;

          if (!isHorizontalSwipe) {
            clearActiveSwipe();
            return;
          }

          if (activeSwipe.side === 'left') {
            if (activeSwipe.action === 'open' && deltaX > 0) {
              applySidebarState('left', true);
            } else if (activeSwipe.action === 'close' && deltaX < 0) {
              applySidebarState('left', false);
            }
          } else if (activeSwipe.side === 'right') {
            if (activeSwipe.action === 'open' && deltaX < 0) {
              applySidebarState('right', true);
            } else if (activeSwipe.action === 'close' && deltaX > 0) {
              applySidebarState('right', false);
            }
          }

          clearActiveSwipe();
        };

        document.addEventListener('touchstart', touchStartHandler, { passive: true });
        document.addEventListener('touchmove', touchMoveHandler, { passive: true });
        document.addEventListener('touchend', touchEndHandler, { passive: true });
        document.addEventListener('touchcancel', clearActiveSwipe, { passive: true });
        window.__musikiCourseLayoutTouchStartHandler = touchStartHandler;
        window.__musikiCourseLayoutTouchMoveHandler = touchMoveHandler;
        window.__musikiCourseLayoutTouchEndHandler = touchEndHandler;
        window.__musikiCourseLayoutTouchCancelHandler = clearActiveSwipe;

        syncLayoutState();

        const foldAllBtn = document.getElementById('sidebar-fold-all-btn');
        if (foldAllBtn instanceof HTMLButtonElement) {
          const getSidebarDetails = () =>
            Array.from(document.querySelectorAll('.sidebar--left details.chapter-details, #class-toc-details'));

          const syncFoldBtn = () => {
            const allOpen = getSidebarDetails().every((d) => (d as HTMLDetailsElement).open);
            foldAllBtn.dataset.folded = allOpen ? 'false' : 'true';
            foldAllBtn.setAttribute('aria-label', allOpen ? 'Colapsar todas las secciones' : 'Desplegar todas las secciones');
            foldAllBtn.title = allOpen ? 'Colapsar todas las secciones' : 'Desplegar todas las secciones';
          };

          foldAllBtn.onclick = () => {
            const details = getSidebarDetails();
            const anyOpen = details.some((d) => (d as HTMLDetailsElement).open);
            details.forEach((d) => { (d as HTMLDetailsElement).open = !anyOpen; });
            syncFoldBtn();
          };

          getSidebarDetails().forEach((d) => {
            d.addEventListener('toggle', syncFoldBtn);
          });
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', mountCourseLayout, { once: true });
      } else {
        mountCourseLayout();
      }

      document.addEventListener('astro:page-load', mountCourseLayout);
    </script>

    <script>
      import { subscribeToLive } from '../lib/live/client.mjs';
      import { formatCountdown, getRemainingMs } from '../lib/live/countdown.mjs';
      import { enhanceCourseNotesContent } from '../scripts/course/notes/index.ts';
      import { enhanceMarkdownTextarea } from '../scripts/markdown-editor-tools.ts';
      import { setupConceptLinks } from '../scripts/concept-linker';

      const courseLayoutRoot = document.querySelector('[data-course-layout-root]');
      const canManageLiveInteractions =
        courseLayoutRoot instanceof HTMLElement
          ? courseLayoutRoot.dataset.canManageLiveInteractions === 'true'
          : false;
      const isAuthenticatedUser =
        courseLayoutRoot instanceof HTMLElement
          ? courseLayoutRoot.dataset.authenticated === 'true'
          : false;
      const canonicalLiveCourseId =
        courseLayoutRoot instanceof HTMLElement
          ? String(courseLayoutRoot.dataset.liveCourseId || '').trim()
          : '';
      const canonicalLivePageSlug =
        courseLayoutRoot instanceof HTMLElement
          ? String(courseLayoutRoot.dataset.livePageSlug || '').trim()
          : '';

      let userSubmissions = {};
      let hasEvalBlocks = false;
      const progressByEvalId = new Map();
      const pollWidgetsByEvalId = new Map();
      const wordcloudWidgetsByEvalId = new Map();
      const forumState = {
        courseId: '',
        isLessonPage: false,
        mode: 'lesson',
        lessonSlug: '',
        boardSlug: '',
        boards: [],
        threads: [],
        selectedThreadId: '',
        openThreadIds: new Set(),
        canWrite: false,
        canManageBoards: false,
      };
      let evalMathRendererPromise = null;
      let unsubscribeLivePolls = null;
      let livePollTickId = null;

      async function loadUserSubmissions() {
        if (!isAuthenticatedUser) {
          userSubmissions = {};
          return;
        }

        try {
          const response = await fetch('/api/submissions/my-submissions');
          const data = await response.json();
          userSubmissions = data?.submissions || {};
        } catch (error) {
          console.error('Error loading submissions:', error);
          userSubmissions = {};
        }
      }

      function parseEvalData(wrapper) {
        try {
          const b64 = wrapper.dataset.evalB64;
          if (b64) {
            const binary = atob(b64);
            const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
            return JSON.parse(new TextDecoder().decode(bytes));
          }

          // Legacy fallback for old parser payload.
          const legacy = wrapper.dataset.eval;
          if (legacy) return JSON.parse(legacy.replace(/&apos;/g, "'"));
        } catch (error) {
          console.error('Error parsing eval wrapper:', error);
        }

        return null;
      }

      function loadScriptOnce(src, marker) {
        return new Promise((resolve, reject) => {
          const existing = document.querySelector(`script[${marker}]`);
          if (existing) {
            if (existing.dataset.loaded === 'true') {
              resolve();
              return;
            }
            existing.addEventListener('load', () => resolve(), { once: true });
            existing.addEventListener('error', () => reject(new Error(`Failed to load ${src}`)), { once: true });
            return;
          }

          const script = document.createElement('script');
          script.src = src;
          script.defer = true;
          script.setAttribute(marker, 'true');
          script.addEventListener('load', () => {
            script.dataset.loaded = 'true';
            resolve();
          }, { once: true });
          script.addEventListener('error', () => reject(new Error(`Failed to load ${src}`)), { once: true });
          document.head.appendChild(script);
        });
      }

      async function ensureEvalMathRenderer() {
        if (typeof window.renderMathInElement === 'function') {
          return window.renderMathInElement;
        }

        if (evalMathRendererPromise) return evalMathRendererPromise;

        evalMathRendererPromise = (async () => {
          if (!window.katex || typeof window.katex.render !== 'function') {
            await loadScriptOnce(
              'https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js',
              'data-eval-katex',
            );
          }

          if (typeof window.renderMathInElement !== 'function') {
            await loadScriptOnce(
              'https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js',
              'data-eval-katex-auto-render',
            );
          }

          return window.renderMathInElement;
        })().catch((error) => {
          console.error('Failed to initialize eval math renderer:', error);
          return null;
        });

        return evalMathRendererPromise;
      }

      function renderEvalMath(container) {
        if (!container) return;

        ensureEvalMathRenderer()
          .then((renderMathInElement) => {
            if (typeof renderMathInElement !== 'function') return;
            renderMathInElement(container, {
              delimiters: [
                { left: '$$', right: '$$', display: true },
                { left: '$', right: '$', display: false },
              ],
              throwOnError: false,
              strict: 'ignore',
              ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
            });
          })
          .catch((error) => {
            console.error('Eval math render error:', error);
          });
      }

      function getSubmission(evalId) {
        return userSubmissions[evalId] || null;
      }

      function getSubmissionPayload(submission) {
        if (!submission) return null;
        return submission.answer ?? submission.payload ?? null;
      }

      function getPreviousFormMsqAnswers(submission) {
        const payload = getSubmissionPayload(submission);
        if (!payload || typeof payload !== 'object') return [];

        const directAnswerIndexes = Array.isArray(payload.answerIndexes)
          ? payload.answerIndexes
          : [];
        if (directAnswerIndexes.length > 0) {
          return directAnswerIndexes.map((value) => String(value));
        }

        const nestedAnswerIndexes =
          payload.answer && typeof payload.answer === 'object' && Array.isArray(payload.answer.answerIndexes)
            ? payload.answer.answerIndexes
            : [];
        if (nestedAnswerIndexes.length > 0) {
          return nestedAnswerIndexes.map((value) => String(value));
        }

        const directAnswer = Array.isArray(payload.answer) ? payload.answer : [];
        if (directAnswer.length > 0) {
          return directAnswer.map((value) => String(value));
        }

        return [];
      }

      function getPreviousFormTextAnswer(submission) {
        const payload = getSubmissionPayload(submission);
        if (!payload || typeof payload !== 'object') return '';

        return ensureEvalText(
          payload.text
          || payload.answerText
          || (payload.answer && typeof payload.answer === 'object'
            ? (
                payload.answer.text
                || payload.answer.answerText
                || payload.answer.value
                || ''
              )
            : ''),
        );
      }

      function getPreviousMcqAnswer(submission) {
        const payload = getSubmissionPayload(submission);
        if (payload && typeof payload === 'object') return payload.answer;
        return payload;
      }

      function toAnswerArray(answer) {
        if (Array.isArray(answer)) {
          return answer
            .map((value) => String(value))
            .filter((value) => value.length > 0);
        }
        if (answer === undefined || answer === null || answer === '') return [];
        return [String(answer)];
      }

      function isSubmissionCorrect(submission) {
        const payload = getSubmissionPayload(submission);
        if (payload && typeof payload === 'object' && typeof payload.isCorrect === 'boolean') {
          return payload.isCorrect;
        }
        if (typeof submission?.score === 'number') return submission.score > 0;
        return false;
      }

      function isCompletionSubmission(submission) {
        const payload = getSubmissionPayload(submission);
        if (!payload || typeof payload !== 'object') return false;

        if (payload.type === 'mcc' && payload.completed === true) return true;
        if (payload.completed === true) return true;

        const nestedAnswer = payload.answer;
        if (nestedAnswer && typeof nestedAnswer === 'object') {
          if (nestedAnswer.type === 'mcc' && nestedAnswer.completed === true) return true;
          if (nestedAnswer.completed === true) return true;
        }

        return false;
      }

      function buildProgressLabel(evalData, position) {
        const preferred = (evalData.title || evalData.prompt || `${evalData.type} ${position + 1}`)
          .replace(/\s+/g, ' ')
          .trim();

        if (preferred.length <= 64) return preferred;
        return `${preferred.slice(0, 61)}...`;
      }

      function registerProgress(evalData, position, isComplete = false) {
        progressByEvalId.set(evalData.id, {
          label: buildProgressLabel(evalData, position),
          complete: Boolean(isComplete),
          type: evalData.type || 'unknown',
        });
        renderPageProgress();
      }

      function setProgressCompletion(evalId, isComplete) {
        const existing = progressByEvalId.get(evalId);
        if (!existing) return;
        existing.complete = Boolean(isComplete);
        progressByEvalId.set(evalId, existing);
        renderPageProgress();
      }

      function renderPageProgress() {
        const container = document.getElementById('page-progress');
        const list = document.getElementById('page-progress-list');
        const meter = document.getElementById('mcc-progress-meter');
        const meterFill = document.getElementById('mcc-progress-fill');
        const meterPercent = document.getElementById('mcc-progress-percent');
        if (!container || !list) return;

        const entries = Array.from(progressByEvalId.entries());
        if (entries.length === 0) {
          container.hidden = true;
          return;
        }

        container.hidden = false;
        list.innerHTML = '';

        const mccEntries = entries.filter(([, item]) => item.type === 'mcc');
        if (meter && meterFill && meterPercent) {
          if (mccEntries.length === 0) {
            meter.hidden = true;
          } else {
            const completedCount = mccEntries.filter(([, item]) => item.complete).length;
            const percent = Math.round((completedCount / mccEntries.length) * 100);
            meter.hidden = false;
            meterFill.style.width = `${percent}%`;
            meterPercent.textContent = `${percent}%`;
          }
        }

        entries.forEach(([evalId, item]) => {
          const li = document.createElement('li');
          li.className = 'progress-item';
          if (item.complete) li.classList.add('is-complete');
          li.dataset.evalId = evalId;

          const dot = document.createElement('span');
          dot.className = 'progress-dot';
          dot.textContent = item.complete ? '✓' : '•';

          const label = document.createElement('span');
          label.className = 'progress-label';
          label.textContent = item.label;

          li.appendChild(dot);
          li.appendChild(label);
          list.appendChild(li);
        });
      }

      function getPageContext() {
        const pathParts = window.location.pathname
          .split('/')
          .filter(Boolean)
          .map((part) => {
            try {
              return decodeURIComponent(part);
            } catch {
              return part;
            }
          });
        const fallbackCourseId = String(canonicalLiveCourseId || '').trim();
        const fallbackPageSlug = String(canonicalLivePageSlug || '').trim();
        return {
          courseId: fallbackCourseId || pathParts[1] || '',
          pageSlug: fallbackPageSlug || pathParts.slice(1).join('/'),
        };
      }

      function ensureLiveClientId() {
        try {
          const storageKey = 'live:client-id';
          const existing = window.localStorage.getItem(storageKey);
          if (existing) return existing;
          const created = crypto.randomUUID();
          window.localStorage.setItem(storageKey, created);
          return created;
        } catch {
          return crypto.randomUUID();
        }
      }

      function formatPollStatus(widget) {
        if (!widget.state.active) return 'Interacción no activa.';
        if (!widget.state.endsAt) return 'Interacción en vivo.';

        const remainingMs = getRemainingMs(widget.state.endsAt, Date.now());
        if (remainingMs === null) return 'Interacción en vivo.';
        if (remainingMs <= 10_000) {
          return `Cierra en ${formatCountdown(remainingMs)}.`;
        }
        return `Tiempo restante: ${formatCountdown(remainingMs)}.`;
      }

      function updatePollCountdown(widget) {
        if (!widget.countdownNode) return;
        if (!widget.state.active || !widget.state.endsAt) {
          widget.countdownNode.hidden = true;
          widget.countdownNode.textContent = '';
          widget.countdownNode.classList.remove('is-closing');
          return;
        }

        const remainingMs = getRemainingMs(widget.state.endsAt, Date.now());
        if (remainingMs === null) {
          widget.countdownNode.hidden = true;
          widget.countdownNode.textContent = '';
          widget.countdownNode.classList.remove('is-closing');
          return;
        }

        widget.countdownNode.hidden = false;
        widget.countdownNode.textContent = formatCountdown(remainingMs);
        widget.countdownNode.classList.toggle('is-closing', remainingMs <= 10_000);
      }

      function setPollFeedback(widget, message, isError = false) {
        if (!widget.feedbackNode) return;
        if (!message) {
          widget.feedbackNode.hidden = true;
          widget.feedbackNode.textContent = '';
          widget.feedbackNode.dataset.error = 'false';
          return;
        }

        widget.feedbackNode.hidden = false;
        widget.feedbackNode.textContent = message;
        widget.feedbackNode.dataset.error = isError ? 'true' : 'false';
      }

      function sanitizePollOptionCounts(rawCounts) {
        if (!rawCounts || typeof rawCounts !== 'object' || Array.isArray(rawCounts)) return {};

        return Object.entries(rawCounts).reduce((acc, [rawKey, rawValue]) => {
          const optionId = String(rawKey || '').trim();
          if (!optionId) return acc;
          const numeric = Number(rawValue);
          if (!Number.isFinite(numeric) || numeric < 0) return acc;
          acc[optionId] = Math.round(numeric);
          return acc;
        }, {});
      }

      function getPersistedPollResults(payload) {
        if (!payload || typeof payload !== 'object') return null;

        const candidates = [];
        const directCounts = sanitizePollOptionCounts(payload.pollOptionCounts);
        if (Object.keys(directCounts).length > 0 || Number.isFinite(Number(payload.pollTotalResponses))) {
          candidates.push({
            optionCounts: directCounts,
            totalResponses: payload.pollTotalResponses,
          });
        }

        if (payload.pollResults && typeof payload.pollResults === 'object') candidates.push(payload.pollResults);
        if (payload.pollSnapshot && typeof payload.pollSnapshot === 'object') candidates.push(payload.pollSnapshot);
        if (payload.snapshot && typeof payload.snapshot === 'object') candidates.push(payload.snapshot);

        if (payload.answer && typeof payload.answer === 'object') {
          if (payload.answer.pollResults && typeof payload.answer.pollResults === 'object') {
            candidates.push(payload.answer.pollResults);
          }
          if (payload.answer.pollSnapshot && typeof payload.answer.pollSnapshot === 'object') {
            candidates.push(payload.answer.pollSnapshot);
          }
        }

        for (const candidate of candidates) {
          if (!candidate || typeof candidate !== 'object') continue;

          const optionCounts = sanitizePollOptionCounts(candidate.optionCounts || candidate.pollOptionCounts);
          const rawTotal = Number(candidate.totalResponses ?? candidate.pollTotalResponses);
          const computedTotal = Object.values(optionCounts).reduce(
            (sum, value) => sum + Math.max(0, Number(value) || 0),
            0,
          );
          const totalResponses = Number.isFinite(rawTotal) ? Math.max(0, Math.round(rawTotal)) : computedTotal;

          if (Object.keys(optionCounts).length === 0 && totalResponses <= 0) continue;
          return {
            optionCounts,
            totalResponses,
          };
        }

        return null;
      }

      function getPersistedPollAnswerLabels(payload, selectedIds, options) {
        if (payload && typeof payload === 'object') {
          const directOptions = Array.isArray(payload.answerOptions) ? payload.answerOptions : null;
          const nestedOptions =
            payload.answer && typeof payload.answer === 'object' && Array.isArray(payload.answer.answerOptions)
              ? payload.answer.answerOptions
              : null;
          const rawOptions = directOptions || nestedOptions;
          if (Array.isArray(rawOptions)) {
            const labels = rawOptions
              .map((item) => String(item || '').trim())
              .filter(Boolean);
            if (labels.length > 0) return labels;
          }
        }

        return selectedIds
          .map((id) => options.find((option) => String(option.id) === String(id))?.text || '')
          .filter(Boolean);
      }

      function sanitizeWordCounts(rawCounts) {
        if (!rawCounts || typeof rawCounts !== 'object' || Array.isArray(rawCounts)) return {};

        return Object.entries(rawCounts).reduce((acc, [rawWord, rawValue]) => {
          const word = String(rawWord || '').trim().replace(/\s+/g, ' ');
          if (!word) return acc;
          const numeric = Number(rawValue);
          if (!Number.isFinite(numeric) || numeric <= 0) return acc;
          acc[word] = Math.max(1, Math.round(numeric));
          return acc;
        }, {});
      }

      const WORDCLOUD_IMAGE_BUCKET = 'live-wordclouds';

      function slugifyWordcloudSegment(value) {
        return String(value || '')
          .trim()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '') || 'item';
      }

      function getR2PublicUrl() {
        const forumRoot = document.getElementById('lesson-forum');
        if (!(forumRoot instanceof HTMLElement)) return '';
        return String(forumRoot.dataset.r2PublicUrl || '').trim().replace(/\/+$/g, '');
      }

      function buildWordcloudImageUrl({ courseId, pageSlug, interactionId, sessionId }) {
        const publicUrl = getR2PublicUrl();
        const safeCourseId = slugifyWordcloudSegment(courseId);
        const safeInteractionId = slugifyWordcloudSegment(interactionId);
        const safeSessionId = slugifyWordcloudSegment(sessionId);
        if (!publicUrl || !safeCourseId || !safeInteractionId || !safeSessionId) return '';

        const lessonPath = String(pageSlug || '')
          .split('/')
          .slice(1)
          .filter(Boolean)
          .map((segment) => slugifyWordcloudSegment(segment))
          .join('/') || 'sin-leccion';
        const fileName = `${safeInteractionId}-${safeSessionId}.png`;
        return `${publicUrl}/${WORDCLOUD_IMAGE_BUCKET}/${safeCourseId}/${lessonPath}/${fileName}`;
      }

      function getPersistedWordcloudResults(payload) {
        if (!payload || typeof payload !== 'object') return null;

        const candidates = [];
        const directCounts = sanitizeWordCounts(payload.wordCounts);
        if (Object.keys(directCounts).length > 0 || Number.isFinite(Number(payload.wordTotalResponses))) {
          candidates.push({
            wordCounts: directCounts,
            totalResponses: payload.wordTotalResponses,
          });
        }

        if (payload.wordcloudResults && typeof payload.wordcloudResults === 'object') {
          candidates.push(payload.wordcloudResults);
        }
        if (payload.wordcloudSnapshot && typeof payload.wordcloudSnapshot === 'object') {
          candidates.push(payload.wordcloudSnapshot);
        }
        if (payload.snapshot && typeof payload.snapshot === 'object') {
          candidates.push(payload.snapshot);
        }

        if (payload.answer && typeof payload.answer === 'object') {
          if (payload.answer.wordcloudResults && typeof payload.answer.wordcloudResults === 'object') {
            candidates.push(payload.answer.wordcloudResults);
          }
          if (payload.answer.wordcloudSnapshot && typeof payload.answer.wordcloudSnapshot === 'object') {
            candidates.push(payload.answer.wordcloudSnapshot);
          }
        }

        for (const candidate of candidates) {
          if (!candidate || typeof candidate !== 'object') continue;
          const wordCounts = sanitizeWordCounts(candidate.wordCounts || candidate.cloud || {});
          const rawTotal = Number(candidate.totalResponses ?? candidate.wordTotalResponses);
          const computedTotal = Object.values(wordCounts).reduce((sum, value) => sum + value, 0);
          const totalResponses = Number.isFinite(rawTotal) ? Math.max(0, Math.round(rawTotal)) : computedTotal;
          if (Object.keys(wordCounts).length === 0 && totalResponses <= 0) continue;
          return {
            wordCounts,
            totalResponses,
          };
        }

        return null;
      }

      function getPersistedWordcloudAnswerText(payload) {
        if (!payload || typeof payload !== 'object') return '';

        const directWord = String(payload.answerWord || payload.answerText || '').trim();
        if (directWord) return directWord;

        if (payload.answer && typeof payload.answer === 'object') {
          const nested = String(
            payload.answer.text
            || payload.answer.word
            || payload.answer.answerWord
            || payload.answer.answerText
            || '',
          ).trim();
          if (nested) return nested;
        }

        return '';
      }

      function getPersistedWordcloudSessionId(payload) {
        if (!payload || typeof payload !== 'object') return '';

        const directSessionId = String(payload.wordcloudSessionId || payload.sessionId || '').trim();
        if (directSessionId) return directSessionId;

        if (payload.answer && typeof payload.answer === 'object') {
          const nestedSessionId = String(
            payload.answer.wordcloudSessionId
            || payload.answer.sessionId
            || '',
          ).trim();
          if (nestedSessionId) return nestedSessionId;
        }

        return '';
      }

      function getPersistedWordcloudImageUrl(payload, evalId) {
        if (!payload || typeof payload !== 'object') return '';

        const directUrlCandidates = [
          payload.wordcloudImageUrl,
          payload.imageUrl,
          payload.publicUrl,
          payload.wordcloudImage && typeof payload.wordcloudImage === 'object' ? payload.wordcloudImage.publicUrl : '',
        ];

        if (payload.answer && typeof payload.answer === 'object') {
          directUrlCandidates.push(
            payload.answer.wordcloudImageUrl,
            payload.answer.imageUrl,
            payload.answer.publicUrl,
            payload.answer.wordcloudImage && typeof payload.answer.wordcloudImage === 'object'
              ? payload.answer.wordcloudImage.publicUrl
              : '',
          );
        }

        for (const candidate of directUrlCandidates) {
          const url = String(candidate || '').trim();
          if (url) return url;
        }

        const sessionId = getPersistedWordcloudSessionId(payload);
        if (!sessionId) return '';

        const { courseId, pageSlug } = getPageContext();
        return buildWordcloudImageUrl({
          courseId,
          pageSlug,
          interactionId: evalId,
          sessionId,
        });
      }

      function buildClassicWordcloudSvg(entries, {
        prompt = '',
        totalResponses = 0,
      } = {}) {
        const width = 1000;
        const height = 560;
        const padding = 44;
        const headerHeight = 88;
        const footerHeight = 40;
        const maxCount = Math.max(...entries.map(([, count]) => count), 1);
        const minCount = Math.min(...entries.map(([, count]) => count), maxCount);

        let cursorX = padding;
        let cursorY = headerHeight + 12;
        let lineHeight = 0;

        const wordNodes = entries.map(([word, count], index) => {
          const ratio = maxCount === minCount ? 1 : (count - minCount) / (maxCount - minCount);
          const fontSize = 22 + ratio * 44;
          const approxWidth = Math.max(fontSize * 1.65, word.length * fontSize * 0.52);
          const approxHeight = fontSize * 1.08;
          const rotation = index % 5 === 0 ? -8 : index % 7 === 0 ? 7 : 0;

          if (cursorX + approxWidth > width - padding) {
            cursorX = padding;
            cursorY += lineHeight + 18;
            lineHeight = 0;
          }

          if (cursorY + approxHeight > height - footerHeight - 8) {
            return '';
          }

          const x = cursorX;
          const y = cursorY + fontSize;
          cursorX += approxWidth + 18;
          lineHeight = Math.max(lineHeight, approxHeight);

          const hue = (index * 37 + 19) % 360;
          const fill = ratio > 0.72
            ? `hsl(${hue} 82% 36%)`
            : `hsl(${hue} 70% 46%)`;

          return `<text x="${x.toFixed(1)}" y="${y.toFixed(1)}" font-size="${fontSize.toFixed(1)}" font-weight="${ratio > 0.6 ? 700 : 500}" fill="${fill}" transform="rotate(${rotation} ${x.toFixed(1)} ${y.toFixed(1)})">${escapeHtml(word)}</text>`;
        }).filter(Boolean);

        const headline = prompt || 'Wordcloud';
        const metaLine = [
          totalResponses > 0 ? `${totalResponses} aportes` : '',
          `${entries.length} términos`,
        ].filter(Boolean).join(' · ');

        return `
          <svg class="wordcloud-svg" viewBox="0 0 ${width} ${height}" role="img" aria-label="${escapeHtml(headline)}">
            <defs>
              <linearGradient id="wordcloud-bg-gradient" x1="0%" x2="100%" y1="0%" y2="100%">
                <stop offset="0%" stop-color="#fffdf7"></stop>
                <stop offset="100%" stop-color="#f3efe2"></stop>
              </linearGradient>
            </defs>
            <rect x="0" y="0" width="${width}" height="${height}" rx="26" fill="url(#wordcloud-bg-gradient)"></rect>
            <rect x="12" y="12" width="${width - 24}" height="${height - 24}" rx="18" fill="none" stroke="rgba(49, 35, 18, 0.12)"></rect>
            <text x="${padding}" y="48" font-size="13" letter-spacing="3.2" fill="rgba(73, 54, 29, 0.52)">WORDCLOUD</text>
            <text x="${padding}" y="76" font-size="26" font-weight="700" fill="#362818">${escapeHtml(headline)}</text>
            ${wordNodes.join('')}
            <text x="${padding}" y="${height - 18}" font-size="14" fill="rgba(73, 54, 29, 0.56)">${escapeHtml(metaLine)}</text>
          </svg>
        `;
      }

      function renderWordcloudCloud(targetNode, rawCounts, totalResponses = 0, options = {}) {
        if (!(targetNode instanceof HTMLElement)) return;

        const entries = Object.entries(sanitizeWordCounts(rawCounts))
          .sort((a, b) => {
            if (b[1] !== a[1]) return b[1] - a[1];
            return a[0].localeCompare(b[0], 'es');
          });

        if (entries.length === 0) {
          targetNode.hidden = true;
          targetNode.innerHTML = '';
          return;
        }

        const total = Math.max(0, Number(totalResponses || 0));
        const prompt = String(options?.prompt || '').trim();
        const imageUrl = String(options?.imageUrl || '').trim();

        const visual = document.createElement('div');
        visual.className = 'wordcloud-visual';

        const fallback = document.createElement('div');
        fallback.className = 'wordcloud-visual-fallback';
        fallback.innerHTML = buildClassicWordcloudSvg(entries, {
          prompt,
          totalResponses: total,
        });
        visual.appendChild(fallback);

        if (imageUrl) {
          const image = document.createElement('img');
          image.className = 'wordcloud-image';
          image.alt = prompt ? `Wordcloud: ${prompt}` : 'Wordcloud exportado';
          image.loading = 'lazy';
          image.decoding = 'async';
          image.src = imageUrl;
          image.hidden = true;
          image.addEventListener('load', () => {
            image.hidden = false;
            fallback.hidden = true;
          });
          image.addEventListener('error', () => {
            image.removeAttribute('src');
            image.hidden = true;
            fallback.hidden = false;
          });
          visual.prepend(image);
        }

        const summary = document.createElement('p');
        summary.className = 'wordcloud-summary';
        summary.textContent = total > 0
          ? `${total} aportes · ${entries.length} términos`
          : `${entries.length} términos`;

        targetNode.hidden = false;
        targetNode.innerHTML = '';
        targetNode.append(visual, summary);
      }

      async function persistWordcloudImage(widget, payload) {
        if (!widget?.canManage || !payload?.active) return;

        const sessionId = String(payload?.sessionId || '').trim();
        const wordCounts = sanitizeWordCounts(payload?.wordCounts || {});
        if (!sessionId || Object.keys(wordCounts).length === 0) return;

        const saveKey = JSON.stringify([
          sessionId,
          Number(payload?.totalResponses || 0),
          Object.entries(wordCounts).sort((left, right) => left[0].localeCompare(right[0], 'es')),
        ]);

        if (widget.lastSavedWordcloudKey === saveKey) return;
        widget.lastSavedWordcloudKey = saveKey;

        const courseContext = getPageContext();
        try {
          const response = await fetch('/api/live/wordcloud-image', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              courseId: courseContext.courseId,
              pageSlug: courseContext.pageSlug,
              interactionId: widget.data?.id || '',
              prompt: widget.data?.prompt || '',
              sessionId,
              wordCounts,
            }),
          });

          const exportPayload = await response.json().catch(() => ({}));
          if (!response.ok) {
            widget.lastSavedWordcloudKey = '';
            return;
          }

          widget.lastSavedWordcloudUrl = String(exportPayload?.publicUrl || '').trim();
          if (widget.lastSavedWordcloudUrl) {
            widget.state.persistedImageUrl = widget.lastSavedWordcloudUrl;
            renderWordcloudState(widget);
          }
        } catch {
          widget.lastSavedWordcloudKey = '';
        }
      }

      function syncPollResults(widget) {
        if (!widget.resultsNode) return;

        const persisted = widget.state.persistedResults && typeof widget.state.persistedResults === 'object'
          ? widget.state.persistedResults
          : null;
        const hasPersistedResults = Boolean(persisted);
        const canShowResults = widget.canManage
          ? widget.data.showResults && (widget.state.active || hasPersistedResults)
          : widget.data.showResults && widget.state.hasSubmitted && (widget.state.active || hasPersistedResults);

        if (!canShowResults) {
          widget.resultsNode.hidden = true;
          widget.resultsNode.innerHTML = '';
          return;
        }

        const sourceOptionCounts = widget.state.active
          ? widget.state.optionCounts
          : (persisted?.optionCounts || widget.state.optionCounts || {});
        const normalizedOptionCounts = sanitizePollOptionCounts(sourceOptionCounts);
        const derivedTotal = Object.values(normalizedOptionCounts).reduce(
          (sum, value) => sum + Math.max(0, Number(value) || 0),
          0,
        );
        const explicitTotal = widget.state.active
          ? Number(widget.state.totalResponses || 0)
          : Number(persisted?.totalResponses ?? widget.state.totalResponses ?? 0);
        const totalResponses = Number.isFinite(explicitTotal) && explicitTotal > 0
          ? Math.round(explicitTotal)
          : derivedTotal;

        if (Object.keys(normalizedOptionCounts).length === 0 && totalResponses <= 0) {
          widget.resultsNode.hidden = true;
          widget.resultsNode.innerHTML = '';
          return;
        }

        widget.resultsNode.hidden = false;
        widget.resultsNode.innerHTML = '';
        widget.data.options.forEach((option) => {
          const optionId = String(option.id || '');
          const count = Math.max(0, Number(normalizedOptionCounts?.[optionId] || 0));
          const percentage = totalResponses > 0 ? Math.round((count / totalResponses) * 100) : 0;

          const row = document.createElement('div');
          row.className = 'poll-result-row';

          const meta = document.createElement('div');
          meta.className = 'poll-result-meta';
          const optionText = document.createElement('span');
          optionText.className = 'poll-result-label';
          optionText.textContent = option.text;
          const optionCount = document.createElement('span');
          optionCount.className = 'poll-result-count';
          optionCount.textContent = `${count} (${percentage}%)`;
          meta.append(optionText, optionCount);

          const track = document.createElement('div');
          track.className = 'poll-result-track';
          const fill = document.createElement('div');
          fill.className = 'poll-result-fill';
          fill.style.width = `${percentage}%`;
          track.appendChild(fill);

          row.append(meta, track);
          widget.resultsNode.appendChild(row);
        });
      }

      function renderPollState(widget) {
        const canRespond = widget.state.active;
        const submissionDone = Boolean(widget.state.hasSubmitted);
        const { courseId } = getPageContext();
        const needsManualSubmit = Boolean(widget.data?.allowMultiple);

        if (widget.submitButton) {
          widget.submitButton.hidden = !canRespond || !needsManualSubmit;
          widget.submitButton.disabled = !canRespond;
          widget.submitButton.textContent = 'Enviar';
        }

        if (widget.startButton) {
          widget.startButton.hidden = !widget.canManage;
          widget.startButton.disabled = widget.state.active;
        }
        if (widget.endButton) {
          widget.endButton.hidden = !widget.canManage;
          widget.endButton.disabled = !widget.state.active || !widget.state.sessionId;
        }
        if (widget.openLink) {
          if (widget.canManage && widget.state.active && widget.state.sessionId) {
            const url = new URL(`/live/${encodeURIComponent(widget.state.sessionId)}`, window.location.origin);
            if (courseId) url.searchParams.set('courseId', courseId);
            widget.openLink.href = `${url.pathname}${url.search}`;
            widget.openLink.hidden = false;
          } else {
            widget.openLink.hidden = true;
          }
        }

        if (widget.formNode) {
          widget.formNode.hidden = !canRespond;
          widget.formNode.querySelectorAll('input').forEach((input) => {
            input.disabled = !canRespond;
          });
        }

        if (widget.statusNode) {
          if (!widget.state.active && submissionDone) {
            widget.statusNode.textContent = 'Interacción finalizada. Tu respuesta fue registrada.';
          } else {
            widget.statusNode.textContent = formatPollStatus(widget);
          }
        }

        updatePollCountdown(widget);
        syncPollResults(widget);
      }

      function emitLiveEvent(eventName, payload) {
        window.dispatchEvent(
          new CustomEvent('live:event', {
            detail: {
              eventName: String(eventName || '').trim(),
              payload: payload && typeof payload === 'object' ? payload : null,
            },
          }),
        );
      }

      function applyLivePayloadToPollWidgets(payload, sourceEvent) {
        if (sourceEvent === 'live.snapshot' && (!payload || !payload.active)) {
          pollWidgetsByEvalId.forEach((widget) => {
            widget.state.active = false;
            widget.state.sessionId = '';
            widget.state.endsAt = null;
            widget.state.totalResponses = 0;
            widget.state.optionCounts = {};
            renderPollState(widget);
          });
          return;
        }

        if (!payload || typeof payload !== 'object') return;

        if (sourceEvent === 'live.ended') {
          const endedInteractionId = String(payload.interactionId || '');
          pollWidgetsByEvalId.forEach((widget) => {
            if (widget.data.id !== endedInteractionId) return;
            widget.state.active = false;
            widget.state.sessionId = '';
            widget.state.endsAt = null;
            setPollFeedback(widget, 'La interacción fue cerrada.');
            renderPollState(widget);
          });
          return;
        }

        if (!payload.active) return;
        const interactionId = String(payload.interactionId || '');

        pollWidgetsByEvalId.forEach((widget) => {
          const isActiveWidget = widget.data.id === interactionId;
          if (!isActiveWidget && (sourceEvent === 'live.started' || sourceEvent === 'live.snapshot')) {
            widget.state.active = false;
            widget.state.sessionId = '';
            widget.state.endsAt = null;
            widget.state.totalResponses = 0;
            widget.state.optionCounts = {};
          }
          if (!isActiveWidget) {
            renderPollState(widget);
            return;
          }

          const nextSessionId = String(payload.sessionId || '');
          const isNewSession = Boolean(nextSessionId) && nextSessionId !== String(widget.state.sessionId || '');
          if (isNewSession) {
            widget.state.hasSubmitted = false;
            widget.state.persistedResults = null;
            try {
              window.localStorage.removeItem(`live:submitted:${widget.data.id}`);
            } catch {
              // ignore storage restrictions
            }
            if (widget.formNode instanceof HTMLElement) {
              widget.formNode.querySelectorAll('input').forEach((field) => {
                if (field instanceof HTMLInputElement) {
                  if (field.type === 'checkbox' || field.type === 'radio') {
                    field.checked = false;
                  } else if (field.type !== 'hidden') {
                    field.value = '';
                  }
                }
              });
            }
          }

          widget.state.active = true;
          widget.state.sessionId = nextSessionId;
          widget.state.endsAt = payload.endsAt || null;
          widget.state.totalResponses = Math.max(0, Number(payload.totalResponses || 0));
          widget.state.optionCounts = payload.optionCounts && typeof payload.optionCounts === 'object'
            ? payload.optionCounts
            : {};
          renderPollState(widget);
        });
      }

      function mountLivePollTransport() {
        if (pollWidgetsByEvalId.size === 0 && wordcloudWidgetsByEvalId.size === 0) return;
        const { courseId } = getPageContext();
        if (!courseId) return;

        unsubscribeLivePolls?.();
        unsubscribeLivePolls = subscribeToLive({
          courseId,
          onEvent: (eventName, payload) => {
            emitLiveEvent(eventName, payload);
            applyLivePayloadToPollWidgets(payload, eventName);
            applyLivePayloadToWordcloudWidgets(payload, eventName);
          },
        });

        if (livePollTickId) {
          window.clearInterval(livePollTickId);
        }
        livePollTickId = window.setInterval(() => {
          pollWidgetsByEvalId.forEach((widget) => {
            updatePollCountdown(widget);
          });
          wordcloudWidgetsByEvalId.forEach((widget) => {
            updatePollCountdown(widget);
          });
        }, 1000);
      }

      function ensureEvalText(value) {
        if (typeof value === 'string') return value.trim();
        if (value === undefined || value === null) return '';
        return String(value).trim();
      }

      function ensureEvalBool(value) {
        if (typeof value === 'boolean') return value;
        if (typeof value === 'string') {
          const normalized = value.trim().toLowerCase();
          if (['true', 'si', 'sí', 'yes', 'clara', 'claro'].includes(normalized)) return true;
          if (['false', 'no', 'unclear', 'difusa'].includes(normalized)) return false;
        }
        return false;
      }

      function clampEvalScore(value) {
        return Math.min(10, Math.max(0, value));
      }

      function parseEvalScore(value) {
        if (typeof value === 'number' && Number.isFinite(value)) return clampEvalScore(value);
        if (typeof value === 'string') {
          const match = value.match(/(\d+(?:[.,]\d+)?)\s*(?:\/\s*10)?/);
          if (!match?.[1]) return null;
          const parsed = Number(match[1].replace(',', '.'));
          if (!Number.isFinite(parsed)) return null;
          return clampEvalScore(parsed);
        }
        return null;
      }

      function ensureEvalPair(value) {
        let items = [];
        if (Array.isArray(value)) {
          items = value.map((item) => ensureEvalText(item)).filter(Boolean);
        } else if (typeof value === 'string') {
          items = value
            .split(/\n|;|\u2022|\-/g)
            .map((item) => item.trim())
            .filter(Boolean);
        }
        const out = items.slice(0, 2);
        while (out.length < 2) out.push('');
        return out;
      }

      function cleanupEvalJsonCandidate(text) {
        if (typeof text !== 'string') return '';
        return text
          .trim()
          .replace(/^```json/i, '')
          .replace(/^```/i, '')
          .replace(/```$/i, '')
          .replace(/,\s*([}\]])/g, '$1')
          .trim();
      }

      function parseEvalJsonLoosely(rawText) {
        const cleaned = cleanupEvalJsonCandidate(rawText);
        const firstBrace = cleaned.indexOf('{');
        if (firstBrace === -1) return null;

        const source = cleaned.slice(firstBrace);

        const tryParse = (candidate) => {
          try {
            const parsed = JSON.parse(candidate);
            return parsed && typeof parsed === 'object' ? parsed : null;
          } catch {
            return null;
          }
        };

        const direct = tryParse(source);
        if (direct) return direct;

        let depth = 0;
        let inString = false;
        let escaped = false;
        let endIndex = -1;

        for (let i = 0; i < source.length; i += 1) {
          const ch = source[i];

          if (inString) {
            if (escaped) {
              escaped = false;
            } else if (ch === '\\') {
              escaped = true;
            } else if (ch === '"') {
              inString = false;
            }
            continue;
          }

          if (ch === '"') {
            inString = true;
            continue;
          }

          if (ch === '{') depth += 1;
          if (ch === '}') depth -= 1;

          if (depth === 0) {
            endIndex = i;
            break;
          }
        }

        if (endIndex !== -1) {
          const balanced = cleanupEvalJsonCandidate(source.slice(0, endIndex + 1));
          const parsedBalanced = tryParse(balanced);
          if (parsedBalanced) return parsedBalanced;
        }

        if (depth > 0) {
          const repaired = cleanupEvalJsonCandidate(`${source}${'}'.repeat(depth)}`);
          const parsedRepaired = tryParse(repaired);
          if (parsedRepaired) return parsedRepaired;
        }

        const lastBrace = source.lastIndexOf('}');
        if (lastBrace !== -1) {
          const sliced = cleanupEvalJsonCandidate(source.slice(0, lastBrace + 1));
          const parsedSliced = tryParse(sliced);
          if (parsedSliced) return parsedSliced;
        }

        return null;
      }

      function deriveAiScore({ tesisClara, fortalezas, debilidades, sugerencia }) {
        let score = 5;
        score += tesisClara ? 1.5 : -1;
        score += fortalezas.filter(Boolean).length * 1.2;
        score -= debilidades.filter(Boolean).length * 0.8;
        if (sugerencia.length >= 30) score += 0.6;
        return Math.round(clampEvalScore(score) * 10) / 10;
      }

      function normalizeAiEvaluation(rawEvaluation) {
        const base = rawEvaluation && typeof rawEvaluation === 'object' ? rawEvaluation : {};
        const recovered = parseEvalJsonLoosely(base.raw || rawEvaluation) || {};

        const baseTesis = base.tesis && typeof base.tesis === 'object' ? base.tesis : {};
        const recoveredTesis = recovered.tesis && typeof recovered.tesis === 'object' ? recovered.tesis : {};
        const baseCal = base.calificacion && typeof base.calificacion === 'object' ? base.calificacion : {};
        const recCal = recovered.calificacion && typeof recovered.calificacion === 'object' ? recovered.calificacion : {};

        const resumen = ensureEvalText(base.resumen) || ensureEvalText(recovered.resumen);
        const tesisClara = ensureEvalBool(baseTesis.clara ?? recoveredTesis.clara ?? base.tesis_clara ?? recovered.tesis_clara);
        const tesisExplicacion =
          ensureEvalText(baseTesis.explicacion) ||
          ensureEvalText(recoveredTesis.explicacion) ||
          ensureEvalText(base.tesis_explicacion) ||
          ensureEvalText(recovered.tesis_explicacion);

        const fortalezas = ensureEvalPair(base.fortalezas ?? recovered.fortalezas);
        const debilidades = ensureEvalPair(base.debilidades ?? recovered.debilidades);
        const sugerencia = ensureEvalText(base.sugerencia) || ensureEvalText(recovered.sugerencia);

        let nota = parseEvalScore(baseCal.nota ?? recCal.nota ?? base.nota ?? recovered.nota);
        if (nota === null) nota = parseEvalScore(sugerencia);
        if (nota === null) {
          nota = deriveAiScore({
            tesisClara,
            fortalezas,
            debilidades,
            sugerencia,
          });
        }

        const justificacion =
          ensureEvalText(baseCal.justificacion) ||
          ensureEvalText(recCal.justificacion) ||
          `Nota sugerida ${nota}/10 según criterios de la rúbrica.`;

        return {
          resumen,
          tesis: {
            clara: tesisClara,
            explicacion: tesisExplicacion,
          },
          fortalezas,
          debilidades,
          sugerencia,
          calificacion: {
            nota,
            justificacion,
          },
          raw: ensureEvalText(base.raw) || ensureEvalText(rawEvaluation),
        };
      }

      function hasAiEvaluation(evaluation) {
        if (!evaluation || typeof evaluation !== 'object') return false;
        return Boolean(
          ensureEvalText(evaluation.resumen)
          || ensureEvalText(evaluation.sugerencia)
          || parseEvalScore(evaluation?.calificacion?.nota) !== null
          || ensureEvalPair(evaluation.fortalezas).some(Boolean)
          || ensureEvalPair(evaluation.debilidades).some(Boolean),
        );
      }

      async function saveSubmission({
        evalId,
        answer,
        isCorrect,
        meta = {},
        score = null,
        feedback = '',
        markAsGraded = false,
      }) {
        if (!isAuthenticatedUser) return false;

        try {
          const { courseId, pageSlug } = getPageContext();
          const numericScore = typeof score === 'number' && Number.isFinite(score) ? score : null;
          const response = await fetch('/api/eval/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              evalId,
              answer,
              isCorrect,
              payload: {
                answer,
                isCorrect,
                ...(meta && typeof meta === 'object' ? meta : {}),
              },
              score: numericScore,
              feedback: ensureEvalText(feedback) || undefined,
              markAsGraded: Boolean(markAsGraded) || numericScore !== null,
              courseId,
              pageSlug,
            }),
          });

          if (!response.ok) return false;
          await loadUserSubmissions();
          // Reflect the new result in the course progress map / sidebar log.
          try { updateCourseProgress(); } catch {}
          try { void applyServerProgress(); } catch {}

          return true;
        } catch (error) {
          console.error('Error saving submission:', error);
          return false;
        }
      }

      function renderMCQ(wrapper, data, position) {
        const previousSubmission = getSubmission(data.id);
        const previousAnswer = getPreviousMcqAnswer(previousSubmission);
        const previousAnswers = toAnswerArray(previousAnswer);
        const wasCorrect = isSubmissionCorrect(previousSubmission);
        const allowsMultiple = Boolean(data.allowMultiple);
        const allowEdit = Boolean(data.allowEdit);
        const correctOptionIndexes = data.options.reduce((acc, option, index) => {
          const optionCorrect = typeof option === 'string'
            ? /^\[(x|X)\]/.test(option.trim())
            : Boolean(option.isCorrect);
          if (optionCorrect) acc.push(String(index));
          return acc;
        }, []);

        registerProgress(data, position, wasCorrect);

        const container = document.createElement('div');
        container.className = 'eval-block';
        container.dataset.evalId = data.id;
        container.id = `eval-${data.id}`;

        const prompt = document.createElement('h4');
        prompt.className = 'eval-prompt';
        prompt.textContent = data.prompt;
        container.appendChild(prompt);

        if (allowsMultiple) {
          const modeHint = document.createElement('p');
          modeHint.className = 'feedback-explanation';
          modeHint.textContent = 'Selecciona todas las opciones correctas.';
          container.appendChild(modeHint);
        }

        if (allowEdit) {
          const editableHint = document.createElement('p');
          editableHint.className = 'feedback-explanation';
          editableHint.textContent = 'Puedes editar y reenviar tu respuesta.';
          container.appendChild(editableHint);
        }

        const form = document.createElement('form');
        form.className = 'mcq-form';

        data.options.forEach((option, index) => {
          const optionText = typeof option === 'string'
            ? option.replace(/^\[(x|X|\s)\]\s*/, '')
            : option.text;
          const optionCorrect = typeof option === 'string'
            ? /^\[(x|X)\]/.test(option.trim())
            : Boolean(option.isCorrect);

          const label = document.createElement('label');
          label.className = 'mcq-option';

          const input = document.createElement('input');
          input.type = allowsMultiple ? 'checkbox' : 'radio';
          input.name = allowsMultiple ? `${data.id}[]` : data.id;
          input.value = String(index);
          input.dataset.correct = optionCorrect ? 'true' : 'false';

          if (previousAnswers.includes(String(index))) {
            input.checked = true;
          }

          const span = document.createElement('span');
          span.textContent = optionText;

          label.appendChild(input);
          label.appendChild(span);
          form.appendChild(label);
        });

        const submitButton = document.createElement('button');
        submitButton.type = 'submit';
        submitButton.className = 'eval-submit';
        submitButton.textContent = previousSubmission && allowEdit ? 'Guardar cambios' : 'Enviar respuesta';
        form.appendChild(submitButton);
        container.appendChild(form);

        const feedback = document.createElement('div');
        feedback.className = 'eval-feedback';
        feedback.style.display = 'none';

        const message = document.createElement('p');
        message.className = 'feedback-message';
        feedback.appendChild(message);

        if (data.explanation) {
          const explanation = document.createElement('p');
          explanation.className = 'feedback-explanation';
          explanation.textContent = data.explanation;
          feedback.appendChild(explanation);
        }

        container.appendChild(feedback);

        if (previousSubmission) {
          message.textContent = wasCorrect ? '✅ ¡Correcto!' : '❌ Incorrecto, intenta de nuevo';
          message.className = `feedback-message ${wasCorrect ? 'correct' : 'incorrect'}`;
          feedback.style.display = 'block';

          if (wasCorrect && !allowEdit) {
            form.querySelectorAll('input').forEach((input) => {
              input.disabled = true;
            });
            submitButton.disabled = true;
          }
        }

        form.addEventListener('submit', async (event) => {
          event.preventDefault();

          const selectedInputs = Array.from(form.querySelectorAll('input:checked'));
          if (selectedInputs.length === 0) {
            console.warn(allowsMultiple ? 'Selecciona al menos una opción.' : 'Por favor selecciona una opción');
            return;
          }

          const selectedValues = selectedInputs.map((input) => String(input.value));
          const normalizedSelected = Array.from(new Set(selectedValues)).sort();
          const normalizedCorrect = Array.from(new Set(correctOptionIndexes)).sort();
          const isCorrect = normalizedSelected.length === normalizedCorrect.length
            && normalizedSelected.every((value, idx) => value === normalizedCorrect[idx]);
          const selectedOptionTexts = normalizedSelected
            .map((selectedIndex) => {
              const idx = Number(selectedIndex);
              const option = data.options[idx];
              if (typeof option === 'string') return option.replace(/^\[(x|X|\s)\]\s*/, '').trim();
              return String(option?.text || '').trim();
            })
            .filter(Boolean);

          message.textContent = isCorrect ? '✅ ¡Correcto!' : '❌ Incorrecto, intenta de nuevo';
          message.className = `feedback-message ${isCorrect ? 'correct' : 'incorrect'}`;
          feedback.style.display = 'block';

          const saved = await saveSubmission({
            evalId: data.id,
            answer: allowsMultiple ? normalizedSelected : normalizedSelected[0],
            isCorrect,
            meta: {
              answerText: selectedOptionTexts.join(' | '),
              answerOptions: selectedOptionTexts,
              answerIndexes: normalizedSelected,
              selectionMode: allowsMultiple ? 'multiple' : 'single',
            },
          });

          if (!saved) {
            console.warn('No se pudo guardar tu respuesta. Intenta nuevamente.');
            return;
          }

          setProgressCompletion(data.id, isCorrect);

          if (isCorrect && !allowEdit) {
            form.querySelectorAll('input').forEach((input) => {
              input.disabled = true;
            });
            submitButton.disabled = true;
          } else if (allowEdit) {
            submitButton.textContent = 'Guardar cambios';
          }
        });

        wrapper.appendChild(container);
        renderEvalMath(container);
      }

      function renderMCC(wrapper, data, position) {
        const previousSubmission = getSubmission(data.id);
        const isCompleted = isCompletionSubmission(previousSubmission);

        registerProgress(data, position, isCompleted);

        const container = document.createElement('div');
        container.className = 'eval-block mcc-block';
        container.dataset.evalId = data.id;
        container.id = `eval-${data.id}`;

        const prompt = document.createElement('h4');
        prompt.className = 'eval-prompt';
        prompt.textContent = data.prompt || 'Marca esta sección como completada.';
        container.appendChild(prompt);

        if (data.summary) {
          const summary = document.createElement('p');
          summary.className = 'mcc-summary';
          summary.textContent = data.summary;
          container.appendChild(summary);
        }

        if (Array.isArray(data.objectives) && data.objectives.length > 0) {
          const goalsLabel = document.createElement('p');
          goalsLabel.className = 'mcc-objectives-label';
          goalsLabel.textContent = 'Al finalizar esta sección serás capaz de:';
          container.appendChild(goalsLabel);

          const list = document.createElement('ul');
          list.className = 'mcc-objectives';
          data.objectives.forEach((objective) => {
            const li = document.createElement('li');
            li.textContent = objective;
            list.appendChild(li);
          });
          container.appendChild(list);
        }

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'eval-submit mcc-submit';
        button.textContent = isCompleted ? (data.successLabel || 'Sección completada') : (data.buttonLabel || 'Marcar como completado');
        button.disabled = isCompleted;
        container.appendChild(button);

        const feedback = document.createElement('div');
        feedback.className = 'eval-feedback';
        feedback.style.display = isCompleted ? 'block' : 'none';
        const message = document.createElement('p');
        message.className = 'feedback-message correct';
        message.textContent = data.successLabel || 'Sección completada';
        feedback.appendChild(message);
        container.appendChild(feedback);

        button.addEventListener('click', async () => {
          const saved = await saveSubmission({
            evalId: data.id,
            answer: {
              type: 'mcc',
              completed: true,
              completedAt: new Date().toISOString(),
            },
            isCorrect: true,
          });

          if (!saved) {
            console.warn('No se pudo guardar el estado de completado. Intenta nuevamente.');
            return;
          }

          button.disabled = true;
          button.textContent = data.successLabel || 'Sección completada';
          message.textContent = data.successLabel || 'Sección completada';
          feedback.style.display = 'block';
          setProgressCompletion(data.id, true);
        });

        wrapper.appendChild(container);
        renderEvalMath(container);
      }

      function renderTextAI(wrapper, data, position) {
        const previousSubmission = getSubmission(data.id);
        const previousPayload = getSubmissionPayload(previousSubmission);
        const previousRecord = previousPayload && typeof previousPayload === 'object' ? previousPayload : {};
        const previousAnswer = previousRecord.answer && typeof previousRecord.answer === 'object'
          ? previousRecord.answer
          : previousRecord;
        const previousStudentText = ensureEvalText(
          previousAnswer.studentText
          || previousAnswer.student_text
          || previousRecord.answerText
          || previousRecord.answerPreview,
        );
        const previousEvaluationSource =
          previousAnswer.evaluation
          || previousRecord.aiEvaluation
          || previousRecord.evaluation
          || null;
        const previousEvaluation = hasAiEvaluation(previousEvaluationSource)
          ? normalizeAiEvaluation(previousEvaluationSource)
          : null;
        const previousScore = previousEvaluation
          ? parseEvalScore(previousEvaluation?.calificacion?.nota)
          : null;
        const passScore = Number.isFinite(Number(data.passScore))
          ? Math.max(0, Number(data.passScore))
          : 6;
        const allowEdit = Boolean(data.allowEdit);
        const wasCorrect = previousScore !== null ? previousScore >= passScore : isSubmissionCorrect(previousSubmission);
        const isReferenceMode = data.type === 'reference_ai';

        registerProgress(data, position, wasCorrect);

        const container = document.createElement('div');
        container.className = 'eval-block patch-ai-block';
        container.dataset.evalId = data.id;
        container.id = `eval-${data.id}`;

        const prompt = document.createElement('h4');
        prompt.className = 'eval-prompt';
        prompt.textContent = data.prompt || data.title || 'Escribe tu respuesta y envíala a corrección.';
        container.appendChild(prompt);

        const meta = document.createElement('p');
        meta.className = 'patch-ai-meta';
        const providerLabel = ensureEvalText(data.provider || 'ollama') || 'ollama';
        const modelLabel = ensureEvalText(data.model);
        meta.textContent = [
          `Proveedor: ${providerLabel}`,
          modelLabel ? `Modelo: ${modelLabel}` : '',
          `Aprobacion: ${passScore}/10`,
        ].filter(Boolean).join(' · ');
        container.appendChild(meta);

        if (ensureEvalText(data.rubric)) {
          const rubricDetails = document.createElement('details');
          rubricDetails.className = 'patch-ai-reference';

          const rubricSummary = document.createElement('summary');
          rubricSummary.textContent = 'Ver rúbrica';
          rubricDetails.appendChild(rubricSummary);

          const rubricPre = document.createElement('pre');
          rubricPre.className = 'patch-ai-code';
          rubricPre.textContent = ensureEvalText(data.rubric);
          rubricDetails.appendChild(rubricPre);

          container.appendChild(rubricDetails);
        }

        if (isReferenceMode && ensureEvalText(data.referenceText)) {
          const referenceDetails = document.createElement('details');
          referenceDetails.className = 'patch-ai-reference';
          if (!previousStudentText) referenceDetails.open = true;

          const referenceSummary = document.createElement('summary');
          referenceSummary.textContent = 'Ver respuesta de referencia';
          referenceDetails.appendChild(referenceSummary);

          const referencePre = document.createElement('pre');
          referencePre.className = 'patch-ai-code';
          referencePre.textContent = ensureEvalText(data.referenceText);
          referenceDetails.appendChild(referencePre);

          container.appendChild(referenceDetails);
        }

        if (allowEdit) {
          const editableHint = document.createElement('p');
          editableHint.className = 'feedback-explanation';
          editableHint.textContent = 'Puedes editar tu respuesta y reenviarla.';
          container.appendChild(editableHint);
        }

        const form = document.createElement('form');
        form.className = 'patch-ai-form';

        const textarea = document.createElement('textarea');
        textarea.className = 'patch-ai-textarea';
        textarea.placeholder = ensureEvalText(data.placeholder) || 'Escribe aqui tu respuesta.';
        textarea.spellcheck = true;
        textarea.autocomplete = 'off';
        textarea.autocapitalize = 'sentences';
        textarea.setAttribute('autocorrect', 'on');
        textarea.value = previousStudentText;
        form.appendChild(textarea);

        const submitButton = document.createElement('button');
        submitButton.type = 'submit';
        submitButton.className = 'eval-submit';
        submitButton.textContent = previousSubmission && allowEdit
          ? 'Reevaluar respuesta'
