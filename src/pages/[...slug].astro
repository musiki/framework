---
export const prerender = false;

import { getCollection, getEntry, render } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Ribbon from '../components/Ribbon.astro';
import GraphModal from '../components/GraphModal.astro';
import Search from '../components/Search.astro';
import RecursosEditor from '../components/course/RecursosEditor.astro';
import CoursePodWorkspace from '../components/course/CoursePodWorkspace.astro';
import WikiLayout from '../layouts/WikiLayout.astro';
import {
  getPublicContentStaticPaths,
  type PublicContentRouteProps,
} from '../lib/public-content-routes';
import { canonicalizeCourseId, getCourseAliases } from '../lib/course-alias';
import { listCourseNotes } from '../lib/notes-fs';
import {
  buildDefaultCreatePath,
  getEditableLocalRepoFile,
  isLocalContentAdminEnabled,
  resolveCourseSource,
  sanitizeRepoMarkdownPath,
  sourcePathFromFrameworkFilePath,
} from '../lib/content-admin';
import { getRepoFile, isGitHubAppConfigured } from '../lib/github-app';
import { getCourseWelcomeFields } from '../lib/dashboard/welcome-fields';
import { resolveLiveManageAccess } from '../lib/live/access';
import {
  buildCourseHref,
  buildCourseLessonHref,
  buildCourseLessonPathIndex,
  encodePathSegments,
  findLessonByCoursePath,
  getCourseEntryLegacyPath,
  getPreferredCoursePathSegment,
  isCourseLessonEntryForCourse,
} from '../lib/course-routing';
import { getCoursePageHistory } from '../lib/page-history';
import { buildPageProperties } from '../lib/page-properties';

import { getRuntimeDynamicContent, getRuntimeDynamicContentByFilePath } from '../lib/runtime-content';
import { normalizeContentSlug, getContentCanonicalSlug } from '../lib/content-slug';
import { iconFor } from '../scripts/room/recursos/icons';
import { buildGraphData } from '../scripts/build-graph-data.mjs';

const getLessonIconInfo = (lesson: any) => {
  const lessonType = String(lesson.data?.type || '').trim().toLowerCase();
  const lessonStatus = String(lesson.data?.status || '').trim().toLowerCase();
  const title = String(lesson.data?.title || '');

  if (lessonStatus === 'draft') {
    return { char: '◩', color: '#888888', isConcept: false };
  }

  let isConcept = lessonType === 'concept';
  if (!isConcept) {
    const isFromContentCollection = (lesson as any).collection === 'content';
    const entryId = String((lesson as any).id || '');
    if (isFromContentCollection || entryId.startsWith('public/')) {
      const isGlossary = lessonType === 'glossary' || entryId.includes('/glosario/') || entryId.startsWith('public/glosario/');
      const isPublicNote = lessonType === 'public-note' || lessonType === 'notes' || entryId.includes('/notes/') || entryId.startsWith('public/notes/');
      if (!isGlossary && !isPublicNote) {
        isConcept = true;
      }
    }
  }

  if (isConcept) {
    return { char: '🔷', color: '', isConcept: true };
  }
  if (title.toUpperCase().includes('MOC')) {
    return { char: '■', color: '#8e7cc3', isConcept: false };
  }
  return { char: '■', color: '#888888', isConcept: false };
};

// Forzamos SSR dinámico puro y desactivamos caché para contenido vivo
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

const rawSlug = Astro.params.slug;
if (!rawSlug) return Astro.redirect('/cursos');

// Exit early for requests with file extensions (e.g., favicon.ico, .map, etc.)
if (/\.[a-z0-9]+$/i.test(rawSlug)) {
  return new Response(null, { status: 404 });
}

const slug = rawSlug
  .split('/')
  .map((segment) => {
    try {
      return decodeURIComponent(segment);
    } catch {
      return segment;
    }
  })
  .join('/');

// Handle legacy /cursos/ prefix by redirecting to top level
if (slug.startsWith('cursos/')) {
  const newPath = slug.replace(/^cursos\//, '/');
  return Astro.redirect(newPath + Astro.url.search);
}

// Parse the slug to get course and optional path
const parts = slug.split('/');
const requestedCoursePathSegment = parts[0];
const isCourseForumPage = (parts.length === 2 && parts[1] === 'foro') || (parts.length === 1 && Astro.url.searchParams.has('board'));
const potentialCanonicalCourseId = await canonicalizeCourseId(requestedCoursePathSegment);

// Check if this is actually a course
const initialCourseIndexCandidate = potentialCanonicalCourseId
  ? await getEntry('cursos', `${potentialCanonicalCourseId}/_index`)
  : null;

const canonicalCourseId = initialCourseIndexCandidate ? potentialCanonicalCourseId : null;

let publicEntry = null;
let PublicContent = null;
let publicTitle = '';
let publicDescription = '';
let publicTags = undefined;
let publicPresentationHref = '';
let publicRouteCollection = '';
let publicRouteEntryId = '';

// Check if it's a general public content entry (like a concept or glossary)
// We check this for all paths as a fallback, but prioritize courses if canonicalCourseId matches
const allPublicPaths = await getPublicContentStaticPaths();
let normalizedRequestedSlug = normalizeContentSlug(slug);

// Manual redirect fallback for common missing slugs
if (normalizedRequestedSlug === 'objetodesonido' && !allPublicPaths.find(p => p.params.slug === 'objetodesonido')) {
   return Astro.redirect('/objetodesonidomovimiento' + Astro.url.search);
}

const lessonPathPart = parts.slice(1).join('/');
const normalizedLessonPath = normalizeContentSlug(lessonPathPart);

const routeMatch = allPublicPaths.find(p => p.params.slug === normalizedRequestedSlug)
  || (parts.length > 1 ? allPublicPaths.find(p => p.params.slug === normalizedLessonPath) : null);

if (routeMatch) {
  const route = routeMatch.props as PublicContentRouteProps;

  if (route.kind === 'redirect') {
    // Skip redirect if it would send us to the same URL (prevents infinite loops
    // when a course lesson URL like /i1/lesson matches a public-routes redirect to /i1/lesson).
    const currentPath = Astro.url.pathname;
    const normalize = (u: string) => decodeURIComponent(u).replace(/\/+/g, '/').replace(/\/$/, '');
    if (normalize(route.redirectTo) !== normalize(currentPath)) {
      return Astro.redirect(route.redirectTo);
    }
    // Same-URL redirect skipped — treat as no public route match for this path.
  } else if (!canonicalCourseId || parts.length > 1) {
    publicRouteCollection = route.collection;
    publicRouteEntryId = route.entryId;
    // @ts-ignore
    publicEntry = await getEntry(route.collection, route.entryId);
    if (publicEntry) {
       const rendered = await render(publicEntry);
       PublicContent = rendered.Content;
       publicTitle = publicEntry.data.title || publicEntry.id.split('/').pop()?.replace(/\.[^/.]+$/, '') || 'Untitled';
       publicDescription = publicEntry.data.summary || publicEntry.data.description || publicEntry.data.subtitle || '';
       publicTags = Array.isArray(publicEntry.data.tags)
          ? publicEntry.data.tags
          : publicEntry.data.tags
            ? String(publicEntry.data.tags).split(',').map((tag) => tag.trim()).filter(Boolean)
            : undefined;
       const rawPresentationTheme =
          (publicEntry.data as Record<string, unknown>).theme ||
          (publicEntry.data as Record<string, unknown>).slideTheme ||
          (publicEntry.data as Record<string, unknown>).revealTheme;
       const rawRevealFlag = (publicEntry.data as Record<string, unknown>).reveal;
       const hasPresentationTheme = (typeof rawPresentationTheme === 'string' && rawPresentationTheme.trim().length > 0)
          || rawRevealFlag === true
          || rawRevealFlag === 'true';
       publicPresentationHref = (hasPresentationTheme && route.kind === 'content') ? route.presentationHref : '';
    }
  }
}

const isPublicWikiPage = Boolean(publicEntry);

// Check auth session early as it's used for course context determination
const session = (Astro.locals as any).session;
const isPublicReaderMode = isPublicWikiPage && !session;

// We need a course context for public notes if the user is logged in
// and the note belongs to an enrolled course.
const requestedCourseId = canonicalCourseId || (session && publicEntry ? (publicEntry.data as any).project : null);
const finalCanonicalCourseId = await canonicalizeCourseId(requestedCourseId);

const courseIndexCandidate = finalCanonicalCourseId
  ? await getEntry('cursos', `${finalCanonicalCourseId}/_index`)
  : null;

// Get the final course index
const courseIndex = (!isPublicWikiPage || session) ? courseIndexCandidate : null;

// If not a public wiki page and not a course, redirect to catalog
if (!isPublicWikiPage && !courseIndex) return Astro.redirect('/cursos');

const canonicalCourseIdToUse = courseIndex ? finalCanonicalCourseId : null;
const courseSlug = canonicalCourseIdToUse;
const courseData = ((courseIndex?.data || {}) as Record<string, unknown>);
const preferredCoursePathSegment = getPreferredCoursePathSegment(
  canonicalCourseIdToUse || '',
  courseIndex?.data as Record<string, unknown>
);
const courseHref = buildCourseHref(canonicalCourseIdToUse || '', courseData);


// Build lesson path index before auth redirects so legacy lesson URLs can
// canonicalize to the frontmatter slug even for anonymous access.
const allLessons = canonicalCourseIdToUse ? (await getCollection('cursos'))
  .filter((entry) => isCourseLessonEntryForCourse(entry, canonicalCourseIdToUse))
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0)) : [];

let liveNotes: any[] = [];
if (canonicalCourseIdToUse) {
  try {
    liveNotes = listCourseNotes(canonicalCourseIdToUse);
    const liveNotesMap = new Map<string, typeof liveNotes[0]>();
    for (const note of liveNotes) {
      const rel = note.slug.replace(/^cursos\//, '').replace(/\\/g, '/');
      liveNotesMap.set(rel, note);
    }

    for (const lesson of allLessons) {
      const filePath = (lesson as any).filePath;
      let rel = '';
      if (filePath) {
        const match = filePath.replace(/\\/g, '/').match(/(?:^|\/)src\/content\/cursos\/(.+)$/);
        if (match) rel = match[1];
      } else {
        rel = lesson.id.replace(/\\/g, '/');
      }
      if (rel) {
        const match = liveNotesMap.get(rel) || liveNotesMap.get(rel + '.md') || liveNotesMap.get(rel.replace(/\.md$/, ''));
        if (match) {
          lesson.data.order = match.order;
          if (match.chapter) lesson.data.chapter = match.chapter;
          lesson.data.title = match.title;
          lesson.data.status = match.status;
        }
      }
    }
    // Re-sort lessons by updated live order values
    allLessons.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
  } catch (err) {
    console.error('[slug] failed to override lesson metadata with live notes:', err);
  }
}

const lessonPathIndex = canonicalCourseIdToUse ? buildCourseLessonPathIndex(
  canonicalCourseIdToUse,
  courseData,
  allLessons,
) : { coursePathSegment: '', entryByLegacyPath: new Map(), entryByShortPath: new Map(), entryByAliasPath: new Map(), pathByEntryId: new Map() };

const requestedLessonPath = parts.slice(1).join('/');
const preAuthLessonMatch =
  parts.length > 1 && !isCourseForumPage
    ? findLessonByCoursePath(requestedLessonPath, lessonPathIndex)
    : null;
const preAuthCanonicalLessonPath = preAuthLessonMatch?.shortPath || '';
const preAuthCourseRedirect =
  requestedCoursePathSegment !== preferredCoursePathSegment
    ? `${courseHref}${isCourseForumPage ? '/foro' : ''}${Astro.url.search}`
    : '';
const preAuthLessonRedirect =
  preAuthLessonMatch && (
    requestedCoursePathSegment !== preferredCoursePathSegment
    || requestedLessonPath !== preAuthCanonicalLessonPath
  )
    ? `${courseHref}/${encodePathSegments(preAuthCanonicalLessonPath)}${Astro.url.search}`
    : '';

const loginRedirectTarget =
  preAuthLessonRedirect
  || preAuthCourseRedirect
  || `${Astro.url.pathname}${Astro.url.search}`;

// Check if user has base access to course.
const isPublicCourse = Boolean(courseIndex?.data?.public || isPublicWikiPage);
if (!session && !isPublicCourse) return Astro.redirect(`/login?redirect=${encodeURIComponent(loginRedirectTarget)}`);


const normalizeRole = (value: unknown) => String(value || '').trim().toLowerCase();
const normalizeForumBoardSlug = (value: unknown) => String(value || '').trim().toLowerCase() || 'general';
const courseIdAliases = await getCourseAliases(canonicalCourseIdToUse || requestedCoursePathSegment);
const liveAccess = await resolveLiveManageAccess(session, canonicalCourseIdToUse || requestedCoursePathSegment);
const sessionEnrollmentRole = String(liveAccess.enrollmentRole || '').trim();
const canManageLiveInteractions = liveAccess.canManage || normalizeRole(sessionEnrollmentRole) === 'teacher';
const hasCourseEnrollment = Boolean(sessionEnrollmentRole);

// Fetch global concepts from the 'content' collection
const globalConcepts = (await getCollection('content')).filter((entry) => {
  const type = String(entry.data.type || '').trim().toLowerCase();
  const status = String(entry.data.status || '').trim().toLowerCase();

  let isConceptOrGlossary = type.includes('concept') || type.includes('glossary');
  if (!isConceptOrGlossary && !type) {
    const entryId = String(entry.id || '');
    if (entryId.startsWith('public/')) {
      const isPublicNote = type === 'public-note' || type === 'notes' || entryId.includes('/notes/') || entryId.startsWith('public/notes/');
      if (!isPublicNote) {
        isConceptOrGlossary = true;
      }
    }
  }

  // They must be concept/glossary
  if (!isConceptOrGlossary) return false;

  // They must be public or user has teacher/live management rights
  if (!canManageLiveInteractions && status !== 'public' && status !== 'published') return false;

  // Filter by project/course
  const project = String(entry.data.project || '').trim().toLowerCase();
  const courseIdLower = (canonicalCourseIdToUse || '').toLowerCase();
  const aliasesLower = courseIdAliases.map(a => a.toLowerCase());

  return project === 'general' || project === courseIdLower || aliasesLower.includes(project);
});

if (session && canonicalCourseIdToUse && !isPublicWikiPage && !hasCourseEnrollment && !canManageLiveInteractions) {
  return Astro.redirect('/cursos');
}

// Redirect enrolled students to welcome poll if not yet completed
const isStudentEnrolled = session && hasCourseEnrollment && !canManageLiveInteractions && normalizeRole(sessionEnrollmentRole) === 'student';
const isRequestingWelcomePage = requestedLessonPath === '_welcome' || requestedLessonPath.startsWith('_welcome/');
const normalizedRequestedLessonPage = normalizeContentSlug(requestedLessonPath);
const isRecursosEditorPage =
  parts.length > 1 &&
  !isCourseForumPage &&
  ['recursos', '80-recursos', '80-recursos-recursos'].includes(normalizedRequestedLessonPage);
if (isStudentEnrolled && !isRequestingWelcomePage) {
  const welcomeEntry = allLessons.find((entry) => entry.id === `${canonicalCourseIdToUse}/_welcome`);
  if (welcomeEntry) {
    const frontmatterEvalIds = Array.isArray((welcomeEntry.data as any).welcomeEvalIds)
      ? ((welcomeEntry.data as any).welcomeEvalIds as string[]).filter(Boolean)
      : [];
    const derivedWelcomeFields = frontmatterEvalIds.length === 0
      ? await getCourseWelcomeFields(canonicalCourseIdToUse)
      : [];
    const welcomeEvalIds = frontmatterEvalIds.length > 0
      ? frontmatterEvalIds
      : derivedWelcomeFields.map((field) => String(field.evalId || '')).filter(Boolean);
    if (welcomeEvalIds.length > 0) {
      const { query } = await import('../lib/db/pool');
      const sessionEmail = String(session?.user?.email || '').trim().toLowerCase();
      if (sessionEmail) {
        const { data: dbUserRows } = await query(
          `SELECT id FROM "User" WHERE "email" ILIKE $1`,
          [sessionEmail]
        );
        const dbUserForWelcome = dbUserRows?.[0];
        if (dbUserForWelcome) {
          const { data: welcomeSubs } = await query(
            `SELECT "assignmentId" FROM "Submission" 
             WHERE "userId" = $1 AND "assignmentId" = ANY($2)`,
            [dbUserForWelcome.id, welcomeEvalIds]
          );
          const submittedIds = new Set((welcomeSubs || []).map((s: any) => String(s.assignmentId)));
          const allCompleted = welcomeEvalIds.every((id) => submittedIds.has(id));
          if (!allCompleted) {
            return Astro.redirect(`${courseHref}/_welcome`);
          }
        }
      }
    }
  }
}

const conceptGlossaryTypes = new Set(['concept', 'glossary', 'notes', 'public-note']);

const conceptsAndGlossary = [
  ...allLessons.filter((l) => {
    const type = String(l.data.type || '').trim().toLowerCase();
    if (!conceptGlossaryTypes.has(type)) return false;

    if (canManageLiveInteractions) return true;

    const status = String(l.data.status || '').trim().toLowerCase();
    return status === 'published' || status === 'public';
  }),
  ...globalConcepts
];

const sidebarLessons = canManageLiveInteractions
  ? allLessons.filter(l => !conceptGlossaryTypes.has(String(l.data.type || '').trim().toLowerCase()))
  : allLessons.filter((l) => {
      const type = String(l.data.type || '').trim().toLowerCase();
      if (conceptGlossaryTypes.has(type)) return false;
      const status = String(l.data.status || '').trim().toLowerCase();
      if (status !== 'published' && status !== 'public') return false;
      // Info type is only visible to logged-in users
      if (type === 'info' && !session) return false;
      return true;
    });

// Group lessons by chapter
const chapters = sidebarLessons.reduce((acc, lesson) => {
  const chapter = lesson.data.chapter || 'general';
  if (!acc[chapter]) acc[chapter] = [];
  acc[chapter].push(lesson);
  return acc;
}, {} as Record<string, typeof allLessons>);

// Group concepts and glossary by chapter as well
conceptsAndGlossary.forEach((lesson) => {
  let chapter = lesson.data.chapter;
  if (!chapter) {
    const isFromContentCollection = (lesson as any).collection === 'content';
    const entryId = String((lesson as any).id || '');
    const type = String(lesson.data.type || '').trim().toLowerCase();

    const isGlossary = type === 'glossary' || entryId.includes('/glosario/') || entryId.startsWith('public/glosario/');
    const isPublicNote = type === 'public-note' || type === 'notes' || entryId.includes('/notes/') || entryId.startsWith('public/notes/');

    if (isGlossary) {
      chapter = '71 GLOSARIO';
    } else if (isPublicNote) {
      chapter = '72 NOTAS PÚBLICAS';
    } else if (isFromContentCollection || entryId.startsWith('public/') || type === 'concept') {
      chapter = '70 CONCEPTOS';
    } else {
      chapter = '79 OTROS';
    }
  }

  if (!chapters[chapter]) chapters[chapter] = [];
  chapters[chapter].push(lesson);
});

// Ensure virtual chapters are present in chapters
if (!chapters['80 RECURSOS']) {
  chapters['80 RECURSOS'] = [];
}
if (session && !chapters['90 NOTAS']) {
  chapters['90 NOTAS'] = [];
}

const sortedChapters = Object.entries(chapters).sort(([leftChapter, leftLessons], [rightChapter, rightLessons]) => {
  const getMinOrder = (name: string, lessons: typeof allLessons) => {
    const matchDigits = name.trim().match(/^(\d+)/);
    const fallbackFromTitle = matchDigits ? parseInt(matchDigits[1], 10) : null;

    const isSystemOrGlobal = (fallbackFromTitle !== null && fallbackFromTitle >= 70) ||
                             name.toUpperCase().includes('RECURSOS') ||
                             name.toUpperCase().includes('NOTAS') ||
                             (lessons.length > 0 && lessons.every(l => l.data.order === 0));
    if (isSystemOrGlobal && fallbackFromTitle !== null) {
      return fallbackFromTitle;
    }

    const liveNotesInChapter = liveNotes.filter(n => n.chapter?.trim().toUpperCase() === name.trim().toUpperCase());
    if (liveNotesInChapter.length > 0) {
      return Math.min(...liveNotesInChapter.map(n => n.order));
    }
    if (lessons.length > 0) {
      const orders = lessons.map(l => l.data.order).filter((o): o is number => typeof o === 'number');
      if (orders.length > 0) {
        return Math.min(...orders);
      }
      if (fallbackFromTitle !== null) {
        return fallbackFromTitle;
      }
      return 0;
    }
    const nameUpper = name.toUpperCase();
    if (nameUpper.includes('RECURSOS')) return 80;
    if (nameUpper.includes('NOTAS')) return 90;
    if (fallbackFromTitle !== null) return fallbackFromTitle;
    return 9999;
  };
  const leftMin = getMinOrder(leftChapter, leftLessons);
  const rightMin = getMinOrder(rightChapter, rightLessons);
  if (leftMin !== rightMin) return leftMin - rightMin;

  const leftIsPublic = /^9\d/.test(leftChapter);
  const rightIsPublic = /^9\d/.test(rightChapter);
  if (leftIsPublic && !rightIsPublic) return 1;
  if (!leftIsPublic && rightIsPublic) return -1;

  return leftChapter
    .replace(/-/g, ' ')
    .localeCompare(rightChapter.replace(/-/g, ' '), 'es', { sensitivity: 'base' });
});

const sidebarChapterEntries: Array<
  | { kind: 'chapter'; chapterName: string; lessons: typeof allLessons }
  | { kind: 'recursos' }
  | { kind: 'notas'; courseId: string }
> = [];
let insertedRecursosSidebarEntry = false;
let insertedNotasSidebarEntry = false;
for (const [chapterName, lessons] of sortedChapters) {
  const slug = normalizeContentSlug(chapterName);
  if (slug === '80-recursos') {
    sidebarChapterEntries.push({ kind: 'recursos' });
    insertedRecursosSidebarEntry = true;
  } else if (slug === '90-notas') {
    if (session && canonicalCourseIdToUse) {
      sidebarChapterEntries.push({ kind: 'notas', courseId: canonicalCourseIdToUse });
      insertedNotasSidebarEntry = true;
    }
  } else {
    sidebarChapterEntries.push({ kind: 'chapter', chapterName, lessons });
  }
}
if (!insertedRecursosSidebarEntry) {
  sidebarChapterEntries.push({ kind: 'recursos' });
}
if (!insertedNotasSidebarEntry && session && canonicalCourseIdToUse) {
  sidebarChapterEntries.push({ kind: 'notas', courseId: canonicalCourseIdToUse });
}

const recursosCourseId = canonicalCourseIdToUse || courseSlug || '';
const recursosClassOptionSeen = new Set<string>();
const recursosClassOptions = sortedChapters
  .map(([chapterName]) => {
    const chapterSlug = normalizeContentSlug(chapterName);
    if (!recursosCourseId || !chapterSlug || chapterSlug === '80-recursos' || /^9\d/.test(chapterName)) {
      return null;
    }
    const value = `${recursosCourseId}/${chapterSlug}`;
    if (recursosClassOptionSeen.has(value)) return null;
    recursosClassOptionSeen.add(value);
    return {
      value,
      label: chapterName.replace(/-/g, ' '),
    };
  })
  .filter(Boolean) as Array<{ value: string; label: string }>;

let recursosSidebarGroups: Array<{
  session: { id: string; name: string; claseId: string | null } | null;
  resources: Array<{ id: string; url: string; name: string; type: string; folder: string | null }>;
}> = [];

if (session && recursosCourseId) {
  try {
    const { query } = await import('../lib/db/pool');
    const stageRoomName = `${recursosCourseId}-stage`;
    const [{ data: sessionRows }, { data: resourceRows }] = await Promise.all([
      query(
        `SELECT id, name, "claseId"
           FROM "ResourceSession"
          WHERE "roomName" = $1
             OR "courseId" = $2
             OR "claseId" = $2
             OR "claseId" LIKE $3
          ORDER BY "createdAt" DESC
          LIMIT 50`,
        [stageRoomName, recursosCourseId, `${recursosCourseId}/%`],
      ),
      query(
        `SELECT id, "sessionId", url, name, type, folder
           FROM "LiveClassResource"
          WHERE "claseId" = $1
             OR "claseId" LIKE $2
             OR "roomName" = $3
          ORDER BY "roomName" ASC, "claseId" ASC NULLS FIRST, folder ASC, "sortOrder" ASC, "createdAt" ASC
          LIMIT 200`,
        [recursosCourseId, `${recursosCourseId}/%`, stageRoomName],
      ),
    ]);
    const resourcesBySession = new Map<string, any[]>();
    for (const resource of resourceRows ?? []) {
      const key = String((resource as any).sessionId || '');
      if (!resourcesBySession.has(key)) resourcesBySession.set(key, []);
      resourcesBySession.get(key)!.push(resource as any);
    }
    const knownSessionIds = new Set((sessionRows ?? []).map((row: any) => String(row.id || '')));
    const orphanGroups = [...resourcesBySession.keys()]
      .filter((sessionId) => sessionId && !knownSessionIds.has(sessionId))
      .map((sessionId) => ({
        session: { id: sessionId, name: `Sesión ${sessionId.slice(0, 8)}`, claseId: null },
        resources: resourcesBySession.get(sessionId) ?? [],
      }));
    recursosSidebarGroups = [
      ...(sessionRows ?? []).map((row: any) => ({
        session: {
          id: String(row.id || ''),
          name: String(row.name || 'Sesión'),
          claseId: row.claseId == null ? null : String(row.claseId),
        },
        resources: resourcesBySession.get(String(row.id || '')) ?? [],
      })),
      ...orphanGroups,
      ...((resourcesBySession.get('') ?? []).length
        ? [{ session: null, resources: resourcesBySession.get('') ?? [] }]
        : []),
    ].sort((a, b) =>
      String(a.session?.name || 'Sin sesión').localeCompare(String(b.session?.name || 'Sin sesión'), 'es', {
        sensitivity: 'base',
        numeric: true,
      })
    );
  } catch (error) {
    console.error('[recursos-sidebar] failed to load resources', error);
  }
}

// Group a session's resources into root items + named folder buckets
function groupByFolder(resources: Array<{ id: string; url: string; name: string; type: string; folder: string | null }>) {
  const byName = (a: { name?: string | null }, b: { name?: string | null }) =>
    String(a.name || '').localeCompare(String(b.name || ''), 'es', { sensitivity: 'base', numeric: true });
  const root: typeof resources = [];
  const folders = new Map<string, typeof resources>();
  for (const r of resources) {
    const f = r.folder?.trim() || '';
    if (!f) { root.push(r); continue; }
    if (!folders.has(f)) folders.set(f, []);
    folders.get(f)!.push(r);
  }
  root.sort(byName);
  const sortedFolders = new Map<string, typeof resources>();
  for (const [name, items] of [...folders.entries()].sort(([a], [b]) => a.localeCompare(b, 'es', { sensitivity: 'base', numeric: true }))) {
    sortedFolders.set(name, items.sort(byName));
  }
  return { root, folders: sortedFolders };
}

function recursosLegacyFolderId(courseId: string, sessionId: string | null | undefined, folderName: string) {
  return `legacy-folder:${courseId}:${sessionId || 'root'}:${folderName}`;
}

// Group concepts and glossary by project and parent
