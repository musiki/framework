      .class-toc-link.level-2 {
        padding-left: 0.6rem;
      }

      .class-toc-link.level-3 {
        padding-left: 1.2rem;
      }

      .class-toc-link.level-4 {
        padding-left: 1.8rem;
      }

      .class-toc-link.level-5 {
        padding-left: 2.4rem;
      }

      .class-toc-link.level-6 {
