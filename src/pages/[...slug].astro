      /* ── new-thread bottom bar / reply bar ── */
      .forum-new-thread-bar {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.55rem 0.5rem;
        background: color-mix(in srgb, var(--c-bg, #fff) 94%, var(--c-bg-mute, #eee) 6%);
        border-top: 1px solid color-mix(in srgb, var(--forum-border-soft, #d9e0e7) 35%, transparent);
      }

      .sidebar--right .forum-new-thread-bar {
        margin:
          0.4rem
          calc(-1 * var(--course-sidebar-pad-x))
          calc(-1 * var(--course-sidebar-pad-bottom));
        padding: 15px 0.55rem 0.5rem;
      }
      .forum-reply-bar { border-top: none; padding: 0.3rem 0.45rem 0.4rem; }

      .forum-plus-wrap { position: relative; flex-shrink: 0; }

      .forum-plus-btn {
        width: 1.8rem; height: 1.8rem;
        border: none; background: none;
        color: var(--forum-text-secondary, #6b7480);
        cursor: pointer; display: flex; align-items: center; justify-content: center;
        border-radius: 50%; padding: 0;
        transition: color 120ms, background 120ms;
      }
      .forum-plus-btn:hover { color: var(--forum-text-primary, #1c1f23); background: rgba(0,0,0,0.06); }
      .forum-plus-btn[aria-expanded="true"] { color: var(--forum-accent, #2f6fff); }

      .forum-plus-popup {
        position: absolute; bottom: calc(100% + 0.4rem); left: 0;
        padding: 0.4rem 0.45rem;
        background: var(--c-bg, #fff);
        border-radius: 10px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.18);
        z-index: 60; min-width: 2.6rem;
        overflow: visible;
      }
      .forum-plus-popup-actions { display: flex; flex-direction: column; gap: 0.22rem; align-items: center; }

      /* tooltips for popup actions emerge to the right, not above (avoids vertical clipping) */
      .forum-plus-popup-actions .forum-action-btn::after {
        left: calc(100% + 0.5rem) !important;
        right: auto !important;
        bottom: auto !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
      }
      .forum-plus-popup-actions .forum-action-btn:hover::after,
      .forum-plus-popup-actions .forum-action-btn:focus-visible::after {
        opacity: 1 !important;
        transform: translateY(-50%) !important;
      }

      .forum-new-thread-form { flex: 1; display: flex; align-items: center; gap: 0.35rem; min-width: 0; }
      .forum-new-thread-editor { flex: 1; min-width: 0; position: relative; }
      .forum-reply-editor { flex: 1; min-width: 0; position: relative; }

      /* ── send button — violet/lila ── */
      .forum-send-btn {
        flex-shrink: 0; width: 1.95rem; height: 1.95rem; min-width: 1.95rem;
        border: none; border-radius: 50%;
        background: rgba(139, 92, 246, 0.5); color: #fff;
        display: inline-flex; align-items: center; justify-content: center;
        cursor: pointer; transition: background 120ms; padding: 0;
      }
      .forum-send-btn:hover { background: rgba(139, 92, 246, 0.82); }
      .forum-send-btn:disabled { opacity: 0.35; cursor: not-allowed; }

      /* ── auto-grow textarea ── */
      .forum-textarea--autogrow {
        resize: none; overflow-y: hidden;
