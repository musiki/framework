      :global(#course-forum-subnav .forum-switcher-link:focus-visible) {
        border-color: var(--forum-switcher-border-color);
        background: var(--forum-switcher-bg-hover);
        outline: none;
      }

      :global(#course-forum-subnav .forum-switcher-link.active) {
        border-color: var(--forum-switcher-border-color);
        background: var(--forum-switcher-bg-active);
        color: var(--forum-text-primary) !important;
        box-shadow: none;
      }

      :global(#course-forum-subnav .forum-switcher-link.is-disabled) {
        opacity: 0.42;
        pointer-events: none;
      }

      :global(#course-forum-subnav .forum-switcher-mark) {
        display: inline-flex;
        align-items: flex-start;
        justify-content: center;
        font-size: 0.92rem;
        font-weight: 700;
