        border: 1px solid var(--c-border);
        border-radius: 8px;
        background: var(--c-bg);
        overflow: hidden;
      }
      .poll-block {
        border-style: solid;
      }
      .form-msq-form,
      .form-text-form {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 0.75rem;
      }
      .form-msq-option {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        font-size: 0.95rem;
      }
      .form-text-input {
        padding: 0.4rem 0.65rem;
        border: 1px solid var(--c-border, #ccc);
        border-radius: 4px;
        font-size: 0.95rem;
        background: var(--c-bg, #fff);
        color: var(--c-fg, #222);
        width: min(100%, 36ch);
      }
      .poll-status {
        margin: 0.25rem 0 0;
        color: var(--c-fg-dim);
