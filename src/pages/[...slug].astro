const getForumSwitcherColor = (index: number) => forumSwitcherPalette[((index % forumSwitcherPalette.length) + forumSwitcherPalette.length) % forumSwitcherPalette.length];
const getForumSwitcherMarkParts = (value: unknown) => {
  const normalized = String(value || '').trim().replace(/\s+/g, ' ');
  if (!normalized) {
