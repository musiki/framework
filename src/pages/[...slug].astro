          threadBodyInput.placeholder = 'Nuevo hilo… (primera línea = título)';
        }

        function setReplyTarget(threadId, postId, authorName) {
          forumState.selectedThreadId = threadId;
          parentPostInput.value = postId;
          if (replyAuthorNameEl) replyAuthorNameEl.textContent = authorName || 'usuario';
          replyIndicatorEl.hidden = false;
          threadBodyInput.placeholder = `Responder a ${authorName || 'usuario'}...`;
          threadBodyInput.focus();
        }

        function updateReplyFormVisibility(canReply) {
          if (!forumState.selectedThreadId || !canReply) {
            clearReplyTarget();
          }
        }

        function renderThreadList() {
          if (forumState.selectedThreadId && !forumState.threads.some((thread) => thread.id === forumState.selectedThreadId)) {
            forumState.selectedThreadId = '';
          }

          threadListEl.innerHTML = '';

          if (forumState.threads.length === 0) {
            const empty = document.createElement('p');
            empty.className = 'forum-empty';
            empty.textContent = forumState.mode === 'board'
              ? 'Todavía no hay hilos en este foro.'
              : 'Todavía no hay hilos en esta lección.';
            threadListEl.appendChild(empty);
            return;
          }

          forumState.threads.forEach((thread) => {
            const threadId = String(thread.id || '').trim();
            const isSelected = thread.id === forumState.selectedThreadId;
            const isOpen = forumState.openThreadIds.has(threadId);

            const item = document.createElement('article');
            item.className = 'forum-thread-item';
            if (isSelected) item.classList.add('active');

            const toggle = document.createElement('button');
            toggle.type = 'button';
            toggle.className = 'forum-thread-toggle';
            toggle.dataset.threadId = threadId;
            toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

            const top = document.createElement('div');
            top.className = 'forum-thread-top';

            const title = document.createElement('span');
            title.className = 'forum-thread-title';
            const titleLabel = document.createElement('span');
            titleLabel.className = 'forum-thread-title-label';
            titleLabel.textContent = thread.title || 'Sin título';
            title.appendChild(titleLabel);

            if (thread.isPinned) {
              const pinIndicator = document.createElement('span');
              pinIndicator.className = 'forum-thread-pin-indicator';
              pinIndicator.title = 'Hilo fijado';
              pinIndicator.setAttribute('aria-hidden', 'true');
              title.prepend(pinIndicator);
              item.classList.add('is-thread-pinned');
            }

            const messageCount = Number.isFinite(thread.messageCount)
              ? Math.max(0, Number(thread.messageCount))
              : (Number.isFinite(thread.postCount) ? Math.max(0, Number(thread.postCount)) : 0);
            const replyCount = Number.isFinite(thread.replyCount)
              ? Math.max(0, Number(thread.replyCount))
              : Math.max(messageCount - 1, 0);

            const caret = document.createElement('span');
            caret.className = 'forum-thread-caret';
            caret.textContent = isOpen ? '▾' : '▸';

            const counts = document.createElement('span');
            counts.className = 'forum-thread-counts';

            const messageChip = document.createElement('span');
            messageChip.className = 'forum-thread-count forum-thread-count-messages';
            messageChip.textContent = String(messageCount);
            messageChip.dataset.tooltip = 'mensajes';
            messageChip.title = 'mensajes';
            counts.appendChild(messageChip);

            const replyChip = document.createElement('span');
            replyChip.className = 'forum-thread-count forum-thread-count-replies';
            replyChip.textContent = String(replyCount);
            replyChip.dataset.tooltip = 'respuestas';
            replyChip.title = 'respuestas';
            counts.appendChild(replyChip);

            const trailing = document.createElement('span');
            trailing.className = 'forum-thread-trailing';

            top.appendChild(title);
            top.appendChild(trailing);

            const meta = document.createElement('div');
            meta.className = 'forum-thread-meta';
            const lastActivity = formatForumDate(thread.lastActivityAt || thread.updatedAt || thread.createdAt);
            const author = document.createElement('span');
            author.className = 'forum-thread-author';
            author.textContent = thread.createdByName || 'Usuario';
            const stats = document.createElement('span');
            stats.className = 'forum-thread-date';
            stats.textContent = lastActivity;
            meta.appendChild(author);
            meta.appendChild(stats);

            toggle.appendChild(top);
            toggle.appendChild(meta);
            toggle.addEventListener('click', async () => {
              setThreadMenuOpen(false);
              const shouldOpen = !forumState.openThreadIds.has(threadId);
              if (shouldOpen) {
                forumState.openThreadIds.add(threadId);
                forumState.selectedThreadId = thread.id;
              } else {
                forumState.openThreadIds.delete(threadId);
                if (forumState.selectedThreadId === thread.id) {
                  forumState.selectedThreadId = Array.from(forumState.openThreadIds)[0] || '';
                }
              }
              clearReplyTarget();
              clearForumThreadPrefetchTimer();

              renderThreadList();
              if (shouldOpen) {
                setThreadLoadingState(threadId);
                await loadPosts(thread.id);
              }
            });

            const inlinePanel = document.createElement('div');
            inlinePanel.className = 'forum-thread-inline-panel';
            inlinePanel.hidden = !isOpen;

            const threadPostList = document.createElement('div');
            threadPostList.className = 'forum-post-list';
            threadPostList.dataset.threadId = threadId;
            inlinePanel.appendChild(threadPostList);

            if (isOpen) {
              const cachedPosts = getForumCachedPayload(forumQueryCache.posts, getForumPostsCacheKey(threadId));
              if (cachedPosts) {
                renderPosts(
                  threadPostList,
                  thread.id,
                  Array.isArray(cachedPosts?.posts) ? cachedPosts.posts : [],
                  Boolean(cachedPosts?.canReply),
                  Boolean(cachedPosts?.canVote),
                );
              } else {
                threadPostList.innerHTML = '<p class="forum-empty">Cargando mensajes...</p>';
              }
            }

            const canEditThread = Boolean(thread.canEdit);
            const canDeleteThread = Boolean(thread.canDelete);
            const canPinThread = Boolean(thread.canPin);
            /** @type {HTMLButtonElement | null} */
            let threadEditButton = null;
            /** @type {HTMLButtonElement | null} */
            let threadDeleteButton = null;
            /** @type {HTMLButtonElement | null} */
            let threadPinButton = null;
            /** @type {HTMLButtonElement | null} */
            let threadMoreButton = null;

            /** @param {boolean} isDisabled */
            const setThreadActionState = (isDisabled) => {
              if (threadMoreButton) threadMoreButton.disabled = isDisabled;
              if (threadEditButton) threadEditButton.disabled = isDisabled;
              if (threadDeleteButton) threadDeleteButton.disabled = isDisabled;
              if (threadPinButton) threadPinButton.disabled = isDisabled;
            };

            const threadActions = document.createElement('div');
            threadActions.className = 'forum-thread-actions forum-thread-actions-menu';
            threadActions.hidden = true;
            const closeSiblingThreadMenus = () => {
              threadListEl.querySelectorAll('.forum-thread-item.is-thread-menu-open').forEach((node) => {
                if (node === item) return;
                node.classList.remove('is-thread-menu-open');
                const menu = node.querySelector('.forum-thread-actions-menu');
                if (menu instanceof HTMLElement) menu.hidden = true;
              });
            };
            const setThreadMenuOpen = (isOpen) => {
              const nextState = Boolean(isOpen) && (canEditThread || canDeleteThread || canPinThread);
              if (nextState) closeSiblingThreadMenus();
              threadActions.hidden = !nextState;
              item.classList.toggle('is-thread-menu-open', nextState);
            };

            if (canEditThread || canDeleteThread || canPinThread) {
              threadMoreButton = document.createElement('button');
              threadMoreButton.type = 'button';
              threadMoreButton.className = 'forum-thread-more-btn forum-action-btn forum-action-more';
              threadMoreButton.textContent = '···';
              threadMoreButton.dataset.tooltip = 'Mas acciones';
              threadMoreButton.title = 'Mas acciones';
              threadMoreButton.setAttribute('aria-label', 'Mas acciones del hilo');
              threadMoreButton.addEventListener('click', (event) => {
                event.preventDefault();
                event.stopPropagation();
                setThreadMenuOpen(threadActions.hidden);
              });
            }

            if (canPinThread) {
              threadPinButton = document.createElement('button');
              threadPinButton.type = 'button';
              threadPinButton.className = 'forum-thread-pin-btn forum-action-btn forum-action-p';
              threadPinButton.dataset.pinned = thread.isPinned ? 'true' : 'false';
              threadPinButton.dataset.tooltip = thread.isPinned ? 'Desfijar hilo' : 'Fijar hilo';
              threadPinButton.title = thread.isPinned ? 'Desfijar hilo' : 'Fijar hilo';
              threadPinButton.setAttribute('aria-label', thread.isPinned ? 'Desfijar hilo' : 'Fijar hilo');
              const pinGlyph = document.createElement('span');
              pinGlyph.className = 'forum-thread-pin-glyph';
              pinGlyph.setAttribute('aria-hidden', 'true');
              threadPinButton.appendChild(pinGlyph);
              threadPinButton.addEventListener('click', async (event) => {
                event.preventDefault();
                event.stopPropagation();
                setThreadMenuOpen(false);

                setThreadActionState(true);
                try {
                  const response = await fetch(`/api/forum/threads/${encodeURIComponent(thread.id)}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ isPinned: !thread.isPinned }),
                  });

                  const payload = await response.json().catch(() => ({}));
                  if (!response.ok) {
                    throw new Error(payload?.error || 'No se pudo actualizar el fijado del hilo.');
                  }

                  invalidateForumThreadCache();
                  invalidateForumPostsCache(thread.id);
                  setForumStatus(thread.isPinned ? 'Hilo desfijado.' : 'Hilo fijado.', 'info');
                  await loadThreads({ preserveSelection: true });
                } catch (error) {
                  console.error('Forum thread pin error:', error);
                  setForumStatus(error?.message || 'No se pudo actualizar el fijado del hilo.', 'error');
                } finally {
                  setThreadActionState(false);
                }
              });
              threadActions.appendChild(threadPinButton);
            }

            if (canEditThread) {
              threadEditButton = document.createElement('button');
              threadEditButton.type = 'button';
              threadEditButton.className = 'forum-thread-edit-btn forum-action-btn forum-action-e';
              threadEditButton.textContent = 'E';
              threadEditButton.dataset.tooltip = 'Editar hilo';
              threadEditButton.title = 'Editar hilo';
              threadEditButton.setAttribute('aria-label', 'Editar hilo');
              threadEditButton.addEventListener('click', async (event) => {
                event.preventDefault();
                event.stopPropagation();
                setThreadMenuOpen(false);

                const nextTitle = window.prompt('Editar título del hilo', thread.title || '');
                if (nextTitle === null) return;

                const cleanedTitle = nextTitle.trim();
                if (cleanedTitle.length < 3) {
                  setForumStatus('El título del hilo debe tener al menos 3 caracteres.', 'error');
                  return;
                }

                setThreadActionState(true);
                try {
                  const response = await fetch(`/api/forum/threads/${encodeURIComponent(thread.id)}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title: cleanedTitle }),
                  });

                  const payload = await response.json().catch(() => ({}));
                  if (!response.ok) {
                    throw new Error(payload?.error || 'No se pudo editar el hilo.');
                  }

                  invalidateForumThreadCache();
                  invalidateForumPostsCache(thread.id);
                  setForumStatus('Hilo actualizado.', 'info');
                  await loadThreads({ preserveSelection: true });
                } catch (error) {
                  console.error('Forum thread edit error:', error);
                  setForumStatus(error?.message || 'No se pudo editar el hilo.', 'error');
                } finally {
                  setThreadActionState(false);
                }
              });
              threadActions.appendChild(threadEditButton);
            }

            if (canDeleteThread) {
              threadDeleteButton = document.createElement('button');
              threadDeleteButton.type = 'button';
              threadDeleteButton.className = 'forum-thread-delete-btn forum-action-btn forum-action-b';
              threadDeleteButton.textContent = 'B';
              threadDeleteButton.dataset.tooltip = 'Borrar hilo';
              threadDeleteButton.title = 'Borrar hilo';
