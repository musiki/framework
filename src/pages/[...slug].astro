        flex-direction: column;
        gap: 0.4rem;
      }

      .progress-meter {
        margin-bottom: 0.75rem;
        padding: 0.55rem 0.6rem;
        border: 1px solid var(--c-border);
        border-radius: 8px;
        background: var(--c-bg-mute);
      }

      .progress-meter[hidden] {
