      :global(.sidebar--left .recursos-sidebar-session[data-drop-target="true"] > .recursos-sidebar-session-name),
      :global(.sidebar--left .recursos-sidebar-folder[data-drop-target="true"] > .recursos-sidebar-folder-name) {
        background: color-mix(in srgb, var(--accent) 12%, transparent);
