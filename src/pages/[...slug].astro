        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: var(--c-fg-dim);
      }
      .patch-ai-card-body {
        margin: 0;
        line-height: 1.55;
      }
      .patch-ai-code {
        margin: 0;
        padding: 0.9rem;
        overflow: auto;
