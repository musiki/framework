      .feedback-message.correct {
        color: #4caf50;
      }
      .feedback-message.incorrect {
        color: #f44336;
      }
      .feedback-explanation {
        margin: 0.5rem 0 0 0;
        font-style: italic;
        color: var(--c-fg-dim);
        line-height: 1.6;
      }
      .mcc-block {
        border-style: dashed;
      }
      .mcc-summary {
        margin: 0 0 1rem 0;
        color: var(--c-fg-dim);
        line-height: 1.5;
      }
      .mcc-objectives-label {
        margin: 0.2rem 0 0.6rem;
        font-weight: 600;
      }
      .mcc-objectives {
        margin: 0 0 0.6rem 1.2rem;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }
      .mcc-submit {
        min-width: 16rem;
      }
      .patch-ai-block {
        border-style: solid;
      }
      .patch-ai-meta {
        margin: -0.3rem 0 1rem;
        color: var(--c-fg-dim);
        font-size: 0.9rem;
      }
      .patch-ai-criteria-label {
        margin: 0.2rem 0 0.4rem;
        font-weight: 600;
      }
      .patch-ai-criteria {
        margin: 0 0 1rem 1.2rem;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .patch-ai-reference {
        margin: 0.85rem 0 1rem;
        border: 1px solid var(--c-border);
        border-radius: 8px;
