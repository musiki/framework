        width: 17px;
        text-align: center;
        flex-shrink: 0;
        display: inline-block;
        line-height: 1.2rem;
      }

      :global(.lesson-icon--concept) {
        transform: scale(0.6);
        transform-origin: center;
      }

      /* Notes sidebar tree layout matching the rest of the tree */
	      :global(.sidebar--left .notas-sb-level) {
