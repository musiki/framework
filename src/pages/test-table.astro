---
import BaseHead from '../components/BaseHead.astro';
import PostgresSheet from '../components/test-table/PostgresSheet';
import { SITE_TITLE } from '../consts';
---

<html lang="es">
  <head>
    <BaseHead title={`Test table | ${SITE_TITLE}`} description="Prueba aislada de grilla tipo spreadsheet conectada a Postgres" />
    <style is:global>
      :root {
        color-scheme: light;
      }

      body {
        margin: 0;
        background: #f6f7f9;
        color: #16181d;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      main {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .test-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 18px 22px 14px;
        border-bottom: 1px solid #d8dde6;
        background: #ffffff;
      }

      .test-title {
        display: grid;
        gap: 2px;
      }

      h1 {
        margin: 0;
        font-size: 20px;
        line-height: 1.2;
        font-weight: 720;
        letter-spacing: 0;
      }

      .test-title span,
      .test-meta {
        font-size: 13px;
        color: #606977;
      }

      .test-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
      }

      .test-meta code {
        padding: 3px 6px;
        border: 1px solid #d8dde6;
        border-radius: 6px;
        background: #f6f7f9;
        color: #252a33;
      }

      .sheet-shell {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
        padding: 12px;
      }

      .sheet-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 10px;
      }

      .sheet-status {
        display: grid;
        gap: 2px;
        min-width: 220px;
      }

      .sheet-status strong {
        font-size: 14px;
        color: #20242c;
      }

      .sheet-status span {
        font-size: 12px;
        color: #667085;
      }

      .sheet-status[data-saving="true"] strong {
        color: #8a5a00;
      }

      .sheet-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
        max-width: 100%;
      }

      button {
        min-height: 32px;
        border: 1px solid #cbd2dd;
        border-radius: 7px;
        background: #ffffff;
        color: #1d2430;
        font: inherit;
        font-size: 13px;
        font-weight: 650;
        padding: 0 12px;
        cursor: pointer;
      }

      button:hover {
        border-color: #8fa0b8;
        background: #f9fafb;
      }

      .sheet-error {
        margin-bottom: 10px;
        border: 1px solid #efb6b6;
        border-radius: 7px;
        background: #fff5f5;
        color: #9d2424;
        padding: 9px 11px;
        font-size: 13px;
      }

      .handsontable {
        font-size: 13px;
      }

      @media (max-width: 900px) {
        .test-header,
        .sheet-toolbar {
          align-items: flex-start;
          flex-direction: column;
        }

        .test-meta {
          white-space: normal;
        }

        .sheet-actions {
          justify-content: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <header class="test-header">
        <div class="test-title">
          <h1>Test table</h1>
          <span>Handsontable + Postgres scratch table</span>
        </div>
        <div class="test-meta">
          <span>Ruta</span>
          <code>/test-table</code>
        </div>
      </header>

      <PostgresSheet client:only="react" />
    </main>
  </body>
</html>
