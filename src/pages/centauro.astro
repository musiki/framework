---
import BaseHead from '../components/BaseHead.astro';
import CentauroPanel from '../components/room/generators/centauro/CentauroPanel.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title="Centauro" description="Version portable de Centauro para Ableton Live" />
    <style is:global>
      html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
        background: #1e1e1e;
        color: #dcdcdc;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }

      /* Compact Ableton Layout styling */
      .conference-stage-panel--centauro {
        background: #252525 !important;
        padding: 6px !important;
        height: 100vh !important;
        box-sizing: border-box;
        overflow: hidden;
      }

      .centauro-shell {
        position: relative;
        display: flex;
        flex-direction: row !important;
        height: 100% !important;
        width: 100% !important;
        gap: 0 !important;
        overflow: hidden;
      }

      .centauro-header-controls {
        flex: 0 0 240px !important;
        width: 240px !important;
        padding: 8px !important;
        background: #2b2b2b !important;
        border-right: 1px solid #3a3a3a !important;
        gap: 6px !important;
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), margin-left 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
        z-index: 10;
        box-sizing: border-box;
      }

      /* Collapsed sidebar state */
      .sidebar-collapsed .centauro-header-controls {
        transform: translateX(-100%);
        margin-left: -240px !important;
      }

      .centauro-control-row {
        flex-direction: column !important;
        gap: 6px !important;
      }

      .centauro-field {
        min-width: 0 !important;
      }

      .centauro-action-row {
        gap: 6px !important;
      }

      .centauro-btn {
        padding: 4px 8px !important;
        font-size: 0.75rem !important;
      }

      .centauro-workspace {
        flex: 1 !important;
        min-width: 0;
        gap: 0 !important;
        height: 100% !important;
      }

      .centauro-keyboard-panel {
        flex: 1 !important;
        height: 100% !important;
        background: transparent !important;
        border: none !important;
        padding: 0 !important;
      }

      /* Hide table in compact Ableton rack view */
      .centauro-info-panel {
        display: none !important;
      }

      #centauro-fullscreen-btn {
        position: fixed;
        right: 8px;
        top: 8px;
        z-index: 20;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #2b2b2b;
        border: 1px solid #3a3a3a;
        color: #dcdcdc;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        transition: background 0.15s ease, color 0.15s ease;
        outline: none;
      }

      #centauro-fullscreen-btn:hover {
        background: #3a3a3a;
        color: #fff;
      }

      /* Virtual Fullscreen fallback styling optimized for mobile Safari & iOS iPad landscape */
      html.virtual-fullscreen, html.virtual-fullscreen body {
        overflow: hidden !important;
        position: fixed !important;
        width: 100vw !important;
        height: 100vh !important;
        height: 100dvh !important;
        top: 0 !important;
        left: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        z-index: 999999 !important;
        touch-action: none;
        -webkit-overflow-scrolling: touch;
      }

      html.virtual-fullscreen .conference-stage-panel--centauro {
        width: 100vw !important;
        height: 100vh !important;
        height: 100dvh !important;
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        z-index: 999999 !important;
      }
    </style>
  </head>
  <body class="centauro-standalone">
    <!-- Fullscreen Toggle Button -->
    <button type="button" id="centauro-fullscreen-btn" title="Pantalla Completa (o Doble toque en el teclado)">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
      </svg>
    </button>

    <CentauroPanel />

    <script>
      import { CentauroController } from '../scripts/room/centauro/CentauroController';
      import screenfull from 'screenfull';

      function init() {
        const podContainer = document.querySelector('.musiki-pod[data-pod="centauro"]') as HTMLElement;
        if (podContainer) {
          new CentauroController({ container: podContainer });
        }

        // Close sidebar handler
        const closeBtn = document.querySelector('[data-centauro-sidebar-close]');
        if (closeBtn) {
          closeBtn.addEventListener('click', () => {
            document.body.classList.add('sidebar-collapsed');
          });
        }

        // Open sidebar handler
        const openBtn = document.querySelector('[data-centauro-sidebar-open]');
        if (openBtn) {
          openBtn.addEventListener('click', () => {
            document.body.classList.remove('sidebar-collapsed');
          });
        }

        // Fullscreen Toggle using screenfull library + virtual-fullscreen fallback
        const fullscreenBtn = document.getElementById('centauro-fullscreen-btn');
        const docEl = document.documentElement;

        const toggleFullscreen = () => {
          if (screenfull && screenfull.isEnabled) {
            if (screenfull.isFullscreen) {
              screenfull.exit().catch(() => {});
              docEl.classList.remove('virtual-fullscreen');
            } else {
              screenfull.request().catch((err: any) => {
                console.warn('screenfull request failed, falling back to pseudo-fullscreen', err);
                docEl.classList.toggle('virtual-fullscreen');
              });
            }
          } else {
            docEl.classList.toggle('virtual-fullscreen');
          }
        };

        if (fullscreenBtn) {
          fullscreenBtn.addEventListener('click', toggleFullscreen);
        }

        // Listen for fullscreen change to sync virtual-fullscreen class
        if (screenfull && screenfull.isEnabled) {
          screenfull.on('change', () => {
            if (!screenfull.isFullscreen) {
              docEl.classList.remove('virtual-fullscreen');
            }
          });
        }

        // Double click / Double tap on keyboard to trigger fullscreen
        const keyboardWrapper = document.querySelector('[data-centauro-keyboard-wrapper]');
        if (keyboardWrapper) {
          let lastTap = 0;
          keyboardWrapper.addEventListener('touchend', (e) => {
            const currentTime = new Date().getTime();
            const tapLength = currentTime - lastTap;
            if (tapLength < 300 && tapLength > 0) {
              e.preventDefault();
              toggleFullscreen();
            }
            lastTap = currentTime;
          });

          keyboardWrapper.addEventListener('dblclick', (e) => {
            e.preventDefault();
            toggleFullscreen();
          });
        }
      }

      document.addEventListener('DOMContentLoaded', init);
      init(); // fallback
    </script>
  </body>
</html>
