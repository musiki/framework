---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { createSupabaseServerClient, ensureDbUserFromSession } from '../lib/forum-server';
import { canonicalizeCourseId } from '../lib/course-alias';
import { safeGetCollection } from '../lib/safe-content-collection';
import 'tabulator-tables/dist/css/tabulator.min.css';

const session = Astro.locals.session as any;
if (!session?.user?.email) {
  return Astro.redirect('/login?redirect=/editExperiment');
}

const supabase = createSupabaseServerClient({ requireServiceRole: true });
const dbUser = await ensureDbUserFromSession(supabase, session);
if (!dbUser?.id) {
  return Astro.redirect('/login?redirect=/editExperiment');
}

const normalizeText = (value: unknown) => String(value || '').trim();
const normalizeRole = (value: unknown) => normalizeText(value).toLowerCase();
const currentYear = String(new Date().getFullYear());

const teacherEnrollmentsQuery = await supabase
  .from('Enrollment')
  .select('id, courseId, roleInCourse')
  .eq('userId', dbUser.id);

if (teacherEnrollmentsQuery.error) {
  throw teacherEnrollmentsQuery.error;
}

const teacherCourseIds = Array.from(
  new Set(
    (
      await Promise.all(
        (teacherEnrollmentsQuery.data || [])
          .filter((enrollment: any) => normalizeRole(enrollment?.roleInCourse) === 'teacher')
          .map((enrollment: any) => canonicalizeCourseId(enrollment?.courseId)),
      )
    ).filter(Boolean),
  ),
);

const requestedUrl = new URL(Astro.request.url);
const requestedCourseId = await canonicalizeCourseId(requestedUrl.searchParams.get('course') || '');
const requestedYear = normalizeText(requestedUrl.searchParams.get('year') || '');
const selectedCourseId = teacherCourseIds.includes(requestedCourseId)
  ? requestedCourseId
  : String(teacherCourseIds[0] || '');
const selectedYear = /^\d{4}$/.test(requestedYear) ? requestedYear : currentYear;

const courseEntries = await safeGetCollection<any>('cursos');
const courseTitleById = new Map<string, string>();
courseEntries.forEach((entry: any) => {
  const entryId = normalizeText(entry?.id || '');
  if (!entryId.endsWith('/_index')) return;
  const courseId = entryId.split('/')[0] || '';
  if (!courseId) return;
  courseTitleById.set(courseId, normalizeText(entry?.data?.title || courseId) || courseId);
});

const availableCourses = teacherCourseIds.map((courseId) => ({
  courseId,
  title: courseTitleById.get(courseId) || courseId,
}));

const rows: Array<Record<string, unknown>> = [];

if (selectedCourseId) {
  const [courseEnrollmentsQuery, metaSubmissionsQuery] = await Promise.all([
    supabase
      .from('Enrollment')
      .select('id, userId, courseId, roleInCourse')
      .eq('courseId', selectedCourseId),
    supabase
      .from('Submission')
      .select('id, userId, assignmentId, payload, submittedAt')
      .eq('assignmentId', `__meta__:course-student-profile:${encodeURIComponent(selectedCourseId)}:${selectedYear}`)
      .order('submittedAt', { ascending: false }),
  ]);

  if (courseEnrollmentsQuery.error) throw courseEnrollmentsQuery.error;
  if (metaSubmissionsQuery.error) throw metaSubmissionsQuery.error;

  const courseEnrollments = courseEnrollmentsQuery.data || [];
  const userIds = Array.from(new Set(courseEnrollments.map((enrollment: any) => normalizeText(enrollment?.userId)).filter(Boolean)));

  const usersQuery = userIds.length > 0
    ? await supabase
        .from('User')
        .select('id, name, email, role')
        .in('id', userIds)
    : { data: [], error: null };

  if (usersQuery.error) throw usersQuery.error;

  const usersById = new Map(
    (usersQuery.data || []).map((user: any) => [normalizeText(user?.id), user]),
  );

  const metaByStudentId = new Map<string, Record<string, any>>();
  (metaSubmissionsQuery.data || []).forEach((submission: any) => {
    const studentId = normalizeText(submission?.userId);
    if (!studentId || metaByStudentId.has(studentId)) return;
    const payload =
      submission?.payload && typeof submission.payload === 'object' && !Array.isArray(submission.payload)
        ? submission.payload
        : {};
    metaByStudentId.set(studentId, payload);
  });

  rows.push(
    ...courseEnrollments.map((enrollment: any) => {
      const userId = normalizeText(enrollment?.userId);
      const user = usersById.get(userId) || {};
      const meta = metaByStudentId.get(userId) || {};
      const name = normalizeText(user?.name || user?.email || '—');
      const nameParts = name.split(/\s+/).filter(Boolean);
      const firstName = nameParts[0] || name;
      const lastName = nameParts.length > 1 ? nameParts.slice(1).join(' ') : '';
      const courseRole = normalizeRole(enrollment?.roleInCourse || 'student') || 'student';

      return {
        id: normalizeText(enrollment?.id || userId),
        enrollmentId: normalizeText(enrollment?.id || ''),
        studentId: userId,
        firstName,
        lastName,
        email: normalizeText(user?.email || ''),
        globalRole: normalizeRole(user?.role || 'student') || 'student',
        courseRole,
        turno: normalizeText(meta?.turno || ''),
        notes: normalizeText(meta?.notes || ''),
        canEditStudentMeta: courseRole !== 'teacher',
      };
    }),
  );

  rows.sort((left, right) => {
    const leftLast = normalizeText(left.lastName || left.firstName || '');
    const rightLast = normalizeText(right.lastName || right.firstName || '');
    const lastDiff = leftLast.localeCompare(rightLast, 'es');
    if (lastDiff !== 0) return lastDiff;
    return normalizeText(left.firstName || '').localeCompare(normalizeText(right.firstName || ''), 'es');
  });
}

const pageTitle = 'Edit Experiment';
const pageDescription = 'Banco de pruebas para editores nativos de Tabulator con persistencia real.';
const editExperimentPayload = encodeURIComponent(
  JSON.stringify({
    rows,
    courseId: selectedCourseId,
    year: selectedYear,
  }),
);
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <style>
      :root {
        --edit-shell-bg: color-mix(in srgb, var(--c-bg) 98%, var(--c-fg) 2%);
        --edit-shell-border: color-mix(in srgb, var(--c-fg) 12%, transparent);
        --edit-muted: color-mix(in srgb, var(--c-fg) 60%, transparent);
        --edit-ok: #0f8a4b;
        --edit-error: #b73838;
        --edit-warn: #a36a00;
      }

      :root.dark {
        --edit-shell-bg: color-mix(in srgb, var(--c-bg) 94%, white 6%);
        --edit-shell-border: color-mix(in srgb, white 12%, transparent);
        --edit-muted: color-mix(in srgb, white 55%, transparent);
        --edit-ok: #6dd79a;
        --edit-error: #ff8a8a;
        --edit-warn: #f3c76a;
      }

      .edit-page {
        width: min(100%, 1680px);
        margin: 0 auto;
        padding: 0.9rem;
      }

      .edit-shell {
        display: grid;
        gap: 0.8rem;
        background: var(--edit-shell-bg);
        border: 1px solid var(--edit-shell-border);
        border-radius: 18px;
        padding: 0.85rem;
      }

      .edit-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        align-items: end;
      }

      .edit-field {
        display: grid;
        gap: 0.25rem;
        min-width: 12rem;
      }

      .edit-field--year {
        min-width: 7.5rem;
      }

      .edit-field label {
        font-size: 0.74rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--edit-muted);
      }

      .edit-field select,
      .edit-field input,
      .edit-apply-btn {
        min-height: 2.25rem;
        border-radius: 10px;
        border: 1px solid var(--edit-shell-border);
        background: var(--c-bg);
        color: var(--c-fg);
        padding: 0 0.75rem;
        font: inherit;
      }

      .edit-apply-btn {
        cursor: pointer;
        font-weight: 600;
      }

      .edit-copy {
        margin: 0;
        color: var(--edit-muted);
        font-size: 0.95rem;
        line-height: 1.45;
      }

      .edit-status {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        align-items: center;
        min-height: 1.5rem;
        font-size: 0.92rem;
      }

      .edit-status strong {
        color: var(--c-fg);
      }

      .edit-status[data-tone='idle'] {
        color: var(--edit-muted);
      }

      .edit-status[data-tone='saving'] {
        color: var(--edit-warn);
      }

      .edit-status[data-tone='success'] {
        color: var(--edit-ok);
      }

      .edit-status[data-tone='error'] {
        color: var(--edit-error);
      }

      .edit-table {
        overflow-x: auto;
      }

      .edit-table :global(.tabulator) {
        border: 1px solid var(--edit-shell-border);
        border-radius: 14px;
        overflow: hidden;
        background: transparent;
      }

      .edit-table :global(.tabulator-header) {
        background: color-mix(in srgb, var(--c-bg) 94%, var(--c-fg) 6%);
      }

      .edit-table :global(.tabulator-row:nth-child(even)) {
        background: color-mix(in srgb, var(--c-bg) 97%, var(--c-fg) 3%);
      }

      .edit-table :global(.tabulator-cell.tabulator-editing) {
        background: color-mix(in srgb, var(--c-link) 10%, var(--c-bg));
      }

      .edit-table :global(.edit-cell--native) {
        background: color-mix(in srgb, var(--c-fg) 3%, transparent);
      }

      .edit-table :global(.edit-cell--readonly) {
        color: var(--edit-muted);
      }

      .edit-table :global(.tabulator-edit-list),
      .edit-table :global(.tabulator-edit-select-list) {
        background: var(--c-bg);
        color: var(--c-fg);
        border: 1px solid var(--edit-shell-border);
      }

      .edit-empty {
        margin: 0;
        padding: 0.9rem 0.2rem 0.1rem;
        color: var(--edit-muted);
      }

      @media (max-width: 900px) {
        .edit-page {
          width: 100%;
          margin: 0;
          padding: 0;
        }

        .edit-shell {
          border: 0;
          border-radius: 0;
          padding: 0.75rem;
        }

        .edit-field {
          min-width: 0;
          flex: 1 1 100%;
        }

        .edit-apply-btn {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="edit-page">
      <section class="edit-shell">
        <form class="edit-toolbar" method="get">
          <div class="edit-field">
            <label for="edit-experiment-course">Curso</label>
            <select id="edit-experiment-course" name="course">
              {availableCourses.length === 0 ? (
                <option value="">Sin cursos</option>
              ) : (
                availableCourses.map((course) => (
                  <option value={course.courseId} selected={course.courseId === selectedCourseId}>
                    {course.title}
                  </option>
                ))
              )}
            </select>
          </div>

          <div class="edit-field edit-field--year">
            <label for="edit-experiment-year">Año</label>
            <input
              id="edit-experiment-year"
              type="number"
              min="2000"
              max="2100"
              step="1"
              name="year"
              value={selectedYear}
            />
          </div>

          <button type="submit" class="edit-apply-btn">Aplicar</button>
        </form>

        <p class="edit-copy">
          Laboratorio limpio para validar edición nativa de Tabulator sin lógica híbrida.
          Esta tabla prueba solo tres persistencias reales: <strong>Rol curso</strong>, <strong>Turno</strong> y <strong>Notes</strong>.
          Arrastrá para seleccionar rangos, usá <strong>Cmd/Ctrl</strong> para sumar rangos discontinuos y hacé <strong>doble click</strong> para editar.
        </p>

        <div class="edit-status" data-edit-status data-tone="idle">
          {selectedCourseId ? (
            <span>
              <strong>{courseTitleById.get(selectedCourseId) || selectedCourseId}</strong> · Año {selectedYear} · {rows.length} filas
            </span>
          ) : (
            <span>No hay cursos docentes disponibles para probar.</span>
          )}
        </div>

        {selectedCourseId ? (
          <div
            class="edit-table"
            data-edit-experiment-root
            data-edit-payload={editExperimentPayload}
          ></div>
        ) : (
          <p class="edit-empty">
            Necesitás tener al menos una inscripción docente para usar este experimento.
          </p>
        )}
      </section>
    </main>

    <script>
      import { TabulatorFull as Tabulator } from 'tabulator-tables';

      const root = document.querySelector('[data-edit-experiment-root]');
      const payload = root instanceof HTMLElement
        ? JSON.parse(decodeURIComponent(root.dataset.editPayload || '%7B%7D'))
        : {};
      const rows = Array.isArray(payload?.rows) ? payload.rows : [];
      const courseId = String(payload?.courseId || '').trim();
      const year = String(payload?.year || '').trim();
      const statusNode = document.querySelector('[data-edit-status]');

      const setStatus = (tone, message) => {
        if (!(statusNode instanceof HTMLElement)) return;
        statusNode.dataset.tone = tone;
        statusNode.textContent = message;
      };

      const normalizeText = (value) => String(value ?? '').trim();

      const persistStudentMeta = async (rowData, field, value) => {
        const body = {
          courseId,
          year,
          studentId: normalizeText(rowData?.studentId),
        };

        if (field === 'turno') body.turno = value;
        if (field === 'notes') body.notes = value;

        const response = await fetch('/api/grade/course-student-meta', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });

        const payload = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(payload?.error || 'No se pudo guardar metadata');
        }

        return payload?.meta || {};
      };

      const persistCourseRole = async (rowData, value) => {
        const response = await fetch('/api/enroll', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            enrollmentId: normalizeText(rowData?.enrollmentId),
            roleInCourse: value,
          }),
        });

        const payload = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(payload?.error || 'No se pudo actualizar el rol del curso');
        }

        return normalizeText(payload?.enrollment?.roleInCourse || value) || value;
      };

      if (root instanceof HTMLElement && courseId) {
        let isApplyingBulkEdit = false;

        const isEditableField = (field) => ['courseRole', 'turno', 'notes'].includes(field);
        const isEditableCell = (cell, field) => {
          const rowData = cell?.getRow?.()?.getData?.() || cell?.getData?.() || {};
          if (field === 'courseRole') return Boolean(normalizeText(rowData?.enrollmentId));
          if (field === 'turno' || field === 'notes') return Boolean(rowData?.canEditStudentMeta);
          return false;
        };

        const getSelectedCells = (table) => {
          const cellsByKey = new Map();
          const ranges = table.getRanges?.() || [];
          ranges.forEach((range) => {
            const rows = range.getCells?.() || [];
            rows.forEach((rowCells) => {
              if (!Array.isArray(rowCells)) return;
              rowCells.forEach((cell) => {
                const rowId = normalizeText(cell?.getRow?.()?.getData?.()?.id || cell?.getRow?.()?.getIndex?.() || '');
                const field = normalizeText(cell?.getField?.() || '');
                if (!rowId || !field) return;
                cellsByKey.set(`${rowId}::${field}`, cell);
              });
            });
          });
          return Array.from(cellsByKey.values());
        };

        const resolveBulkTargets = (table, anchorCell) => {
          const field = normalizeText(anchorCell?.getField?.() || '');
          if (!isEditableField(field)) return [anchorCell];

          const targets = getSelectedCells(table)
            .filter((cell) => normalizeText(cell?.getField?.() || '') === field)
            .filter((cell) => isEditableCell(cell, field));

          const anchorRowId = normalizeText(anchorCell?.getRow?.()?.getData?.()?.id || anchorCell?.getRow?.()?.getIndex?.() || '');
          const hasAnchor = targets.some((cell) => {
            const rowId = normalizeText(cell?.getRow?.()?.getData?.()?.id || cell?.getRow?.()?.getIndex?.() || '');
            return rowId === anchorRowId;
          });

          if (!hasAnchor && isEditableCell(anchorCell, field)) {
            targets.unshift(anchorCell);
          }

          return targets.length > 0 ? targets : [anchorCell];
        };

        const buildResolvedRowPatch = async (rowData, field, nextValue) => {
          if (field === 'courseRole') {
            const resolvedRole = await persistCourseRole(rowData, normalizeText(nextValue).toLowerCase() || 'student');
            return {
              courseRole: resolvedRole,
              canEditStudentMeta: normalizeText(resolvedRole).toLowerCase() !== 'teacher',
            };
          }

          const meta = await persistStudentMeta(rowData, field, nextValue);
          if (field === 'turno') {
            return {
              turno: normalizeText(meta?.turno || nextValue),
            };
          }

          if (field === 'notes') {
            return {
              notes: normalizeText(meta?.notes || nextValue),
            };
          }

          return {};
        };

        const table = new Tabulator(root, {
          data: rows,
          index: 'id',
          layout: 'fitDataFill',
          height: '72vh',
          reactiveData: false,
          editTriggerEvent: 'dblclick',
          selectableRange: true,
          selectableRangeAutoFocus: false,
          columnDefaults: {
            headerSort: false,
            headerHozAlign: 'center',
            vertAlign: 'middle',
            resizable: 'header',
          },
          columns: [
            { title: 'Apellido', field: 'lastName', minWidth: 150 },
            { title: 'Nombre', field: 'firstName', minWidth: 138 },
            { title: 'Email', field: 'email', minWidth: 220 },
            { title: 'Rol global', field: 'globalRole', width: 110, hozAlign: 'center' },
            {
              title: 'Rol curso',
              field: 'courseRole',
              width: 120,
              hozAlign: 'center',
              cssClass: 'edit-cell--native',
              editor: 'list',
              editorParams: {
                values: {
                  student: 'Student',
                  teacher: 'Teacher',
                },
                autocomplete: false,
                clearable: false,
                verticalNavigation: 'table',
                maxWidth: true,
              },
              editable: (cell) => Boolean(normalizeText(cell.getRow().getData()?.enrollmentId)),
              formatter: (cell) => {
                const value = normalizeText(cell.getValue()).toLowerCase();
                return value === 'teacher' ? 'Teacher' : 'Student';
              },
            },
            {
              title: 'Turno',
              field: 'turno',
              width: 90,
              hozAlign: 'center',
              cssClass: 'edit-cell--native',
              editor: 'list',
              editorParams: {
                values: ['M', 'T', 'N'],
                autocomplete: false,
                clearable: false,
                verticalNavigation: 'table',
                maxWidth: true,
              },
              editable: (cell) => Boolean(cell.getRow().getData()?.canEditStudentMeta),
            },
            {
              title: 'Notes',
              field: 'notes',
              minWidth: 260,
              cssClass: 'edit-cell--native',
              editor: 'input',
              editorParams: {
                selectContents: true,
                elementAttributes: {
                  maxlength: '280',
                },
              },
              editable: (cell) => Boolean(cell.getRow().getData()?.canEditStudentMeta),
            },
          ],
        });

        table.on('cellEdited', async (cell) => {
          if (isApplyingBulkEdit) return;

          const field = normalizeText(cell.getField());
          const row = cell.getRow();
          const rowData = row.getData() || {};
          const previousValue = cell.getOldValue();
          const nextValue = cell.getValue();

          if (!['courseRole', 'turno', 'notes'].includes(field)) return;
          if (nextValue === previousValue) return;

          const targets = resolveBulkTargets(table, cell);
          const count = targets.length;

          try {
            isApplyingBulkEdit = true;
            setStatus(
              'saving',
              count > 1
                ? `Guardando ${field} en ${count} celdas seleccionadas...`
                : `Guardando ${field} para ${normalizeText(rowData.lastName || rowData.email || 'fila')}...`,
            );

            let successCount = 0;
            const failureMessages = [];

            for (const targetCell of targets) {
              const targetRow = targetCell.getRow();
              const targetRowData = targetRow.getData() || {};
              const targetPreviousValue = targetCell === cell
                ? previousValue
                : targetCell.getValue();

              try {
                const patch = await buildResolvedRowPatch(targetRowData, field, nextValue);
                await targetRow.update(patch);
                successCount += 1;
              } catch (error) {
                await targetRow.update({ [field]: targetPreviousValue });
                failureMessages.push(
                  error instanceof Error ? error.message : 'No se pudo guardar',
                );
              }
            }

            if (failureMessages.length > 0) {
              if (successCount > 0) {
                setStatus('error', `Se guardaron ${successCount} celdas, pero ${failureMessages.length} fallaron.`);
                window.alert(`Se guardaron ${successCount} celdas, pero ${failureMessages.length} fallaron.`);
              } else {
                const message = failureMessages[0] || 'No se pudo guardar';
                setStatus('error', message);
                window.alert(message);
              }
              return;
            }

            if (field === 'courseRole') {
              setStatus('success', count > 1 ? `Rol curso guardado en ${count} celdas.` : `Rol curso guardado para ${normalizeText(rowData.lastName || rowData.email || 'fila')}.`);
              return;
            }

            if (field === 'turno') {
              setStatus('success', count > 1 ? `Turno guardado en ${count} celdas.` : `Turno guardado para ${normalizeText(rowData.lastName || rowData.email || 'fila')}.`);
              return;
            }

            if (field === 'notes') {
              setStatus('success', count > 1 ? `Notes guardadas en ${count} celdas.` : `Notes guardadas para ${normalizeText(rowData.lastName || rowData.email || 'fila')}.`);
            }
          } catch (error) {
            await row.update({ [field]: previousValue });
            const message = error instanceof Error ? error.message : 'No se pudo guardar';
            setStatus('error', message);
            window.alert(message);
          } finally {
            isApplyingBulkEdit = false;
          }
        });
      }
    </script>
  </body>
</html>
