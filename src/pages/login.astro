---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { SignIn } from "auth-astro/components";
import { resolveRequestAuthOrigin } from "../lib/auth-origin";
import { t } from "../lib/i18n";
import { TENANTS, DEFAULT_TENANT_ID } from "../lib/tenant/tenants";

const tenant = Astro.locals.tenant ?? TENANTS[DEFAULT_TENANT_ID];
const locale = tenant.locale;

const session = (Astro.locals as any).session;

const toSafeRedirect = (value: unknown): string => {
    let text = typeof value === "string" ? value.trim() : "";
    if (!text) return "";

    for (let attempts = 0; attempts < 2; attempts += 1) {
        if (!/%[0-9a-f]{2}/i.test(text)) break;
        try {
            const decoded = decodeURIComponent(text);
            if (!decoded || decoded === text) break;
            text = decoded.trim();
        } catch {
            break;
        }
    }

    if (!text) return "";
    if (!text.startsWith("/") || text.startsWith("//")) return "";
    if (text.startsWith("/login")) return "";
    if (text.startsWith("/api/auth")) return "";
    return text;
};

const requestedRedirect = toSafeRedirect(Astro.url.searchParams.get("redirect"));
const callbackPath = requestedRedirect || "/dashboard";
const authOrigin = resolveRequestAuthOrigin(Astro.request);
const callbackUrl = `${authOrigin}${callbackPath}`;

if (session?.user?.email) {
    return Astro.redirect(callbackPath);
}

// When Logto is configured it replaces authentik as the primary login;
// Google stays below as fallback in both cases.
const logtoEnabled = Boolean(process.env.LOGTO_ISSUER_URL || import.meta.env.LOGTO_ISSUER_URL);
---
<html lang={locale}>
<head>
    <BaseHead title={t(locale, "login.title")} description={t(locale, "login.description")} />
    <style>
        .wrap { max-width: 400px; margin: 4rem auto; padding: 2rem; border: 1px solid var(--c-border); border-radius: 8px; }
        h1 { text-align: center; }
        .provider-login {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            margin-top: 2rem;
        }
        .provider-login button {
            display: block;
            width: 100%;
            padding: 0.75rem;
            border: 1px solid var(--c-border);
            text-align: center;
            border-radius: 6px;
            text-decoration: none;
            background: var(--c-bg);
            color: var(--c-fg);
            cursor: pointer;
            font-size: 1rem;
            transition: all 0.2s ease;
        }
        .provider-login button:hover {
            background-color: var(--c-bg-mute);
            transform: translateY(-1px);
        }
        .btn-authentik {
            border-color: #fd4b2d !important;
            font-weight: 600;
        }
        .btn-google {
            opacity: 0.7;
            font-size: 0.9rem !important;
        }
        .divider {
            height: 1px;
            background: var(--c-border);
            margin: 0.5rem 0;
            position: relative;
        }
    </style>
</head>
<body>
    <Header />
    <main class="wrap">
        <h1>{t(locale, "login.heading")}</h1>
        <div class="provider-login">
            {tenant.id !== DEFAULT_TENANT_ID ? (
                <SignIn provider={tenant.authProviders[0]} options={{ callbackUrl }}>
                    <span class="btn-authentik">{t(locale, "login.signIn")}</span>
                </SignIn>
            ) : (<>
            {logtoEnabled ? (
                <SignIn provider="logto" options={{ callbackUrl }}>
                    <span class="btn-authentik">{t(locale, "login.signIn")}</span>
                </SignIn>
            ) : (
                <SignIn provider="authentik" options={{ callbackUrl }}>
                    <span class="btn-authentik">{t(locale, "login.enter", { name: tenant.brand.name })}</span>
                </SignIn>
            )}

            <div class="divider"></div>

            <SignIn provider="google" options={{ callbackUrl }}>
                <span class="btn-google">{t(locale, "login.google")}</span>
            </SignIn>
            </>)}
        </div>
    </main>
</body>
</html>
