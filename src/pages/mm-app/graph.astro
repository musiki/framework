---
// Internal page for mm "/graph" (middleware rewrite). The concept graph of
// the space, filterable by forum and status (a plain GET form, works without
// JS). The server renders the accessible version (concepts by status +
// relations table); graph.ts draws the D3 force graph (bundled, no CDN) from
// the data attribute, in the MishMash Lab's visual language. The graph wrapper
// (toolbar, canvas, key help) stays hidden until the script draws, so readers
// without JS only get the lists.
import MmLayout from '../../layouts/MmLayout.astro';
import MmStatus from '../../components/mm/MmStatus.astro';
import { t, type MessageKey } from '../../lib/i18n';
import { applyMmLang } from '../../lib/mm/ui-lang';
import { CONCEPT_STATUSES, graph, type GraphEdge, type GraphNode } from '../../lib/mm/concepts';
import { listForums, type ForumSummary } from '../../lib/mm/forum';
import { loadMmViewer, logPageError } from '../../lib/mm/page-data';
import { conceptLabel, conceptPath } from '../../lib/mm/view';
export const prerender = false;

const isMm = Astro.locals.tenant?.id === 'mm';
const lang = applyMmLang(Astro);
const forumParam = String(Astro.url.searchParams.get('forum') ?? '').trim();
const statusParam = String(Astro.url.searchParams.get('status') ?? '').trim();
const status = (CONCEPT_STATUSES as readonly string[]).includes(statusParam) ? statusParam : '';

let state: 'ok' | 'unavailable' = 'ok';
let forums: ForumSummary[] = [];
let nodes: GraphNode[] = [];
let edges: GraphEdge[] = [];
let forumSlug = '';

if (isMm) {
  try {
    const viewer = await loadMmViewer(Astro.locals);
    forums = await listForums({ spaceId: viewer.space.id });
    const forum = forums.find((f) => f.slug === forumParam) ?? null;
    forumSlug = forum?.slug ?? '';
    ({ nodes, edges } = await graph({ spaceId: viewer.space.id, forumId: forum?.id ?? null, status: status || null, lang }));
  } catch (err) {
    logPageError('graph', err);
    state = 'unavailable';
  }
} else Astro.response.status = 404;
if (state === 'unavailable') Astro.response.status = 503;

const relLabel = (type: string) => t(lang, `mm.relationTypes.${type}` as MessageKey);
const labelOf = new Map(nodes.map((n) => [n.id, conceptLabel(n, lang)]));
const graphData = JSON.stringify({
  nodes: nodes.map((n) => ({ id: n.id, label: labelOf.get(n.id)!.text, lang: labelOf.get(n.id)!.lang, status: n.status, statusLabel: t(lang, `mm.status.${n.status}` as MessageKey), href: conceptPath(n.id), excerpt: n.excerpt, excerptLang: n.excerptLang })),
  links: edges.map((e) => ({ source: e.source, target: e.target, type: e.type, label: relLabel(e.type) })),
});
const byStatus = CONCEPT_STATUSES.map((s) => ({ status: s, nodes: nodes.filter((n) => n.status === s) })).filter((g) => g.nodes.length);
---
{!isMm ? (
  <html lang="en"><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>Not found</title></head><body><h1>Not found</h1></body></html>
) : state !== 'ok' ? (
  <MmStatus lang={lang} kind="unavailable" />
) : (
  <MmLayout lang={lang} title={t(lang, 'mm.graph.title')} description={t(lang, 'mm.graph.lead')}>
    <h1>{t(lang, 'mm.graph.title')}</h1>
    <p class="mm-lead">{t(lang, 'mm.graph.lead')}</p>

    <form class="mm-filters" method="get" action="/graph" aria-label={t(lang, 'mm.graph.filters')}>
      <div class="mm-form-row">
        <label for="mm-g-forum">{t(lang, 'mm.graph.forum')}</label>
        <select id="mm-g-forum" name="forum">
          <option value="">{t(lang, 'mm.graph.allForums')}</option>
          {forums.map((f) => <option value={f.slug} selected={f.slug === forumSlug}>{f.title}</option>)}
        </select>
      </div>
      <div class="mm-form-row">
        <label for="mm-g-status">{t(lang, 'mm.graph.status')}</label>
        <select id="mm-g-status" name="status">
          <option value="">{t(lang, 'mm.graph.allStatuses')}</option>
          {CONCEPT_STATUSES.map((s) => <option value={s} selected={s === status}>{t(lang, `mm.status.${s}` as MessageKey)}</option>)}
        </select>
      </div>
      <button class="mm-button mm-button-small" type="submit">{t(lang, 'mm.graph.apply')}</button>
    </form>

    <ul class="mm-legend" aria-label={t(lang, 'mm.graph.legend')}>
      {CONCEPT_STATUSES.map((s) => (
        <li><span class={`mm-dot mm-st-${s}`} aria-hidden="true"></span>{t(lang, `mm.status.help.${s}` as MessageKey)}</li>
      ))}
    </ul>

    {nodes.length ? (
      <>
        <p class="mm-visually-hidden">{t(lang, 'mm.graph.summary', { nodes: nodes.length, edges: edges.length })}</p>
        <div class="mm-graph-wrap" data-mm-graph-wrap hidden>
          <div class="mm-graph-tools" role="toolbar" aria-label={t(lang, 'mm.graph.controls')} aria-controls="mm-g-canvas">
            <button type="button" class="mm-button mm-button-small mm-button-quiet" data-mm-graph-act="in" aria-label={t(lang, 'mm.graph.zoomIn')} title={t(lang, 'mm.graph.zoomIn')}><span aria-hidden="true">+</span></button>
            <button type="button" class="mm-button mm-button-small mm-button-quiet" data-mm-graph-act="out" aria-label={t(lang, 'mm.graph.zoomOut')} title={t(lang, 'mm.graph.zoomOut')}><span aria-hidden="true">−</span></button>
            <button type="button" class="mm-button mm-button-small mm-button-quiet" data-mm-graph-act="fit" title={t(lang, 'mm.graph.fitLabel')}>{t(lang, 'mm.graph.fit')}</button>
            <button type="button" class="mm-button mm-button-small mm-button-quiet" data-mm-graph-act="reset" title={t(lang, 'mm.graph.resetLabel')}>{t(lang, 'mm.graph.reset')}</button>
            <button type="button" class="mm-button mm-button-small mm-button-quiet" data-mm-graph-act="labels" aria-pressed="false">{t(lang, 'mm.graph.showLabels')}</button>
          </div>
          <div
            class="mm-graph"
            id="mm-g-canvas"
            data-mm-graph
            data-graph={graphData}
            data-selected-template={t(lang, 'mm.graph.selected')}
            data-open-label={t(lang, 'mm.graph.open')}
            data-no-definition={t(lang, 'mm.graph.noDefinition')}
            role="group"
            aria-label={t(lang, 'mm.graph.canvas')}
            aria-describedby="mm-g-keys"
          ></div>
          <p class="mm-help" id="mm-g-keys">{t(lang, 'mm.graph.keys')}</p>
          <p class="mm-visually-hidden" aria-live="polite" data-mm-graph-status></p>
        </div>

        <section aria-labelledby="mm-g-list">
          <h2 id="mm-g-list">{t(lang, 'mm.graph.listTitle')}</h2>
          {byStatus.map((g) => (
            <>
              <h3><span class={`mm-dot mm-st-${g.status}`} aria-hidden="true"></span> {t(lang, `mm.status.${g.status}` as MessageKey)}</h3>
              <ul class="mm-concept-list">
                {g.nodes.map((n) => {
                  const l = labelOf.get(n.id)!;
                  return <li class={`mm-st-${n.status}`}><a href={conceptPath(n.id)} lang={l.lang}>{l.text}</a></li>;
                })}
              </ul>
            </>
          ))}
        </section>

        <section aria-labelledby="mm-g-rel">
          <h2 id="mm-g-rel">{t(lang, 'mm.graph.relationsTitle')}</h2>
          {edges.length ? (
            <div class="mm-table-wrap">
              <table class="mm-table">
                <thead>
                  <tr>
                    <th scope="col">{t(lang, 'mm.graph.source')}</th>
                    <th scope="col">{t(lang, 'mm.graph.relation')}</th>
                    <th scope="col">{t(lang, 'mm.graph.target')}</th>
                  </tr>
                </thead>
                <tbody>
                  {edges.map((e) => {
                    const s = labelOf.get(e.source);
                    const tt = labelOf.get(e.target);
                    return (
                      <tr>
                        <td><a href={conceptPath(e.source)} lang={s?.lang}>{s?.text ?? e.source}</a></td>
                        <td>{relLabel(e.type)}</td>
                        <td><a href={conceptPath(e.target)} lang={tt?.lang}>{tt?.text ?? e.target}</a></td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="mm-muted">{t(lang, 'mm.graph.relationsEmpty')}</p>
          )}
        </section>
      </>
    ) : (
      <p class="mm-note">{t(lang, 'mm.graph.empty')}</p>
    )}
  </MmLayout>
)}

<script>
  import '../../scripts/mm/graph.ts';
</script>
