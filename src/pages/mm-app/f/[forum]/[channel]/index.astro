---
// Internal page for mm "/f/<group>/<channel>" (middleware rewrite). A channel
// of a group: breadcrumbs group › channel, then the forum page (threads,
// bibliography — the group's unless overridden —, concepts born here). A
// channel of another group, an archived one, or the reserved slug "t"
// (/f/<group>/t without a thread) is a 404.
import MmBoardPage from '../../../../../components/mm/MmBoardPage.astro';
import { applyMmLang } from '../../../../../lib/mm/ui-lang';
import { loadBoardPage } from '../../../../../lib/mm/board-pages';
export const prerender = false;

const isMm = Astro.locals.tenant?.id === 'mm';
const lang = applyMmLang(Astro);
const data = await loadBoardPage(Astro.locals, isMm, String(Astro.params.forum ?? ''), String(Astro.params.channel ?? ''));
if (data.state === 'notFound') Astro.response.status = 404;
if (data.state === 'unavailable') Astro.response.status = 503;
---
<MmBoardPage lang={lang} isMm={isMm} data={data} />
