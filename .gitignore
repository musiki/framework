# Dependencies
node_modules/

# Build output
dist/
dist_old/
dist_tmp/
.tmp/
.cache/

# Astro
.astro/
.content-sources/
src/content/cursos/**
!src/content/cursos/
!src/content/cursos/.gitkeep
src/content/public/**
!src/content/public/
!src/content/public/.gitkeep
src/content/.obsidian/

# Environment variables
.env
.env*.local
.env.*
*.env
*.env.*
!services/ollama-api/.env.example
.env copy
.env*.copy

# Editor directories and files
.history/
.DS_Store
.aiexclude
.vscode/easycode.ignore
.gstack/

