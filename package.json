{
  "name": "framework",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:force": "astro dev --force",
    "start": "astro dev",
    "test": "node --test \"src/lib/live/*.test.mjs\" \"src/scripts/course/sidebar/*.test.mjs\" \"src/scripts/notas/*.test.mjs\" \"src/scripts/course/notes/*.test.mjs\"",
    "preflight": "bash scripts/preflight.sh",
    "graph:build": "node src/scripts/build-graph-data.mjs",
    "vault:sync": "node src/scripts/update-vault-index.mjs",
    "eval:sync:db": "node src/scripts/sync-eval-assignment-db.mjs",
    "content:pull": "node scripts/pull-sources.mjs",
    "content:watch": "node scripts/watch-content.mjs",
    "content:assemble:dry": "node scripts/assemble-content.mjs",
    "content:assemble": "node scripts/assemble-content.mjs --apply && npm run vault:sync && npm run graph:build",
    "repo:materia:new": "node scripts/scaffold-materia-repo.mjs",
    "build:content": "npm run content:pull -- --clean && npm run content:assemble",
    "build": "npm run build:content && (npm run eval:sync:db || true) && astro build --remote",
    "build:local": "npm run build:content && (npm run eval:sync:db || true) && astro build",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "preview": "astro preview",
    "astro": "astro",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:seed": "astro db seed",
    "db:push": "astro db push",
    "db:studio": "astro db studio",
    "github:tokens:audit": "node scripts/github-token-audit.mjs"
  },
  "dependencies": {
    "@astrojs/db": "^0.21.1",
    "@astrojs/node": "^10.0.6",
    "@astrojs/react": "^5.0.5",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@auth/core": "^0.37.4",
    "@aws-sdk/client-s3": "^3.1004.0",
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-csl": "^0.7.22",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@handsontable/react-wrapper": "^17.1.0",
    "@mediapipe/tasks-vision": "^0.10.32",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@strudel/codemirror": "1.3.0",
    "@strudel/hydra": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/repl": "1.3.0",
    "@strudel/sampler": "0.2.4",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/tonal": "1.2.6",
    "@strudel/xen": "1.2.6",
    "@supabase/supabase-js": "^2.91.0",
    "auth-astro": "^4.2.0",
    "better-auth": "^1.6.18",
    "codemirror": "^6.0.2",
    "dockview-core": "^5.2.0",
    "drawing-drum-machine": "1.0.5",
    "drizzle-orm": "^0.45.2",
    "essentia.js": "^0.1.3",
    "force-graph": "^1.51.0",
    "fuse.js": "^7.1.0",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "handsontable": "^17.1.0",
    "hast-util-to-html": "^9.0.5",
    "hydra-synth": "1.4.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.1.1",
    "livekit-client": "^2.17.2",
    "livekit-server-sdk": "^2.15.0",
    "marked": "^16.3.0",
    "mdast-util-to-hast": "^13.2.0",
    "mermaid": "^11.12.3",
    "path-to-regexp": "^8.3.0",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-highlight": "^7.0.2",
    "rehype-mathjax": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-wiki-link": "^2.0.1",
    "reveal.js": "^5.2.1",
    "robust-predicates": "^3.0.3",
    "sharp": "^0.34.3",
    "superdough": "1.3.0",
    "tabulator-tables": "^6.3.1",
    "three": "^0.183.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.4",
    "@types/pg": "^8.20.0",
    "astro": "^6.2.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "supabase": "^2.84.4"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@10.9.3",
  "overrides": {
    "drizzle-orm": "^0.45.2",
    "@xmldom/xmldom": ">=0.9.10",
    "fast-xml-parser": ">=5.7.0",
    "@nodable/entities": ">=2.1.0",
    "fast-xml-builder": ">=1.1.9",
    "uuid": ">=11.1.1",
    "esbuild": "^0.28.1",
    "kysely": "^0.28.17",
    "devalue": "^5.8.1",
    "fast-uri": "^4.0.0"
  }
}
